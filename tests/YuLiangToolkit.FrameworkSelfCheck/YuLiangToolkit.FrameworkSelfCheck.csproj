<Project Sdk="Microsoft.NET.Sdk">

  <!-- 自检程序（纯控制台，不在 GUI 里跑）：按“分组”跑，只跑改动相关的部分（见 AGENTS.md）。
       运行： dotnet run 后接本项目 csproj 路径，再传组名（例如 theme、core,shell）。
       不传组名 = 全部分组；组名清单见 Program.cs 顶部的 selfCheckGroups。
       默认在系统临时目录里造一个数据根，不会碰仓库里的 Data/Config；
       想指定目录就设环境变量 YLT_HOME。退出码 0 = 本次跑的分组全部通过。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 和主程序保持一致：引用了「PDF 阅读器」，要能跑 Windows.Data.Pdf 的真实渲染自检，
         所以同样是 net9.0-windows10.0.19041.0。 -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>YuLiangToolkit.FrameworkSelfCheck</RootNamespace>
    <AssemblyName>YuLiangToolkit.FrameworkSelfCheck</AssemblyName>
  </PropertyGroup>


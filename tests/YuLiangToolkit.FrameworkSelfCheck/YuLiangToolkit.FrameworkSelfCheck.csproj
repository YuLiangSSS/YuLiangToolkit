<Project Sdk="Microsoft.NET.Sdk">

  <!-- 自检程序（纯控制台，不在 GUI 里跑）：Data/Config 轮子 + 主页搜索/排序逻辑。
       运行： dotnet run  加上本项目 csproj 路径即可（见 AGENTS.md「自检」一节）。
       默认在系统临时目录里造一个数据根，不会碰仓库里的 Data/Config；
       想指定目录就设环境变量 YLT_HOME。退出码 0 = 全部通过。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>YuLiangToolkit.FrameworkSelfCheck</RootNamespace>
    <AssemblyName>YuLiangToolkit.FrameworkSelfCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\YuLiangToolkit.Core\YuLiangToolkit.Core.csproj" />
    <!-- 主页的搜索/排序逻辑（ToolFilter / ToolCard）在主程序集里，引用来做纯逻辑断言。
         注意：只 new ToolCard，不碰任何需要 WPF Application 资源的东西。 -->
    <ProjectReference Include="..\..\YuLiangTookit.csproj" />
    <!-- 「批量重命名」的命名规则/冲突检测（RenameEngine）也是纯逻辑，直接断言。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.BatchRename\YuLiangToolkit.Tools.BatchRename.csproj" />
    <!-- 「Flash 下载器」：站点解析 / 命名规则 / SWFNetPath.ini / 批量下载计划 / 本地服务器路径映射
         / 真下载（打自检自己起的小 HTTP 服务器）/ 自动下载缺失文件，全部无头跑。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.FlashDownloader\YuLiangToolkit.Tools.FlashDownloader.csproj" />
    <!-- 「联机聊天室」：协议帧 / CRC32 / 单次流量上限 / 会话文件夹命名与聊天记录
         / 真的在 127.0.0.1 上开一局主机 + 客户端聊一轮（双向文字与文件）。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.ChatRoom\YuLiangToolkit.Tools.ChatRoom.csproj" />
    <!-- 「osu! 下图器」：查询串 / 文件名清洗 / 本地日期与 Key 数筛选 / 配置轮子
         / 打自检自己起的假镜像真下载（跳过已存在、404 计失败、取消不留半个文件）。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.MapDownloader\YuLiangToolkit.Tools.MapDownloader.csproj" />
    <!-- 「视频 / 音乐播放器」：扩展名归类 / 时间与快进快退 / 自然排序 / 扫文件夹 / 合并去重
         / 播放顺序（顺序·单曲·随机）/ 配置；再塞一个假播放器把 ViewModel 整条链路跑一遍。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.MediaPlayer\YuLiangToolkit.Tools.MediaPlayer.csproj" />
  </ItemGroup>

</Project>

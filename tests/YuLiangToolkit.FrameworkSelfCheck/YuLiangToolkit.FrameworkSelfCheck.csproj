<Project Sdk="Microsoft.NET.Sdk">

  <!-- 自检程序（纯控制台，不在 GUI 里跑）：按“分组”跑，只跑改动相关的部分（见 AGENTS.md）。
       运行： dotnet run 后接本项目 csproj 路径，再传组名（例如 theme、core,shell）。
       不传组名 = 全部分组；组名清单见 Program.cs 顶部的 selfCheckGroups。
       默认在系统临时目录里造一个数据根，不会碰仓库里的 Data/Config；
       想指定目录就设环境变量 YLT_HOME。退出码 0 = 本次跑的分组全部通过。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 和主程序保持一致：引用了「PDF 阅读器」，要能跑 Windows.Data.Pdf 的真实渲染自检，
         所以同样是 net9.0-windows10.0.19041.0。 -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>YuLiangToolkit.FrameworkSelfCheck</RootNamespace>
    <AssemblyName>YuLiangToolkit.FrameworkSelfCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\YuLiangToolkit.Core\YuLiangToolkit.Core.csproj" />
    <!-- 主页的搜索/排序逻辑（ToolFilter / ToolCard）在主程序集里，引用来做纯逻辑断言。
         注意：只 new ToolCard，不碰任何需要 WPF Application 资源的东西。 -->
    <ProjectReference Include="..\..\YuLiangTookit.csproj" />
    <!-- 「批量重命名」的命名规则/冲突检测（RenameEngine）也是纯逻辑，直接断言。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.BatchRename\YuLiangToolkit.Tools.BatchRename.csproj" />
    <!-- 「Flash 下载器」：站点解析 / 命名规则 / SWFNetPath.ini / 批量下载计划 / 本地服务器路径映射
         / 真下载（打自检自己起的小 HTTP 服务器）/ 自动下载缺失文件，全部无头跑。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.FlashDownloader\YuLiangToolkit.Tools.FlashDownloader.csproj" />
    <!-- 「联机聊天室」：协议帧 / CRC32 / 单次流量上限 / 会话文件夹命名与聊天记录
         / 真的在 127.0.0.1 上开一局主机 + 客户端聊一轮（双向文字与文件）。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.ChatRoom\YuLiangToolkit.Tools.ChatRoom.csproj" />
    <!-- 「osu! 下图器」：查询串 / 文件名清洗 / 本地日期与 Key 数筛选 / 配置轮子
         / 打自检自己起的假镜像真下载（跳过已存在、404 计失败、取消不留半个文件）。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.MapDownloader\YuLiangToolkit.Tools.MapDownloader.csproj" />
    <!-- 「视频 / 音乐播放器」：扩展名归类 / 时间与快进快退 / 自然排序 / 扫文件夹 / 合并去重
         / 播放顺序（顺序·单曲·随机）/ 配置；再塞一个假播放器把 ViewModel 整条链路跑一遍。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.MediaPlayer\YuLiangToolkit.Tools.MediaPlayer.csproj" />
    <!-- 「图片连续阅读器」：页序自然排序 / 三种滚动方式的偏移数学 / 中键单点-按住状态机
         / 排版尺寸 / 真扫一个临时图片文件夹。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.PictureViewer\YuLiangToolkit.Tools.PictureViewer.csproj" />
    <!-- 「PDF 阅读器」：滚动排版 / 双页配对 / 惯性纯逻辑 + 生成一份最小 PDF 真走一遍
         Windows.Data.Pdf 渲染链路（无头，不弹窗）。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.PdfReader\YuLiangToolkit.Tools.PdfReader.csproj" />
    <!-- 「osu!mania 转谱」：OsuParsers 解析桥往返 / 星数 / 等级公式 / 转 K / 转 LN，
         全部是纯逻辑（合成谱面文本在临时目录里造，不碰仓库 Data/Config）。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.OsuMania\YuLiangToolkit.Tools.OsuMania.csproj" />
    <!-- 「棋牌」：五子棋胜负 / 禁手，象棋走法 / 将军 / 摆棋 / 让先 / 记谱，
         以及在本机 127.0.0.1 上真的开一局房间（主机 + 客户端双向同步）。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.BoardGames\YuLiangToolkit.Tools.BoardGames.csproj" />
    <!-- 「KPS 按键统计」：统计引擎口径 / 内置预设 / 配置序列化 / 热键解析 / Raw Input 真实注入。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.Kps\YuLiangToolkit.Tools.Kps.csproj" />
    <!-- 「Spug 验证码测试」：URL / 参数校验、短信 GET 拼接、邮箱 POST JSON、响应解析、本地验证、打码、配置；
         假 HttpMessageHandler 真跑请求层，不碰外网。 -->
    <ProjectReference Include="..\..\src\YuLiangToolkit.Tools.SpugCaptcha\YuLiangToolkit.Tools.SpugCaptcha.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Data / Config 轮子的自检程序（纯控制台，不在 GUI 里跑）。
       运行： dotnet run  加上本项目 csproj 路径即可（见 代码记录.md「自检」一节）。
       默认在系统临时目录里造一个数据根，不会碰仓库里的 Data/Config；
       想指定目录就设环境变量 YLT_HOME。退出码 0 = 全部通过。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>YuLiangToolkit.FrameworkSelfCheck</RootNamespace>
    <AssemblyName>YuLiangToolkit.FrameworkSelfCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\YuLiangToolkit.Core\YuLiangToolkit.Core.csproj" />
  </ItemGroup>

</Project>

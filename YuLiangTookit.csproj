<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 本目录下 src/ 里的库项目源码不能被这个主项目重复编译进来；
         仓库根的 Data/ 与 Config/ 只是“说明 + 可选种子”（真正运行时的 Data/Config 在 exe 旁边），
         tests/ 是自检程序，都不参与编译；
         MapDownloader/ 是移植「osu! 下图器」时参考的原版 WinForms 小项目（不是本项目的一部分）；
         HeavenUsurperToolkit-master/ 是移植「音游工具」时参考的旧项目（同样不是本项目的一部分，
         不排除的话它自己的 App.xaml.cs / AssemblyInfo.cs 会被 SDK 隐式 glob 进来，报 ThemeInfo 重复） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);src\**;Data\**;Config\**;tests\**;FlashGameDownloader\**;MapDownloader\**;HeavenUsurperToolkit-master\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 注意：不要用 <None CopyToOutputDirectory> 往 exe 旁边拷 Data/Config 的内容！
       那样这些文件会被记进 obj\...\*.FileListAbsolute.txt，一旦仓库里对应的种子文件被删掉，
       下次构建的 IncrementalClean 会把 exe 旁边的同名文件当垃圾删掉（用户数据就没了，已踩过）。
       运行时目录里的说明文件由程序自己首次运行时写入（见 RuntimeReadme），发布时用 publish.ps1 附带。 -->

  <ItemGroup>
    <ProjectReference Include="src\YuLiangToolkit.Core\YuLiangToolkit.Core.csproj" />
    <ProjectReference Include="src\YuLiangToolkit.Tools.VideoToAudio\YuLiangToolkit.Tools.VideoToAudio.csproj" />
    <ProjectReference Include="src\YuLiangToolkit.Tools.MediaPlayer\YuLiangToolkit.Tools.MediaPlayer.csproj" />
    <ProjectReference Include="src\YuLiangToolkit.Tools.BatchRename\YuLiangToolkit.Tools.BatchRename.csproj" />
    <ProjectReference Include="src\YuLiangToolkit.Tools.FlashDownloader\YuLiangToolkit.Tools.FlashDownloader.csproj" />
    <ProjectReference Include="src\YuLiangToolkit.Tools.ChatRoom\YuLiangToolkit.Tools.ChatRoom.csproj" />
    <ProjectReference Include="src\YuLiangToolkit.Tools.MapDownloader\YuLiangToolkit.Tools.MapDownloader.csproj" />
    <ProjectReference Include="src\YuLiangToolkit.Tools.OsuMania\YuLiangToolkit.Tools.OsuMania.csproj" />
    <ProjectReference Include="src\YuLiangToolkit.Tools.Sample\YuLiangToolkit.Tools.Sample.csproj" />
  </ItemGroup>

</Project>

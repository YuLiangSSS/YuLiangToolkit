<UserControl x:Class="YuLiangToolkit.Tools.ChatRoom.Views.ChatRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- 联机聊天室：一页里放完
         ① 顶部：标题 + 状态徽标（身份 / 地址 / 延迟）
         ② 连接条：左 = 主机（监听地址 + 端口 + 开房间），右 = 客户端（主机地址 + 端口 + 连接）
         ③ 聊天记录（占满宽度：文字 / 图片 / 音频 / 视频 / 文件，靠左靠右区分谁说的）+ 输入区
         ④ 底部：流量（上限 + 用量指示）/ 发送选项 / 文件传输 + 房间成员 / 历史记录 + 协议与日志
         样式全部来自 App.xaml（CardStyle / TextBoxStyle / PrimaryButtonStyle …），不自造风格。

         ⚠ 布局注意（v0.41.0 起可拖拽）：整页在 ScrollViewer 里，可上下拖的「② 聊天 / ③ 底部三栏」
         都是**固定像素行**（不是 * 行），所以卡片内部可以放心用 * 行让列表 / 日志吃掉多出来的高度；
         别把整页改成 * 行（ScrollViewer 量内容时给无限高度，星号行会退化，卡片被撑得极高）。
         ②③ 之间是上下分隔条，① 主机/客户端、④ 成员/历史之间是左右分隔条；
         拖动调大小（蓝线 + ↔ / ↕ 光标），松手自动记住（Config\layout.json），双击恢复这一处；
         全部恢复默认：主页设置 →「界面布局 → 恢复默认布局」。约定见 docs/dev/layout.md。 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />                 <!-- 标题 + 状态徽标 -->
                <RowDefinition Height="Auto" />                 <!-- 状态栏 -->
                <RowDefinition Height="Auto" />                 <!-- ① 连接条（内部左右可拖） -->
                <RowDefinition Height="600" MinHeight="400" />  <!-- ② 聊天（可上下拖） -->
                <RowDefinition Height="12" />                   <!-- 聊天 / 底部三栏 分隔条 -->
                <RowDefinition Height="470" MinHeight="320" />  <!-- ③ 底部三栏（可上下拖） -->
                <RowDefinition Height="Auto" />                 <!-- ④ 成员 + 历史 -->
                <RowDefinition Height="Auto" />                 <!-- ⑤ 协议与日志 -->
            </Grid.RowDefinitions>

            <!-- ===================== 标题 + 状态 ===================== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="💬 联机聊天室" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="主机开一个 TCP 端口等人连，客户端填「IP（或内网穿透给的域名）+ 端口」就能聊。文字、图片、音频、视频、任意文件都能发；每次连接单独一个记录文件夹，并带单次流量上限。" />
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="12,8"
                        VerticalAlignment="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="250"
                        Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelfDisplay}" FontSize="11.5" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding PeerSummary}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="360" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ListenSummary}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="360" Margin="0,2,0,0"
                                   Visibility="{Binding ListenSummary, Converter={StaticResource EmptyToVisInverse}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding NoticeText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="760" />
                    <TextBlock Text="{Binding ActivityText}" FontSize="10.5" Margin="18,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- ===================== ① 连接条 ===================== -->
            <!-- 左右可拖：主机（*，跟着窗口变宽）| 客户端（固定像素、可拖） -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="480" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- 主机 -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🖥 我是主机（开房间等人连）" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <!-- 傻瓜模式：勾上就不显示监听地址 / 端口那些控件，全交给工具自己挑。
                                 ⚠ 注意 IP 和端口并不会被藏起来 —— 开完房间下面的「连接信息」里全都有
                                 （内网穿透要照着填本地端口）。 -->
                            <CheckBox Grid.Column="1" Content="傻瓜模式" Style="{StaticResource CheckBoxStyle}"
                                      FontSize="11" VerticalAlignment="Center"
                                      IsChecked="{Binding SimpleMode}"
                                      ToolTip="不用你选监听地址和端口：点「开房间」后工具自动挑一个空闲端口，并把本机 IPv4 / IPv6 地址列出来" />
                        </Grid>
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="开监听后把下面这串地址发给对方。局域网直接可用；外网请用端口映射 / 内网穿透工具，把它给的「域名 + 端口」发给对方。" />

                        <!-- 傻瓜模式：这里只放一句话说明，具体的地址端口在下面的「连接信息」里 -->
                        <TextBlock Text="{Binding SimpleModeHint}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding SimpleMode, Converter={StaticResource BoolToVis}}" />

                        <!-- 普通模式才显示：监听地址 + 端口 + 一键绑定 + 本机地址提示 -->
                        <StackPanel Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,8,0,0">
                                <!-- 监听地址就是一个普通输入框（不用下拉框）：
                                     常见就那几个值，下面的「全部 IPv4 / 含 IPv6 / 只本机」按钮一点就填好了，
                                     下拉列表反而挡视线（本机地址一多，列表里全是长 IPv6）。
                                     端口用 Width="Auto"：正文字号下 5 位数字加内边距天然放得下，不写死像素。 -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" MinWidth="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="监听" VerticalAlignment="Center" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Height="30" Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding ListenAddress, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="0.0.0.0 = 本机所有 IPv4 网卡（推荐）；:: = 同时支持 IPv6；也可以只绑某张网卡的地址（点下面的按钮一键填）" />
                                <TextBox Grid.Column="2" Height="30" Margin="8,0,0,0" Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="监听端口（1024~65535 挑一个没人占的）" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="绑定：" FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Content="全部 IPv4" Padding="8,2" FontSize="10.5" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetListenAllCommand}"
                                        ToolTip="监听 0.0.0.0：本机所有 IPv4 网卡，局域网直连用这个" />
                                <Button Content="含 IPv6" Padding="8,2" FontSize="10.5" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetListenAllV6Command}"
                                        ToolTip="监听 ::（双栈）：同一个端口 IPv4 与 IPv6 都能连" />
                                <Button Content="只本机" Padding="8,2" FontSize="10.5" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetListenLocalCommand}"
                                        ToolTip="只监听 127.0.0.1：只有本机连得上，用来自己测功能" />
                            </StackPanel>

                            <!-- 本机有哪些地址可以填（原来那是下拉列表里的内容，改成输入框后放这里当提示） -->
                            <TextBlock Text="{Binding LocalAddressHint}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="开房间" Style="{StaticResource PrimaryButtonStyle}" MinWidth="82"
                                    Command="{Binding StartHostCommand}" IsEnabled="{Binding IsOffline}" />
                            <Button Content="断开" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding StopCommand}" IsEnabled="{Binding IsOnline}" />
                            <Button Content="复制地址" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding CopyAddressCommand}" />
                            <Button Content="全部请出" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding KickAllCommand}" ToolTip="把所有客户端移出房间（自己继续监听）" />
                        </StackPanel>

                        <!-- ===== 连接信息：开完房间直接摊出来（IPv4 / IPv6 / 端口 / 内网穿透怎么填） ===== -->
                        <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding HasShareInfo, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="📋 连接信息（复制给要连进来的人）" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ListenModeText}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />

                                <TextBlock Text="局域网 IPv4" FontSize="10.5" Margin="0,8,0,3"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding HasIpv4Rows, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding ShareIpv4Rows}"
                                              Visibility="{Binding HasIpv4Rows, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Text}" FontSize="12" FontFamily="Consolas, Cascadia Mono, monospace"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding DetailText}" FontSize="10"
                                                           Margin="8,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Button Grid.Column="2" Content="复制" Padding="8,1" FontSize="10.5"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="IPv6" FontSize="10.5" Margin="0,8,0,3"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding HasIpv6Rows, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding ShareIpv6Rows}"
                                              Visibility="{Binding HasIpv6Rows, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Text}" FontSize="12" FontFamily="Consolas, Cascadia Mono, monospace"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding DetailText}" FontSize="10"
                                                           Margin="8,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Button Grid.Column="2" Content="复制" Padding="8,1" FontSize="10.5"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- 没有 IPv6 就直说，别让用户以为是哪里填错了。
                                     ⚠ 这里必须用 EmptyToVisInverse（非空才显示）：EmptyToVis 是反过来的
                                     ——它在字符串为空时显示，是给输入框占位符用的（踩过：提示一直不出现）。 -->
                                <TextBlock Text="{Binding Ipv6NoticeText}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding Ipv6NoticeText, Converter={StaticResource EmptyToVisInverse}}" />

                                <!-- 只绑了本机 / 一个地址都没探到时，解释一句（而不是列一堆连不上的地址） -->
                                <TextBlock Text="{Binding ShareNoticeText}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding ShareNoticeText, Converter={StaticResource EmptyToVisInverse}}" />

                                <TextBlock Text="{Binding PunchHintText}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding AdvertiseText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <!-- 左右分隔条：拖动改「主机」与「客户端」两栏的宽度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="chat-room.主机与客户端" />

                <!-- 客户端 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <StackPanel>
                        <TextBlock Text="🔌 我是客户端（连别人的房间）" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="内网穿透：穿透工具把主机那台机器的端口映射出来后，把「它给的域名/IP + 端口」填在下面（本功能走普通 TCP，穿透工具按 TCP 类型映射）。" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主机" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="1" Height="30" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="IPv4（192.168.1.5）/ IPv6（[fe80::1]）/ 域名（内网穿透工具给的，如 xxx.frp.io）" />
                            <TextBox Grid.Column="2" Height="30" Margin="8,0,0,0" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="端口" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="连接" Style="{StaticResource PrimaryButtonStyle}" MinWidth="82"
                                    Command="{Binding ConnectCommand}" IsEnabled="{Binding IsOffline}" />
                            <Button Content="断开" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding StopCommand}" IsEnabled="{Binding IsOnline}" />
                            <Button Content="复制" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding CopyAddressCommand}" />
                            <Button Content="测延迟" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding PingCommand}" ToolTip="发一个心跳包，测一下到对方的往返时间" />
                        </StackPanel>

                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="连上之后双方互发消息：你发的所有内容主机都收得到；主机的消息会广播给房间里的每个客户端。" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== ② 聊天 ===================== -->
            <!-- 固定像素行里：工具条 / 消息列表(*) / 输入区，聊天列表吃掉区块多出来的高度 -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 工具条 -->
                    <Grid Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="聊天记录" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HistorySummary}" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="清空聊天" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearChatCommand}"
                                    ToolTip="只清界面，磁盘上的聊天记录不会被删" />
                            <Button Content="打开记录文件夹" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding OpenSessionFolderCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 消息列表：吃掉区块剩下的高度（区块可上下拖），最少留 160 -->
                    <ListBox x:Name="MessageList" Grid.Row="1" ItemsSource="{Binding Messages}"
                             Style="{StaticResource FileListStyle}"
                             MinHeight="160" Margin="8,10,8,0"
                             core:ScrollChaining.Enabled="True"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="双击图片打开原图；音视频点「播放」">
                        <ListBox.ItemContainerStyle>
                            <!-- 行样式必须自己补齐四条（内边距 / 悬停选中反馈 / 前景色 / 选中条），见 AGENTS.md -->
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FileRowItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- ===== 系统提示：居中灰字 ===== -->
                                    <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3"
                                               Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" />

                                    <!-- ===== 普通消息：靠左 / 靠右 ===== -->
                                    <StackPanel Visibility="{Binding IsSystem, Converter={StaticResource InverseBoolConverter}}"
                                                HorizontalAlignment="Left" MaxWidth="560">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- 发送者 + 时间 -->
                                        <StackPanel Orientation="Horizontal" Margin="2,0,2,3">
                                            <TextBlock Text="{Binding SenderLine}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- 文字气泡 -->
                                        <Border CornerRadius="8" Padding="11,7" Margin="0,0,0,2"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" />
                                        </Border>

                                        <!-- 图片：显示自动压缩的预览图，双击打开原图 -->
                                        <Border CornerRadius="6" Margin="0,2,0,2" Padding="3"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                HorizontalAlignment="Left" Cursor="Hand"
                                                MouseLeftButtonDown="OnImageClick"
                                                ToolTip="{Binding FileSummary}"
                                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding ThumbnailPath}" MaxWidth="380" MaxHeight="280"
                                                   Stretch="Uniform" StretchDirection="DownOnly" />
                                        </Border>

                                        <!-- 音频：点一下播 -->
                                        <Border CornerRadius="6" Margin="0,2,0,2" Padding="8"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileSummary}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="▶ 播放 / 暂停" Padding="10,3" FontSize="11"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="OnToggleMediaClick" />
                                                    <Button Content="打开" Padding="10,3" FontSize="11" Margin="6,0,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="OnOpenFileButtonClick" Tag="{Binding LocalPath}" />
                                                </StackPanel>
                                                <!-- MediaElement 在 LoadedBehavior=Manual 时不会自己响，靠上面那个按钮 Play() -->
                                                <MediaElement Source="{Binding LocalPath}" LoadedBehavior="Manual"
                                                              UnloadedBehavior="Manual" Volume="0.8" Height="1" Opacity="0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 视频：点一下播 -->
                                        <Border CornerRadius="6" Margin="0,2,0,2" Padding="3"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <MediaElement Source="{Binding LocalPath}" LoadedBehavior="Manual"
                                                              UnloadedBehavior="Manual" Volume="0.8"
                                                              MaxWidth="380" MaxHeight="260" />
                                                <StackPanel Orientation="Horizontal" Margin="6,4,6,4">
                                                    <TextBlock Text="{Binding FileSummary}" FontSize="10.5" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <Button Content="▶ 播放 / 暂停" Padding="10,3" FontSize="11" Margin="10,0,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Click="OnToggleMediaClick" />
                                                    <Button Content="打开" Padding="10,3" FontSize="11" Margin="6,0,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="OnOpenFileButtonClick" Tag="{Binding LocalPath}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 其它文件（图片 / 音频 / 视频之外的那一行；没有文件时这一块自己藏起来） -->
                                        <Border CornerRadius="6" Margin="0,2,0,2" Padding="10,8"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasAudio}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFile}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileSummary}" FontSize="11.5" TextWrapping="Wrap" />
                                                <ProgressBar Value="{Binding File.Ratio, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,0"
                                                             Style="{StaticResource ProgressBarStyle}"
                                                             Visibility="{Binding File.IsActive, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding File.ProgressText}" FontSize="10.5" Margin="0,4,0,0"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="打开文件" Padding="10,3" FontSize="11"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="OnOpenFileButtonClick" Tag="{Binding LocalPath}" />
                                                    <Button Content="打开所在文件夹" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Click="OnRevealFileButtonClick" Tag="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 输入区 -->
                    <StackPanel Grid.Row="2" Margin="18,10,18,16">
                        <Grid>
                            <TextBox x:Name="InputBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="回车发送，Shift+回车换行" />
                            <TextBlock Text="说点什么…（回车发送，Shift+回车换行）" Margin="12,8,0,0"
                                       VerticalAlignment="Top" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding MessageText, Converter={StaticResource EmptyToVis}}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="发送" Style="{StaticResource PrimaryButtonStyle}" MinWidth="76"
                                        Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" />
                                <Button Content="发送文件…" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding AttachCommand}" ToolTip="图片 / 音频 / 视频 / 压缩包 / 任意文件，可多选" />
                                <Button Content="发送图片…" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding SendImageCommand}" ToolTip="{Binding ImageQualityHint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Height="32" Margin="12,0,0,0" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding TransferNote, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="发文件时附带的留言（发完自动清空）" />
                            <TextBlock Grid.Column="1" Text="发文件时想说的一句话…" Margin="24,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding TransferNote, Converter={StaticResource EmptyToVis}}" />
                        </Grid>

                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="收 / 发都在同一个列表里：自己发的靠右（蓝底），对方发的靠左。图片自动压一份预览（不额外占流量），双击预览图打开原图。" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 上下分隔条：拖动改「② 聊天」与「③ 底部三栏」的高度（双击恢复这一处） -->
            <core:PaneSplitter Grid.Row="4" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="chat-room.聊天与底部" />

            <!-- ===================== ③ 底部三栏 =====================
                 中间那栏的「发图压缩」是这三个下拉里文字最长的（"只压过大的图（推荐）"），
                 所以它要比左右两栏**宽一点**（5:6:5）；等宽或更窄会把下拉框挤到文字显示不全。
                 栏间距 10px：1024 宽的最小窗口下，这一点点差距正好是输入框能不能放开 4 位数的区别。 -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <!-- 流量 -->
                <!-- 卡片被拖得比内容还矮时内部滚动（滚到头再交给整页，见 ScrollChaining） -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel>
                            <TextBlock Text="流量（单次连接）" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="「一次连接」= 一次会话（一个记录文件夹）。到上限就停止发送，不会一口气把流量跑光。" />

                            <TextBlock Text="{Binding TrafficSummaryText}" FontSize="12.5" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding TrafficRateText}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <ProgressBar Value="{Binding TrafficRatio, Mode=OneWay}" Maximum="1" Height="8" Margin="0,8,0,0"
                                         Style="{StaticResource ProgressBarStyle}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TrafficLimitText}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding TrafficRatioText}" FontSize="10.5" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <TextBlock Text="⚠ 本次流量已到上限：已停止发送。可以调大上限（立刻生效）或重新连接。" FontSize="11"
                                       Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding IsTrafficExhausted, Converter={StaticResource BoolToVis}}" />

                            <!-- 底部三栏比较窄，标签一律放在输入框**上面**（不占横向宽度）：
                                 1024 宽的最小窗口下，侧边标签会把下拉框挤到只剩几十像素、文字被裁掉。 -->
                            <TextBlock Text="上限（MB）" FontSize="11.5" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="30" MinWidth="140" Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding TrafficLimitMb, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="一次连接最多能跑多少流量；填 0 = 不限（不建议）" />
                                <TextBlock Grid.Column="1" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <TextBlock Text="算哪个方向" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox Margin="0,4,0,0" Height="30" ItemsSource="{Binding TrafficScopeOptions}"
                                      SelectedItem="{Binding SelectedTrafficScope}" DisplayMemberPath="Label"
                                      Style="{StaticResource ComboBoxStyle}" />

                            <CheckBox Margin="0,10,0,0" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.NotifyPeerOnLimit}" Content="到上限时通知对方" />
                            <TextBlock FontSize="10.5" Margin="24,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="打开时对方会看到「本端流量到顶，暂停发送」，免得以为你掉线了。" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 发送选项 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel>
                            <TextBlock Text="发送选项" FontSize="13" FontWeight="SemiBold" />

                            <TextBlock Text="昵称" FontSize="11.5" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Margin="0,4,0,0" Height="30" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="头像（一个 emoji）" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Margin="0,4,0,0" Height="30" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding Emoji, UpdateSourceTrigger=PropertyChanged}" ToolTip="填一个 emoji 就行" />

                            <TextBlock Text="发图压缩" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox Margin="0,4,0,0" Height="30" ItemsSource="{Binding ImageQualityOptions}"
                                      SelectedItem="{Binding SelectedImageQuality}" DisplayMemberPath="Label"
                                      Style="{StaticResource ComboBoxStyle}" />
                            <TextBlock Text="{Binding ImageQualityHint}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="大文件确认（MB）" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="30" MinWidth="140" Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding Cfg.ConfirmFileMb, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="超过这个大小（MB）先问一句再发；填 0 = 不确认" />
                                <TextBlock Grid.Column="1" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <CheckBox Margin="0,10,0,0" Style="{StaticResource CheckBoxStyle}" IsChecked="{Binding Cfg.AutoStart}"
                                      Content="打开工具时自动开局" />

                            <TextBlock Text="表情（点一下插到输入框）" FontSize="11.5" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding QuickEmojis}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Padding="6,2" Margin="0,0,4,4" FontSize="14"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.InsertEmojiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 文件传输 -->
                <!-- 固定像素行里：标题 / 传输列表(*) / 底部说明，列表吃掉多出来的高度 -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,14,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="文件传输" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="发送：" /><Run Text="{Binding UploadSummary, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="接收：" /><Run Text="{Binding DownloadSummary, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Top" Command="{Binding ClearTransfersCommand}" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Transfers}" Style="{StaticResource FileListStyle}"
                                 MinHeight="120" Margin="8,10,8,0"
                                 core:ScrollChaining.Enabled="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DirectionText, Mode=OneWay}" />
                                            <Run Text="　" />
                                            <Run Text="{Binding FileName, Mode=OneWay}" />
                                        </TextBlock>
                                        <ProgressBar Value="{Binding Ratio, Mode=OneWay}" Maximum="1" Height="4" Margin="0,5,0,0"
                                                     Style="{StaticResource ProgressBarStyle}" />
                                        <TextBlock Text="{Binding ProgressText}" FontSize="10.5" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Margin="18,8,18,14"
                                   Text="同一时刻只传一个文件（避免把这一条连接的带宽抢光），后面的自动排队。" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== ④ 房间成员 + 历史记录 ===================== -->
            <!-- 左右可拖：成员（固定像素、可拖）| 历史记录（*，跟着窗口变宽） -->
            <Grid Grid.Row="6" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- 房间成员 -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <StackPanel>
                        <Grid Margin="18,14,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="房间成员" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MemberListSummary}" FontSize="10.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Top" Command="{Binding RefreshMembersCommand}" />
                        </Grid>

                        <ListBox ItemsSource="{Binding MemberItems}" Style="{StaticResource FileListStyle}"
                                 MinHeight="130" MaxHeight="250" Margin="8,10,8,12"
                                 core:ScrollChaining.Enabled="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Opacity="{Binding Opacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Display}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding RoleText, Mode=OneWay}" />
                                                <Run Text="　" />
                                                <Run Text="{Binding JoinedText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding EndpointText}" FontSize="10" Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="移出" Padding="10,3" FontSize="11"
                                                Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.KickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanKick, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- 左右分隔条：拖动改「房间成员」与「历史记录」两栏的宽度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="chat-room.成员与历史" />

                <!-- 历史记录 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <StackPanel>
                        <Grid Margin="18,14,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="历史记录" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HistorySummary}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SessionRootText}" FontSize="10" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionRootText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RefreshHistoryCommand}" />
                                <Button Content="打开根目录" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding OpenRootFolderCommand}" />
                            </StackPanel>
                        </Grid>

                        <ListBox ItemsSource="{Binding History}" Style="{StaticResource FileListStyle}"
                                 MinHeight="130" MaxHeight="250" Margin="8,10,8,12"
                                 core:ScrollChaining.Enabled="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTip="「查看」= 把那次聊天读回界面；「文件夹」= 打开那次的数据目录">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SessionName}" FontSize="12" />
                                            <TextBlock Text="{Binding SummaryText}" FontSize="10.5" Margin="0,2,0,0"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding DirectoryPath}" FontSize="10" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryPath}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="查看" Padding="10,3" FontSize="11"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="文件夹" Padding="10,3" FontSize="11" Margin="6,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.OpenHistoryFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== ⑤ 协议与日志 ===================== -->
            <Border Grid.Row="7" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="协议与日志" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="协议是「4 字节长度 + JSON 头 + 裸载荷」的 TCP 流：文字走 JSON 载荷、文件走裸字节（不膨胀）。说明文件在 Data\chat-room\Protocol\chat-protocol.json，首次运行自动释放。" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="查看协议说明" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenProtocolDocCommand}" />
                        <Button Content="打开我的记录文件夹" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding OpenSessionFolderCommand}" />
                    </StackPanel>
                    <TextBox Style="{StaticResource LogTextBoxStyle}" Height="120" Margin="0,10,0,0"
                             Text="{Binding LogText, Mode=OneWay}" core:ScrollChaining.Enabled="True" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="YuLiangToolkit.Tools.RandomNumber.Views.RandomNumberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             PreviewKeyDown="OnPreviewKeyDown">

    <!-- 随机数生成器（random-number）。
         布局约定见 docs/dev/layout.md：
           · 页面级两块「左（范围 + 生成选项）｜ 右（结果）」左右分栏，中间一条竖分隔条
             （Key=random-number.设置与结果）；
           · 左列内部「范围与精确度 ↔ 生成选项」是一条横分隔条（Key=random-number.范围与生成选项）。
         两块都能拖、尺寸自动记住（Config\layout.json），双击分隔条恢复这一处。
         颜色全部 {DynamicResource}，控件样式全部来自 App.xaml。 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  core:ScrollChaining.Enabled="True">
        <Grid Margin="28,16,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== 页头 ===================== -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="🎲 随机数生成器" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="按可调的下限 / 上限 / 精确度生成随机数。数值用任意精度十进制精确表示：下限能写 1e100，精确度能写 0.001，结果不会出现 0.30000000000000004 这种浮点尾巴。Enter 生成，结果可一键复制。" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="340" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="420" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- ===================== 左：范围与精确度（上） + 生成选项（下） ===================== -->
                <Grid Grid.Column="0" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="290" MinHeight="270" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="298" MinHeight="260" />
                    </Grid.RowDefinitions>

                    <!-- ===== 范围与精确度 ===== -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True">
                            <StackPanel>
                                <TextBlock Text="范围与精确度" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock FontSize="10.5" Margin="0,4,0,14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="都能写超大数 / 超细步长：100000000000000000000、1e-18、0.01" />

                                <TextBlock Text="下限（含）" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="LowerBox" Style="{StaticResource TextBoxStyle}" Margin="0,5,0,0"
                                         Text="{Binding Cfg.Lower, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                         ToolTip="可以写负数、超大整数或 1e30 这类科学计数法" />

                                <TextBlock Text="上限（含）" FontSize="11.5" Margin="0,12,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="UpperBox" Style="{StaticResource TextBoxStyle}" Margin="0,5,0,0"
                                         Text="{Binding Cfg.Upper, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                         ToolTip="上限不在步长网格上时，会自动向下对齐（结果绝不超上限）" />

                                <TextBlock Text="精确度（步长，必须大于 0）" FontSize="11.5" Margin="0,12,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="StepBox" Style="{StaticResource TextBoxStyle}" Margin="0,5,0,0"
                                         Text="{Binding Cfg.Step, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                         ToolTip="生成值一定是 下限 + k × 精确度；0.1 / 0.01 / 0.001 都行" />

                                <!-- 常用步长：点一下填进上面的输入框 -->
                                <ItemsControl ItemsSource="{Binding StepPresets}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Command="{Binding DataContext.ApplyStepPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="2" Padding="4,2" FontSize="11.5"
                                                    ToolTip="点一下把精确度设成这个值" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding RangeHint}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding RangeHint, Converter={StaticResource EmptyToVisInverse}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 上下分隔条：拖「范围与精确度」与「生成选项」的高度（双击恢复这一处） -->
                    <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                       Key="random-number.范围与生成选项" />

                    <!-- ===== 生成选项 ===== -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <!-- 选项区吃掉剩余高度（*）：卡片被拖矮时它自己滚，下面的生成按钮始终可见 -->
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="生成选项" FontSize="13" FontWeight="SemiBold" />

                            <!-- 选项放在 * 行里自带滚动：卡片被拖矮时上面能滚，下面的「生成」按钮始终点得到 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          core:ScrollChaining.Enabled="True" Margin="0,0,0,4">
                                <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="生成个数" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cfg.Count}" FontSize="12"
                                               FontWeight="SemiBold" MinWidth="48" TextAlignment="Right"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Cfg.Count}" Style="{StaticResource SliderStyle}"
                                        Margin="0,4,0,0" ToolTip="1 ~ 100（要更多可以在配置里改，最多 10000）" />

                                <CheckBox Content="允许重复（关掉 = 不重复抽样）" IsChecked="{Binding Cfg.AllowDuplicates}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0" />

                                <CheckBox Content="生成后按数值从小到大排序" IsChecked="{Binding Cfg.SortResults}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="分隔符" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SeparatorOptions}"
                                              SelectedItem="{Binding Cfg.Separator}"
                                              Style="{StaticResource ComboBoxStyle}" Margin="12,0,0,0"
                                              ToolTip="「复制结果」和结果区用的分隔符" />
                                </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 参数错误提示（红色小字，不弹窗） -->
                            <TextBlock Grid.Row="2" Text="{Binding ErrorText}" FontSize="11.5" TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding ErrorText, Converter={StaticResource EmptyToVisInverse}}" />

                            <Button Grid.Row="3" Content="生成随机数（Enter）" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="0,12,0,0" MinHeight="34"
                                    Command="{Binding GenerateCommand}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 左右分隔条：拖「设置区」与「结果区」的宽度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="random-number.设置与结果" />

                <!-- ===================== 右：结果 ===================== -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,14,18,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="结果" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="复制结果" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CopyCommand}" ToolTip="按当前分隔符把全部结果复制到剪贴板" />
                            <Button Grid.Column="2" Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0" Command="{Binding ClearCommand}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,0">
                            <ListBox ItemsSource="{Binding Results}" Style="{StaticResource FileListStyle}"
                                     core:ScrollChaining.Enabled="True"
                                     ToolTip="每个结果都是精确值（双击可选中复制单条）">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Wrap：百位级的大数也不被裁掉 -->
                                        <TextBlock Text="{Binding}" FontSize="13"
                                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="还没有结果。设好下限 / 上限 / 精确度后点「生成随机数」或按 Enter。"
                                       Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVis}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"
                                       Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                        </Grid>

                        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="18,8,18,12" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

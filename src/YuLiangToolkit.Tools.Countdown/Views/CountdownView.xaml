<UserControl x:Class="YuLiangToolkit.Tools.Countdown.Views.CountdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:controls="clr-namespace:YuLiangToolkit.Core.Controls;assembly=YuLiangToolkit.Core"
             xmlns:notify="clr-namespace:YuLiangToolkit.Core.Notifications;assembly=YuLiangToolkit.Core"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.Countdown.Views"
             Background="Transparent">

    <UserControl.Resources>
        <notify:ThemeBrushNameConverter x:Key="KeyToBrush" />

        <!-- 改键框（显式给出，不依赖 Core 的隐式默认样式） -->
        <Style x:Key="HotkeyBoxLocalStyle" TargetType="controls:HotkeyBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:HotkeyBox">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" MinHeight="28">
                            <Grid>
                                <TextBlock Text="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}}"
                                           Margin="10,0,24,0" VerticalAlignment="Center" FontSize="12"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,9,0" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsCapturing" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 预设时长小按钮 -->
        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="⏳ 倒计时" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Text="设个时长、按开始就行。到点会弹通知并响铃；开始 / 暂停 / 重置 / +1 分钟都能设全局快捷键，在别的程序前面也能按。" />
            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Text="{Binding ShortcutSummary}" />
        </StackPanel>

        <!-- ===================== 主区域 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="400" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：倒计时显示 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 状态行 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,18,22,0">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}" />
                        <TextBlock Text="{Binding StateText}" FontSize="12.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 大号数字 + 进度环 -->
                    <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <views:CountdownRing x:Name="Ring" Width="250" Height="250"
                                             Progress="{Binding Progress}"
                                             ShowRing="{Binding Cfg.ShowProgressRing}"
                                             RingBrush="{DynamicResource AccentBrush}"
                                             TrackBrush="{DynamicResource InputBackgroundBrush}"
                                             Finished="{Binding IsFinished}"
                                             FinishedBrush="{DynamicResource DangerBrush}"
                                             Visibility="{Binding Cfg.ShowProgressRing, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{Binding RemainingText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                   FontSize="54" FontWeight="SemiBold"
                                   TextOptions.TextFormattingMode="Display" />
                    </Grid>

                    <!-- 按钮组 -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="22,14,22,18">
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="开始" Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="100" Height="38" Margin="0,0,10,8"
                                    Command="{Binding StartCommand}"
                                    ToolTip="开始 / 继续（已经在走时不会重置）" />
                            <Button Content="暂停" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="100" Height="38" Margin="0,0,10,8"
                                    Command="{Binding PauseCommand}" />
                            <Button Content="重置" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="100" Height="38" Margin="0,0,10,8"
                                    Command="{Binding ResetCommand}" />
                            <Button Content="+1 分钟" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="100" Height="38" Margin="0,0,0,8"
                                    Command="{Binding AddMinuteCommand}" />
                        </WrapPanel>

                        <TextBlock Text="{Binding StatusText}" FontSize="11" HorizontalAlignment="Center"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="countdown.计时与设置" />

            <!-- ===== 右：设置 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="设置" FontSize="14" FontWeight="SemiBold"
                               Margin="18,16,18,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="18,0,18,18">

                            <!-- ① 时长 -->
                            <TextBlock Text="时长" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding DurationInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="90（秒）/ 5:30（分:秒）/ 1:02:03 / 1h30m" />
                                <Button Grid.Column="1" Content="应用" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0" Command="{Binding ApplyInputCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding InputHint}" FontSize="10.5" TextWrapping="Wrap"
                                       Margin="0,5,0,0" Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding InputHint, Converter={StaticResource EmptyToVisInverse}}" />

                            <!-- 预设 -->
                            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Style="{StaticResource PresetButtonStyle}"
                                                Command="{Binding DataContext.UsePresetCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ② 快捷键 -->
                            <TextBlock Text="快捷键" FontSize="12.5" FontWeight="SemiBold" Margin="0,14,0,6" />
                            <CheckBox Content="启用这个工具的快捷键" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.ShortcutsEnabled, Mode=TwoWay}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开始" FontSize="12" VerticalAlignment="Center" />
                                <controls:HotkeyBox Grid.Column="1" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                    ComboText="{Binding Cfg.StartHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsCaptureEnabled="{Binding Cfg.ShortcutsEnabled}" />
                                <CheckBox Grid.Column="2" Content="启用" Style="{StaticResource CheckBoxStyle}"
                                          Margin="10,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding Cfg.StartEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="暂停" FontSize="12" VerticalAlignment="Center" />
                                <controls:HotkeyBox Grid.Column="1" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                    ComboText="{Binding Cfg.PauseHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsCaptureEnabled="{Binding Cfg.ShortcutsEnabled}" />
                                <CheckBox Grid.Column="2" Content="启用" Style="{StaticResource CheckBoxStyle}"
                                          Margin="10,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding Cfg.PauseEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="重置" FontSize="12" VerticalAlignment="Center" />
                                <controls:HotkeyBox Grid.Column="1" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                    ComboText="{Binding Cfg.ResetHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsCaptureEnabled="{Binding Cfg.ShortcutsEnabled}" />
                                <CheckBox Grid.Column="2" Content="启用" Style="{StaticResource CheckBoxStyle}"
                                          Margin="10,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding Cfg.ResetEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="+1 分钟" FontSize="12" VerticalAlignment="Center" />
                                <controls:HotkeyBox Grid.Column="1" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                    ComboText="{Binding Cfg.AddMinuteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsCaptureEnabled="{Binding Cfg.ShortcutsEnabled}" />
                                <CheckBox Grid.Column="2" Content="启用" Style="{StaticResource CheckBoxStyle}"
                                          Margin="10,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding Cfg.AddMinuteEnabled, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="也可以去「主页设置 → 快捷键」统一改 / 禁用。" />

                            <!-- ③ 到点提醒 -->
                            <TextBlock Text="到点提醒" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,6" />
                            <CheckBox Content="静音（保留声音选择，只是不播）" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.Muted, Mode=TwoWay}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="提示音" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                          ItemsSource="{Binding SoundOptions}"
                                          SelectedItem="{Binding SelectedSound, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="试听" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0" Padding="10,3" FontSize="11.5"
                                        Command="{Binding PlaySoundTestCommand}" />
                                <Button Grid.Column="3" Content="…" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6,0,0,0" Padding="10,3" FontSize="11.5"
                                        Command="{Binding BrowseSoundCommand}" ToolTip="选一个 .wav 文件" />
                            </Grid>

                            <!-- ④ 通知 -->
                            <TextBlock Text="通知" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,6" />
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="到点一定会弹（不管在不在前台）。快捷键操作只在没看这个页面时弹。" />
                            <notify:NotificationSettingsView DataContext="{Binding Cfg.Notification}" />

                            <!-- ⑤ 显示 -->
                            <TextBlock Text="显示" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,6" />
                            <CheckBox Content="显示进度环" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.ShowProgressRing, Mode=TwoWay}" />

                            <!-- ⑥ 日志 -->
                            <TextBlock Text="运行日志" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,6" />
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     Style="{StaticResource LogTextBoxStyle}" Height="100"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     core:ScrollChaining.Enabled="True" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- 批量重命名工具：规则计算（RenameEngine）是纯逻辑，可直接被自检程序引用断言。 -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>YuLiangToolkit.Tools.BatchRename</RootNamespace>
    <AssemblyName>YuLiangToolkit.Tools.BatchRename</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YuLiangToolkit.Core\YuLiangToolkit.Core.csproj" />
  </ItemGroup>

</Project>

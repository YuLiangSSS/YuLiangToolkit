<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:YuLiangToolkit.Core.Controls">

    <!-- ================= HotkeyBox 默认样式（改键输入框） =================
         颜色全部走外壳主题 token（InputBackgroundBrush / BorderBrush / TextPrimaryBrush …），
         换主题立即生效。⚠ DynamicResource 不支持 FallbackValue（会编译报错 MC3045），
         所以兜底色写在 Setter 的 Value 里，token 存在时 DynamicResource 会盖掉它。

         ⚠ 模板根**直接是 Border**（不套 Grid）：套一层没有尺寸的 Grid 时，
         控件在 Auto 列里会被压成 0 宽 0 高，整个框看不见（踩过一次）。
         ✕ 按钮叠在 Border 右上角，用单独一层 Grid 包住这两样。

         交互（见 HotkeyBox.cs）：点一下进入捕获 → 按住组合键 → 全部松开定下来；Esc 取消、右侧 ✕ 清空。 -->

    <Style TargetType="{x:Type controls:HotkeyBox}">
        <Setter Property="Foreground" Value="#F2F4F8" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#22252C" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#3A3F49" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HotkeyBox}">
                    <Border x:Name="Box"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="28">
                        <Grid>
                            <TextBlock x:Name="Label"
                                       Text="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="10,0,24,0"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- 清空（框内右侧的小 ✕） -->
                            <Button x:Name="Clear"
                                    Content="✕"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Padding="5,1"
                                    FontSize="10.5"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    ToolTip="清空（等于这条快捷键不设置）" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 捕获中：边框换成强调色，提示正在录 -->
                        <Trigger Property="IsCapturing" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>

                        <Trigger Property="IsCaptureEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Clear" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<UserControl x:Class="YuLiangToolkit.Tools.Alarm.Views.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:notify="clr-namespace:YuLiangToolkit.Core.Notifications;assembly=YuLiangToolkit.Core"
             Background="Transparent">

    <UserControl.Resources>
        <notify:ThemeBrushNameConverter x:Key="KeyToBrush" />

        <!-- 时间按钮（点它展开编辑）：无底、悬停才给浅底 -->
        <Style x:Key="DayTimeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 星期勾选小方块 -->
        <Style x:Key="DayToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="⏰ 闹钟" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Text="想什么时候被叫醒就加一个。可以按星期重复、加备注、响的时候贪睡；到点会弹通知并响铃。关掉这个页面也照样会响。" />
            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Text="{Binding SummaryText}" />
        </StackPanel>

        <!-- ===================== 主区域 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：闹钟列表 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 工具条 -->
                    <Grid Grid.Row="0" Margin="18,14,18,8">
                        <TextBlock Text="我的闹钟" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ 添加闹钟" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="14,5" Command="{Binding AddAlarmCommand}" Margin="0,0,8,0" />
                            <Button Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,5" Command="{Binding ClearAllCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 响铃横幅 -->
                    <Border Grid.Row="1" Margin="18,0,18,8" Padding="14,10"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Visibility="{Binding IsRinging, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding RingingTitle}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="{Binding RingingText}" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="贪睡" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,5" Margin="0,0,8,0"
                                        Command="{Binding SnoozeCommand}"
                                        Visibility="{Binding CanSnooze, Converter={StaticResource BoolToVis}}" />
                                <Button Content="停止" Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="14,5" Command="{Binding StopRingCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="14,0,10,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="14,10" Margin="0,0,0,6"
                                            Opacity="{Binding RowOpacity}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 大号时间：点它展开 / 收起编辑区 -->
                                                <Button Grid.Column="0" Style="{StaticResource DayTimeButtonStyle}"
                                                        Command="{Binding DataContext.ToggleExpandCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Entry}"
                                                        ToolTip="点一下改时间 / 备注 / 重复">
                                                    <TextBlock Text="{Binding Time}"
                                                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                               FontSize="26" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Button>

                                                <!-- 标题 + 重复 / 下次 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock FontSize="10.5" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding RepeatText, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding NextText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- 开关 -->
                                                <CheckBox Grid.Column="2" Style="{StaticResource CheckBoxStyle}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                                          IsChecked="{Binding Entry.Enabled, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleEnabledCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding Entry}"
                                                          ToolTip="开 / 关这个闹钟" />

                                                <!-- 删除 -->
                                                <Button Grid.Column="3" Content="✕"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8,3" FontSize="11"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveAlarmCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Entry}"
                                                        ToolTip="删除这个闹钟" />
                                            </Grid>

                                            <!-- ===== 展开的编辑区 ===== -->
                                            <Border Margin="0,10,0,0" Padding="12,10"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="时间" FontSize="11.5" VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBox Width="82" Style="{StaticResource TextBoxStyle}"
                                                                 Text="{Binding Entry.Time, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 ToolTip="24 小时制，例如 07:30" />
                                                    </StackPanel>

                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="备注" FontSize="11.5"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBox Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                                                 Text="{Binding Entry.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="例如 起床 / 开会（可留空）" />
                                                    </Grid>

                                                    <!-- 重复的星期 -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <TextBlock Text="重复" FontSize="11.5" VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <CheckBox Style="{StaticResource DayToggleStyle}" Content="一"
                                                                  IsChecked="{Binding Entry.Monday, Mode=TwoWay}" />
                                                        <CheckBox Style="{StaticResource DayToggleStyle}" Content="二"
                                                                  IsChecked="{Binding Entry.Tuesday, Mode=TwoWay}" />
                                                        <CheckBox Style="{StaticResource DayToggleStyle}" Content="三"
                                                                  IsChecked="{Binding Entry.Wednesday, Mode=TwoWay}" />
                                                        <CheckBox Style="{StaticResource DayToggleStyle}" Content="四"
                                                                  IsChecked="{Binding Entry.Thursday, Mode=TwoWay}" />
                                                        <CheckBox Style="{StaticResource DayToggleStyle}" Content="五"
                                                                  IsChecked="{Binding Entry.Friday, Mode=TwoWay}" />
                                                        <CheckBox Style="{StaticResource DayToggleStyle}" Content="六"
                                                                  IsChecked="{Binding Entry.Saturday, Mode=TwoWay}" />
                                                        <CheckBox Style="{StaticResource DayToggleStyle}" Content="日"
                                                                  IsChecked="{Binding Entry.Sunday, Mode=TwoWay}" />
                                                        <TextBlock Text="（都不勾 = 只响一次）" FontSize="10.5"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>

                                                    <CheckBox Content="响铃时可以贪睡" Style="{StaticResource CheckBoxStyle}"
                                                              Margin="0,10,0,0" FontSize="11.5"
                                                              IsChecked="{Binding Entry.SnoozeEnabled, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="380"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⏰" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="还没有闹钟。点右上角「+ 添加闹钟」加一个。"
                                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 状态条 -->
                    <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11"
                               Margin="18,0,18,12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="alarm.闹钟与设置" />

            <!-- ===== 右：设置 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="设置" FontSize="14" FontWeight="SemiBold"
                               Margin="18,16,18,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="18,0,18,18">

                            <!-- 响铃 -->
                            <TextBlock Text="响铃" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <CheckBox Content="静音（保留声音选择，只是不播）" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.Muted, Mode=TwoWay}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="响铃音" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                          ItemsSource="{Binding SoundOptions}"
                                          SelectedItem="{Binding SelectedSound, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="试听" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0" Padding="10,3" FontSize="11.5"
                                        Command="{Binding TestSoundCommand}" />
                                <Button Grid.Column="3" Content="…" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6,0,0,0" Padding="10,3" FontSize="11.5"
                                        Command="{Binding BrowseSoundCommand}" ToolTip="选一个 .wav 文件" />
                            </Grid>

                            <CheckBox Content="反复播放，直到我停止或贪睡" Style="{StaticResource CheckBoxStyle}"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding Cfg.RepeatSound, Mode=TwoWay}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="贪睡时长" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Slider Grid.Column="1" Margin="10,0,0,0" Minimum="1" Maximum="60"
                                        SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        Value="{Binding Cfg.SnoozeMinutes, Mode=TwoWay}"
                                        Style="{StaticResource SliderStyle}" />
                                <TextBlock Grid.Column="2" MinWidth="52" TextAlignment="Right" FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding Cfg.SnoozeMinutes, StringFormat={}{0} 分}" />
                            </Grid>

                            <!-- 每个闹钟的重复天（在列表里改不了，这里给选中说明） -->
                            <TextBlock Text="小提示" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,6" />
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="在列表里点闹钟的时间可以改时间、备注和重复的星期（点时间那一行展开编辑）。只响一次的闹钟响过就会自动关掉。" />

                            <!-- 通知 -->
                            <TextBlock Text="通知" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,6" />
                            <notify:NotificationSettingsView DataContext="{Binding Cfg.Notification}" />

                            <!-- 日志 -->
                            <TextBlock Text="运行日志" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,6" />
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     Style="{StaticResource LogTextBoxStyle}" Height="100"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     core:ScrollChaining.Enabled="True" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

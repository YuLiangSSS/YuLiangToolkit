<Window x:Class="YuLiangToolkit.Tools.Screenshot.Views.ScreenshotPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图调色板"
        Width="430" Height="370"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="额外调色板" Foreground="#FFF0F0F0" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="点色块，或输入 #RRGGBB / #AARRGGBB" Foreground="#FF9E9E9E" FontSize="12" Margin="0,3,0,10" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="SwatchesPanel" />
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="颜色" Foreground="#FFD0D0D0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="HexBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                     Background="#FF2A2A2A" Foreground="White" BorderBrush="#5532ADE6" Padding="6,2" />
            <Button Grid.Column="2" Content="取消" Width="66" Height="30" Margin="8,0,0,0" Click="OnCancelClick" />
            <Button Grid.Column="3" Content="确定" Width="66" Height="30" Margin="8,0,0,0" Click="OnOkClick" />
        </Grid>
    </Grid>
</Window>

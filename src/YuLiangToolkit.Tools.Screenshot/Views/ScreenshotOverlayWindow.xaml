<Window x:Class="YuLiangToolkit.Tools.Screenshot.Views.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图工具"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="#01000000"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Cursor="Cross"
        Focusable="True"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseWheel="OnMouseWheel">
    <Window.Resources>
        <Style x:Key="OverlayToolButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#FFF4F7FF" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="29" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ToolTipService.ShowDuration" Value="4000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#99FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#665B9CFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7DB4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF4F7FF" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#99FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#665B9CFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayTextButtonStyle" TargetType="Button" BasedOn="{StaticResource OverlayActionButtonStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="OverlayCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource OverlayActionButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFD3D3" />
            <Setter Property="Background" Value="#33FF5555" />
            <Setter Property="BorderBrush" Value="#66FF7777" />
        </Style>

        <Style x:Key="OverlayColorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Black" ClipToBounds="True">
        <Image x:Name="Backdrop" Stretch="Fill" IsHitTestVisible="False" />
        <Path x:Name="DimPath" Fill="#8A000000" IsHitTestVisible="False" />
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRect" Stroke="#FF7DB4FF" StrokeThickness="2" Visibility="Collapsed" />
            <Canvas x:Name="AnnotationCanvas" ClipToBounds="True" />
            <Canvas x:Name="HandleCanvas" />
        </Canvas>

        <Canvas x:Name="ChromeCanvas" Background="Transparent">
            <Border x:Name="SizeBadge" Background="#E610141A" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="5" Padding="8,3" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>

            <Border x:Name="HintPanel" Background="#E610141A" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="9" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="拖动鼠标框选截图区域" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="双击选区直接复制 · Enter 复制 · S 保存 · P 贴图 · Esc / 右键取消"
                               Foreground="#B8C0CC" FontSize="11.5" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="Magnifier" Background="#F0121720" BorderBrush="#88FFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="6" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel>
                    <Border Width="150" Height="84" CornerRadius="4" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush x:Name="MagnifierBrush" Stretch="Fill" />
                        </Border.Background>
                        <Grid>
                            <Line X1="0" Y1="42" X2="150" Y2="42" Stroke="#AAFF5555" StrokeThickness="1" />
                            <Line X1="75" Y1="0" X2="75" Y2="84" Stroke="#AAFF5555" StrokeThickness="1" />
                            <Rectangle Width="7" Height="7" Stroke="White" StrokeThickness="1" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Fill="Transparent" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="MagnifierColorText" Foreground="#FFE8EAF0" FontSize="11"
                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="Toolbar" Background="#F0141A22" BorderBrush="#66FFFFFF" BorderThickness="1"
                    CornerRadius="10" Padding="8,6" Visibility="Collapsed">
                <StackPanel>
                    <WrapPanel x:Name="ToolButtonsHost" Orientation="Horizontal" />
                    <WrapPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <TextBlock Text="颜色" Foreground="#B8C0CC" FontSize="11.5" VerticalAlignment="Center" Margin="4,0,4,0" />
                        <StackPanel x:Name="ColorPaletteHost" Orientation="Horizontal" VerticalAlignment="Center" />
                        <Button Content="调色板" ToolTip="打开额外调色板" Style="{StaticResource OverlayTextButtonStyle}"
                                Margin="4,0,0,0" Click="OnPaletteClick" />
                        <Border Width="1" Height="20" Background="#44FFFFFF" Margin="8,0" />
                        <TextBlock Text="线宽" Foreground="#B8C0CC" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <ComboBox x:Name="ThicknessCombo" Width="58" Height="26" Margin="0,0,6,0"
                                  SelectionChanged="OnThicknessChanged" />
                        <CheckBox x:Name="FillCheck" Content="填充" Foreground="#E8EAF0" VerticalAlignment="Center"
                                  Margin="4,0,8,0" Click="OnFillChanged" />
                        <Border Width="1" Height="20" Background="#44FFFFFF" Margin="2,0,8,0" />
                        <Button Content="↶" ToolTip="撤销 Ctrl+Z" Style="{StaticResource OverlayActionButtonStyle}"
                                Click="OnUndoClick" />
                        <Button Content="↷" ToolTip="重做 Ctrl+Y" Style="{StaticResource OverlayActionButtonStyle}"
                                Click="OnRedoClick" />
                        <Button Content="复制" ToolTip="复制到剪贴板 Ctrl+C / Enter" Style="{StaticResource OverlayTextButtonStyle}"
                                Click="OnCopyClick" />
                        <Button Content="保存" ToolTip="保存为图片 Ctrl+S" Style="{StaticResource OverlayTextButtonStyle}"
                                Click="OnSaveClick" />
                        <Button Content="贴图" ToolTip="贴到桌面 P" Style="{StaticResource OverlayTextButtonStyle}"
                                Click="OnPinClick" />
                        <Button Content="取消" ToolTip="取消 Esc" Style="{StaticResource OverlayCloseButtonStyle}"
                                Click="OnCancelClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="TextEditorHost" Background="#EE0C1118" BorderBrush="#FF7DB4FF" BorderThickness="1"
                    CornerRadius="5" Padding="3" Visibility="Collapsed">
                <TextBox x:Name="TextEditor" MinWidth="180" MinHeight="30" MaxWidth="520"
                         Foreground="White" Background="Transparent" BorderThickness="0"
                         FontSize="20" FontFamily="Microsoft YaHei UI, Segoe UI"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         PreviewKeyDown="OnTextEditorKeyDown" LostKeyboardFocus="OnTextEditorLostFocus" />
            </Border>

            <Border x:Name="ToastPanel" Background="#F018202A" BorderBrush="#88FFFFFF" BorderThickness="1"
                    CornerRadius="7" Padding="14,8" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="#FFF4F7FF" FontSize="12.5" TextWrapping="Wrap"
                           MaxWidth="620" />
            </Border>
        </Canvas>
    </Grid>
</Window>

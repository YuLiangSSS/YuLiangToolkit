<UserControl x:Class="YuLiangToolkit.Tools.Screenshot.Views.ScreenshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:controls="clr-namespace:YuLiangToolkit.Core.Controls;assembly=YuLiangToolkit.Core"
             Background="Transparent">

    <UserControl.Resources>
        <!-- 改键框：和秒表 / 倒计时页面同一套本地模板，避免跨程序集隐式样式偶发不生效。 -->
        <Style x:Key="HotkeyBoxLocalStyle" TargetType="controls:HotkeyBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:HotkeyBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" MinHeight="28">
                            <Grid>
                                <TextBlock Text="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}}"
                                           Margin="10,0,24,0" VerticalAlignment="Center" FontSize="12.5"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                           Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,9,0" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsCapturing" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ListRowSelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="430" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="📷 截图工具" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Text="按快捷键截屏 → 在全屏冻结图上框选 → 用工具栏标注 / 马赛克 / 文字 → 复制、保存或贴到桌面。所有动作都在本页，不另建托盘图标或托盘右键菜单。" />
            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Text="{Binding ShortcutSummary}" />
        </StackPanel>

        <!-- ===================== 三栏工作区 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="390" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：操作台 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="260" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="18,16,18,10">
                        <TextBlock Text="操作台" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StoragePathText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="18,0,18,18">
                            <Button Content="📷 开始截图" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="42" FontSize="14" Command="{Binding CaptureCommand}"
                                    ToolTip="打开框选编辑覆盖层（也可以按全局快捷键）" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="截屏并复制" Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34" Margin="0,0,4,0" Command="{Binding CaptureCopyCommand}" />
                                <Button Grid.Column="1" Content="重复上次区域" Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34" Margin="4,0,0,0" Command="{Binding CaptureRepeatCommand}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="全屏截图" Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32" Margin="0,0,4,0" Command="{Binding CaptureFullCommand}" />
                                <Button Grid.Column="1" Content="活动窗口" Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32" Margin="4,0,0,0" Command="{Binding CaptureActiveWindowCommand}" />
                            </Grid>

                            <!-- 最近一张 -->
                            <TextBlock Text="最近一张" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <Border Height="172" Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding LastPreviewImage}" Stretch="Uniform" Margin="5"
                                           Visibility="{Binding HasLastPreview, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="还没有截图&#x0a;点上面的「开始截图」试试" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Visibility="{Binding HasLastPreview, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </Border>

                            <!-- 贴图 / 历史操作 -->
                            <TextBlock Text="贴图与历史" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <Button Content="📌 贴图（从剪贴板）" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32" HorizontalContentAlignment="Left" Padding="12,0"
                                    Command="{Binding PastePinCommand}" />
                            <Button Content="👁 隐藏 / 显示所有贴图" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,6,0,0"
                                    Command="{Binding TogglePinsCommand}" />
                            <Button Content="🔁 切换到下一贴图组" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,6,0,0"
                                    Command="{Binding SwitchPinGroupCommand}" />
                            <TextBlock Text="{Binding PinGroupText}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,4,0,0" />
                            <Button Content="🧹 清空截屏历史" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,12,0,0"
                                    Command="{Binding ClearHistoryCommand}" />
                            <Button Content="📂 打开截图保存文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,6,0,0"
                                    Command="{Binding OpenSaveFolderCommand}" />

                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="7" Padding="10,8" Margin="0,14,0,0">
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="screenshot.操作台与历史" />

            <!-- ===== 中：历史 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,16,18,10">
                        <StackPanel>
                            <TextBlock Text="截图历史" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HistorySummary}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,4"
                                Command="{Binding RefreshHistoryCommand}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="HistoryList" ItemsSource="{Binding HistoryItems}"
                                 SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource HistoryItemStyle}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 core:ScrollChaining.Enabled="True"
                                 Margin="12,0,12,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="102" Height="66" Background="#FF101319" CornerRadius="5"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="10.5"
                                                       Foreground="{DynamicResource FaintTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="还没有历史截图。&#x0a;截图并确认后会出现在这里（可在设置里关闭历史）。"
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="14,8,14,14">
                        <Button Content="复制" Style="{StaticResource SecondaryButtonStyle}" Padding="13,4"
                                Command="{Binding CopyHistoryCommand}" />
                        <Button Content="贴图" Style="{StaticResource SecondaryButtonStyle}" Padding="13,4" Margin="7,0,0,0"
                                Command="{Binding PinHistoryCommand}" />
                        <Button Content="打开" Style="{StaticResource SecondaryButtonStyle}" Padding="13,4" Margin="7,0,0,0"
                                Command="{Binding OpenHistoryCommand}" />
                        <Button Content="所在位置" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="7,0,0,0"
                                Command="{Binding RevealHistoryCommand}" />
                        <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}" Padding="13,4" Margin="7,0,0,0"
                                Command="{Binding DeleteHistoryCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <core:PaneSplitter Grid.Column="3" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="screenshot.历史与设置" />

            <!-- ===== 右：设置 ===== -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="18,16,18,10">
                        <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="也可在「主页设置 → 快捷键」统一改键 / 拆分 / 禁用。"
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="18,0,18,18">

                            <!-- 快捷键 -->
                            <TextBlock Text="快捷键" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <CheckBox Content="启用这个工具的全局快捷键" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.EnableGlobalHotkeys, Mode=TwoWay}"
                                      ToolTip="关掉后四条都不注册，配置保留" />

                            <!-- 截屏 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" MinWidth="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="截屏" FontSize="12" VerticalAlignment="Center" />
                                <controls:HotkeyBox Grid.Column="1" Width="140" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                    ComboText="{Binding Cfg.CaptureHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsCaptureEnabled="{Binding Cfg.EnableGlobalHotkeys}" />
                                <CheckBox Grid.Column="2" Content="启用" Style="{StaticResource CheckBoxStyle}"
                                          Margin="9,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding Cfg.CaptureHotkeyEnabled, Mode=TwoWay}" />
                                <Button Grid.Column="3" Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="7,0,0,0" Padding="9,3" FontSize="11"
                                        Command="{Binding ClearShortcutCommand}" CommandParameter="capture" />
                            </Grid>

                            <!-- 截屏并复制 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" MinWidth="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="截屏并复制" FontSize="12" VerticalAlignment="Center" />
                                <controls:HotkeyBox Grid.Column="1" Width="140" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                    ComboText="{Binding Cfg.CaptureCopyHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsCaptureEnabled="{Binding Cfg.EnableGlobalHotkeys}" />
                                <CheckBox Grid.Column="2" Content="启用" Style="{StaticResource CheckBoxStyle}"
                                          Margin="9,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding Cfg.CaptureCopyHotkeyEnabled, Mode=TwoWay}" />
                                <Button Grid.Column="3" Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="7,0,0,0" Padding="9,3" FontSize="11"
                                        Command="{Binding ClearShortcutCommand}" CommandParameter="capture-copy" />
                            </Grid>

                            <!-- 重复上次 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" MinWidth="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="重复上次区域" FontSize="12" VerticalAlignment="Center" />
                                <controls:HotkeyBox Grid.Column="1" Width="140" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                    ComboText="{Binding Cfg.RepeatHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsCaptureEnabled="{Binding Cfg.EnableGlobalHotkeys}" />
                                <CheckBox Grid.Column="2" Content="启用" Style="{StaticResource CheckBoxStyle}"
                                          Margin="9,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding Cfg.RepeatHotkeyEnabled, Mode=TwoWay}" />
                                <Button Grid.Column="3" Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="7,0,0,0" Padding="9,3" FontSize="11"
                                        Command="{Binding ClearShortcutCommand}" CommandParameter="repeat" />
                            </Grid>

                            <!-- 贴图 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" MinWidth="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="贴图" FontSize="12" VerticalAlignment="Center" />
                                <controls:HotkeyBox Grid.Column="1" Width="140" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                    ComboText="{Binding Cfg.PasteHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsCaptureEnabled="{Binding Cfg.EnableGlobalHotkeys}" />
                                <CheckBox Grid.Column="2" Content="启用" Style="{StaticResource CheckBoxStyle}"
                                          Margin="9,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding Cfg.PasteHotkeyEnabled, Mode=TwoWay}" />
                                <Button Grid.Column="3" Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="7,0,0,0" Padding="9,3" FontSize="11"
                                        Command="{Binding ClearShortcutCommand}" CommandParameter="paste" />
                            </Grid>

                            <!-- 输出 -->
                            <TextBlock Text="输出" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <CheckBox Content="截图完成后自动复制到剪贴板" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.AutoCopyOnConfirm, Mode=TwoWay}" />
                            <CheckBox Content="截图完成后自动保存一份" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.AutoSaveOnCapture, Mode=TwoWay}" Margin="0,7,0,0" />
                            <CheckBox Content="保存后打开所在文件夹" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.OpenFolderAfterSave, Mode=TwoWay}" Margin="0,7,0,0" />

                            <TextBlock Text="保存文件夹" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Cfg.EffectiveSaveFolder, Mode=OneWay}" IsReadOnly="True"
                                         Style="{StaticResource TextBoxStyle}" FontSize="11.5" />
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="7,0,0,0" Padding="9,3" Command="{Binding BrowseSaveFolderCommand}" />
                                <Button Grid.Column="2" Content="打开" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6,0,0,0" Padding="9,3" Command="{Binding OpenSaveFolderCommand}" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="文件名前缀" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding Cfg.FilePrefix, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Margin="7,0,0,0" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding FormatOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}" Width="124" Margin="7,0,0,0" />
                            </Grid>

                            <Grid Margin="0,8,0,0" Visibility="{Binding IsJpg, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="JPG 质量" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding Cfg.JpgQuality, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Margin="7,0,0,0" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="压缩程度" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CompressionOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedCompression, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}" Margin="7,0,0,0" />
                            </Grid>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Margin="78,4,0,0"
                                       Text="开启压缩后，保存 / 复制 / 历史 / 贴图统一按所选 JPG 档位；不压缩保持原图。" />

                            <!-- 自定义截屏 -->
                            <TextBlock Text="自定义截屏" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CustomTargetOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedCustomTarget, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}" Margin="7,0,0,0" />
                                <TextBox Grid.Column="2" Text="{Binding Cfg.CustomCaptureDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Margin="7,0,0,0" ToolTip="延迟秒数（0~30）" />
                                <Button Grid.Column="3" Content="截一张" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="7,0,0,0" Padding="9,3" Command="{Binding CustomCaptureCommand}" />
                            </Grid>

                            <!-- 编辑默认值 -->
                            <TextBlock Text="编辑默认值" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="默认颜色" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding Cfg.DefaultColor, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Margin="7,0,0,0" ToolTip="支持 #AARRGGBB / #RRGGBB" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding ThicknessOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedDefaultThickness, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}" Width="78" Margin="7,0,0,0" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="默认工具" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ToolOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedDefaultTool, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}" Margin="7,0,0,0" />
                            </Grid>
                            <CheckBox Content="显示放大镜 / 取色信息" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.MagnifierEnabled, Mode=TwoWay}" Margin="0,10,0,0" />
                            <CheckBox Content="框选时显示尺寸标签" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.ShowSizeBadge, Mode=TwoWay}" Margin="0,7,0,0" />
                            <CheckBox Content="矩形 / 椭圆默认填充" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.DefaultFill, Mode=TwoWay}" Margin="0,7,0,0" />

                            <!-- 历史 / 贴图 -->
                            <TextBlock Text="历史与贴图" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <CheckBox Content="保留截图历史" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.KeepHistory, Mode=TwoWay}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="历史上限" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding Cfg.HistoryLimit, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Margin="7,0,0,0" ToolTip="最多保留多少张，0 = 不保留" />
                            </Grid>
                            <CheckBox Content="新贴图强制置顶" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.PinTopmost, Mode=TwoWay}" Margin="0,8,0,0" />

                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="清空截屏历史" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4" Command="{Binding ClearHistoryCommand}" />
                                <Button Content="恢复默认设置" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4" Margin="7,0,0,0" Command="{Binding ResetSettingsCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

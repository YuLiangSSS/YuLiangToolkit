<UserControl x:Class="YuLiangToolkit.Tools.PptViewer.Views.PptViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent"
             Focusable="True"
             AllowDrop="True">

    <!-- 「PPT 阅读器」界面：顶部工具条（打开 / 最近 / 放映 / 缩略图 / 备注 / 翻页 / 缩放 / 查找）
         → 错误提示 → 主区域（缩略图栏 | 幻灯片显示区 | 备注栏）→ 状态栏。
         整页是满屏 Grid（外壳用 ContentControl 承载并缓存视图），**不套整页 ScrollViewer**；
         缩略图 / 备注栏与幻灯片区之间用 core:PaneSplitter（可拖、会记住、双击复位，见 docs/dev/layout.md），
         关掉对应开关时列宽 + 分隔条一起收起（BoolToPaneLength + BoolToVis）。
         ⚠ 中间放映区是深色底 + 幻灯片白纸，属于「文档画面」，颜色可以写死；
         工具条 / 侧栏 / 状态栏一律用主题 token（DynamicResource）。 -->

    <UserControl.Resources>
        <!-- 工具条里的小按钮：比 SecondaryButtonStyle 窄一点（缩放 / 翻页 / 查找） -->
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="30" />
        </Style>

        <!-- 左侧缩略图列表的一行：悬停 / 选中高亮，选中项即当前页 -->
        <Style x:Key="SlideListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ListRowSelectedBackgroundBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush"
                                        Value="{DynamicResource ListRowSelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 缩略图上的小标签（隐藏 / 备注） -->
        <Style x:Key="ThumbnailBadgeStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 工具条 -->
            <RowDefinition Height="Auto" />   <!-- 错误提示（空时收起） -->
            <RowDefinition Height="*" />      <!-- 主区域：缩略图 / 幻灯片区 / 备注栏 -->
            <RowDefinition Height="Auto" />   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ================= 工具条 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel>
                <!-- 第一行：打开 / 最近 / 文档信息 / 放映 + 视图开关 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Content="📽️ 打开演示文稿…" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenCommand}" VerticalAlignment="Center"
                            ToolTip="打开 .pptx / .pptm / .ppsx 文件（只读浏览；Ctrl+O）" />

                    <!-- 最近打开：下拉里点一条直接重新打开；右边「清空」只删记录、不删文件 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🕘 最近" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="RecentCombo" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding RecentItems}" SelectedItem="{Binding SelectedRecent}"
                                  MinWidth="180" MaxWidth="240" VerticalAlignment="Center"
                                  ToolTip="最近打开的演示文稿（新的在上；文件已不存在的会标灰）">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTipText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding RecentSummary}" FontSize="10.5" Margin="8,0,4,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="清空" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding ClearRecentCommand}"
                                ToolTip="清空最近打开记录（不会删除本地文件）" />
                    </StackPanel>

                    <!-- 当前演示文稿标题 / 路径（悬停显示作者 / 时间 / 尺寸 / 大小 / 完整路径） -->
                    <StackPanel Grid.Column="2" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DocumentTitle}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DocumentInfo}" />
                        <TextBlock Text="{Binding FilePathText}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DocumentInfo}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▶ 放映" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding StartPresentationCommand}"
                                ToolTip="从当前页开始全屏放映（F5；Esc 退出）" />
                        <CheckBox Content="缩略图" IsChecked="{Binding ShowThumbnails}"
                                  Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center" Margin="14,0,0,0"
                                  ToolTip="显示 / 隐藏左侧缩略图栏（会记住）" />
                        <CheckBox Content="备注" IsChecked="{Binding ShowNotes}" IsEnabled="{Binding CanShowNotes}"
                                  Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center" Margin="14,0,0,0"
                                  ToolTip="显示 / 隐藏右侧备注栏；当前页没有备注时不可用（会记住开关）" />
                    </StackPanel>
                </Grid>

                <!-- 第二行：缩放 / 翻页 / 快捷键提示 -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="缩放" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="−" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding ZoomOutCommand}" ToolTip="缩小 10%（Ctrl+滚轮也行）" />
                        <TextBox x:Name="ZoomBox" Width="66" Margin="6,0" TextAlignment="Center"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding ZoomText}"
                                 PreviewKeyDown="OnZoomBoxPreviewKeyDown"
                                 ToolTip="输入 25 ~ 400 的百分比，按回车生效（会切到手工缩放）" />
                        <Button Content="+" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding ZoomInCommand}" ToolTip="放大 10%（Ctrl+滚轮也行）" />
                        <Button Content="100%" Style="{StaticResource CompactButtonStyle}" Margin="6,0,0,0"
                                Command="{Binding ZoomResetCommand}" ToolTip="恢复 100% 缩放" />
                        <CheckBox Content="适应窗口" IsChecked="{Binding FitToWindow}"
                                  Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="按窗口大小铺满一张幻灯片；关掉后用百分比缩放" />
                    </StackPanel>

                    <!-- 翻页：第一张 / 上一张 / 页码 / 下一张 / 最后一张（键盘也行） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Content="⏮" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding FirstSlideCommand}" ToolTip="第一张（Home）" />
                        <Button Content="◀" Style="{StaticResource CompactButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding PrevSlideCommand}" ToolTip="上一张（PageUp / ↑ / ←）" />
                        <TextBlock Text="{Binding SlideIndicator}" MinWidth="80" FontSize="12.5"
                                   TextAlignment="Center" VerticalAlignment="Center" Margin="8,0"
                                   ToolTip="当前页 / 总页数" />
                        <Button Content="▶" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding NextSlideCommand}" ToolTip="下一张（PageDown / ↓ / → / 空格）" />
                        <Button Content="⏭" Style="{StaticResource CompactButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding LastSlideCommand}" ToolTip="最后一张（End）" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" FontSize="10.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="↑↓ / ←→ 翻页 · Ctrl+滚轮 缩放 · F5 放映" />
                </Grid>

                <!-- 第三行：查找 / 复制本页文字 -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="查找" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Grid Width="210">
                            <TextBox x:Name="SearchBox" Height="28" Padding="8,0" VerticalContentAlignment="Center"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                                     ToolTip="在正文与备注里查找（Ctrl+F；回车 = 下一个，Shift+回车 = 上一个，Esc = 清除）" />
                            <TextBlock Text="查找正文 / 备注 (Ctrl+F)" Margin="10,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>

                        <!-- 查找结果浮层：DataContext 在代码后置里设成 ViewModel（Popup 不在可视树里，不会自动继承）。
                             点一条命中直接跳到对应页，点浮层外面 / Esc 收起。 -->
                        <Popup x:Name="SearchResultsPopup"
                               PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsSearchResultOpen, Mode=TwoWay}">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="4" Width="380" MaxHeight="260">
                                <ListBox ItemsSource="{Binding SearchHits}"
                                         SelectedItem="{Binding SelectedSearchHit, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ToolTip="点一条跳到对应页">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PageText}" FontSize="11"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SourceText}" FontSize="10.5"
                                                               Margin="8,0,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Snippet}" FontSize="11" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>

                        <CheckBox Content="区分大小写" IsChecked="{Binding SearchMatchCase}"
                                  Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center" Margin="8,0,0,0"
                                  ToolTip="查找时区分大小写（正文 + 备注）" />
                        <TextBlock Text="{Binding SearchSummary}" MinWidth="88" FontSize="10.5" Margin="8,0,4,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="↑" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding SearchPrevCommand}" ToolTip="上一个命中（Shift+回车）" />
                        <Button Content="↓" Style="{StaticResource CompactButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding SearchNextCommand}" ToolTip="下一个命中（回车）" />
                        <Button Content="✕" Style="{StaticResource CompactButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding ClearSearchCommand}" ToolTip="清除查找（Esc）" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="📋 复制本页文字" Style="{StaticResource CompactButtonStyle}"
                            Command="{Binding CopySlideTextCommand}"
                            ToolTip="把当前页的纯文字（标题 + 正文 + 表格）复制到剪贴板" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= 错误提示（有错误才出现；不弹 MessageBox） ================= -->
        <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource DangerBrush}" BorderThickness="0,0,0,1" Padding="14,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToVisInverse}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="{DynamicResource DangerBrush}" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ================= 主区域 ================= -->
        <Grid Grid.Row="2" Margin="12,10,12,8" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <!-- 缩略图栏：宽度跟着「缩略图」开关收起（拖动改宽度，记忆在 Config\layout.json） -->
                <ColumnDefinition
                    Width="{Binding ShowThumbnails, Converter={StaticResource BoolToPaneLength}, ConverterParameter=220}"
                    MinWidth="{Binding ShowThumbnails, Converter={StaticResource BoolToPaneLength}, ConverterParameter=160}" />
                <!-- 缩略图栏 / 幻灯片区 分隔条独占一列；缩略图关掉时这一列也收成 0 -->
                <ColumnDefinition
                    Width="{Binding ShowThumbnails, Converter={StaticResource BoolToPaneLength}, ConverterParameter=12}" />
                <!-- 幻灯片区：随窗口缩放 -->
                <ColumnDefinition Width="*" MinWidth="360" />
                <!-- 幻灯片区 / 备注栏 分隔条：备注栏关掉时一起收成 0 -->
                <ColumnDefinition
                    Width="{Binding IsNotesPaneOpen, Converter={StaticResource BoolToPaneLength}, ConverterParameter=12}" />
                <!-- 备注栏：可拖宽度，记忆在 Config\layout.json -->
                <ColumnDefinition
                    Width="{Binding IsNotesPaneOpen, Converter={StaticResource BoolToPaneLength}, ConverterParameter=320}"
                    MinWidth="{Binding IsNotesPaneOpen, Converter={StaticResource BoolToPaneLength}, ConverterParameter=220}" />
            </Grid.ColumnDefinitions>

            <!-- 缩略图栏 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"
                    Visibility="{Binding ShowThumbnails, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="14,12,12,8">
                        <TextBlock Text="🖼 幻灯片" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SlideIndicator}" FontSize="10.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <ListBox x:Name="SlideList" Grid.Row="1" Margin="6,0,6,8"
                             ItemsSource="{Binding Slides}"
                             SelectedItem="{Binding CurrentSlide, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource SlideListItemStyle}"
                             core:ScrollChaining.Enabled="True"
                             ToolTip="点缩略图跳到对应幻灯片">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Background="White" CornerRadius="3" ClipToBounds="True"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}" Height="72" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <Grid Margin="1,4,1,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTipText}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="🗒" Style="{StaticResource ThumbnailBadgeStyle}"
                                                       ToolTip="这一页有演讲者备注"
                                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="隐藏" Style="{StaticResource ThumbnailBadgeStyle}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       ToolTip="隐藏幻灯片：放映时跳过"
                                                       Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="点缩略图跳页 · 拖动右侧缝隙可调宽度" FontSize="10.5"
                               Margin="14,8,14,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- 缩略图栏 / 幻灯片区 分隔条 -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="ppt-viewer.缩略图栏与幻灯片"
                               Visibility="{Binding ShowThumbnails, Converter={StaticResource BoolToVis}}" />

            <!-- 幻灯片区：深色底 + 居中的白色幻灯片（画面颜色不跟主题走） -->
            <Border Grid.Column="2" Background="#0E1014" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <Grid Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                        <!-- 适应窗口：Image 直接 Uniform 铺满可用区域（保持 16:9 / 4:3 比例，四周留深色边） -->
                        <Grid Margin="18" Visibility="{Binding FitToWindow, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding SlideImage}" Stretch="Uniform"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>

                        <!-- 手工缩放：按百分比算好宽高，放到可滚动区域里居中（滚轮 / 滚动条看大图的局部） -->
                        <ScrollViewer Margin="12"
                                      Visibility="{Binding FitToWindow, Converter={StaticResource InverseBoolToVis}}"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                      CanContentScroll="False"
                                      core:ScrollChaining.Enabled="True">
                            <Border Background="White" BorderBrush="#33000000" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding SlideImage}" Stretch="Fill"
                                       Width="{Binding SlideDisplayWidth}" Height="{Binding SlideDisplayHeight}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </ScrollViewer>

                        <!-- 右下角页码小标签 -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,14"
                                Background="#99000000" CornerRadius="10" Padding="10,4"
                                IsHitTestVisible="False">
                            <TextBlock Text="{Binding SlideIndicator}" Foreground="#EEFFFFFF" FontSize="11.5" />
                        </Border>

                        <!-- 打开了文件但里面一张幻灯片都没有（空包 / 解析器不认识的部件） -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasSlides, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="📄" FontSize="34" HorizontalAlignment="Center" />
                            <TextBlock Text="这份演示文稿里没有幻灯片" FontSize="13" Margin="0,12,0,0"
                                       HorizontalAlignment="Center" Foreground="#B8C0CC" />
                        </StackPanel>
                    </Grid>

                    <!-- 空状态：没打开文件时显示拖入提示 -->
                    <Border Style="{StaticResource CardStyle}" Padding="28" Margin="6,6,6,6"
                            Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                            <TextBlock Text="📽️" FontSize="44" HorizontalAlignment="Center" />
                            <TextBlock Text="把 .pptx / .pptm / .ppsx 拖到这里" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock Text="或者点左上角「📽️ 打开演示文稿…」。只读浏览，不会改动原文件。"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="支持：文字 / 图片 / 表格 / 常见形状 / 背景与主题色 · 缩略图导航 · 备注 · 查找 · 缩放 · 复制本页文字 · 全屏放映"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 解析中：居中提示（不挡鼠标，避免用户重复点打开） -->
                    <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="False" Background="Transparent">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="18,12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar IsIndeterminate="True" Width="130" Height="4"
                                             Style="{StaticResource ProgressBarStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ProgressText}" Margin="12,0,0,0" FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- 幻灯片区 / 备注栏 分隔条 -->
            <core:PaneSplitter Grid.Column="3" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="ppt-viewer.幻灯片与备注栏"
                               Visibility="{Binding IsNotesPaneOpen, Converter={StaticResource BoolToVis}}" />

            <!-- 备注栏：当前页的演讲者备注（只读） -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"
                    Visibility="{Binding IsNotesPaneOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="14,12,12,8">
                        <TextBlock Text="🗒 备注" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="当前页的演讲者备注（只读显示，不会改动原文件）" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ScrollViewer Margin="14,0,10,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True">
                            <TextBlock Text="{Binding NotesText}" FontSize="12" TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </ScrollViewer>

                        <!-- 当前页没有备注时给一句提示（备注栏仍可关掉） -->
                        <TextBlock Text="这一页没有备注" FontSize="11.5" Margin="14,10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding NotesText, Converter={StaticResource EmptyToVis}}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="拖左侧缝隙可调宽度 · 没有备注的页这里显示提示"
                               FontSize="10.5" Margin="14,8,14,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="3" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="380" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold"
                               MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePathText}" />
                    <TextBlock Text="{Binding FileSizeText}" FontSize="11.5" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding DocumentSummary}" FontSize="11.5" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SlideIndicator}" FontSize="11.5" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="70" Height="4" IsIndeterminate="True" Margin="0,0,10,0"
                                 Style="{StaticResource ProgressBarStyle}" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ZoomText}" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

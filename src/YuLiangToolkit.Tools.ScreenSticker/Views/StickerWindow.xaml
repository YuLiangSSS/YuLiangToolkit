<Window x:Class="YuLiangToolkit.Tools.ScreenSticker.Views.StickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕贴纸"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove"
        MouseWheel="OnMouseWheel"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">

    <!-- 说明：每张贴纸 = 一个独立透明无边框窗口（和 Live2D 桌宠同一个思路，见 PetWindow）。
         窗口大小 = 图片显示大小（不留边距，所以拖到屏幕边缘不会有一圈透明死区），
         背景全透明 → PNG 的透明部分也透出桌面；整块矩形都能点（包括图片的透明像素）。
         图片本身不参与命中测试：鼠标事件统一由 Root 网格处理（拖动 / 四边四角拉伸 / 滚轮缩放）。 -->

    <Window.ContextMenu>
        <!-- 右键菜单：全部用 App.xaml 的深色菜单模板（DarkContextMenuStyle + 隐式菜单项样式），
             否则 WPF 默认 MenuItem 模板会在左边留一条白色图标列（见 AGENTS.md 硬性规则 13）。 -->
        <ContextMenu x:Name="StickerMenu" Style="{StaticResource DarkContextMenuStyle}"
                     Opened="OnMenuOpened" Closed="OnMenuClosed">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuLeafItemStyle}" />
                <Style TargetType="Separator" BasedOn="{StaticResource DarkMenuSeparatorStyle}" />
            </ContextMenu.Resources>

            <MenuItem x:Name="MenuItemTopmost" Header="强制置顶（覆盖其它窗口）" IsCheckable="True"
                      Click="OnMenuTopmostClick"
                      ToolTip="打开后这张贴纸会一直盖在普通窗口上面；再点一次取消" />

            <MenuItem x:Name="MenuItemGifSpeed" Header="动图播放速度"
                      Style="{StaticResource DarkMenuParentItemStyle}"
                      ToolTip="对 GIF / APNG / 动图 WebP 有效；静态图这一项是灰的">
                <MenuItem.Resources>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuLeafItemStyle}" />
                </MenuItem.Resources>
                <MenuItem x:Name="MenuItemGifSpeed025" Header="0.25×" Tag="0.25" IsCheckable="True"
                          Click="OnMenuGifSpeedClick" ToolTip="四分之一速（很慢）" />
                <MenuItem x:Name="MenuItemGifSpeed050" Header="0.5×" Tag="0.5" IsCheckable="True"
                          Click="OnMenuGifSpeedClick" />
                <MenuItem x:Name="MenuItemGifSpeed075" Header="0.75×" Tag="0.75" IsCheckable="True"
                          Click="OnMenuGifSpeedClick" />
                <MenuItem x:Name="MenuItemGifSpeed100" Header="1×（原速）" Tag="1" IsCheckable="True"
                          Click="OnMenuGifSpeedClick" />
                <MenuItem x:Name="MenuItemGifSpeed125" Header="1.25×" Tag="1.25" IsCheckable="True"
                          Click="OnMenuGifSpeedClick" />
                <MenuItem x:Name="MenuItemGifSpeed150" Header="1.5×" Tag="1.5" IsCheckable="True"
                          Click="OnMenuGifSpeedClick" />
                <MenuItem x:Name="MenuItemGifSpeed200" Header="2×" Tag="2" IsCheckable="True"
                          Click="OnMenuGifSpeedClick" />
                <MenuItem x:Name="MenuItemGifSpeed300" Header="3×" Tag="3" IsCheckable="True"
                          Click="OnMenuGifSpeedClick" />
            </MenuItem>

            <MenuItem x:Name="MenuItemReset" Header="恢复默认"
                      Style="{StaticResource DarkMenuParentItemStyle}"
                      ToolTip="把这张贴纸恢复成刚贴上去时的默认状态">
                <MenuItem.Resources>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuLeafItemStyle}" />
                    <Style TargetType="Separator" BasedOn="{StaticResource DarkMenuSeparatorStyle}" />
                </MenuItem.Resources>
                <MenuItem Header="恢复默认大小（图片原始尺寸）" Click="OnMenuResetSizeClick"
                          ToolTip="按图片自身像素尺寸显示；超大图会缩到屏幕内，中心点不动" />
                <MenuItem x:Name="MenuItemResetSpeed" Header="恢复默认速度（跟随设置）" Click="OnMenuResetSpeedClick"
                          ToolTip="动图播放速度回到「设置 → 动图默认播放速度」；静态图不可用" />
                <Separator />
                <MenuItem Header="全部恢复默认（大小 + 速度 + 置顶）" Click="OnMenuResetDefaultsClick"
                          ToolTip="大小 / 速度 / 置顶一起恢复；位置不动" />
            </MenuItem>

            <Separator />
            <MenuItem Header="层级：上移一层" Click="OnMenuMoveUpClick" />
            <MenuItem Header="层级：下移一层" Click="OnMenuMoveDownClick" />
            <MenuItem Header="层级：置于最上层" Click="OnMenuMoveToTopClick" />
            <MenuItem Header="层级：置于最下层" Click="OnMenuMoveToBottomClick" />
            <Separator />
            <MenuItem Header="居中显示" Click="OnMenuCenterClick" />
            <Separator />
            <MenuItem Header="打开图片所在文件夹" Click="OnMenuRevealClick" />
            <MenuItem Header="把主窗口叫到前面（管理贴纸）" Click="OnMenuOpenToolPageClick"
                      ToolTip="贴纸管理页在侧边栏「桌面 → 屏幕贴纸」" />
            <Separator />
            <MenuItem Header="关闭这张贴纸" Click="OnMenuCloseClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root" Background="Transparent">
        <!-- 图片：Stretch=Fill。窗口默认按图片比例，但允许用户拖四边 / 四角自由拉伸；
             自由拉伸后窗口比例可以和图不同，所以这里必须 Fill（Uniform 会留边）。 -->
        <Image x:Name="Picture" Stretch="Fill" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- 悬浮提示框：只在鼠标进入 / 靠近边缘时出现（边缘会同时换 ↔ ↕ 等光标）；
             不参与命中测试，不影响拖动。 -->
        <Border x:Name="HoverFrame" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                CornerRadius="3" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Window>

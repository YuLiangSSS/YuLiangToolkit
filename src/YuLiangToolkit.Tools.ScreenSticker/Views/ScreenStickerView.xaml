<UserControl x:Class="YuLiangToolkit.Tools.ScreenSticker.Views.ScreenStickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent"
             AllowDrop="True"
             DragOver="OnStickerDragOver"
             Drop="OnStickerDrop">

    <UserControl.Resources>
        <!-- 「最近使用」缩略图的右键菜单。
             ⚠ WPF 默认的 ContextMenu / MenuItem 模板在深色主题下会留一条「图标列」白底竖条，
             只设 Background 盖不掉，所以这里用自定义模板（与 Excel / 浏览器右键菜单同一套做法）。 -->
        <Style x:Key="StickerContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StickerMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 屏幕贴纸工具页（工具 Id = screen-sticker）。
         页面职责：选图（可多选）/ 拖入图片（可多张，松手即贴）/ 最近使用缩略图 /
         桌面贴纸管理（置顶、层级、关闭）/ 偏好设置。
         贴纸窗口的存活与持久化在 StickerSession（见 ViewModels/ScreenStickerViewModel.cs）。
         根节点必须 Background="Transparent"，否则页面空白处（ScrollViewer 没画到的区域）不参与命中，
         从资源管理器拖进来的图片会「拖不进页面」。

         布局约定见 docs/dev/layout.md：
           · 页面 = 标题 / 工具条 + 三个页面级区块，整体套 ScrollViewer；
           · 上半区（最近使用 ‖ 贴纸管理）与设置区上下可拖（固定像素行 + MinHeight），
             最近使用与贴纸管理左右可拖（左 * + 右固定）；
           · 相邻区块的边界各有一条独立的 core:PaneSplitter（Key = screen-sticker.*），
             松手自动记住、双击恢复这一处、全部恢复在「主页设置 → 界面布局」。
         样式全部来自 App.xaml；颜色一律 DynamicResource，不写死。 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,26">

            <!-- ===================== 标题 + 一句话说明 ===================== -->
            <StackPanel>
                <TextBlock Text="📌 屏幕贴纸" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Margin="0,5,0,0"
                           Text="把任意图片贴到桌面上：每张独立浮动，可自由拖动 / 滚轮缩放 / 调整层级 / 单独强制置顶。这里负责选图、最近使用与所有贴纸的统一管理。" />
            </StackPanel>

            <!-- ===================== 顶部工具条 ===================== -->
            <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Content="🖼 选择图片…" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ChooseImagesCommand}" VerticalAlignment="Center"
                                ToolTip="可以多选；支持的格式：png / jpg / bmp / gif / tif / ico / webp" />
                        <Button Grid.Column="1" Content="📋 粘贴剪贴板" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Command="{Binding PasteClipboardCommand}" VerticalAlignment="Center"
                                ToolTip="把剪贴板里的图片贴到桌面：截图 / 网页复制的一张图，或在资源管理器里复制的多张图片文件；也可以按 Ctrl+V" />
                        <Button Grid.Column="2" Content="🕘 恢复上次贴纸" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Command="{Binding RestoreStickersCommand}" VerticalAlignment="Center"
                                ToolTip="按保存的记录把当前还没显示的贴纸放回桌面" />
                        <TextBlock Grid.Column="4" Text="{Binding StickerSummaryText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="桌面上正在显示的贴纸数量 / 配置里保存着、可以恢复的贴纸数量" />
                    </Grid>

                    <!-- 状态行：选图失败 / 恢复结果等即时反馈就在工具条下方，不用滚到页面底部看 -->
                    <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                </Grid>
            </Border>

            <!-- ===================== 页面级区块：上半区（最近使用 ‖ 贴纸管理） + 设置 ===================== -->
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <!-- 上半区 / 设置区都是固定像素行：拖中间那条横缝 = 一块变高、另一块变矮 -->
                    <RowDefinition Height="480" MinHeight="360" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="300" MinHeight="220" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="420" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- ===================== A）最近使用 ===================== -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="🕘 最近使用" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RecentSummaryText}" FontSize="10.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                        Height="26" Padding="10,0" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding ClearRecentCommand}"
                                        ToolTip="清空最近使用记录（不会删除本地图片）" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              core:ScrollChaining.Enabled="True">
                                    <ItemsControl ItemsSource="{Binding RecentItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 一张缩略图 = 一个按钮：点一下就把这张图贴到桌面 -->
                                                <Button Width="132" Margin="0,0,8,8" Padding="6"
                                                        Command="{Binding AddCommand}"
                                                        ToolTip="{Binding ToolTipText}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Style.Triggers>
                                                                <!-- 文件已不存在的记录标灰（后台 CanOpen 检查结果） -->
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.ContextMenu>
                                                        <!-- ContextMenu 不在可视树里，这里显式把 DataContext 接到按钮的数据项上 -->
                                                        <ContextMenu Style="{StaticResource StickerContextMenuStyle}"
                                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="再贴一张" Style="{StaticResource StickerMenuItemStyle}"
                                                                      Command="{Binding AddCommand}" />
                                                            <MenuItem Header="移除这条记录" Style="{StaticResource StickerMenuItemStyle}"
                                                                      Command="{Binding RemoveCommand}" />
                                                            <MenuItem Header="在资源管理器中显示" Style="{StaticResource StickerMenuItemStyle}"
                                                                      Command="{Binding RevealCommand}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <!-- 宽度写死成 118 = 按钮宽 132 − 左右内边距，保证缩略图占位框不会塌成 0 -->
                                                    <StackPanel Width="118">
                                                        <Grid Height="76">
                                                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                    CornerRadius="4" />
                                                            <TextBlock Text="🖼" FontSize="22" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource FaintTextBrush}" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding FileName}" FontSize="11" Margin="1,6,1,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                        <TextBlock Text="{Binding AvailabilityText}" FontSize="10"
                                                                   Margin="1,2,1,0" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource DangerBrush}"
                                                                   Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 空状态：还没有贴过图片 -->
                                <TextBlock Text="{Binding RecentEmptyText}" FontSize="11.5" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="360" IsHitTestVisible="False"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding HasRecentItems, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 左右分隔条：拖动改「最近使用」与「桌面贴纸管理」的宽度 -->
                    <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                       Key="screen-sticker.最近与贴纸管理" />

                    <!-- ===================== B）桌面上的贴纸 ===================== -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,14,18,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="🖼 桌面上的贴纸" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StickerCountText}" FontSize="10.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListBox ItemsSource="{Binding Stickers}" Style="{StaticResource FileListStyle}"
                                         Margin="8,0,8,8" core:ScrollChaining.Enabled="True"
                                         ToolTip="每张贴纸一行：勾选 = 强制置顶；↑ / ↓ = 调整层级；✕ = 关闭这一张">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 缩略图（后台解码，显示前先放一个图片占位） -->
                                                <Grid Width="52" Height="40">
                                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="4" />
                                                    <TextBlock Text="🖼" FontSize="16" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FaintTextBrush}" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                    <TextBlock Text="{Binding DetailText}" FontSize="10.5" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>

                                                <!-- GIF 倍速按钮：只在动画 GIF 行显示；点一下循环换档（右键菜单可选具体倍速） -->
                                                <Button Grid.Column="2" Content="{Binding SpeedText}"
                                                        Width="42" Height="24" Padding="0" FontSize="10.5"
                                                        Margin="0,0,6,0" VerticalAlignment="Center"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding CycleSpeedCommand}"
                                                        Visibility="{Binding IsAnimated, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="GIF 播放速度：点一下换一档（0.25× ~ 3×）；也可以右键贴纸选具体倍速" />

                                                <CheckBox Grid.Column="3" Content="置顶" VerticalAlignment="Center"
                                                          Margin="0,0,6,0" Style="{StaticResource CheckBoxStyle}"
                                                          IsChecked="{Binding Topmost, Mode=TwoWay}"
                                                          ToolTip="勾上 = 这张贴纸始终显示在其它窗口上面（会立即生效并保存）" />

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="↑" Width="24" Height="24" Padding="0" FontSize="11"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding MoveUpCommand}"
                                                            ToolTip="上移一层（更靠前）" />
                                                    <Button Content="↓" Width="24" Height="24" Padding="0" FontSize="11"
                                                            Margin="4,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding MoveDownCommand}"
                                                            ToolTip="下移一层（更靠后）" />
                                                    <Button Content="✕" Width="24" Height="24" Padding="0" FontSize="10"
                                                            Margin="4,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding CloseCommand}"
                                                            ToolTip="关闭这一张贴纸（会同时删掉它的保存记录）" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 空状态：桌面上还没有贴纸 -->
                                <TextBlock Text="{Binding StickerEmptyText}" FontSize="11.5" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="300" IsHitTestVisible="False"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding HasStickers, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>

                            <!-- 底部批量操作：置顶 / 取消置顶 / 恢复 / 恢复默认（大小 / 速度 / 全部） / 关闭全部。
                                 按钮多、卡片宽度只有 420，用 WrapPanel 自动换行，别挤成一行 -->
                            <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                       Margin="18,2,18,14">
                                <Button Content="全部置顶" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                        Margin="0,0,6,6" Command="{Binding SetAllTopmostCommand}"
                                        ToolTip="把桌面上所有贴纸都设为强制置顶" />
                                <Button Content="全部取消置顶" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                        Margin="0,0,6,6" Command="{Binding ClearAllTopmostCommand}"
                                        ToolTip="取消所有贴纸的强制置顶（回到普通窗口层）" />
                                <Button Content="恢复上次贴纸" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                        Margin="0,0,6,6" Command="{Binding RestoreStickersCommand}"
                                        ToolTip="按保存的记录把还没显示的贴纸放回桌面" />
                                <Button Content="恢复默认大小" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                        Margin="0,0,6,6" Command="{Binding ResetAllSizesCommand}"
                                        ToolTip="把所有贴纸恢复成图片自身原始尺寸（超大图缩到屏幕内；位置不动）" />
                                <Button Content="恢复默认速度" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                        Margin="0,0,6,6" Command="{Binding ResetAllSpeedsCommand}"
                                        ToolTip="把所有 GIF 贴纸的播放速度恢复成设置里的默认速度" />
                                <Button Content="全部恢复默认" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                        Margin="0,0,6,6" Command="{Binding ResetAllDefaultsCommand}"
                                        ToolTip="把所有贴纸的大小 / GIF 速度 / 置顶一起恢复默认（会先确认；位置和图片不变）" />
                                <Button Content="全部关闭" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"
                                        Margin="0,0,0,6" Foreground="{DynamicResource DangerBrush}"
                                        Command="{Binding CloseAllStickersCommand}"
                                        ToolTip="关闭全部贴纸并清空保存记录（会先确认；图片文件不受影响）" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 横分隔条：拖动改「上半区」与「设置」的高度 -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="screen-sticker.上半区与设置" />

                <!-- ===================== C）设置 + 日志 ===================== -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="100" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="⚙ 设置" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"
                                       Text="改一下立即生效并自动保存（没有保存按钮）；这里的偏好只影响以后新贴的贴纸。" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="300" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1*" MinWidth="280" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：偏好设置（内容比区块高时自己滚，滚到头交给整页） -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          core:ScrollChaining.Enabled="True">
                                <StackPanel Margin="0,0,6,0">
                                    <CheckBox Content="启动程序时自动恢复上次的贴纸"
                                              IsChecked="{Binding AutoRestoreOnStartup}"
                                              Style="{StaticResource CheckBoxStyle}"
                                              ToolTip="关掉 = 启动时不自动把上次的贴纸放回桌面（仍可在工具页点「恢复上次贴纸」）" />
                                    <CheckBox Content="新贴纸默认置顶" Margin="0,10,0,0"
                                              IsChecked="{Binding DefaultTopmost}"
                                              Style="{StaticResource CheckBoxStyle}"
                                              ToolTip="打开 = 以后新贴的图片默认强制置顶；已经贴上去的贴纸不受影响" />
                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="新贴纸出现时按图片自身原始尺寸显示（超大图会先缩到屏幕内，极小图最小 48px）；想改回去用贴纸右键「恢复默认大小」。" />

                                    <TextBlock Text="GIF 默认播放速度（0.25× ~ 3×）" FontSize="11.5" Margin="0,14,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="0.25" Maximum="3" SmallChange="0.25" LargeChange="0.25"
                                                TickFrequency="0.25" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center" Style="{StaticResource SliderStyle}"
                                                Value="{Binding DefaultGifSpeed, Mode=TwoWay}"
                                                ToolTip="1× = GIF 文件自带的播放速度；只影响以后新贴的 GIF" />
                                        <TextBlock Grid.Column="1" Text="{Binding DefaultGifSpeedText}" FontSize="11"
                                                   MinWidth="56" TextAlignment="Right" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="只影响以后新贴的 GIF；已经贴上的可以在贴纸右键菜单或「桌面上的贴纸」列表里逐张调。" />

                                    <TextBlock Text="最近使用上限（0 ~ 100，0 = 不记录）" FontSize="11.5" Margin="0,14,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Width="76" Text="{Binding RecentLimitText, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource TextBoxStyle}" ToolTip="填 0 = 不记录并清空列表" />
                                        <TextBlock Grid.Column="1" Text="条" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="0 = 不记录（并清空最近使用）；默认 50，最大 100；改小会立刻裁掉最旧的记录。" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 右：操作按钮 + 状态行 + 只读日志 -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" MaxHeight="120" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0">
                                    <Button Content="恢复默认设置" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,6" Command="{Binding ResetSettingsCommand}"
                                            ToolTip="只恢复上面的偏好设置；桌面上的贴纸与最近使用记录不会被改动" />
                                    <Button Content="打开配置文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,0,6" Command="{Binding OpenConfigFolderCommand}"
                                            ToolTip="{Binding ConfigPathText}" />
                                </WrapPanel>

                                <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />

                                <TextBox Grid.Row="2" Text="{Binding LogText, Mode=OneWay}"
                                         Style="{StaticResource LogTextBoxStyle}"
                                         core:ScrollChaining.Enabled="True"
                                         ToolTip="最近的操作日志（贴图失败的原因也会记在这里）" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

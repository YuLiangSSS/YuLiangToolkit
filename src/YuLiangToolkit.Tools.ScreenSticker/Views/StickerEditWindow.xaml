<Window x:Class="YuLiangToolkit.Tools.ScreenSticker.Views.StickerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑贴图"
        Width="980" Height="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,10">
            <Button Content="画笔" Tag="pen" Click="OnToolClick" Margin="2" Width="60" Height="30" />
            <Button Content="荧光笔" Tag="highlighter" Click="OnToolClick" Margin="2" Width="68" Height="30" />
            <Button Content="橡皮" Tag="eraser" Click="OnToolClick" Margin="2" Width="60" Height="30" />
            <Border Width="1" Height="24" Background="#55FFFFFF" Margin="8,3" />
            <TextBlock Text="颜色" Foreground="#FFD0D0D0" VerticalAlignment="Center" Margin="4,0" />
            <WrapPanel x:Name="ColorPanel" VerticalAlignment="Center" />
            <Border Width="1" Height="24" Background="#55FFFFFF" Margin="8,3" />
            <TextBlock Text="粗细" Foreground="#FFD0D0D0" VerticalAlignment="Center" Margin="4,0" />
            <Slider x:Name="ThicknessSlider" Width="100" Minimum="1" Maximum="40" Value="4"
                    VerticalAlignment="Center" ValueChanged="OnThicknessChanged" />
            <Border Width="1" Height="24" Background="#55FFFFFF" Margin="8,3" />
            <Button Content="撤销" Click="OnUndoClick" Margin="2" Width="60" Height="30" />
            <Button Content="重做" Click="OnRedoClick" Margin="2" Width="60" Height="30" />
            <Button Content="清空" Click="OnClearClick" Margin="2" Width="60" Height="30" />
        </WrapPanel>
        <Border Grid.Row="1" Background="#FF111111" BorderBrush="#5532ADE6" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <InkCanvas x:Name="Ink" Background="Transparent" />
                </Viewbox>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="#FF9E9E9E" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="取消" Width="76" Height="32" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="保存为新贴图" Width="120" Height="32" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>

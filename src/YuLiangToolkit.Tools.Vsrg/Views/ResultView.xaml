<UserControl x:Class="YuLiangToolkit.Tools.Vsrg.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!-- 结算页：本局准确率 / 最大 combo / 各判定档次数 + 两个按钮（再玩一次 / 返回选歌）。
         不做评级、不记历史最佳（按需求）。 -->

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding ResultTitleText}" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ResultChartTitle}" FontSize="13" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ResultChartSubtitle}" FontSize="12" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 两个大数字 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="准确率" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ResultAccuracyText}" FontSize="42" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="最大 Combo" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ResultMaxComboText}" FontSize="42" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="24,18,24,0" />

                <!-- 判定档统计 -->
                <ScrollViewer Grid.Row="2" Margin="24,14,24,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ResultTierCounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="15"
                                               FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="60"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,4">
                    <Button Content="再玩一次" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130"
                            Height="36" Command="{Binding ReplayCommand}" />
                    <Button Content="返回选歌" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"
                            MinWidth="130" Height="36" Command="{Binding ResultBackCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

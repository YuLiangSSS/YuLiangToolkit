<UserControl x:Class="YuLiangToolkit.Tools.Vsrg.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.Vsrg.Views"
             Background="Transparent">

    <!-- 游玩页：整块区域铺满（一屏看全、不进滚动条）。
         顶部一条信息栏（曲名 / 准确率 / combo / 进度），其余全是自绘轨道画布；
         暂停遮罩盖在整页上面（与俄罗斯方块的「准备好了吗」同一套写法）。 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 信息栏 ===== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PlayingChart.TitleLine}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PlayingDifficultyName}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="准确率" FontSize="10.5" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PlayAccuracyText}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Combo" FontSize="10.5" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PlayComboText}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="进度" FontSize="10.5" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PlayProgressText}" FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Button Content="{Binding PauseButtonText}" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding TogglePauseCommand}" MinWidth="66"
                            ToolTip="暂停 / 继续（Esc 或 P）" />
                    <Button Content="退出" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding QuitPlayCommand}" MinWidth="66"
                            ToolTip="退出当前歌曲，回选歌页" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 轨道画布 ===== -->
        <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" ClipToBounds="True">
            <Grid>
                <views:PlayfieldCanvas x:Name="Canvas"
                                      Engine="{Binding Engine}"
                                      PositionMs="{Binding PlayPositionMs}"
                                      ApproachMs="{Binding Cfg.ApproachMs}"
                                      JudgementText="{Binding HudJudgementText}"
                                      KeyLabels="{Binding LaneLabelsText}"
                                      LaneBackgroundBrush="{DynamicResource InputBackgroundBrush}"
                                      LaneLineBrush="{DynamicResource BorderBrush}"
                                      JudgementLineBrush="{DynamicResource AccentBrush}"
                                      JudgementTextBrush="{DynamicResource AccentBrush}"
                                      KeyLabelBrush="{DynamicResource TextSecondaryBrush}" />

                <!-- ===== 暂停遮罩 ===== -->
                <Grid Background="#B2000000"
                      Visibility="{Binding PauseOverlayVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="已暂停" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="White" />
                        <TextBlock Text="Esc / P 继续" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Foreground="#CCFFFFFF" />

                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0" HorizontalAlignment="Center">
                            <Button Content="继续" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110"
                                    Command="{Binding TogglePauseCommand}" />
                            <Button Content="退出到选歌" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="12,0,0,0" MinWidth="130"
                                    Command="{Binding QuitPlayCommand}"
                                    ToolTip="结束本局，回选歌页重新选歌" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

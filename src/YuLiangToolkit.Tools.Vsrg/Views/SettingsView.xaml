<UserControl x:Class="YuLiangToolkit.Tools.Vsrg.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.Vsrg.Views"
             Background="Transparent">

    <!-- 设置页：三块上下堆叠（游玩设置 / 键位 / 判定档），块与块之间有一条横分隔条。
         布局约定见 docs/dev/layout.md：整页包在 ScrollViewer 里，块之间用固定像素行（拖完总高度会变、
         外层自己出滚动条）；页头是 Auto 行，不用管。 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,22,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="164" MinHeight="130" />
                <RowDefinition Height="12" />
                <RowDefinition Height="470" MinHeight="300" />
            </Grid.RowDefinitions>

        <!-- ===== 页头 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="⚙ 设置" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="改一下立刻生效、自动保存（配置在 Config\vsrg\config.json，没有保存按钮）。" />
            </StackPanel>

            <Button Grid.Column="1" Content="← 返回选歌" Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center" Command="{Binding GoSongSelectCommand}" />
        </Grid>

        <!-- ===== ① 游玩设置 ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="游玩" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="开始游玩时进入全屏" Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding Cfg.PlayFullscreen}"
                              ToolTip="点「开始游玩」立刻进全屏；打完（或按设置退出去结算）时自动退出全屏" />
                    <CheckBox Content="切走窗口时自动暂停" Style="{StaticResource CheckBoxStyle}" Margin="24,0,0,0"
                              IsChecked="{Binding Cfg.PauseOnLostFocus}" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox Content="退出当前歌曲时进结算页" Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding Cfg.QuitToResult}"
                              ToolTip="勾上：暂停 / 退出按已打的部分算一局成绩进结算；不勾：直接回选歌页（默认）" />
                    <TextBlock Text="（不勾 = 退出直接回选歌，成绩不算）" FontSize="11.5" Margin="10,1,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 音频偏移 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="音频偏移" FontSize="12.5"
                               VerticalAlignment="Center" MinWidth="76" />
                    <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource SliderStyle}"
                            Minimum="-500" Maximum="500" TickFrequency="5" SmallChange="1" LargeChange="10"
                            Value="{Binding Cfg.AudioOffsetMs}" VerticalAlignment="Center"
                            ToolTip="音乐听起来偏晚就填正数（判定时间跟着往后挪）" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AudioOffsetText}" FontSize="12.5"
                               MinWidth="72" TextAlignment="Right" VerticalAlignment="Center" />

                    <!-- 滚动速度 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="滚动速度" FontSize="12.5" Margin="0,12,0,0"
                               VerticalAlignment="Center" />
                    <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource SliderStyle}" Margin="0,12,0,0"
                            Minimum="1" Maximum="20" TickFrequency="0.5" SmallChange="0.1" LargeChange="1"
                            Value="{Binding Cfg.ScrollSpeed}" VerticalAlignment="Center"
                            ToolTip="越高 note 落得越快" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScrollSpeedText}" FontSize="12.5" TextAlignment="Right"
                                   MinWidth="72" />
                        <TextBlock Text="{Binding ApproachMs}" FontSize="10.5" TextAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="音量" FontSize="12.5" VerticalAlignment="Center" MinWidth="76" />
                    <Slider Style="{StaticResource SliderStyle}" Width="220" Minimum="0" Maximum="1"
                            TickFrequency="0.05" SmallChange="0.01" LargeChange="0.1"
                            Value="{Binding MusicVolume}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== ② 键位 ===== -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,14,0,0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="键位（1K ~ 10K）" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="点一下某一轨的方框，然后按一个键就绑定了（Esc 取消）。只认单键，修饰键不行。" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="恢复默认键位" Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Center" Command="{Binding ResetKeysCommand}" />
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding KeyConflictText}" FontSize="11.5" TextWrapping="Wrap"
                           Margin="0,8,0,0" Foreground="{DynamicResource DangerBrush}"
                           Visibility="{Binding HasKeyConflict, Converter={StaticResource BoolToVis}}" />

                <ItemsControl Grid.Row="2" ItemsSource="{Binding KeyBindings}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="{Binding LaneNumber, StringFormat=第 {0} 轨}" FontSize="10.5"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <views:KeyBindRow Row="{Binding}" Margin="0,4,0,0"
                                                  Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 横分隔条（可拖 / 双击复位 / 自动记住） -->
        <core:PaneSplitter Grid.Row="3" Style="{StaticResource PaneSplitterHorizontalStyle}"
                           Key="vsrg.设置.键位与判定" />

        <!-- ===== ③ 判定 ===== -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="判定档" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="从严格到宽松排列，按下时取第一个够得着的档。Standard 四档可以改数值、可以排队，但删不掉；Miss 永远是兜底、排最后。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="加一档" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddTierCommand}" />
                        <Button Content="恢复 Standard" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding ResetTiersCommand}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <CheckBox Content="面条（长条）尾部判定" Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding Cfg.TailJudgementEnabled}" />
                    <TextBlock Text="{Binding TailWindowText}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="尾部宽度乘数" FontSize="12.5" VerticalAlignment="Center" MinWidth="96" />
                        <Slider Style="{StaticResource SliderStyle}" Width="220" Minimum="0.1" Maximum="3"
                                TickFrequency="0.1" SmallChange="0.05" LargeChange="0.25"
                                Value="{Binding Cfg.TailWindowMultiplier}" VerticalAlignment="Center"
                                ToolTip="尾判窗口 = 每个档的窗口 × 这个乘数" />
                        <TextBlock Text="{Binding Cfg.TailWindowMultiplier, StringFormat=×{0:0.0}}" FontSize="12.5"
                                   Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="48" />
                    </StackPanel>

                    <TextBlock Text="{Binding TierValidationText}" FontSize="11.5" TextWrapping="Wrap"
                               Margin="0,8,0,0" Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding HasTierError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- 判定档列表：用 ItemsControl 自己排（DataGrid 在深色主题下会留白色表头 / 格子，
                     项目里其它工具页也都是自绘行） -->
                <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                              core:ScrollChaining.Enabled="True">
                    <StackPanel>
                        <!-- 表头 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="判定档" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="窗口 (±ms)" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="准确率 (%)" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="操作" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Tiers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Style="{StaticResource TextBoxStyle}" Margin="0,0,8,0"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBox Grid.Column="1" Style="{StaticResource TextBoxStyle}" Margin="0,0,8,0"
                                                 IsEnabled="{Binding IsMiss, Converter={StaticResource InverseBoolConverter}}"
                                                 Text="{Binding WindowMs, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}" />

                                        <TextBox Grid.Column="2" Style="{StaticResource TextBoxStyle}" Margin="0,0,8,0"
                                                 Text="{Binding AccuracyWeight, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="↑" Style="{StaticResource SecondaryButtonStyle}"
                                                    MinWidth="30" Padding="4,0"
                                                    Command="{Binding DataContext.MoveTierUpCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="往上挪（更严格的方向）" />
                                            <Button Content="↓" Style="{StaticResource SecondaryButtonStyle}"
                                                    MinWidth="30" Padding="4,0" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.MoveTierDownCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="往下挪（更宽松的方向）" />
                                            <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}"
                                                    MinWidth="46" Padding="4,0" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RemoveTierCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsPreset, Converter={StaticResource InverseBoolConverter}}"
                                                    ToolTip="预设档不能删" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

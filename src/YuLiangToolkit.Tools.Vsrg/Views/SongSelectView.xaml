<UserControl x:Class="YuLiangToolkit.Tools.Vsrg.Views.SongSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent">

    <!-- 选歌页：左「谱面集列表」 ｜ 竖分隔条 ｜ 右「详情 + 难度 + 开始」。
         布局约定见 docs/dev/layout.md：左 * ｜ 12px 分隔条 ｜ 右 420px（可拖）。 -->

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <!-- ===== 页头 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="🎹 VSRG" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="竖直下落式音游：读 osu!mania 谱面（只认 mode 3），把 .osz 拖进窗口就能导入。1K~10K 都能玩。" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="导入 .osz" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ImportCommand}" MinWidth="108"
                        ToolTip="选一个或多个 .osz 文件导入（也可以直接把文件拖进窗口）" />
                <Button Content="设置" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding GoSettingsCommand}" MinWidth="72"
                        ToolTip="全屏 / 音频偏移 / 滚动速度 / 键位 / 判定档" />
            </StackPanel>
        </Grid>

        <!-- ===== 导入状态 / 数据目录提示 ===== -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Border Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Visibility="{Binding HasImportStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ImportStatus}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>

            <TextBlock Text="{Binding StorageHintText}" FontSize="11" Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- ===== 主体：左列表 / 右详情 ===== -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="420" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左：谱面集列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="谱面集" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" MinWidth="56"
                                    Command="{Binding RefreshLibraryCommand}"
                                    ToolTip="重新扫描 Mapset 文件夹" />
                            <Button Content="打开文件夹" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding OpenMapsetFolderCommand}"
                                    ToolTip="在资源管理器里打开 Mapset 根目录（可以直接往里放文件夹）" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" Style="{StaticResource FileListStyle}"
                             ItemsSource="{Binding Songs}"
                             SelectedItem="{Binding SelectedSong}"
                             Visibility="{Binding IsLibraryEmpty, Converter={StaticResource InverseBoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding TitleLine}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubtitleLine}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空状态 -->
                    <Border Grid.Row="1" Padding="24"
                            Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🗂" FontSize="42" HorizontalAlignment="Center" />
                            <TextBlock Text="还没有谱面集" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,12,0,0" HorizontalAlignment="Center" />
                            <TextBlock FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="把 osu! 谱面集的 .osz 文件直接拖进这个窗口（可以一次拖多个），或者点右上角「导入 .osz」。" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,8,16,12">
                        <Button Content="定位这首歌" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RevealSongCommand}"
                                ToolTip="在资源管理器里选中当前谱面集的文件夹" />
                        <Button Content="删除这首歌" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding DeleteSongCommand}"
                                ToolTip="只删这一个谱面集文件夹（删了就找不回来）" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 竖分隔条（可拖 / 双击复位 / 自动记住） -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="vsrg.选歌.列表与详情" />

            <!-- 右：详情 + 难度 + 开始 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="140" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 封面 -->
                    <Border Grid.Row="0" Height="180" Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="8,8,0,0" ClipToBounds="True" Margin="12,12,12,0">
                        <Grid>
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding CoverHint}" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="16,14,16,0">
                        <TextBlock Text="{Binding SelectedSongTitle}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasSelectedSong, Converter={StaticResource BoolToVis}}" />                        <TextBlock Text="{Binding SelectedSongSubtitle}" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding HasSelectedSong, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="难度" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,0"
                                   Visibility="{Binding HasSelectedSong, Converter={StaticResource BoolToVis}}" />

                        <ListBox Style="{StaticResource FileListStyle}" MaxHeight="220" Margin="0,6,0,0"
                                 ItemsSource="{Binding Difficulties}"
                                 SelectedItem="{Binding SelectedDifficulty}"
                                 Visibility="{Binding HasSelectedSong, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding DisplayLine}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailLine}" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="16,10,16,14">
                        <TextBlock Text="{Binding StartBlockReason}" FontSize="11.5" TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding StartBlockReason, Converter={StaticResource EmptyToVisInverse}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StartBlockIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Content="▶  开始游玩" Style="{StaticResource PrimaryButtonStyle}" Height="38"
                                FontSize="14" Command="{Binding StartPlayCommand}"
                                ToolTip="按设置决定是否立刻进入全屏" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

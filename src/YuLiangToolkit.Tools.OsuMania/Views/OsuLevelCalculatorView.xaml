<UserControl x:Class="YuLiangToolkit.Tools.OsuMania.Views.OsuLevelCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.OsuMania.Views"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <UserControl.Resources>
        <views:ScrollBarWidthConverter x:Key="ScrollBarWidth" />
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,26">

            <!-- ===== 标题 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="⭐ osu! 等级计算器" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="拖入 .osu 批量计算 mania 星数（Star Rating）与等级（Level）：只读谱面，不会修改或生成任何文件。" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Center" Padding="12,8">
                    <TextBlock Text="{Binding RowCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </Grid>

            <!-- ===== ① 谱面与结果表 ===== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="① 谱面与计算结果" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 拖放区（事件挂在 UserControl 根上） -->
                    <Border Margin="0,12,0,0" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                            Padding="16,13" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📂" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="把 .osu 文件或文件夹拖到这里" FontSize="13" />
                                    <TextBlock Text="文件夹会递归查找 .osu；重复文件自动去重，也可以点右侧按钮选择"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="选择文件…" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectFilesCommand}" />
                                <Button Content="清空表格" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding ClearRowsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== 结果表：表头写在 ListBox 模板里，与数据行同列容器 =====
                         左边距 33 = 行缩进（外边距10+边框1+内边距10+强调条3+内容9），右边距 21 = 行右边距+边框+内边距；
                         末尾占一列滚动条宽度。列宽必须与数据行一字不差。 -->
                    <ListBox x:Name="ResultList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                             Height="250" Margin="8,10,8,0" core:ScrollChaining.Enabled="True"
                             ToolTip="一行 = 一张谱面；加载失败的谱面会标红并在状态列写原因">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource FileListStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBox">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="33,0,21,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="{Binding Converter={StaticResource ScrollBarWidth}}" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Level" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="StarRating" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="2" Text="OD" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="3" Text="Key数" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="4" Text="Title" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="5" Text="Difficulty" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="6" Text="Artist" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="7" Text="Creator" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="8" Text="状态" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Grid>

                                                <ScrollViewer x:Name="ScrollViewer" Grid.Row="1" Focusable="False"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Padding="0" Background="Transparent">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent" CornerRadius="6" ToolTip="{Binding Tooltip}">
                                    <!-- ⚠ 列宽必须与上面表头一字不差 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding StarRatingText}" />
                                        <TextBlock Grid.Column="2" Text="{Binding OdText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding KeyCountText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding Difficulty}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="6" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="7" Text="{Binding Creator}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="Status" Grid.Column="8" Text="{Binding StatusText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#3A2222" />
                                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ===== ② 进度与日志 ===== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="② 进度与日志" FontSize="13" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="参数说明 ▾" Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Center" Command="{Binding ToggleHelpCommand}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                     Style="{StaticResource ProgressBarStyle}" Height="8" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="12,0,0,0" MinWidth="70"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>

                    <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" />

                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource LogTextBoxStyle}" Height="130" Margin="0,10,0,0"
                             core:ScrollChaining.Enabled="True" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="清空日志" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearLogCommand}" />
                    </StackPanel>

                    <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                            Visibility="{Binding IsHelpVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding HelpText}" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="19" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== ③ 操作 ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="打开谱面文件夹" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenFolderCommand}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" />
                    <Button Content="重新计算" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding RecalculateCommand}"
                            ToolTip="改过谱面 OD / 内容后点它重算全部行" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="说明：星数用 StarRating 算法（Star Rating Rebirth / srcalc 思路的 C# 重写，其中数学工具来自 ppy osu!lazer，MIT）计算，它不是 osu! 官方 mania 难度算法，与游戏内显示的 SR 可能有 1 星以上差异；等级是按这套 SR 拟合的旧公式换算。两者都只读谱面。只支持 osu!mania（Mode=3），非 mania / 损坏 / 键数不在 1~10 的文件会在状态列标红。" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

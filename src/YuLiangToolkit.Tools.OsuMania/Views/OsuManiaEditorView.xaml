<UserControl x:Class="YuLiangToolkit.Tools.OsuMania.Views.OsuManiaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.OsuMania.Views"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <!-- 「osu!mania 谱面编辑器」。布局约定见 docs/dev/layout.md：
         ① 顶部信息条（标题 / 统计 / 打开保存） | ② 播放条 | ③ 主编辑区（时间轴画布）
         ④ 右侧时间点面板 —— ③ ↔ ④ 之间有竖缝可拖；高度全部交给 * 行，不写死。 -->

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />                                  <!-- ① 标题 + 操作 -->
            <RowDefinition Height="Auto" />                                  <!-- ② 播放条 -->
            <RowDefinition Height="*" MinHeight="320" />                     <!-- ③ 编辑区 + ④ 时间点 -->
            <RowDefinition Height="Auto" />                                  <!-- ⑤ 状态条 -->
        </Grid.RowDefinitions>

        <!-- ===== ① 标题 / 统计 / 打开保存 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="🎼 osu!mania 谱面编辑器" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TitleText}" FontSize="13" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ChartSummary}" FontSize="11.5" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="打开谱面…" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenChartCommand}" />
                <Button Content="{Binding SaveButtonHint}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding SaveChartCommand}" ToolTip="写回原 .osu 文件（Ctrl+S）" />
                <Button Content="重新加载" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding ReloadChartCommand}" ToolTip="丢弃未保存改动，重新读盘" />
                <Button Content="所在文件夹" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding RevealInExplorerCommand}" />
            </StackPanel>
        </Grid>

        <!-- ===== ② 播放 / 编辑工具条 ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 播放控制 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayButton" Content="{Binding PlayPauseGlyph}" Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="42" FontSize="14" Command="{Binding PlayPauseCommand}"
                            ToolTip="播放 / 暂停（空格）" />
                    <Button Content="⏹" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" MinWidth="42"
                            Command="{Binding StopCommand}" ToolTip="停止并回到 0（Esc）" />
                    <Button Content="⏮" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" MinWidth="42"
                            Command="{Binding JumpToStartCommand}" ToolTip="回到开头" />
                    <Button Content="⏭" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" MinWidth="42"
                            Command="{Binding JumpToEndCommand}" ToolTip="跳到结尾" />

                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13"
                               Text="{Binding CurrentTimeText}" />
                    <TextBlock Margin="4,0" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}"
                               Text="/" />
                    <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DurationText}" />
                </StackPanel>

                <!-- 编辑工具 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <RadioButton Content="普通键" Style="{StaticResource RadioButtonStyle}"
                                 IsChecked="{Binding LongNoteTool, Converter={StaticResource InverseBoolConverter}}"
                                 ToolTip="左键点击放普通键（1）" />
                    <RadioButton Content="长条" Style="{StaticResource RadioButtonStyle}" Margin="14,0,0,0"
                                 IsChecked="{Binding LongNoteTool}"
                                 ToolTip="按住左键往下拖放长条（2）" />

                    <TextBlock Text="细分" VerticalAlignment="Center" Margin="22,0,6,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="DivisorBox" Style="{StaticResource ComboBoxStyle}" MinWidth="72"
                              ItemsSource="{Binding DivisorOptions}"
                              SelectedItem="{Binding GridDivisor}"
                              ToolTip="节拍细分：每拍几格（4 = 1/4 拍）" />

                    <CheckBox Content="吸附" Style="{StaticResource CheckBoxStyle}" Margin="14,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding SnapToGrid}" ToolTip="吸附到节拍网格（Q 切换）" />
                    <CheckBox Content="跟随" Style="{StaticResource CheckBoxStyle}" Margin="14,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding FollowPlayhead}" ToolTip="播放时自动滚动时间轴" />
                </StackPanel>

                <!-- 撤销 / 重做 / 删除 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="撤销" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" />
                    <Button Content="重做" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"
                            Command="{Binding RedoCommand}" ToolTip="Ctrl+Y" />
                    <Button Content="删除选中" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"
                            Command="{Binding DeleteSelectedCommand}" ToolTip="Delete" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ③ 编辑区 | ④ 时间点面板 ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="12" />                                <!-- 分隔条独占一列 -->
                <ColumnDefinition Width="320" MinWidth="240" />                <!-- 时间点面板：可拖 -->
            </Grid.ColumnDefinitions>

            <!-- ③ 时间轴画布（自绘；AudioStatus 叠在左上角） -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <views:ChartCanvas x:Name="Canvas"
                                       LaneBrush="{DynamicResource InputBackgroundBrush}"
                                       LaneLineBrush="{DynamicResource BorderBrush}"
                                       BarLineBrush="{DynamicResource BorderBrush}"
                                       BeatLineBrush="{DynamicResource SeparatorBrush}"
                                       GridLineBrush="{DynamicResource SeparatorBrush}"
                                       NoteBrush="{DynamicResource AccentBrush}"
                                       LongNoteBrush="{DynamicResource AccentHoverBrush}"
                                       SelectionBrush="{DynamicResource SuccessBrush}"
                                       PlayheadBrush="{DynamicResource DangerBrush}"
                                       RedLineBrush="{DynamicResource DangerBrush}"
                                       GreenLineBrush="{DynamicResource SuccessBrush}"
                                       RulerTextBrush="{DynamicResource FaintTextBrush}"
                                       RulerBackgroundBrush="{DynamicResource HeaderBackgroundBrush}" />
                    <!-- 左下角提示 / 音频状态（不挡鼠标） -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10"
                            Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="8,5"
                            IsHitTestVisible="False" Opacity="0.92">
                        <StackPanel>
                            <TextBlock Text="{Binding AudioStatus}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="320"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource FaintTextBrush}"
                                       Text="左键放键 · 长条工具按住下拖 · 右键删除 · 中键/滚动条滚时间轴 · 滚轮缩放" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 左右分隔条：拖动改编辑区 / 时间点面板的宽度（双击恢复这一处） -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="osu-mania-editor.编辑区与时间点" />

            <!-- ④ 时间点（红线 / 绿线）面板 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="90" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="时间点（红线 = BPM，绿线 = SV）" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="双击列表项可跳到该时间点；绿线 SV 只做数据，不影响播放" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ 红线" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddRedLineCommand}" ToolTip="在播放头处加一条红线（沿用当前 BPM）" />
                            <Button Content="+ 绿线" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding AddGreenLineCommand}" ToolTip="在播放头处加一条绿线（SV 1.0）" />
                            <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding DeleteTimingPointCommand}" />
                        </StackPanel>

                        <!-- 音频偏移：每条声卡 / 耳机的缓冲延迟不同，用耳朵对齐 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音频偏移" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding AudioOffsetMs, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="毫秒。正数 = 画面往后推（音符看着比音乐早时用）；负数则相反" />
                            <TextBlock Grid.Column="2" Text="ms" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource FaintTextBrush}" />
                        </Grid>

                        <!-- 自动保存：无操作 N 秒后静默写盘 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="自动保存" Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoSaveEnabled}" />
                            <TextBox Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding AutoSaveIdleSeconds, UpdateSourceTrigger=LostFocus}"
                                     IsEnabled="{Binding AutoSaveEnabled}"
                                     ToolTip="无操作多少秒后自动保存（2~600）。摆放 / 拖动 / 删除 note、滚时间轴、移动鼠标都算操作" />
                            <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource FaintTextBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding AutoSaveHintText}" FontSize="10.5" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource FaintTextBrush}" />
                    </StackPanel>

                    <ListBox x:Name="TimingList" Grid.Row="2" Margin="4,10,4,0"
                             ItemsSource="{Binding TimingPoints}"
                             SelectedItem="{Binding SelectedTimingPoint}"
                             MouseDoubleClick="OnTimingListDoubleClick"
                             core:ScrollChaining.Enabled="True">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource FileListStyle}" />
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- ⚠ 不要在这里用 emoji（🔴 / 🟢）：TextBlock 指定 FontFamily="Consolas" 时
                                     emoji 没有对应字形，整行会渲染成空白（截图里踩过）。
                                     用一个小色块 + 等宽文字区分红线 / 绿线。 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center"
                                            Margin="0,0,7,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRed}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 选中时间点的编辑区 -->
                    <Border Grid.Row="3" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                            Padding="10,8" Margin="0,10,0,0" IsEnabled="{Binding CanEditTimingPoint}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="时间(ms)" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding TimingTimeText, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Grid.Row="1" Text="BPM" VerticalAlignment="Center" Margin="0,6,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding IsSelectedTimingRed, Converter={StaticResource BoolToVis}}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,6,0,0" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding TimingBpmText, UpdateSourceTrigger=LostFocus}"
                                     Visibility="{Binding IsSelectedTimingRed, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Grid.Row="2" Text="SV" VerticalAlignment="Center" Margin="0,6,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding IsSelectedTimingRed, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="8,6,0,0" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding TimingSvText, UpdateSourceTrigger=LostFocus}"
                                     Visibility="{Binding IsSelectedTimingRed, Converter={StaticResource InverseBoolToVis}}" />

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="改完按回车 / 点「应用」写回" FontSize="10"
                                       Margin="0,6,0,0" Foreground="{DynamicResource FaintTextBrush}" />
                        </Grid>
                    </Border>

                    <Button Grid.Row="4" Content="应用改动" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"
                            Command="{Binding ApplyTimingPointCommand}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===== ⑤ 状态条 ===== -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusDetail}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource FaintTextBrush}" />
        </Grid>
    </Grid>
</UserControl>

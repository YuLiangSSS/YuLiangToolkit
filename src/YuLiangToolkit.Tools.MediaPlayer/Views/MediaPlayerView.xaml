<UserControl x:Class="YuLiangToolkit.Tools.MediaPlayer.Views.MediaPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             AllowDrop="True">

    <!-- 「视频 / 音乐播放器」的界面。样式全部来自 App.xaml（见 AGENTS.md）；
         只有播放控制按钮是这里自定义的（圆形无边框），因为全局按钮样式是「带边框的方块」。
         布局照参考图：中间播放区 + 进度条 + 一排控制按钮，右边是播放列表；
         「设置」是同一个页面里的覆盖面板（盖住整列，不弹子窗口，见 docs/dev/pitfalls.md 的说明）。

         ⚠ 播放控制按钮里不要用 ⏪ ⏩ ⏹ 🔁 这类字符：本机字体没有这些码位，
         会退化成「带方框的豆腐块」（截图核对时才发现）。这里一律用矢量 Path，
         齿轮用 Segoe MDL2 Assets（跟标题栏的窗口按钮同一个字体，一定有）。 -->

    <UserControl.Resources>

        <!-- 播放区那一列的边距：平时四周留白，全屏时清零（画面直接顶到屏幕边上）。
             右边距是 0：中间那条 12 宽的分隔条列已经隔开了两块，蓝线正好落在播放区 / 播放列表的中间
             （再留 14 右边距的话缝会变成 26，蓝线会贴着播放列表的边框，像多了一条线）。
             全屏时还要跨掉「分隔条 + 播放列表」两列：播放列表全屏时收起（见 ShowPlaylist），
             跨过去画面才能真正铺满整页 —— 不然右边会空出一条固定宽度的缝。 -->
        <Style x:Key="PlayerSurfaceStyle" TargetType="Grid">
            <Setter Property="Margin" Value="18,16,0,14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 画面那一块：全屏时铺满整屏（跨掉控制条那一行）、去掉圆角与边框 -->
        <Style x:Key="VideoSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="#0C0F14" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 全屏时压住画面底部的渐变（上透下黑，控制条看着像"浮"在视频上） -->
        <LinearGradientBrush x:Key="FullscreenBarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#B8000000" Offset="0.42" />
            <GradientStop Color="#E6000000" Offset="1" />
        </LinearGradientBrush>

        <!-- 控制条：平时是画面下面的一排；全屏时**浮在画面底部**（鼠标一动才浮出来，见 ControlsVisible） -->
        <Style x:Key="ControlBarStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0" />
            <!-- ⚠ 默认行号必须写在 Style 里：如果写在控件的 XAML 上（Grid.Row="1"），本地值的优先级高于
                 Style 触发器，下面全屏时的 Grid.Row=0 会**静默失效**（v0.9.5 查出来的老坑）。 -->
            <Setter Property="Grid.Row" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                    <Setter Property="Background" Value="{StaticResource FullscreenBarBrush}" />
                    <Setter Property="Padding" Value="24,30,24,14" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 播放控制按钮：圆形、无边框、悬停才亮 -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="99" Background="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 播放 / 暂停：强调色实心、大一圈 -->
        <Style x:Key="TransportPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="99" Background="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置页里的小标题 / 行标签 -->
        <Style x:Key="SettingsSectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- 布局（v0.41.0 起可拖拽）：整页左右两块「播放区 | 播放列表」，
         两块之间是一条 core:PaneSplitter 独占的列（12 宽）——拖动改宽度（蓝线 + ↔ 光标），
         松手自动记住（Config\layout.json），双击恢复这一处；
         全部恢复默认：主页设置 →「界面布局 → 恢复默认布局」。约定见 docs/dev/layout.md。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />      <!-- 播放区：随窗口缩放 -->
            <ColumnDefinition Width="12" />                    <!-- 分隔条独占一列 -->
            <ColumnDefinition Width="338" MinWidth="240" />    <!-- 播放列表：固定宽度、可拖（338 = 卡片 320 + 右侧 18 边距） -->
        </Grid.ColumnDefinitions>

        <!-- ==================== 左：播放区（设置面板会盖住整列） ==================== -->
        <Grid x:Name="PlayerColumn" Grid.Column="0" Style="{StaticResource PlayerSurfaceStyle}">

            <Grid x:Name="PlayerInnerGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 视频 / 音频封面（全屏时铺满整屏，见 VideoSurfaceStyle） -->
                <Border x:Name="VideoSurface" Grid.Row="0" Style="{StaticResource VideoSurfaceStyle}" ClipToBounds="True">
                    <Grid>
                        <MediaElement x:Name="Media" Stretch="Uniform"
                                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      ScrubbingEnabled="True" Volume="0.8" />

                        <!-- 音频：盖一层「专辑封面」占位（视频时不显示） -->
                        <Border x:Name="CoverOverlay" Background="#12161D"
                                Visibility="{Binding CoverVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="24">
                                <TextBlock Text="{Binding CoverGlyph}" FontSize="58" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding TitleText}" FontSize="18" FontWeight="SemiBold"
                                           Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SubtitleText}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,8,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 视频时左上角压一条标题（不然看不出在放哪个文件） -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#A6000000"
                                CornerRadius="12,0,12,0" Padding="14,8"
                                Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TitleText}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            </StackPanel>
                        </Border>

                        <!-- 鼠标感应层：画面本身没有控件，靠它保证「动鼠标 → 浮出控制条」一定收得到事件 -->
                        <Border Background="Transparent" />

                        <!-- 全屏按钮：压在画面右下角（跟常见播放器一个位置，也不跟下面那排控制按钮抢宽度）。
                             全屏时这个按钮藏起来、改用控制条右边的那个（见 ShowCornerFullscreenButton）。 -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"
                                Width="38" Height="38" Style="{StaticResource TransportButtonStyle}"
                                Background="#66000000"
                                FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                                Content="{Binding FullscreenGlyph}" Command="{Binding ToggleFullscreenCommand}"
                                ToolTip="{Binding FullscreenTooltip}"
                                Visibility="{Binding ShowCornerFullscreenButton, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- ===== 控制条：进度 + 按钮 + 状态。全屏时它浮在画面底部、鼠标一动才出现 ===== -->
                <Border x:Name="ControlBar" Style="{StaticResource ControlBarStyle}"
                        Visibility="{Binding ControlsVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 全屏时在进度条上方显示正在放什么（普通模式下面板里已经有标题了） -->
                    <TextBlock Grid.Row="0" Text="{Binding TitleText}" FontSize="13" FontWeight="SemiBold"
                               Margin="6,0,6,2" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVis}}" />

                <!-- 进度条（点 / 拖可以跳转，见代码后置的 OnSeek*） -->
                <Grid Grid.Row="1" Margin="6,14,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding PositionText}" MinWidth="48" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Grid x:Name="SeekArea" Grid.Column="1" Height="20" Margin="10,0" Background="Transparent"
                          Cursor="Hand" ToolTip="点一下或按住拖动，跳到任意位置"
                          MouseLeftButtonDown="OnSeekMouseDown" MouseMove="OnSeekMouseMove"
                          MouseLeftButtonUp="OnSeekMouseUp" MouseLeave="OnSeekMouseLeave">
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressRatio, Mode=OneWay}"
                                     Style="{StaticResource ProgressBarStyle}" Height="6"
                                     VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" MinWidth="48" TextAlignment="Right"
                               FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>

                <!-- 控制按钮：设置 ｜ 快退 · **播放/暂停（正中）** · 快进 · 停止 ｜ 播放顺序 · 音量 · 退出全屏
                     ⚠ 大播放键必须独自占中间那个 Auto 列、左右两列都是 *，它的中心才等于整条控制条的中心。
                     以前把「快退 + 播放 + 快进 + 停止」当成一组居中，组的中心在中间、播放键本身偏左（v0.9.6 修）。 -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左列：设置贴最左，快退贴住播放键 -->
                    <Grid Grid.Column="0">
                        <!-- 设置：Segoe MDL2 Assets 的齿轮（E713）/ 返回箭头（E72B） -->
                        <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                                Style="{StaticResource TransportButtonStyle}"
                                Content="{Binding SettingsGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip="设置（在同一个页面里打开，不弹子窗口）" />

                        <!-- 快退：左键退一步，右键上一首（右键在代码后置里接，Button.Click 只认左键） -->
                        <Button x:Name="BackButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,3,0" Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding SeekBackwardCommand}" ToolTip="{Binding SeekBackwardTooltip}">
                            <Path Data="M 7,0 L 0,6.5 L 7,13 Z M 14,0 L 7,6.5 L 14,13 Z"
                                  Fill="{DynamicResource TextPrimaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- 正中：播放 / 暂停（左右两列都是 *，所以它的中心 = 控制条中心） -->
                    <Button x:Name="PlayPauseButton" Grid.Column="1"
                            Style="{StaticResource TransportPrimaryButtonStyle}"
                            Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayTooltip}">
                        <Grid Width="14" Height="14">
                            <Path Data="M 1,0 L 14,7 L 1,14 Z" Fill="White"
                                  Visibility="{Binding ShowPlayIcon, Converter={StaticResource BoolToVis}}" />
                            <Path Data="M 1,0 H 5 V 14 H 1 Z M 9,0 H 13 V 14 H 9 Z" Fill="White"
                                  Visibility="{Binding ShowPauseIcon, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>

                    <!-- 右列：快进 + 停止贴住播放键；播放顺序 / 音量 / 退出全屏贴最右 -->
                    <Grid Grid.Column="2">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                            <!-- 快进：左键快进一步，右键下一首 -->
                            <Button x:Name="ForwardButton" Margin="3,0,3,0"
                                    Style="{StaticResource TransportButtonStyle}"
                                    Command="{Binding SeekForwardCommand}" ToolTip="{Binding SeekForwardTooltip}">
                                <Path Data="M 0,0 L 7,6.5 L 0,13 Z M 7,0 L 14,6.5 L 7,13 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}" />
                            </Button>

                            <!-- 停止：位置回到开头 -->
                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Command="{Binding StopCommand}" ToolTip="停止（位置回到开头）">
                                <Path Data="M 0.5,0.5 H 12.5 V 12.5 H 0.5 Z" Fill="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 播放顺序：点一下轮换（列表循环 → 单曲循环 → 随机播放） -->
                            <Button Width="46" Height="34" Style="{StaticResource TransportButtonStyle}" Margin="0"
                                    Content="{Binding ModeShortText}" FontSize="11.5" FontWeight="SemiBold"
                                    Command="{Binding CyclePlayModeCommand}"
                                    ToolTip="{Binding PlayModeTooltip}" />
                            <TextBlock Text="音量" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,6,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Slider Width="92" Minimum="0" Maximum="100" Value="{Binding VolumeValue}"
                                    Style="{StaticResource SliderStyle}" VerticalAlignment="Center" ToolTip="音量" />

                            <!-- 退出全屏：全屏时控制条右边这个才是按钮（画面右下角那个圆钮在全屏时藏起来了） -->
                            <Button Width="44" Height="34" Style="{StaticResource TransportButtonStyle}" Margin="10,0,0,0"
                                    FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Content="{Binding FullscreenGlyph}" Command="{Binding ToggleFullscreenCommand}"
                                    ToolTip="{Binding FullscreenTooltip}"
                                    Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 状态栏（每个功能自己一句“正在干什么”，主窗口底部那条是外壳的） -->
                <TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="6,12,6,0" FontSize="11"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                </Border>
            </Grid>

            <!-- ===== 设置面板：盖住左边整列（不弹子窗口） =====
                 为什么不做子窗口：WPF 的子窗口要自己管生命周期（关工具时还得负责关掉它），
                 而这一屏内容一页就放得下 —— 盖一层反而最简单、也不会丢焦点。 -->
            <Border Background="#FF151820" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              core:ScrollChaining.Enabled="True">
                    <StackPanel Margin="26,18,26,18" MaxWidth="660" HorizontalAlignment="Left">

                        <TextBlock Text="播放器设置" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SettingsPathText}" FontSize="10.5" Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="改一下就自动保存（不用点保存按钮）；关掉工具 / 退出程序时还会强制落盘一次。"
                                   FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- ===== 读取 ===== -->
                        <TextBlock Text="打开文件夹时" Style="{StaticResource SettingsSectionStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="读取哪些文件" Style="{StaticResource SettingsLabelStyle}" />
                            <ComboBox Grid.Column="1" Height="32" HorizontalAlignment="Left" MinWidth="230"
                                      ItemsSource="{Binding IncludeModeOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedIncludeMode}"
                                      Style="{StaticResource ComboBoxStyle}" />
                        </Grid>
                        <TextBlock Text="{Binding IncludeModeHint}" FontSize="10.5" Margin="132,7,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                        <CheckBox Content="连子文件夹一起读取（递归）" Margin="132,14,0,0"
                                  IsChecked="{Binding ScanRecursive}"
                                  Style="{StaticResource CheckBoxStyle}"
                                  ToolTip="打开：整个目录树都扫；关掉：只看这一层" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="再开一个文件夹" Style="{StaticResource SettingsLabelStyle}" />
                            <ComboBox Grid.Column="1" Height="32" HorizontalAlignment="Left" MinWidth="230"
                                      ItemsSource="{Binding AppendModeOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedAppendMode}"
                                      Style="{StaticResource ComboBoxStyle}" />
                        </Grid>
                        <TextBlock Text="「打开文件」按钮和拖进来的文件一律追加（那个设置只管文件夹）。"
                                   FontSize="10.5" Margin="132,7,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- ===== 播放 ===== -->
                        <TextBlock Text="播放" Style="{StaticResource SettingsSectionStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快进 / 快退步长" Style="{StaticResource SettingsLabelStyle}" />
                            <Slider Grid.Column="1" Minimum="0.1" Maximum="60" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="1"
                                    Value="{Binding SeekStepSeconds}"
                                    Style="{StaticResource SliderStyle}"
                                    VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Width="66" Margin="10,0,0,0" Height="32"
                                     Text="{Binding SeekStepSeconds, StringFormat={}{0:0.0}, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource TextBoxStyle}" ToolTip="也可以直接输数字，精确到 0.1 秒" />
                        </Grid>
                        <TextBlock Text="0.1 ~ 60 秒，精确到 0.1 秒。快退 / 快进按钮：左键跳这个秒数，右键换上一首 / 下一首。"
                                   FontSize="10.5" Margin="132,7,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="播放顺序" Style="{StaticResource SettingsLabelStyle}" />
                            <ComboBox Grid.Column="1" Height="32" HorizontalAlignment="Left" MinWidth="230"
                                      ItemsSource="{Binding PlayModeOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedPlayMode}"
                                      Style="{StaticResource ComboBoxStyle}"
                                      ToolTip="播放条右边那个「循环 / 单曲 / 随机」按钮点的也是它" />
                        </Grid>

                        <!-- 时间显示：左边那个时间正向数 / 倒着数（右边始终是总时长） -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="时间显示" Style="{StaticResource SettingsLabelStyle}" />
                            <ComboBox Grid.Column="1" Height="32" HorizontalAlignment="Left" MinWidth="230"
                                      ItemsSource="{Binding TimeDisplayOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedTimeDisplay}"
                                      Style="{StaticResource ComboBoxStyle}"
                                      ToolTip="左边那个时间：正向数到结尾，或者倒着数还剩多少（右边始终是总时长）" />
                        </Grid>
                        <TextBlock Text="左边的时间：默认从 0:00 数到总时长；选「剩余时间」就从总时长倒着数到 0:00（还差多少播完）。右边始终显示总时长。"
                                   FontSize="10.5" Margin="132,7,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量" Style="{StaticResource SettingsLabelStyle}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding VolumeValue}" Style="{StaticResource SliderStyle}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" MinWidth="46" Margin="10,0,0,0"
                                       FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <!-- ===== 后台 ===== -->
                        <TextBlock Text="切到别的工具时" Style="{StaticResource SettingsSectionStyle}" />
                        <CheckBox Content="后台播放（界面切走也继续出声）" Margin="132,0,0,0"
                                  IsChecked="{Binding BackgroundPlayback}"
                                  Style="{StaticResource CheckBoxStyle}"
                                  ToolTip="打开后：切到别的工具 / 回主页时声音不断，左下角会出现一个迷你播放条" />
                        <TextBlock Text="打开时左下角会浮出一个小窗：滚动显示标题，带快退 / 播放暂停 / 快进，点标题回到播放器；右上角 × 直接关掉小窗并停止播放。"
                                   FontSize="10.5" Margin="132,7,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- ===== 下次打开 ===== -->
                        <TextBlock Text="下次打开这个工具时" Style="{StaticResource SettingsSectionStyle}" />
                        <CheckBox Content="恢复上次的播放列表" Margin="132,0,0,0"
                                  IsChecked="{Binding RestorePlaylist}"
                                  Style="{StaticResource CheckBoxStyle}" />
                        <CheckBox Content="恢复上次听到的位置（只选中，不自动出声）" Margin="132,12,0,0"
                                  IsChecked="{Binding ResumeLastPlayed}"
                                  Style="{StaticResource CheckBoxStyle}" />
                        <TextBlock Text="{Binding LastFolderText}" FontSize="10.5" Margin="132,7,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- ===== 底部按钮 ===== -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="恢复默认设置" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ResetSettingsCommand}" />
                            <Button Content="打开配置文件夹" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenConfigFolderCommand}" />
                            <Button Content="打开数据文件夹" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="返回播放" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ToggleSettingsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 左右分隔条：拖动改「播放区」与「播放列表」的宽度（双击恢复这一处；
             全屏时播放列表收起，这条缝跟着一起藏起来，画面靠 PlayerSurfaceStyle 的 ColumnSpan 铺满） -->
        <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                           Key="media-player.播放区与播放列表"
                           Visibility="{Binding ShowPlaylist, Converter={StaticResource BoolToVis}}" />

        <!-- ==================== 右：播放列表（全屏时收起，见 ShowPlaylist） ==================== -->
        <Border Grid.Column="2" Margin="0,16,18,14" Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                ClipToBounds="True"
                Visibility="{Binding ShowPlaylist, Converter={StaticResource BoolToVis}}">
            <Grid Margin="12,14,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 + 统计 -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="播放列表" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PlaylistSummary}" FontSize="10.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- 打开 / 移除 / 清空。用 WrapPanel：播放列表被拖窄时按钮自动折到第二行，不会被裁掉 -->
                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button Content="📂 文件夹" Margin="0,0,6,6" FontSize="11" Padding="9,5"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenFolderCommand}"
                            ToolTip="打开一个或多个文件夹（按设置里的读取方式过滤，可递归）" />
                    <Button Content="🎵 文件" Margin="0,0,6,6" FontSize="11" Padding="9,5"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenFilesCommand}"
                            ToolTip="手动挑几个媒体文件（也可以直接把文件拖进窗口）" />
                    <Button Content="✕ 移除" Margin="0,0,6,6" FontSize="11" Padding="9,5"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RemoveSelectedCommand}"
                            ToolTip="从列表里拿掉选中的那一行（不删磁盘文件）" />
                    <Button Content="清空" Margin="0,0,0,6" FontSize="11" Padding="9,5"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearPlaylistCommand}"
                            ToolTip="清空整个列表（不删磁盘文件）" />
                </WrapPanel>

                <!-- 列表本体 + 空状态 -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="PlaylistBox" ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Style="{StaticResource FileListStyle}"
                             core:ScrollChaining.Enabled="True"
                             MouseDoubleClick="OnPlaylistDoubleClick"
                             ToolTip="单击选中，双击播放">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 行号；正在播的那行换成 ▶ -->
                                    <TextBlock x:Name="NumberText" Text="{Binding Number}" FontSize="10.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="PlayingMark" Text="▶" FontSize="9.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />

                                    <TextBlock Grid.Column="1" Text="{Binding KindGlyph}" FontSize="10.5"
                                               Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Tooltip}" />
                                    <TextBlock Grid.Column="3" Text="{Binding KindText}" FontSize="10"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="PlayingMark" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空列表提示（有内容时藏起来） -->
                    <TextBlock Text="列表是空的&#10;点上面的「文件夹」或「文件」加进来，&#10;也可以把文件 / 文件夹直接拖进这个窗口"
                               Visibility="{Binding IsPlaylistEmpty, Converter={StaticResource BoolToVis}}"
                               FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <!-- 选中行的说明 / 快捷键提示 -->
                <StackPanel Grid.Row="3" Margin="4,10,4,0">
                    <TextBlock Text="{Binding SelectedItemText}" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="快捷键：空格 播放/暂停 · ←/→ 快退/快进 · Delete 从列表移除" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

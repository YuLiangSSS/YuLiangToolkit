<UserControl x:Class="YuLiangToolkit.Tools.WordViewer.Views.WordViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent"
             Focusable="True"
             AllowDrop="True"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewMouseWheel="OnPreviewMouseWheel"
             DragOver="OnDragOver"
             Drop="OnDrop">

    <!-- Word 阅读器界面：顶部工具条（打开 / 最近 / 大纲 / 缩放 / 查找）→ 错误提示 → 主区域（大纲栏 + 可拖分隔条 + 阅读区）→ 状态栏。
         整页是满屏 Grid（外壳用 ContentControl 承载并缓存视图），**不套整页 ScrollViewer**；
         大纲栏与阅读区之间用 core:PaneSplitter（可拖、会记住、双击复位，见 docs/dev/layout.md），
         大纲关掉时列宽 / 分隔条一起收起（BoolToPaneLength + BoolToVis）。
         ⚠ 阅读区里的白纸 / 正文颜色属于「文档纸张」的渲染，可以写死白色与近黑字；
         工具条 / 大纲栏 / 状态栏一律用主题 token（DynamicResource）。 -->

    <UserControl.Resources>
        <!-- 大纲里的一行：像列表项，悬停高亮 -->
        <Style x:Key="OutlineItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具条里的小按钮（缩放 +/- / 查找上一个下一个）：比 SecondaryButtonStyle 窄一点 -->
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="30" />
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 工具条 -->
            <RowDefinition Height="Auto" />   <!-- 错误提示（空时收起） -->
            <RowDefinition Height="*" />      <!-- 主区域：大纲 / 阅读区 -->
            <RowDefinition Height="Auto" />   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ================= 工具条 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel>
                <!-- 第一行：打开 / 最近 / 文档信息 / 大纲开关 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Content="📘 打开 Word 文档…" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenCommand}" VerticalAlignment="Center"
                            ToolTip="打开 .docx / .docm 文件（只读浏览；Ctrl+O）" />

                    <!-- 最近打开：下拉里点一条直接重新打开；右边「清空」只删记录、不删文件 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🕘 最近" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="RecentCombo" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding RecentItems}" SelectedItem="{Binding SelectedRecent}"
                                  MinWidth="180" MaxWidth="240" VerticalAlignment="Center"
                                  ToolTip="最近打开的文档（新的在上；文件已不存在的会标灰）">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding RecentSummary}" FontSize="10.5" Margin="8,0,4,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="清空" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding ClearRecentCommand}" ToolTip="清空最近打开记录（不会删除本地文件）" />
                    </StackPanel>

                    <!-- 当前文档标题 / 路径 -->
                    <StackPanel Grid.Column="2" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DocumentTitle}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FilePathText}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePathText}" />
                    </StackPanel>

                    <CheckBox Grid.Column="3" Content="显示大纲" IsChecked="{Binding ShowOutline}"
                              Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center"
                              ToolTip="显示 / 隐藏左侧大纲栏（会记住）" />
                </Grid>

                <!-- 第二行：缩放 / 查找 -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="缩放" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="−" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding ZoomOutCommand}" ToolTip="缩小 10%（Ctrl+滚轮也行）" />
                        <TextBox x:Name="ZoomBox" Width="66" Margin="6,0" TextAlignment="Center"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding ZoomText}"
                                 PreviewKeyDown="OnZoomBoxPreviewKeyDown"
                                 ToolTip="输入 50 ~ 300 的百分比，按回车生效" />
                        <Button Content="+" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding ZoomInCommand}" ToolTip="放大 10%（Ctrl+滚轮也行）" />
                        <Button Content="100%" Style="{StaticResource CompactButtonStyle}" Margin="6,0,0,0"
                                Command="{Binding ZoomResetCommand}" ToolTip="恢复 100%" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="查找" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Grid Width="200">
                            <TextBox x:Name="SearchBox" Height="28" Padding="8,0" VerticalContentAlignment="Center"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                                     ToolTip="在正文里查找（Ctrl+F；回车 = 下一个，Shift+回车 = 上一个，Esc = 清除）" />
                            <TextBlock Text="查找正文 (Ctrl+F)" Margin="10,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                        <TextBlock Text="{Binding SearchStatus}" MinWidth="72" FontSize="10.5" Margin="8,0,4,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="↑" Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding SearchPrevCommand}" ToolTip="上一个命中（Shift+回车）" />
                        <Button Content="↓" Style="{StaticResource CompactButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding SearchNextCommand}" ToolTip="下一个命中（回车）" />
                        <Button Content="✕" Style="{StaticResource CompactButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding ClearSearchCommand}" ToolTip="清除查找（Esc）" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= 错误提示（有错误才出现；不弹 MessageBox） ================= -->
        <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource DangerBrush}" BorderThickness="0,0,0,1" Padding="14,8"
                Visibility="{Binding ErrorText, Converter={StaticResource EmptyToVisInverse}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="{DynamicResource DangerBrush}" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ================= 主区域 ================= -->
        <Grid Grid.Row="2" Margin="12,10,12,8" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <!-- 大纲栏：宽度跟着「显示大纲」开关收起（拖动改宽度，记忆在 Config\layout.json） -->
                <ColumnDefinition
                    Width="{Binding ShowOutline, Converter={StaticResource BoolToPaneLength}, ConverterParameter=280}"
                    MinWidth="{Binding ShowOutline, Converter={StaticResource BoolToPaneLength}, ConverterParameter=200}" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 大纲栏 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"
                    Visibility="{Binding ShowOutline, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="14,12,12,8">
                        <TextBlock Text="📑 大纲" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OutlineSummary}" FontSize="10.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="6,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <ItemsControl ItemsSource="{Binding Outline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource OutlineItemStyle}"
                                            Padding="{Binding IndentPadding}"
                                            ToolTip="{Binding LevelText}"
                                            Click="OnOutlineItemClick">
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Text="点标题跳到正文对应位置" FontSize="10.5" Margin="14,8,14,10"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 大纲栏 / 阅读区 分隔条（大纲关掉时一起收起） -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="word-viewer.大纲与阅读区"
                               Visibility="{Binding ShowOutline, Converter={StaticResource BoolToVis}}" />

            <!-- 阅读区 -->
            <Grid Grid.Column="2">
                <!-- 白色纸面：圆角 + 投影 + 裁切。文档纸面颜色不跟深色主题走 -->
                <Border Margin="0,0,14,10" Background="White" CornerRadius="6" ClipToBounds="True"
                        Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.35" Color="#000000" />
                    </Border.Effect>
                    <FlowDocumentScrollViewer x:Name="DocumentViewer"
                                              Document="{Binding FlowDocument}"
                                              Zoom="{Binding ZoomScale, Mode=OneWay}"
                                              IsToolBarVisible="False"
                                              Background="Transparent"
                                              Padding="0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto" />
                </Border>

                <!-- 空状态：没打开文件时显示拖入提示 -->
                <Border Style="{StaticResource CardStyle}" Padding="28" Margin="6,6,20,16"
                        Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="📘" FontSize="42" HorizontalAlignment="Center" />
                        <TextBlock Text="把 .docx / .docm 拖到这里" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="或者点左上角「📘 打开 Word 文档…」。只读浏览，不会改动原文件。"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="支持：段落样式 · 标题大纲 · 表格 · 图片 · 缩放 · 查找"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- 解析中：居中提示（不挡鼠标，避免用户重复点打开） -->
                <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        IsHitTestVisible="False" Background="Transparent" Margin="0,0,14,10">
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="18,12"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar IsIndeterminate="True" Width="130" Height="4"
                                         Style="{StaticResource ProgressBarStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressText}" Margin="12,0,0,0" FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="3" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold"
                               MaxWidth="280" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePathText}" />
                    <TextBlock Text="{Binding FileSizeText}" FontSize="11.5" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding DocumentSummary}" FontSize="11.5" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="70" Height="4" IsIndeterminate="True" Margin="0,0,10,0"
                                 Style="{StaticResource ProgressBarStyle}" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ZoomText}" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

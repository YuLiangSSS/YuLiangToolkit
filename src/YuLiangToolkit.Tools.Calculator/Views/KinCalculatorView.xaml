<UserControl x:Class="YuLiangToolkit.Tools.Calculator.Views.KinCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <!-- 辈分计算模式（calculator 工具的第二个模式，由 CalculatorView 切换显示）。
         布局约定见 docs/dev/layout.md：
           · 左「① 结果 + ② 关系链」上下两块，中间一条横分隔条（Key=calculator.辈分结果与关系）；
           · 右「③ 称谓对照表 + 说明」上下两块，中间一条横分隔条（Key=calculator.辈分对照表与说明）；
           · 左区与右区之间一条竖分隔条（Key=calculator.辈分左右）。
         颜色全部 {DynamicResource}，按钮样式全部来自 App.xaml。 -->

    <UserControl.Resources>
        <!-- 关系按钮模板：点一下往关系链里走一级（Label / Step 由 KinStepButton 提供） -->
        <DataTemplate x:Key="KinStepButtonTemplate">
            <Button Content="{Binding Label}"
                    Command="{Binding DataContext.StepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Step}"
                    ToolTip="{Binding ToolTipText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Margin" Value="3" />
                        <Setter Property="Padding" Value="4,6" />
                        <Setter Property="FontSize" Value="13.5" />
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="430" MinWidth="320" />
        </Grid.ColumnDefinitions>

            <!-- ===================== 左：结果（上） + 关系链（下） ===================== -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="296" MinHeight="240" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="352" MinHeight="270" />
                </Grid.RowDefinitions>

                <!-- ===== ① 结果卡 ===== -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="40" />
                        </Grid.RowDefinitions>

                        <!-- 上排：辈分徽章 / 支系 / 反向称谓 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"
                                    Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Result.GenerationText}" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"
                                    Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Result.BranchText}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding RegionText}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <!-- 叫法主标题 -->
                        <TextBlock Grid.Row="1" Text="{Binding Result.Title}" FontSize="40" FontWeight="SemiBold"
                                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- 副标题：书面称谓 / 南北另一边的叫法 -->
                        <TextBlock Grid.Row="2" Text="{Binding Result.Subtitle}" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- 白话解释 + 反向称谓 -->
                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Result.Note}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                    Padding="12,10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                        <Run Text="他 / 她该叫你：" />
                                        <Run Text="{Binding Result.ReverseTitle, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{DynamicResource AccentBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Result.ReversePathText, StringFormat=（从对方看：{0}）}"
                                               FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 上下分隔条：拖「结果」与「关系链」的高度 -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="calculator.辈分结果与关系" />

                <!-- ===== ② 关系链 ===== -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="② 关系链：从你开始，一级一级点下去" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StepCount, StringFormat=共 {0} 步}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <!-- 当前关系链 + 退一级 / 重来 -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="12,9">
                                <TextBlock Text="{Binding PathText}" FontSize="13" TextWrapping="Wrap"
                                           MaxHeight="60" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Content="退一级" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding UndoCommand}" ToolTip="去掉最后一步" />
                                <Button Content="重来" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding ResetCommand}" ToolTip="回到「我」" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding StatusText, Converter={StaticResource EmptyToVisInverse}}" />

                        <!-- 十个关系按钮（5 列 × 2 行） -->
                        <ItemsControl Grid.Row="3" Margin="0,10,0,0" ItemsSource="{Binding StepButtons}"
                                      ItemTemplate="{StaticResource KinStepButtonTemplate}" VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <Border Grid.Row="4" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                Padding="12,10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="小提示" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PeerHint}" FontSize="11" Margin="0,5,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ScopeHint}" FontSize="11" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 左右分隔条：拖左区与右区的宽度 -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="calculator.辈分左右" />

            <!-- ===================== 右：对照表（上） + 说明（下） ===================== -->
            <Grid Grid.Column="2" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="300" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="228" MinHeight="190" />
                </Grid.RowDefinitions>

                <!-- ===== ③ 称谓对照表 ===== -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,14,18,0">
                            <TextBlock Text="③ 称谓对照表" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="点一行就把它的关系装到左边" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="18,10,18,8">
                            <TextBox Style="{StaticResource TextBoxStyle}" Height="30"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     SpellCheck.IsEnabled="False" ToolTip="按叫法 / 书面称谓 / 关系名搜索" />
                            <TextBlock Text="搜叫法或关系（例如 姨、姑姑、爸爸的）" FontSize="11.5"
                                       Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource FaintTextBrush}"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="8,0,8,0">
                            <ListBox x:Name="TermList" ItemsSource="{Binding Terms}"
                                     Style="{StaticResource FileListStyle}"
                                     core:ScrollChaining.Enabled="True"
                                     SelectionChanged="OnTermSelectionChanged"
                                     ToolTip="{Binding ToolTipText}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding ToolTipText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PathText}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding North}" FontSize="12"
                                                       Margin="10,0,0,0" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding South}" FontSize="12"
                                                       Margin="10,0,0,0" MinWidth="66"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="没有匹配的称谓，换个关键词试试。"
                                       Visibility="{Binding HasTerms, Converter={StaticResource InverseBoolToVis}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="240" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <TextBlock Grid.Row="3" Text="{Binding TermsCountText}" Margin="18,8,18,12"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- 上下分隔条：拖「对照表」与「说明」的高度 -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="calculator.辈分对照表与说明" />

                <!-- ===== 说明与设置 ===== -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="18,16,18,18">
                            <TextBlock Text="说明（改一下自动保存）" FontSize="13" FontWeight="SemiBold" />

                            <TextBlock Text="叫法地区" FontSize="11.5" Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton Content="北方叫法" GroupName="kin-region" Style="{StaticResource RadioButtonStyle}"
                                             IsChecked="{Binding IsNorthRegion, Mode=TwoWay}" />
                                <RadioButton Content="南方叫法" GroupName="kin-region" Style="{StaticResource RadioButtonStyle}"
                                             Margin="20,0,0,0" IsChecked="{Binding IsSouthRegion, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Text="我是" FontSize="11.5" Margin="0,14,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding Cfg.KinGender}"
                                      Style="{StaticResource ComboBoxStyle}" Margin="0,5,0,0" Width="120"
                                      HorizontalAlignment="Left"
                                      ToolTip="只影响「对方该叫我什么」（弟弟 / 妹妹、侄子 / 侄女…）" />

                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                    Padding="12,10" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="小提示" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="· 关系链可以一直点下去（妈妈的妈妈的哥哥的女儿…），每一级都会实时算出叫什么。" />
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="· 南北叫法只改称呼文字：北方「姥爷 / 姥姥 / 大伯 / 大娘 / 弟妹」，南方「外公 / 外婆 / 伯伯 / 伯母 / 弟媳」。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
</UserControl>

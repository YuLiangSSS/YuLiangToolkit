<UserControl x:Class="YuLiangToolkit.Tools.Calculator.Views.DateCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <!-- 日期计算模式（calculator 工具的第三个模式，由 CalculatorView 切换显示）。
         布局约定见 docs/dev/layout.md：
           · 左「输入（上）｜ 结果（下）」两块 + 一条横分隔条（Key=calculator.日期输入与结果）；
           · 左区与右区之间一条竖分隔条（Key=calculator.日期左右）；
           · 右「算法说明（上）｜ 小提示（下）」两块 + 一条横分隔条（Key=calculator.日期说明与提示）。
         颜色全部 {DynamicResource}，控件样式全部来自 App.xaml。 -->

    <UserControl.Resources>
        <!-- 「今天」小按钮：三个日期栏共用 -->
        <Style x:Key="TinyButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="360" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <!-- ===================== 左：输入（上） + 结果（下） ===================== -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="320" MinHeight="270" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" MinHeight="260" />
            </Grid.RowDefinitions>

            <!-- ===== ① 输入：算法 + 两个日期 + 天数 ===== -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel>
                            <TextBlock Text="① 选择算法" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                                      Style="{StaticResource ComboBoxStyle}" Margin="0,8,0,0" MinHeight="32"
                                      ToolTip="三种算法：相差多少天 / 加减天数 / 拆成几年几个月几天" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="开始日期" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Grid.Column="1" Content="今天" Style="{StaticResource TinyButtonStyle}"
                                        Command="{Binding UseTodayCommand}" CommandParameter="start"
                                        ToolTip="填今天的日期" />
                            </Grid>
                            <TextBox x:Name="StartBox" Style="{StaticResource TextBoxStyle}" MinHeight="34"
                                     Margin="0,6,0,0" FontSize="15"
                                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                     Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="支持 2024-1-5、2024/1/5、2024.1.5、2024年1月5日、20240105" />
                            <TextBlock FontSize="10.5" Margin="2,4,0,0"
                                       Foreground="{DynamicResource FaintTextBrush}"
                                       Text="例：2024-1-5、2024/1/5、2024年1月5日、20240105" />

                            <!-- 结束日期（相差 / 拆开算才需要） -->
                            <StackPanel Visibility="{Binding NeedsEndDate, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="结束日期" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Grid.Column="1" Content="今天" Style="{StaticResource TinyButtonStyle}"
                                            Command="{Binding UseTodayCommand}" CommandParameter="end"
                                            ToolTip="填今天的日期" />
                                </Grid>
                                <TextBox Style="{StaticResource TextBoxStyle}" MinHeight="34" Margin="0,6,0,0"
                                         FontSize="15" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                         Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="⇅ 交换开始 / 结束" Style="{StaticResource TinyButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding SwapCommand}" />
                            </StackPanel>

                            <!-- 天数（加减天数才需要） -->
                            <StackPanel Visibility="{Binding NeedsOffset, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="加 / 减天数" FontSize="12" Margin="0,14,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Style="{StaticResource TextBoxStyle}" MinHeight="34" Margin="0,6,0,0"
                                         FontSize="15" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                         Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="正数是往后，负数是往前：30 / -30 / +7 都行" />
                                <TextBlock FontSize="10.5" Margin="2,4,0,0"
                                           Foreground="{DynamicResource FaintTextBrush}"
                                           Text="正数往后算、负数往前算（例如 30 或 -30）" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 错误提示固定在卡片底部、不跟内容一起滚走：填错时必须看得见 -->
                    <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"
                            Padding="10,7" Margin="0,10,0,0"
                            Visibility="{Binding ErrorText, Converter={StaticResource EmptyToVisInverse}}">
                        <TextBlock Text="{Binding ErrorText}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 上下分隔条：拖「输入」与「结果」的高度 -->
            <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="calculator.日期输入与结果" />

            <!-- ===== ② 结果 ===== -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="② 结果" FontSize="13" FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Right" Content="复制结果" Style="{StaticResource TinyButtonStyle}"
                                Command="{Binding CopyCommand}" ToolTip="把结果和下面的明细一起复制" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding SummaryText}" FontSize="11.5" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding SummaryText, Converter={StaticResource EmptyToVisInverse}}" />

                    <!-- 大号结果 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding ResultText, Converter={StaticResource EmptyToVisInverse}}">
                        <TextBlock Text="{Binding ResultText}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResultUnit}" FontSize="15" Margin="8,0,0,5"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 明细：一行一条 -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0"
                                  core:ScrollChaining.Enabled="True">
                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" MinWidth="88"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="4" Text="{Binding StatusText}" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding StatusText, Converter={StaticResource EmptyToVisInverse}}" />

                    <!-- 没算出结果时的说明（否则结果卡是一片空白，看着像卡了） -->
                    <TextBlock Grid.Row="3" Margin="0,14,0,0" TextWrapping="Wrap" VerticalAlignment="Top"
                               FontSize="11.5" MaxWidth="420" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding PlaceholderText}"
                               Visibility="{Binding ResultText, Converter={StaticResource EmptyToVis}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 左右分隔条：拖左区与右区的宽度 -->
        <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                           Key="calculator.日期左右" />

        <!-- ===================== 右：算法说明（上） + 小提示（下） ===================== -->
        <Grid Grid.Column="2" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="340" MinHeight="260" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" MinHeight="200" />
            </Grid.RowDefinitions>

            <!-- ===== ③ 三种算法说明 ===== -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              core:ScrollChaining.Enabled="True">
                    <StackPanel Margin="18,16,18,18">
                        <TextBlock Text="③ 三种算法" FontSize="13" FontWeight="SemiBold" />

                        <TextBlock Text="相差天数" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="从 A 到 B 过了多少天。默认不算开始当天、算结束当天（也就是日历上翻过去的天数），同时给出「含首尾」的天数（两头都算，请假 / 出差那种说法）。" />

                        <TextBlock Text="加减天数" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="某一天往后推 / 往前推 N 天是哪一天。正数是往后、负数是往前；结果会带上星期几和「一年中的第几天」，倒推也顺手给出来。" />

                        <TextBlock Text="拆开算" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="两个日期之间是几年几个月几天（「宝宝多大」「合同多久」常用）—— 一个整月一个整月地往前推，剩下不足一个月按天算；月末对齐（1 月 31 日加一个月算 2 月 28 / 29 日）。" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 上下分隔条：拖「算法说明」与「小提示」的高度 -->
            <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="calculator.日期说明与提示" />

            <!-- ===== ④ 小提示 ===== -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              core:ScrollChaining.Enabled="True">
                    <StackPanel Margin="18,16,18,18">
                        <TextBlock Text="小提示" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="· 日期只认「年在前」的写法（2024-1-5）；1/5/2024 这种月日在前的写法各国习惯不同，宁可提示重写，也不瞎猜。" />
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="· 填了错的日期（例如 2 月 30 日）会直接说「2024 年 2 月只有 29 天」，不静默改数。" />
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="· 只算公历（含闰年、闰月日历本身），不换算农历 / 节气 —— 那是「日历」工具的事。" />
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="· 三种算法共用同一组输入框，来回切算法时填过的日期不会丢；关掉再打开也还在。" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

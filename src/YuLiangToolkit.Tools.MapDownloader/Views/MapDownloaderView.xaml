<UserControl x:Class="YuLiangToolkit.Tools.MapDownloader.Views.MapDownloaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.MapDownloader.Views"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <UserControl.Resources>
        <!-- 表头末尾那一列用它占位：ListBox 给滚动条预留的宽度 -->
        <views:ScrollBarWidthConverter x:Key="ScrollBarWidth" />
    </UserControl.Resources>

    <!-- 样式全部来自 App.xaml（CardStyle / TextBoxStyle / ComboBoxStyle / PrimaryButtonStyle …） -->
    <!-- 布局（v0.41.0 起可拖拽，v0.42.0 补齐所有缝隙）：整页是「标题 / ① 凭据 / ② 搜索条件 / ③ 结果 / ④ 进度与日志 / 提示」几块，
         ①②③④ 四个页面级区块之间各有一条上下 core:PaneSplitter，拖动即可调大小（悬停蓝线 + ↕ 光标），
         松手自动记住（Config\layout.json），双击缝隙恢复这一处；
         全部恢复默认：主页设置 →「界面布局 → 恢复默认布局」。约定见 docs/dev/layout.md。
         ⚠ 可拖的竖排区块都是固定像素行；①② 表单卡内容比行高还高时自己内部滚动，整页仍在 ScrollViewer 里滚动。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,22,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />                                <!-- 标题 -->
                <RowDefinition Height="180" MinHeight="150" />                 <!-- ① API 凭据（可上下拖；内容约 155 + 16 上边距） -->
                <RowDefinition Height="12" />                                  <!-- ① / ② 分隔条 -->
                <RowDefinition Height="196" MinHeight="170" />                 <!-- ② 搜索条件（可上下拖；内容约 185） -->
                <RowDefinition Height="12" />                                  <!-- ② / ③ 分隔条 -->
                <RowDefinition Height="540" MinHeight="320" />                 <!-- ③ 搜索结果（可上下拖） -->
                <RowDefinition Height="12" />                                  <!-- ③ / ④ 分隔条 -->
                <RowDefinition Height="260" MinHeight="230" />                 <!-- ④ 进度与日志（可上下拖） -->
                <RowDefinition Height="Auto" />                                <!-- 底部提示 -->
            </Grid.RowDefinitions>

            <!-- ===== 标题 ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🎧 osu! 下图器" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="搜谱面集 → 勾选（或全量）下载 .osz。下载走第三方镜像 dl.sayobot.cn（不是官方站），带视频的包大得多。" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Center" Padding="12,8">
                    <TextBlock Text="{Binding TokenStatusText}" FontSize="12" TextWrapping="Wrap" MaxWidth="330" />
                </Border>
            </Grid>

            <!-- ===== ① API 凭据 ===== -->
            <!-- 固定像素行 + MinHeight：内容比行高时卡片自己内部滚动（滚到头再交给整页），行被拖小也不会裁字。 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          core:ScrollChaining.Enabled="True">
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="① API 凭据（存 Config\map-downloader\config.json，本机自用）" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12"
                               Text="osu! 的搜索接口要先换一个 Access Token：去官网注册一个 OAuth 应用（Client Credentials），把 Client ID 与 Client Secret 填进来即可。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Client ID" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding Cfg.ClientId, UpdateSourceTrigger=PropertyChanged}"
                                 Width="110" Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Grid.Column="2" Text="Client Secret" VerticalAlignment="Center" Margin="18,0,8,0" />
                        <TextBox Grid.Column="3" Text="{Binding Cfg.ClientSecret, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="220" HorizontalAlignment="Left" Style="{StaticResource TextBoxStyle}" />
                        <CheckBox Grid.Column="4" Content="打开工具时自动换 Token" VerticalAlignment="Center" Margin="18,0,0,0"
                                  IsChecked="{Binding Cfg.AutoGetToken}" Style="{StaticResource CheckBoxStyle}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="获取 Token" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GetTokenCommand}" />
                        <Button Content="去 osu! 注册 OAuth 应用" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding OpenOAuthPageCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </ScrollViewer>

            <!-- 上下分隔条：拖动改「① API 凭据」与「② 搜索条件」的高度（双击恢复这一处） -->
            <core:PaneSplitter Grid.Row="2" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="map-downloader.凭据与搜索" />

            <!-- ===== ② 搜索条件 ===== -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          core:ScrollChaining.Enabled="True">
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="② 搜索条件" FontSize="13" FontWeight="SemiBold" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="关键词" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding Cfg.LastQuery, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="180" Style="{StaticResource TextBoxStyle}"
                                 ToolTip="标题 / 艺术家 / 作者都认" />

                        <TextBlock Grid.Column="2" Text="模式" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedMode}" Width="104" Style="{StaticResource ComboBoxStyle}" />

                        <TextBlock Grid.Column="4" Text="Key 数" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox Grid.Column="5" ItemsSource="{Binding KeyCountOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedKeyCount}" Width="92"
                                  IsEnabled="{Binding KeyCountEnabled}" Style="{StaticResource ComboBoxStyle}"
                                  ToolTip="只对 Mania 有效（本地筛选）" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="状态" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedStatus}" Width="118" Style="{StaticResource ComboBoxStyle}" />

                        <TextBlock Grid.Column="2" Text="排序" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedSort}" Width="128" Style="{StaticResource ComboBoxStyle}" />

                        <TextBlock Grid.Column="4" Text="日期从" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <TextBox Grid.Column="5" Text="{Binding Cfg.DateFrom, UpdateSourceTrigger=PropertyChanged}"
                                 Width="104" Style="{StaticResource TextBoxStyle}" ToolTip="yyyy-MM-dd，留空 = 不限" />
                        <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="到" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Cfg.DateTo, UpdateSourceTrigger=PropertyChanged}"
                                     Width="104" Style="{StaticResource TextBoxStyle}" ToolTip="yyyy-MM-dd，留空 = 不限" />
                            <TextBlock Text="{Binding LocalFilterHint}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <CheckBox Grid.Column="7" Content="包含 NSFW" VerticalAlignment="Center" Margin="16,0,0,0"
                                  IsChecked="{Binding Cfg.IncludeNsfw}" Style="{StaticResource CheckBoxStyle}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="搜索" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" />
                        <Button Content="加载更多" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding LoadMoreCommand}" />
                        <Button Content="{Binding FetchAllText}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding FetchAllCommand}"
                                ToolTip="沿着游标把所有页都取回来（再点一次 = 停止）" />
                        <TextBlock Text="{Binding ResultSummary}" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </ScrollViewer>

            <!-- 上下分隔条：拖动改「② 搜索条件」与「③ 搜索结果」的高度（双击恢复这一处） -->
            <core:PaneSplitter Grid.Row="4" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="map-downloader.搜索与结果" />

            <!-- ===== ③ 结果 ===== -->
            <!-- 结果表放 * 行、删掉写死的 Height=330：区域被拖高 / 拖矮时只有表格跟着伸缩；
                 卡片被拖矮时裁掉溢出内容。 -->
            <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />                <!-- 标题 + 已选统计 -->
                        <RowDefinition Height="*" MinHeight="120" />   <!-- 结果表（随区域伸缩） -->
                        <RowDefinition Height="Auto" />                <!-- 选择 / 下载按钮 -->
                        <RowDefinition Height="Auto" />                <!-- 保存目录 -->
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="③ 搜索结果（勾上要下的那些行）" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectionText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </Grid>

                    <!-- ===== 结果表：表头写在 ListBox 自己的 ControlTemplate 里 =====
                         表头与数据行**同处一列**（Grid 第 0 行表头 / 第 1 行 ScrollViewer + ItemsPresenter），
                         宽度天然一致，不用监听布局事件；列定义两边必须**一字不差**。
                         左边距 33 = 行内容的缩进（外边距10 + 内边距10 + 边框1 + 强调条3 + 内容缩进9），
                         右边距 21 = 行的右边距 + 内边距 + 边框，末尾再占一列滚动条宽度（见 ScrollBarWidthConverter）。 -->
                    <!-- 结果表：放 * 行、去掉写死的 Height=330（区域拖高 / 拖矮时表格自己伸缩） -->
                    <ListBox x:Name="ResultList" ItemsSource="{Binding Sets}" Grid.Row="1" Margin="8,10,8,0"
                             MinHeight="120" core:ScrollChaining.Enabled="True"
                             ToolTip="勾选左侧方框 = 选中要下载的谱面集">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource FileListStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBox">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="33,0,21,6"
                                                      DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="118" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="50" />
                                                        <!-- ListBox 给滚动条预留的位置 -->
                                                        <ColumnDefinition Width="{Binding Converter={StaticResource ScrollBarWidth}}" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="ID" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="标题" Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="艺术家" Grid.Column="3" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="Mapper" Grid.Column="4" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="状态" Grid.Column="5" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="日期" Grid.Column="6" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="难度" Grid.Column="7" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="CS" Grid.Column="8" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Grid>

                                                <!-- ⚠ x:Name 必须叫 "ScrollViewer"：ListBox 是按这个名字找「滚动宿主」的 -->
                                                <ScrollViewer x:Name="ScrollViewer" Grid.Row="1" Focusable="False"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Padding="0" Background="Transparent">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Tooltip}">
                                    <!-- ⚠ 列宽必须与上面表头一字不差 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Style="{StaticResource CheckBoxStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Artist}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Creator}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{Binding DateText}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="7" Text="{Binding DifficultyCount}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="8" Text="{Binding KeyRangeText}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 选择与下载 -->
                    <Grid Grid.Row="2" Margin="18,12,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="全选" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectAllCommand}" />
                            <Button Content="清空选择" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding ClearSelectionCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="下载选中（无视频）" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding DownloadSelectedNoVideoCommand}" />
                            <Button Content="下载选中（含视频）" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding DownloadSelectedFullCommand}" />
                            <Button Content="下载全部（无视频）" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding DownloadAllNoVideoCommand}" />
                            <Button Content="下载全部（含视频）" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding DownloadAllFullCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="18,10,18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="保存到" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding FolderText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="选择目录" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChooseFolderCommand}" />
                            <Button Content="打开目录" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 上下分隔条：拖动改「搜索结果」与「进度与日志」的高度（双击恢复这一处） -->
            <core:PaneSplitter Grid.Row="6" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="map-downloader.结果与日志" />

            <!-- ===== ④ 进度与日志 ===== -->
            <!-- 日志框放 * 行、删掉写死的 Height=120（区域拖高 / 拖矮时只有日志跟着伸缩）。 -->
            <Border Grid.Row="7" Style="{StaticResource CardStyle}" Margin="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />                <!-- 标题 -->
                        <RowDefinition Height="Auto" />                <!-- 进度条（下载中才显示） -->
                        <RowDefinition Height="Auto" />                <!-- 下载汇总 -->
                        <RowDefinition Height="Auto" />                <!-- 状态 -->
                        <RowDefinition Height="*" MinHeight="60" />    <!-- 日志（随区域伸缩） -->
                        <RowDefinition Height="Auto" />                <!-- 取消 / 清空日志 -->
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="④ 进度与日志" FontSize="13" FontWeight="SemiBold" />

                    <Grid Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                     Style="{StaticResource ProgressBarStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="12,0,0,0" MinWidth="70"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{Binding DownloadSummaryText}" Margin="0,10,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" />

                    <TextBox Grid.Row="4" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource LogTextBoxStyle}" Margin="0,10,0,0" MinHeight="60"
                             core:ScrollChaining.Enabled="True" />

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" />
                        <Button Content="清空日志" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding ClearLogCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="8" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="提示：搜索走 osu! 官方 API（只读公开数据，需要自己注册的 Client ID / Secret）；.osz 文件走第三方镜像下载，勾选多行时最多同时下 5 个（可在 config.json 里改 parallelDownloads）。日期与 Key 数是拉回来之后在本地筛的。" />
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>

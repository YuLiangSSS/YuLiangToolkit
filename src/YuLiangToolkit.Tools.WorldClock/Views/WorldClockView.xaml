<UserControl x:Class="YuLiangToolkit.Tools.WorldClock.Views.WorldClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.WorldClock.Views"
             Background="Transparent">

    <!-- 全球时钟（world-clock）。
         布局约定见 docs/dev/layout.md：
           · 整页不套外层 ScrollViewer，用 Grid 行 Auto / * 撑满；
           · 主区左右两栏 =「时钟区（*）｜ PaneSplitter（12，Key=world-clock.时钟与设置）｜ 设置卡片（380，Min 320）」，
             设置卡片内部自己滚并挂 core:ScrollChaining；
           · 颜色一律 DynamicResource token，样式全部来自 App.xaml；右键菜单套 DarkMenu 系列样式。 -->

    <UserControl.Resources>

        <!-- 一只钟（表盘视图 / 列表视图共用同一个数据模板的不同外壳） -->
        <Style x:Key="ClockTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <!-- 夜里的城市：底色压暗一眼就能看出来（城市名旁边也有 🌙 角标） -->
                <DataTrigger Binding="{Binding DimAtNight}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 拖动把手 ≡（只在解锁时可见，悬停变手 / 移动光标） -->
        <Style x:Key="DragHandleStyle" TargetType="Border">
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="ToolTip" Value="按住拖动可以调整顺序" />
        </Style>

        <!-- 卡片右上角的小图标按钮（锁 / 删除）：无底、悬停才浮出底色 -->
        <Style x:Key="TileIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 删除按钮悬停变红 -->
        <Style x:Key="TileDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource TileIconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 锁按钮：图标是 Segoe MDL2 Assets 的码位（U+E72E / U+E785），必须用这套字体，
             否则渲染成豆腐块。 -->
        <Style x:Key="TileLockButtonStyle" TargetType="Button" BasedOn="{StaticResource TileIconButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 城市搜索结果行（整行可点） -->
        <Style x:Key="CityPickButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 设置卡片里的小节标题 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <!-- 说明 / 提示小字 -->
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- 滑块旁边的数值 -->
        <Style x:Key="SliderValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- 一只钟的右键菜单（表盘 / 列表共用）：必须套 App.xaml 的 DarkMenu 系列样式（AGENTS.md 规则 13）。
             ⚠ ContextMenu 不在可视树里、拿不到 UserControl 的 DataContext，所以约定：
             卡片 Border 的 Tag 放 ViewModel（模板里已绑好），这里 DataContext 取它，
             CommandParameter 取 PlacementTarget.DataContext（= 这一只钟）。 -->
        <ContextMenu x:Key="ClockContextMenu" x:Shared="False"
                     Style="{StaticResource DarkContextMenuStyle}"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Resources>
                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource DarkMenuLeafItemStyle}" />
                <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource DarkMenuSeparatorStyle}" />
            </ContextMenu.Resources>
            <MenuItem Header="让标题栏显示这一只" Command="{Binding UseForTitleBarCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="复制这一只的时间" Command="{Binding CopyTimeCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="上移" Command="{Binding MoveUpCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="下移" Command="{Binding MoveDownCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="置顶" Command="{Binding BringToTopCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="锁定 / 解锁" Command="{Binding ToggleLockCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="删除" Command="{Binding RemoveClockCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- ===== 表盘视图里的一只钟 ===== -->
        <DataTemplate x:Key="AnalogClockTemplate">
            <Border Style="{StaticResource ClockTileStyle}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    ContextMenu="{StaticResource ClockContextMenu}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ① 城市名 + 拖动把手 + 锁 / 删除 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DragHandleStyle}"
                                Visibility="{Binding CanDrag, Converter={StaticResource BoolToVis}}"
                                PreviewMouseLeftButtonDown="OnHandleMouseDown"
                                PreviewMouseMove="OnHandleMouseMove"
                                PreviewMouseLeftButtonUp="OnHandleMouseUp">
                            <TextBlock Text="≡" FontSize="13" Foreground="{DynamicResource FaintTextBrush}"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="2,0,0,0">
                            <TextBlock Text="{Binding CityName}" FontSize="13.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PhaseEmoji}" FontSize="11" Margin="5,1,0,0"
                                       VerticalAlignment="Center" ToolTip="{Binding PhaseText}" />
                            <!-- 标题栏正在跟随这一只（右键菜单里可以改） -->
                            <TextBlock Text="🕐" FontSize="9.5" Margin="4,0,0,0" VerticalAlignment="Center"
                                       ToolTip="标题栏正在显示这个城市的时间"
                                       Visibility="{Binding IsTitleBarClock, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource TileLockButtonStyle}"
                                    Content="{Binding LockGlyph}" ToolTip="{Binding LockHint}"
                                    Command="{Binding DataContext.ToggleLockCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource TileDeleteButtonStyle}"
                                    Content="✕" ToolTip="{Binding DeleteHint}"
                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RemoveClockCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>

                    <!-- ② 表盘 -->
                    <views:AnalogClockFace Grid.Row="1" Margin="0,8,0,0"
                                           HorizontalAlignment="Center"
                                           Width="{Binding DataContext.Cfg.DialSize,
                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Height="{Binding DataContext.Cfg.DialSize,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Clock="{Binding}"
                                           ShowSeconds="{Binding DataContext.Cfg.ShowSeconds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           ShowTicks="{Binding DataContext.Cfg.ShowDialTicks, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FaceBrush="{DynamicResource InputBackgroundBrush}"
                                           RimBrush="{DynamicResource BorderBrush}"
                                           TickBrush="{DynamicResource TextSecondaryBrush}"
                                           HandBrush="{DynamicResource TextPrimaryBrush}"
                                           SecondHandBrush="{DynamicResource AccentBrush}"
                                           HubBrush="{DynamicResource AccentBrush}" />

                    <!-- ③ 数字时间 -->
                    <TextBlock Grid.Row="2" Text="{Binding TimeText}" HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                               FontSize="22" FontWeight="SemiBold" />

                    <!-- ④ 日期 + 跨日角标 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="{Binding DateText}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding DateText, Converter={StaticResource EmptyToVisInverse}}" />
                        <Border Background="{DynamicResource TagChipBackgroundBrush}"
                                BorderBrush="{DynamicResource TagChipBorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="5,0" Margin="6,0,0,0"
                                Visibility="{Binding DayOffsetText, Converter={StaticResource EmptyToVisInverse}}">
                            <TextBlock Text="{Binding DayOffsetText}" FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- ⑤ 与本地时差 + 夏令时角标 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,6,0,0">
                        <TextBlock Text="{Binding OffsetText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding OffsetText, Converter={StaticResource EmptyToVisInverse}}" />
                        <Border Background="{DynamicResource TagChipBackgroundBrush}"
                                CornerRadius="4" Padding="5,0" Margin="6,0,0,0"
                                Visibility="{Binding DstBadgeText, Converter={StaticResource EmptyToVisInverse}}"
                                ToolTip="此刻这个城市处于夏令时">
                            <TextBlock Text="{Binding DstBadgeText}" FontSize="10"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== 列表视图里的一只钟 ===== -->
        <DataTemplate x:Key="ListClockTemplate">
            <Border Style="{StaticResource ClockTileStyle}" Padding="12,10" Margin="0,0,0,8"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    ContextMenu="{StaticResource ClockContextMenu}"
                    MouseLeftButtonDown="OnRowMouseLeftButtonDown"
                    ToolTip="{Binding DetailTip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DragHandleStyle}"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanDrag, Converter={StaticResource BoolToVis}}"
                            PreviewMouseLeftButtonDown="OnHandleMouseDown"
                            PreviewMouseMove="OnHandleMouseMove"
                            PreviewMouseLeftButtonUp="OnHandleMouseUp">
                        <TextBlock Text="≡" FontSize="15" Foreground="{DynamicResource FaintTextBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0" MinWidth="150">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CityName}" FontSize="13.5" FontWeight="SemiBold"
                                       MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PhaseEmoji}" FontSize="11" Margin="5,1,0,0"
                                       VerticalAlignment="Center" ToolTip="{Binding PhaseText}" />
                        </StackPanel>
                        <!-- 英文名 + 日期 + 跨日 / 夏令时角标都放在第二行：城市名那一行留给中文
                             （挤在一行时日期会被裁成「日 周四」） -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding EnglishName}" FontSize="10"
                                       Foreground="{DynamicResource FaintTextBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="110" VerticalAlignment="Center"
                                       Visibility="{Binding EnglishName, Converter={StaticResource EmptyToVisInverse}}" />
                            <TextBlock Text="{Binding DateText}" FontSize="10.5" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding DateText, Converter={StaticResource EmptyToVisInverse}}" />
                            <Border Background="{DynamicResource TagChipBackgroundBrush}"
                                    BorderBrush="{DynamicResource TagChipBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4,0" Margin="6,0,0,0"
                                    Visibility="{Binding DayOffsetText, Converter={StaticResource EmptyToVisInverse}}">
                                <TextBlock Text="{Binding DayOffsetText}" FontSize="9.5"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Border Background="{DynamicResource TagChipBackgroundBrush}"
                                    CornerRadius="4" Padding="4,0" Margin="5,0,0,0"
                                    Visibility="{Binding DstBadgeText, Converter={StaticResource EmptyToVisInverse}}"
                                    ToolTip="此刻这个城市处于夏令时">
                                <TextBlock Text="{Binding DstBadgeText}" FontSize="9.5"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" MinWidth="132" TextAlignment="Right"
                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                               FontSize="24" FontWeight="SemiBold" />

                    <!-- 时差 -->
                    <TextBlock Grid.Column="3" Text="{Binding OffsetText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="18,0,10,0"
                               FontSize="11" MinWidth="128" TextAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <!-- 锁 / 删除 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TileLockButtonStyle}"
                                Content="{Binding LockGlyph}" ToolTip="{Binding LockHint}"
                                Command="{Binding DataContext.ToggleLockCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource TileDeleteButtonStyle}"
                                Content="✕" ToolTip="{Binding DeleteHint}"
                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.RemoveClockCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🕐 全球时钟" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Text="一页看多个城市的当前时间：表盘 / 列表两种视图，显示日期、与本地时差、跨日角标和昼夜状态；可加城市（内置城市库 + 自定义 UTC 偏移）、拖动排序、锁定防手滑，删错了 6 秒内还能撤销。" />
            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Text="{Binding SummaryText}" />
        </StackPanel>

        <!-- ===================== 主区域：时钟区 ｜ 分隔条 ｜ 设置 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：时钟区 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 工具条两行：第一行「我的钟 + 视图切换」，第二行排序 / 锁定按钮。
                         挤成一行时（窗口窄 / 侧栏展开）按钮会被裁掉。 -->
                    <Grid Grid.Row="0" Margin="18,14,18,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="我的钟" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                      HorizontalAlignment="Left" MinWidth="168" MaxWidth="220"
                                      ItemsSource="{Binding ViewModeOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedViewOption, Mode=TwoWay}"
                                      ToolTip="表盘：一面钟墙；列表：一行一个城市，看得更清楚" />
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button Content="按时间排" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SortByTimeCommand}" Margin="0,0,8,0"
                                    ToolTip="按各城市当地时间从早到晚排（锁定的城市位置不变）" />
                            <Button Content="按名称排" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SortByNameCommand}" Margin="0,0,8,0" />
                            <Button Content="全部锁定" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding LockAllCommand}" Margin="0,0,8,0"
                                    ToolTip="一次性锁住所有钟：✕ 隐藏、不能拖动，防止手滑" />
                            <Button Content="全部解锁" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding UnlockAllCommand}"
                                    ToolTip="一次性解锁所有钟" />
                        </WrapPanel>
                    </Grid>

                    <!-- 撤销条（删掉一只钟后出现，6 秒后自动消失） -->
                    <Border Grid.Row="1" Margin="18,0,18,8" Padding="12,8"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding HasUndo, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="{Binding UndoHint}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="撤销" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Right" Padding="14,5"
                                    Command="{Binding UndoDeleteCommand}" />
                        </Grid>
                    </Border>

                    <!-- 钟墙 / 列表 -->
                    <Grid Grid.Row="2" Margin="14,0,10,6">
                        <!-- 表盘视图 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True"
                                      Visibility="{Binding IsAnalogView, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Clocks}"
                                          ItemTemplate="{StaticResource AnalogClockTemplate}"
                                          Margin="4,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 列表视图 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True"
                                      Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Clocks}"
                                          ItemTemplate="{StaticResource ListClockTemplate}"
                                          Margin="4,4,4,0" />
                        </ScrollViewer>

                        <!-- 空状态 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🕐" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="还没有钟 —— 在右边「添加城市」里搜一个城市点一下就行。"
                                       FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="先加上北京 / 东京 / 伦敦 / 纽约" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Command="{Binding AddStarterCitiesCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 状态条 -->
                    <TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="11"
                               Margin="18,0,18,12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- 左右分隔条：拖动改「时钟区」与「设置」的宽度（双击恢复这一处） -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="world-clock.时钟与设置" />

            <!-- ===== 右：设置 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,16,18,10">
                        <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="18,0,18,18">

                            <!-- ① 添加城市 -->
                            <TextBlock Text="添加城市" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                            <Grid>
                                <TextBox x:Name="CitySearchBox" Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding CityFilter, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="中文 / 英文 / 国家名都能搜（例如 伦敦、London、英国）" />
                                <TextBlock Text="搜索城市…" IsHitTestVisible="False" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding CityFilter, Converter={StaticResource EmptyToVis}}" />
                            </Grid>

                            <Border Margin="0,8,0,0" MaxHeight="196" ClipToBounds="True"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="6,6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              core:ScrollChaining.Enabled="True">
                                    <ItemsControl ItemsSource="{Binding CityMatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CityPickButtonStyle}"
                                                        Click="OnCityClick"
                                                        ToolTip="点一下加入我的钟">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                                            <TextBlock Text="{Binding EnglishName}" FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Region}" FontSize="10.5"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <TextBlock Text="列表里已有的城市会提示一句、不会重复添加。" Style="{StaticResource HintTextStyle}" />

                            <!-- ② 自定义偏移 -->
                            <TextBlock Text="城市库里没有？手填偏移" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="城市名（随便写，留空就用 UTC 偏移当名字）" />
                                <TextBlock Text="名字（可留空）" IsHitTestVisible="False" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding CustomName, Converter={StaticResource EmptyToVis}}" />
                                <TextBox Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding CustomOffsetText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="UTC 偏移：+8 / -5:30 / 5.5 / UTC+8 都行" />
                                <Button Grid.Column="2" Content="添加" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0" Command="{Binding AddOffsetClockCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding CustomOffsetPreview}" Style="{StaticResource HintTextStyle}"
                                       Foreground="{DynamicResource AccentBrush}" />

                            <!-- ③ 外观 -->
                            <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="表盘大小" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Slider Grid.Column="1" Margin="10,0,0,0"
                                        Minimum="130" Maximum="320" SmallChange="5" LargeChange="20"
                                        Value="{Binding Cfg.DialSize, Mode=TwoWay}"
                                        Style="{StaticResource SliderStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Cfg.DialSize, StringFormat={}{0:0}}"
                                           Style="{StaticResource SliderValueStyle}" />
                            </Grid>

                            <CheckBox Content="显示秒（秒针 + 秒数）" IsChecked="{Binding Cfg.ShowSeconds, Mode=TwoWay}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,12,0,0" />
                            <CheckBox Content="24 小时制（关掉 = 12 小时制 + 上午 / 下午）"
                                      IsChecked="{Binding Cfg.Hour24, Mode=TwoWay}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0" />
                            <CheckBox Content="显示日期与星期" IsChecked="{Binding Cfg.ShowDate, Mode=TwoWay}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0" />
                            <CheckBox Content="显示与本地时差" IsChecked="{Binding Cfg.ShowOffset, Mode=TwoWay}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0" />
                            <CheckBox Content="夜里换成暗底色（一眼看出那边是半夜）"
                                      IsChecked="{Binding Cfg.ColorByDayNight, Mode=TwoWay}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0" />
                            <CheckBox Content="表盘画刻度" IsChecked="{Binding Cfg.ShowDialTicks, Mode=TwoWay}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0" />

                            <!-- ④ 复制 -->
                            <TextBlock Text="复制" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="复制全部时间" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CopyAllCommand}"
                                        ToolTip="所有城市一行一个，方便贴到聊天 / 文档里" />
                            </StackPanel>
                            <TextBlock Text="也可以双击一只钟（列表视图）或右键「复制这一只」。"
                                       Style="{StaticResource HintTextStyle}" />

                            <!-- ⑤ 日志 -->
                            <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}" />
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     Style="{StaticResource LogTextBoxStyle}" Height="120"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     core:ScrollChaining.Enabled="True" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

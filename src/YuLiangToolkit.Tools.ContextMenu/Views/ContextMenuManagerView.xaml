<UserControl x:Class="YuLiangToolkit.Tools.ContextMenu.Views.ContextMenuManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <!-- 右键菜单管理（context-menu-manager）。
         布局约定见 docs/dev/layout.md：
           · 左右：条目列表（*）｜ core:PaneSplitter（Key=context-menu-manager.列表与详情）｜详情/操作（固定像素）；
           · 上下：主区域（固定像素行）｜ core:PaneSplitter（Key=context-menu-manager.主区域与日志）｜运行日志；
           · 整页包在 ScrollViewer 里，内层列表 / 详情 / 日志挂 ScrollChaining（滚到头交给整页）。 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  core:ScrollChaining.Enabled="True">
        <StackPanel Margin="28,22,28,26">

            <!-- ===== 页头：说明 + 统计 ===== -->
            <StackPanel>
                <TextBlock Text="🖱️ 右键菜单管理" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="枚举 Windows 右键菜单里的项目（文件 / 文件夹 / 空白处 / 驱动器 / 桌面背景），把不需要的（例如「上传到百度网盘」）隐藏、随时恢复。只写当前用户（HKCU）的覆盖项，不删原注册表键，不需要管理员权限。" />
                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{Binding StatsText}" />
            </StackPanel>

            <!-- ===== 主区域 + 运行日志：上下可拖（两块都是固定像素行） ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <!-- 主区域：左列表 / 竖分隔条 / 右详情（左右可拖） -->
                    <RowDefinition Height="400" MinHeight="340" />
                    <RowDefinition Height="12" />
                    <!-- 日志：内部 Auto（标题）+ *（日志框） -->
                    <RowDefinition Height="160" MinHeight="110" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="400" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== 左：条目列表卡（内部：标题 / 筛选 / 列表* / 状态） ===== -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 卡标题 + 刷新 -->
                            <Grid Grid.Row="0" Margin="18,14,18,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="条目列表" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="扫描当前用户的右键菜单注册表项" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                                        ToolTip="重新扫描注册表，并保持当前筛选条件" />
                            </Grid>

                            <!-- 搜索 -->
                            <Grid Grid.Row="1" Margin="18,0,18,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="搜索" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,0,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}"
                                         ToolTip="按名称 / 位置 / 类型 / 注册表路径 / 说明筛选（忽略大小写）" />
                            </Grid>

                            <!-- 位置 / 类型 / 只看已隐藏（窗口窄时自动换行） -->
                            <WrapPanel Grid.Row="2" Margin="18,0,18,4">
                                <TextBlock Text="位置" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,6" />
                                <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}"
                                          Style="{StaticResource ComboBoxStyle}" MinWidth="150" Margin="0,0,14,6"
                                          ToolTip="按右键菜单出现的位置筛选" />
                                <TextBlock Text="类型" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,6" />
                                <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"
                                          Style="{StaticResource ComboBoxStyle}" MinWidth="104" Margin="0,0,14,6"
                                          ToolTip="菜单命令 = 注册表 shell 动词；扩展模块 = COM 外壳扩展" />
                                <CheckBox Content="只看已隐藏" IsChecked="{Binding ShowOnlyHidden}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,6" VerticalAlignment="Center" />
                            </WrapPanel>

                            <!-- 列表（* 行吃掉卡片多出来的高度）+ 空状态占位 -->
                            <Grid Grid.Row="3" Margin="8,0,8,0">
                                <ListBox x:Name="EntryListBox" ItemsSource="{Binding Entries}"
                                         SelectedItem="{Binding SelectedEntry}"
                                         Style="{StaticResource FileListStyle}"
                                         core:ScrollChaining.Enabled="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ToolTip="单击选中；右侧小按钮可直接隐藏 / 恢复">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Padding="18,7" Margin="0,1" CornerRadius="6"
                                                    Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- 已隐藏的行：名称用主题红色 + 小徽标区分 -->
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTipText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                                    BorderThickness="1"
                                                                    BorderBrush="{DynamicResource DangerBrush}"
                                                                    Background="{DynamicResource InputBackgroundBrush}"
                                                                    Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding StatusBadge}" FontSize="10"
                                                                           Foreground="{DynamicResource DangerBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Content="{Binding ToggleActionLabel}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanToggle}"
                                                            ToolTip="{Binding ToolTipText}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                    <Setter TargetName="Row" Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="{Binding EmptyHint}"
                                           Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVis}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340"
                                           Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                            </Grid>

                            <!-- 状态栏文字 -->
                            <Grid Grid.Row="4" Margin="18,8,18,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding StatsText}" FontSize="11" Margin="12,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center"
                                           ToolTip="{Binding StatsText}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 左右分隔条：拖动改「条目列表」与「详情 / 操作」的宽度（双击恢复这一处） -->
                    <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                       Key="context-menu-manager.列表与详情" />

                    <!-- ===== 右：详情 / 操作卡（内部滚动，滚到头交给整页） ===== -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True">
                            <StackPanel Margin="18,16,18,18">
                                <TextBlock Text="详情 / 操作" FontSize="13" FontWeight="SemiBold" />

                                <!-- 未选中占位 -->
                                <TextBlock Text="在左侧列表里选中一项，就能在这里查看它的详情，并隐藏 / 恢复。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                                <!-- 选中项详情 -->
                                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <WrapPanel Margin="0,9,0,0">
                                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,3" Margin="0,0,8,6">
                                            <TextBlock Text="{Binding SelectedEntry.KindLabel}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,3" Margin="0,0,8,6">
                                            <TextBlock Text="{Binding SelectedEntry.ScopeLabel}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,3" Margin="0,0,8,6"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                Visibility="{Binding SelectedEntry.IsHidden, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SelectedEntry.StatusLabel}" FontSize="11"
                                                       Foreground="{DynamicResource DangerBrush}" />
                                        </Border>
                                        <Border BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,3" Margin="0,0,8,6"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                Visibility="{Binding SelectedEntry.IsHidden, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding SelectedEntry.StatusLabel}" FontSize="11"
                                                       Foreground="{DynamicResource SuccessBrush}" />
                                        </Border>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,3" Margin="0,0,8,6"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                Visibility="{Binding SelectedEntry.SourceLabel, Converter={StaticResource EmptyToVisInverse}}">
                                            <TextBlock Text="{Binding SelectedEntry.SourceLabel}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </WrapPanel>

                                    <!-- 注册表路径 + 复制 -->
                                    <TextBlock Text="注册表路径" FontSize="11" Margin="0,10,0,5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SelectedEntry.RegistryLocation, Mode=OneWay}"
                                                 Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                                 TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                 Padding="10,7" MinHeight="34"
                                                 ToolTip="{Binding SelectedEntry.RegistryLocation}" />
                                        <Button Grid.Column="1" Content="复制" Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="8,0,0,0" VerticalAlignment="Top"
                                                Command="{Binding CopyLocationCommand}" />
                                    </Grid>

                                    <!-- 说明 -->
                                    <TextBlock Text="说明" FontSize="11" Margin="0,12,0,5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedEntry.Detail}" FontSize="12" TextWrapping="Wrap" />

                                    <!-- Service 给出的状态说明（不可隐藏原因、需要重启资源管理器等） -->
                                    <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"
                                            Padding="10,8" Margin="0,12,0,0"
                                            Visibility="{Binding SelectedEntry.StatusNote, Converter={StaticResource EmptyToVisInverse}}">
                                        <TextBlock Text="{Binding SelectedEntry.StatusNote}" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>

                                    <!-- 大按钮：隐藏 / 恢复选中项 -->
                                    <Button Content="{Binding SelectedEntry.ToggleActionLabel}"
                                            Command="{Binding ToggleSelectedCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinHeight="38" Margin="0,16,0,0"
                                            ToolTip="立即写入当前用户注册表；隐藏后可用「恢复显示」还原" />
                                </StackPanel>

                                <!-- 批量 / 系统操作（不需要选中项） -->
                                <TextBlock Text="批量 / 系统操作" FontSize="12" FontWeight="SemiBold" Margin="0,22,0,8" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" Command="{Binding RestoreAllCommand}"
                                        ToolTip="{Binding StatsText}">
                                    <TextBlock Text="恢复全部（仅本工具隐藏的）" TextWrapping="Wrap" TextAlignment="Center" />
                                </Button>
                                <Button Content="重启资源管理器" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                        Command="{Binding RestartExplorerCommand}"
                                        ToolTip="改完右键菜单后如果没立即生效，用这个重启 explorer.exe（会先弹确认框）" />

                                <!-- 安全说明 -->
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                        Padding="12,10" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="安全说明" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="· 只写当前用户（HKCU）的覆盖项，不改 HKLM，不需要管理员权限。" />
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="· 不删除原注册表键：隐藏只是额外写一个覆盖值，随时可以恢复。" />
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="· 个别情况下需要重启资源管理器（explorer.exe）才会生效。" />
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="· Win11 默认只显示常用项：被隐藏的项在「显示更多选项」（Shift+F10）里也不会出现。" />
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="· 「恢复全部」只恢复本工具隐藏的项，其他程序隐藏的不会被修改。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 上下分隔条：拖动改「主区域」与「运行日志」的高度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="context-menu-manager.主区域与日志" />

                <!-- ===== 运行日志（日志框吃掉多出来的高度） ===== -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="70" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold" />
                        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                                 Style="{StaticResource LogTextBoxStyle}" Margin="0,10,0,0"
                                 core:ScrollChaining.Enabled="True" />
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="YuLiangToolkit.Tools.MemeBoard.Views.MemeBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent"
             AllowDrop="True"
             Loaded="OnLoaded"
             DragOver="OnFileDragOver"
             Drop="OnFileDrop">

    <!-- 表情包收藏夹（meme-board）。
         布局约定见 docs/dev/layout.md：
           · 整页不套外层 ScrollViewer，用 Grid 行 Auto / * 撑满；
           · 主区左右两栏 =「收藏网格（*）｜ PaneSplitter（12，Key=meme-board.收藏与设置）｜ 设置卡片（420，Min 320）」，
             设置卡片内部自己滚并挂 core:ScrollChaining；
           · 颜色一律 DynamicResource token，样式全部来自 App.xaml；右键菜单套 DarkMenu 系列样式。 -->

    <UserControl.Resources>

        <!-- 收藏网格的方格：悬停 / 选中反馈和列表行一致 -->
        <Style x:Key="MemeTileStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <!-- x:Name 会变 AutomationId；这里把每项的名字也挂到 AutomationProperties.Name，方便端到端测试定位 -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="160" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="ToolTip" Value="{Binding HintText}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ListRowSelectedBackgroundBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource ListRowSelectedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置卡片里的小节标题 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <!-- 说明 / 提示小字 -->
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- 滑块旁边的数值 -->
        <Style x:Key="SliderValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="😆 表情包收藏夹" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Text="收藏常用表情包图片，单击一张就复制到剪贴板并自动粘贴到目标 QQ 会话；设置里可以开 / 关自动发送（随机延迟）、切换「仅复制到剪贴板」、选择目标 QQ 窗口。" />
            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Text="{Binding StatsText}" />
        </StackPanel>

        <!-- ===================== 主区域：收藏网格 ｜ 分隔条 ｜ 设置 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="420" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：收藏网格 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="150" />
                    </Grid.RowDefinitions>

                    <!-- 标题 / 统计 / 搜索 / 工具条 -->
                    <Grid Grid.Row="0" Margin="18,16,18,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="我的收藏" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatsText}" FontSize="11" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="按文件名搜索收藏的图片" />
                            <TextBlock Text="搜索文件名…" IsHitTestVisible="False" Margin="12,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button x:Name="ImportButton" Content="导入图片…" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ImportCommand}" Margin="0,0,8,8"
                                    ToolTip="可一次多选；也可以直接把图片拖进这个页面" />
                            <Button x:Name="ClipboardButton" Content="从剪贴板添加" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddFromClipboardCommand}" Margin="0,0,8,8"
                                    ToolTip="把剪贴板里的图片存成 PNG 收进收藏夹" />
                            <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshCommand}" Margin="0,0,8,8"
                                    ToolTip="重新扫描数据文件夹里的图片" />
                            <Button Content="打开数据文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" />
                            <Button Content="删除选中" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                                    ToolTip="把选中的图片从收藏夹和数据文件夹里删除" />
                        </WrapPanel>
                    </Grid>

                    <!-- 收藏网格：单击一张就触发动作（不是双击） -->
                    <Grid Grid.Row="1" Margin="10,0,10,10">
                        <ListBox x:Name="ItemList"
                                 ItemsSource="{Binding VisibleItems}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 Style="{StaticResource FileListStyle}"
                                 ItemContainerStyle="{StaticResource MemeTileStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 core:ScrollChaining.Enabled="True"
                                 PreviewMouseLeftButtonUp="OnItemMouseLeftButtonUp"
                                 PreviewMouseRightButtonDown="OnItemPreviewMouseRightButtonDown"
                                 ToolTip="单击图片：复制到剪贴板并按设置粘贴到 QQ；右键：更多操作">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding HintText}">
                                        <Border Height="150"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                       MaxWidth="150" MaxHeight="150"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="🖼️" FontSize="30"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                                            </Grid>
                                        </Border>

                                        <!-- 文件名最多两行，超出省略（完整路径在悬停提示里） -->
                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="32"
                                                   Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <!-- 右键菜单：必须套 DarkContextMenuStyle + 隐式 DarkMenuLeafItemStyle / DarkMenuSeparatorStyle（AGENTS.md 规则 13） -->
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <ContextMenu.Resources>
                                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource DarkMenuLeafItemStyle}" />
                                        <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource DarkMenuSeparatorStyle}" />
                                    </ContextMenu.Resources>

                                    <MenuItem Header="仅复制这张" Command="{Binding CopyOnlyCommand}" />
                                    <MenuItem Header="粘贴到 QQ" Command="{Binding PasteToQqCommand}" />
                                    <Separator />
                                    <MenuItem Header="打开所在位置" Command="{Binding OpenItemLocationCommand}" />
                                    <MenuItem Header="从收藏删除" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <!-- 空状态 / 搜索无结果的提示 -->
                        <TextBlock Text="{Binding EmptyHint}"
                                   Visibility="{Binding HasVisibleItems, Converter={StaticResource InverseBoolToVis}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 左右分隔条：拖动改「收藏网格」与「设置」的宽度（双击恢复这一处） -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="meme-board.收藏与设置" />

            <!-- ===== 右：设置 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,16,18,10">
                        <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" />
                    </Grid>

                    <!-- 内容比卡片高时自己滚，滚到头交给页面 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="18,0,18,18">

                            <!-- ① 点击图片后 -->
                            <TextBlock Text="点击图片后" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                            <StackPanel>
                                <RadioButton x:Name="PasteRadio" GroupName="MemeActionMode"
                                             Content="复制并粘贴到 QQ（默认）"
                                             IsChecked="{Binding Cfg.IsPasteToQq, Mode=TwoWay}"
                                             Style="{StaticResource RadioButtonStyle}"
                                             ToolTip="复制到剪贴板 → 切到目标 QQ 窗口 → 校验会话 → Ctrl+V" />
                                <RadioButton x:Name="ClipboardOnlyRadio" GroupName="MemeActionMode"
                                             Content="仅复制到剪贴板（防风控）"
                                             IsChecked="{Binding Cfg.IsClipboardOnly, Mode=TwoWay}"
                                             Style="{StaticResource RadioButtonStyle}" Margin="0,10,0,0"
                                             ToolTip="完全不操作 QQ，图片只放到剪贴板，由你手动粘贴" />
                            </StackPanel>

                            <TextBlock Text="自动发送：" Style="{StaticResource HintTextStyle}" Margin="0,10,0,0" />
                            <CheckBox x:Name="AutoSendCheckBox"
                                      Content="粘贴后自动发送（模拟回车）"
                                      IsChecked="{Binding Cfg.AutoSend}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,4,0,0"
                                      ToolTip="关闭后只把图片粘贴进 QQ 输入框，发送由你自己按回车" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最短等待" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Slider Grid.Column="1" Margin="10,0,0,0"
                                        Minimum="0.2" Maximum="5" SmallChange="0.1" LargeChange="0.5"
                                        Value="{Binding DelayMinSeconds, Mode=TwoWay}"
                                        Style="{StaticResource SliderStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding DelayMinSeconds, StringFormat={}{0:0.0} 秒}"
                                           Style="{StaticResource SliderValueStyle}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最长等待" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Slider Grid.Column="1" Margin="10,0,0,0"
                                        Minimum="0.2" Maximum="5" SmallChange="0.1" LargeChange="0.5"
                                        Value="{Binding DelayMaxSeconds, Mode=TwoWay}"
                                        Style="{StaticResource SliderStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding DelayMaxSeconds, StringFormat={}{0:0.0} 秒}"
                                           Style="{StaticResource SliderValueStyle}" />
                            </Grid>

                            <TextBlock Text="{Binding DelayRangeText}" Style="{StaticResource HintTextStyle}" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="只有开启「自动发送」时才生效：粘贴确认后随机等一小会儿，且发送前会再确认前台仍是同一个 QQ 窗口。" />

                            <!-- ② 目标 QQ 窗口 -->
                            <TextBlock Text="目标 QQ 窗口" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TargetCombo"
                                          ItemsSource="{Binding Windows}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ToolTip="只列出读得到会话名的 QQ 聊天窗口（主窗口或独立聊天窗口）" />
                                <Button x:Name="RefreshWindowsButton" Grid.Column="1" Content="刷新检测"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding RefreshWindowsCommand}"
                                        ToolTip="重新枚举 QQ 窗口并读取每个窗口当前的会话名" />
                            </Grid>
                            <TextBlock Text="{Binding TargetStatusText}" Style="{StaticResource HintTextStyle}" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="提示：主窗口要先切到目标群；或者双击群名打开独立聊天窗口。工具只检测 / 校验 / 选择会话，不会自动帮你切换。" />

                            <!-- ③ 安全校验 -->
                            <TextBlock Text="安全校验" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="VerifyCheckBox"
                                      Content="粘贴前校验目标会话（当前会话不一致就中止）"
                                      IsChecked="{Binding Cfg.VerifyTargetChat}"
                                      Style="{StaticResource CheckBoxStyle}"
                                      ToolTip="强烈建议保持开启：图片已经复制到剪贴板，但当前会话不是目标会话时不会往 QQ 里粘贴" />

                            <!-- ④ 日志 -->
                            <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}" />
                            <TextBox x:Name="LogBox"
                                     Text="{Binding LogText, Mode=OneWay}"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     Height="150"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     core:ScrollChaining.Enabled="True" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="清空日志" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ClearLogCommand}" />
                                <Button Content="打开数据文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0" Command="{Binding OpenDataFolderCommand}" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

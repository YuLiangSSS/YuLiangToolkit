<?xml version="1.0"?>
<SyntaxDefinition name="Lua" extensions=".lua" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#57A64A" />
  <Color name="String" foreground="#D69D85" />
  <Color name="Char" foreground="#D69D85" />
  <Color name="NumberLiteral" foreground="#B5CEA8" />
  <Color name="Keywords" foreground="#569CD6" />
  <Color name="Type" foreground="#4EC9B0" />
  <Color name="MethodCall" foreground="#DCDCAA" />
  <Color name="Property" foreground="#9CDCFE" />
  <Color name="Preprocessor" foreground="#9B9B9B" />
  <Color name="Punctuation" foreground="#D4D4D4" />
  <RuleSet>
    <!-- 块注释要放在行注释之前（Lua 的块注释也以两个减号开头） -->
    <Span color="Comment" multiline="true" begin="--\[\[" end="\]\]" />
    <Span color="Comment" begin="--" />
    <!-- 长字符串 [[ ... ]] -->
    <Span color="String" multiline="true" begin="\[\[" end="\]\]" />
    <Span color="String" begin='"' end='"'>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="String" begin="'" end="'">
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    <Keywords color="Keywords">
      <Word>and</Word>
      <Word>break</Word>
      <Word>do</Word>
      <Word>else</Word>
      <Word>elseif</Word>
      <Word>end</Word>
      <Word>false</Word>
      <Word>for</Word>
      <Word>function</Word>
      <Word>goto</Word>
      <Word>if</Word>
      <Word>in</Word>
      <Word>local</Word>
      <Word>nil</Word>
      <Word>not</Word>
      <Word>or</Word>
      <Word>repeat</Word>
      <Word>return</Word>
      <Word>then</Word>
      <Word>true</Word>
      <Word>until</Word>
      <Word>while</Word>
    </Keywords>
    <!-- 常用标准库函数按方法名上色 -->
    <Keywords color="MethodCall">
      <Word>print</Word>
      <Word>pairs</Word>
      <Word>ipairs</Word>
      <Word>require</Word>
      <Word>type</Word>
      <Word>tostring</Word>
      <Word>tonumber</Word>
      <Word>pcall</Word>
      <Word>error</Word>
      <Word>assert</Word>
      <Word>setmetatable</Word>
      <Word>getmetatable</Word>
    </Keywords>
    <Rule color="NumberLiteral">\b(0[xX][0-9a-fA-F]+|\d+(\.\d+)?([eE][+-]?\d+)?|\.\d+)\b</Rule>
    <Rule color="MethodCall">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Punctuation">[{}()\[\],.;:+\-*/%&amp;|&lt;&gt;=!?~^#]+</Rule>
  </RuleSet>
</SyntaxDefinition>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- 「文本编辑器」：AvalonEdit（MIT，见 THIRD-PARTY-NOTICES.md）做编辑内核——
       行号列 / 语法高亮 / 大文件虚拟化 / 撤销重做都由它提供；
       菜单栏 / 标签条 / 查找替换条 / 设置面板是本项目手写的深色界面。 -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>YuLiangToolkit.Tools.TextEditor</RootNamespace>
    <AssemblyName>YuLiangToolkit.Tools.TextEditor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YuLiangToolkit.Core\YuLiangToolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <!-- 语法高亮定义（AvalonEdit xshd）：内置定义没覆盖的新语言 + 按文件名识别的 Dockerfile。
       以嵌入资源编进程序集，运行时由 Core/EditorSyntaxDefinitions.cs 读入并做 VS 深色适配。 -->
  <ItemGroup>
    <EmbeddedResource Include="Highlighting\*.xshd" />
  </ItemGroup>

  <!-- 自检程序直接调用 ViewModel 的内部文件操作 / 自动保存入口（不为了测试另开 public API）。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="YuLiangToolkit.FrameworkSelfCheck" />
  </ItemGroup>

</Project>

<UserControl x:Class="YuLiangToolkit.Tools.TextEditor.Views.TextEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:te="clr-namespace:YuLiangToolkit.Tools.TextEditor"
             xmlns:vm="clr-namespace:YuLiangToolkit.Tools.TextEditor.ViewModels"
             xmlns:conv="clr-namespace:YuLiangToolkit.Tools.TextEditor.Views"
             Background="{DynamicResource WindowBackgroundBrush}"
             AllowDrop="True" Drop="OnDropFile" DragOver="OnDragOverFile"
             Focusable="False">

    <!-- 文本编辑器（参考 Zed）：顶部菜单栏 + 标签条 + 查找替换条 + 编辑器宿主 + 状态栏，
         右侧偏好设置浮层（可拖宽，Esc / × 关闭）。
         ⚠ 每个标签一个 AvalonEdit TextEditor 实例（在 TextEditorView.xaml.cs 里按 ActiveTab 创建），
         全部叠在 EditorHost 里、只显示激活那个 —— 各标签的撤销栈 / 光标 / 滚动互不影响。
         ⚠ 菜单栏必须自定义模板：WPF 默认 MenuItem 模板有「图标列」白底竖条（深色主题下突兀），
           同浏览器右键菜单的教训。
         ⚠ 设置面板浮层的宽度 = 它所在列的宽度（显隐时 304 px / 0，见 PaneWidthConverter）：
           收起时列真的归零、编辑区不被挤窄；拖过的宽度由 PaneSplitter 记忆（别再用 code-behind 改列宽）。 -->

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />

        <!-- 最近文件菜单项标题：长路径截断（完整路径进 ToolTip），不让「打开最近」把菜单撑到屏幕外 -->
        <DataTemplate x:Key="RecentFileHeaderTemplate">
            <TextBlock Text="{Binding}" MaxWidth="480" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <!-- ================= 菜单栏（深色自定义模板） ================= -->

        <!-- Menu 本体：去掉默认 chrome，横向排布顶级菜单 -->
        <Style x:Key="EditorMenuBarStyle" TargetType="Menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Menu">
                        <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶级菜单项（文件 / 编辑 / 查看 / 偏好设置）：模板里带 PART_Popup（子菜单从底部弹出） -->
        <Style x:Key="EditorTopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Row" Background="Transparent"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}" Margin="1,2"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,4,16,16"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" Padding="4"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 子菜单里的父项（打开最近 ▸）：同样带弹层，弹出方向改为右侧 -->
        <Style x:Key="EditorMenuParentStyle" TargetType="MenuItem"
               BasedOn="{StaticResource EditorTopMenuItemStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="IsEnabled" Value="{Binding HasItems, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Row" Background="Transparent"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="›" Margin="24,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="4,0,16,16"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" Padding="4"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 叶子菜单项：勾选列（可勾选项才出现）+ 标题 + 右侧快捷键文案 -->
        <Style x:Key="EditorMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckGlyph" Grid.Column="0" Text="✓"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Margin="28,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        </Style>

        <!-- ================= 标签条（照浏览器的多标签样式） ================= -->

        <!-- 标签条上的小按钮（+ 新建、× 关闭） -->
        <Style x:Key="TabMiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签内容：标题（未保存带 ●） + 关闭按钮；选中 = 卡片底色，悬停 = 行悬停色 -->
        <DataTemplate x:Key="EditorTabItemTemplate" DataType="{x:Type vm:EditorTab}">
            <Border x:Name="Root" Margin="2,3" Padding="9,5"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="Transparent" SnapsToDevicePixels="True">
                <Grid ToolTip="{Binding FilePathText}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Header}" VerticalAlignment="Center"
                               MaxWidth="168" TextTrimming="CharacterEllipsis" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button x:Name="CloseButton" Grid.Column="1" Content="&#xE711;"
                            Style="{StaticResource TabMiniButtonStyle}" Margin="5,0,0,0"
                            ToolTip="关闭标签（Ctrl+W，中键点击也行）"
                            Click="OnTabCloseClick" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="EditorTabItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTabListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemTemplate" Value="{StaticResource EditorTabItemTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource EditorTabItemContainerStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
            <Setter Property="SelectedItem" Value="{Binding ActiveTab, Mode=TwoWay}" />
        </Style>

        <!-- ================= 设置面板小控件 ================= -->

        <!-- 颜色预设小方块 -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>

        <!-- 查找条上的紧凑按钮 -->
        <Style x:Key="FindMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource TabMiniButtonStyle}">
            <Setter Property="Width" Value="28" />
        </Style>

        <!-- ================= 左侧文件浏览器（打开文件夹才出现） ================= -->

        <!-- 展开箭头（无边框小三角，展开时转 90°） -->
        <Style x:Key="EditorTreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="Arrow" Text="&#xE76C;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文件树条目：悬停 / 选中都是主题事件色，不用 WPF 默认的浅蓝选中块 -->
        <Style x:Key="EditorTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" Background="Transparent"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="2,2" Margin="0,0,0,1" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Style="{StaticResource EditorTreeExpanderStyle}"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      RecognizesAccessKey="True" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource CardBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 所有层级的文件树条目都用同一套深色样式（手动构建 TreeViewItem 时也能套上） -->
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource EditorTreeItemStyle}" />

        <!-- ================= 底部控制台 ================= -->

        <!-- 右侧控制台标签列表项：标题 + 关闭 × -->
        <Style x:Key="ConsoleTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="8,5" Margin="0,0,0,1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource CardBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 控制台输出区（只读、等宽字体、不做边框） -->
        <Style x:Key="ConsoleOutputStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 菜单栏 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="4,0" SnapsToDevicePixels="True">
            <Menu Style="{StaticResource EditorMenuBarStyle}">

                <!-- ── 文件 ── -->
                <MenuItem Header="文件" Style="{StaticResource EditorTopMenuItemStyle}">
                    <MenuItem Header="新建" InputGestureText="Ctrl+N"
                              Command="{Binding NewFileCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="打开…" InputGestureText="Ctrl+O"
                              Command="{Binding OpenFileCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="打开最近" Style="{StaticResource EditorMenuParentStyle}"
                              ItemsSource="{Binding RecentItems}">
                        <MenuItem.ItemContainerStyle>
                            <!-- 点击用 EventSetter 走 code-behind：最近列表在 Popup 里，
                                 RelativeSource 找不到上面的 Menu，命令绑定会静默失效 -->
                            <Style TargetType="MenuItem" BasedOn="{StaticResource EditorMenuItemStyle}">
                                <Setter Property="Header" Value="{Binding}" />
                                <Setter Property="HeaderTemplate" Value="{StaticResource RecentFileHeaderTemplate}" />
                                <Setter Property="ToolTip" Value="{Binding}" />
                                <EventSetter Event="Click" Handler="OnRecentFileClick" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="打开文件夹…" InputGestureText="Ctrl+Shift+O"
                              Command="{Binding OpenFolderCommand}" Style="{StaticResource EditorMenuItemStyle}"
                              ToolTip="选一个文件夹作为工作区，左侧出现文件浏览器（跟 Zed 一样）" />
                    <MenuItem Header="关闭文件夹" Command="{Binding CloseFolderCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="刷新文件浏览器" Command="{Binding RefreshFolderCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="保存" InputGestureText="Ctrl+S"
                              Command="{Binding SaveCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="另存为…" InputGestureText="Ctrl+Shift+S"
                              Command="{Binding SaveAsCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="全部保存" Command="{Binding SaveAllCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="关闭标签" InputGestureText="Ctrl+W"
                              Command="{Binding CloseTabCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="关闭全部" Command="{Binding CloseAllCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                </MenuItem>

                <!-- ── 编辑 ── -->
                <MenuItem Header="编辑" Style="{StaticResource EditorTopMenuItemStyle}">
                    <MenuItem Header="撤销" InputGestureText="Ctrl+Z"
                              Command="{Binding UndoCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="重做" InputGestureText="Ctrl+Y"
                              Command="{Binding RedoCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="剪切" InputGestureText="Ctrl+X"
                              Command="{Binding CutCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="复制" InputGestureText="Ctrl+C"
                              Command="{Binding CopyCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="粘贴" InputGestureText="Ctrl+V"
                              Command="{Binding PasteCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="全选" InputGestureText="Ctrl+A"
                              Command="{Binding SelectAllCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="查找" InputGestureText="Ctrl+F"
                              Command="{Binding FindCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="替换" InputGestureText="Ctrl+H"
                              Command="{Binding ReplaceCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                </MenuItem>

                <!-- ── 查看 ── -->
                <MenuItem Header="查看" Style="{StaticResource EditorTopMenuItemStyle}">
                    <MenuItem Header="放大" InputGestureText="Ctrl+="
                              Command="{Binding ZoomInCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="缩小" InputGestureText="Ctrl+-"
                              Command="{Binding ZoomOutCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="重置缩放" InputGestureText="Ctrl+0"
                              Command="{Binding ResetZoomCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="行号" IsCheckable="True"
                              IsChecked="{Binding Cfg.ShowLineNumbers, Mode=TwoWay}"
                              Style="{StaticResource EditorMenuItemStyle}"
                              ToolTip="在编辑区左侧显示行号（设置里也能调）" />
                    <MenuItem Header="自动换行" IsCheckable="True"
                              IsChecked="{Binding Cfg.WordWrap, Mode=TwoWay}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="文件浏览器" IsCheckable="True"
                              IsChecked="{Binding Cfg.ShowWorkspaceSidebar, Mode=TwoWay}"
                              IsEnabled="{Binding HasWorkspace}"
                              InputGestureText="Ctrl+B"
                              Style="{StaticResource EditorMenuItemStyle}"
                              ToolTip="打开文件夹后才可用；Ctrl+B 展开 / 收起左侧文件浏览器" />
                    <MenuItem Header="显示 / 隐藏控制台" InputGestureText="Ctrl+`"
                              Command="{Binding ToggleTerminalCommand}"
                              Style="{StaticResource EditorMenuItemStyle}"
                              ToolTip="底部控制台（CMD / PowerShell 标签页）" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="Markdown 预览" IsCheckable="True"
                              IsChecked="{Binding Cfg.ShowMarkdownPreview, Mode=TwoWay}"
                              InputGestureText="Ctrl+Shift+M"
                              Style="{StaticResource EditorMenuItemStyle}"
                              ToolTip="打开 .md 文件时在编辑区下方显示「实际效果预览」（排版 / 表格 / 代码块都真渲染）" />
                </MenuItem>

                <!-- ── 终端（底部控制台：CMD / PowerShell 标签页） ── -->
                <MenuItem Header="终端" Style="{StaticResource EditorTopMenuItemStyle}">
                    <MenuItem Header="显示 / 隐藏控制台" InputGestureText="Ctrl+`"
                              Command="{Binding ToggleTerminalCommand}" Style="{StaticResource EditorMenuItemStyle}" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="新建 CMD 控制台" Command="{Binding NewCmdConsoleCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="新建 PowerShell 控制台" Command="{Binding NewPowerShellConsoleCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="清空当前控制台" Command="{Binding ClearConsoleCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="停止当前命令" Command="{Binding StopConsoleCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                    <MenuItem Header="关闭当前控制台" Command="{Binding CloseConsoleCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                </MenuItem>

                <!-- ── 偏好设置 ── -->
                <MenuItem Header="偏好设置" Style="{StaticResource EditorTopMenuItemStyle}">
                    <MenuItem Header="打开偏好设置面板" Command="{Binding ShowSettingsCommand}"
                              Style="{StaticResource EditorMenuItemStyle}"
                              ToolTip="字体 / 字号 / 行距 / 缩放 / 背景颜色 / 行号 / 自动换行 / 缩进 / 自动保存" />
                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}" />
                    <MenuItem Header="重置缩放为 100%" Command="{Binding ResetZoomCommand}"
                              Style="{StaticResource EditorMenuItemStyle}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ================= 主区域 = 文件浏览器 + 编辑列 + 偏好设置浮层 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="0" MaxWidth="520" />
                <!-- 左侧文件浏览器：打开文件夹才占宽度（关着时 0，编辑区拿回空间） -->
                <ColumnDefinition Width="Auto" />
                <!-- 文件浏览器与编辑区的分隔条 -->
                <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="320" />
                <!-- 编辑列：随窗口缩放 -->
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <!-- 分隔条自己的列（样式定宽 12；设置关着时跟着归零） -->
                <ColumnDefinition x:Name="SettingsColumn" Width="0" MaxWidth="640" />
                <!-- 设置浮层：显示 = 304 px（拖过由 PaneSplitter 记忆，宽度由 code-behind 按记忆值设），
                     关着 = 0（真的不占编辑区宽度）。⚠ 别在这里写 Binding：ColumnDefinition 不在逻辑树 /
                     视觉树里，拿不到 DataContext，绑定会静默失效。 -->
            </Grid.ColumnDefinitions>

            <!-- ── 左侧文件浏览器（打开文件夹才出现；Zed 那种工作区侧栏） ── -->
            <Border x:Name="WorkspacePanel" Grid.Column="0" Visibility="Collapsed"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,8,6,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding WorkspaceName}" FontSize="12.5" FontWeight="SemiBold"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Cfg.LastFolder}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#xE72C;" Style="{StaticResource TabMiniButtonStyle}"
                                ToolTip="刷新文件浏览器" Command="{Binding RefreshFolderCommand}" />
                        <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource TabMiniButtonStyle}"
                                ToolTip="关闭文件夹" Command="{Binding CloseFolderCommand}" />
                    </Grid>
                    <Border DockPanel.Dock="Bottom" Padding="10,6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Text="双击文件在编辑器中打开" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <TreeView x:Name="WorkspaceFileTree" Background="Transparent" BorderThickness="0"
                              Padding="4,4,4,8"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              MouseDoubleClick="OnWorkspaceTreeDoubleClick" />
                </DockPanel>
            </Border>

            <!-- 文件浏览器与编辑区的分隔条（打开文件夹才出现；拖动宽度随界面布局一起记住） -->
            <core:PaneSplitter x:Name="SidebarSplitter" Grid.Column="1"
                               Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="text-editor.文件浏览器与编辑区"
                               Visibility="Collapsed" />

            <!-- ── 编辑列：标签条 / 查找条 / 编辑器宿主 / Markdown 预览 / 底部控制台 ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="PreviewRow" Height="0" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="TerminalRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- 标签条 -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="6,2" SnapsToDevicePixels="True">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE710;" ToolTip="新建标签页（Ctrl+N）"
                                Style="{StaticResource TabMiniButtonStyle}" Margin="4,0,2,0"
                                VerticalAlignment="Center" Command="{Binding NewFileCommand}" />
                        <Button DockPanel.Dock="Right" Content="&gt;_" ToolTip="打开 / 隐藏控制台（Ctrl+`）"
                                Style="{StaticResource TabMiniButtonStyle}" Margin="4,0,2,0"
                                VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                Command="{Binding ToggleTerminalCommand}" />
                        <Button DockPanel.Dock="Right" Content="&#xE8B7;" ToolTip="打开文件夹（Ctrl+Shift+O）"
                                Style="{StaticResource TabMiniButtonStyle}" Margin="4,0,2,0"
                                VerticalAlignment="Center" Command="{Binding OpenFolderCommand}" />
                        <ListBox x:Name="TabList" Style="{StaticResource EditorTabListBoxStyle}"
                                 ItemsSource="{Binding Tabs}"
                                 PreviewMouseDown="OnTabListMouseDown"
                                 PreviewMouseWheel="OnTabListMouseWheel">
                            <!-- ⚠ 必须显式横向排布：ListBox 默认 ItemsPanel 是纵向 VirtualizingStackPanel，
                                 不加这一段标签会竖着叠、只看得见第一个 -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 查找 / 替换条（Ctrl+F / Ctrl+H 呼出，Esc 关闭） -->
                <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="FindBox" Width="230" Height="28"
                                     Style="{StaticResource TextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="查找内容（回车 = 下一个，Shift+回车 = 上一个）"
                                     TextChanged="OnFindContextChanged"
                                     KeyDown="OnFindBoxKeyDown" />
                            <Button Content="&#x25B2;" Style="{StaticResource FindMiniButtonStyle}"
                                    Margin="6,0,0,0" ToolTip="上一个（Shift+F3）"
                                    Click="OnFindPreviousClick" FontFamily="Segoe UI Symbol" />
                            <Button Content="&#x25BC;" Style="{StaticResource FindMiniButtonStyle}"
                                    ToolTip="下一个（F3 / 回车）"
                                    Click="OnFindNextClick" FontFamily="Segoe UI Symbol" />
                            <TextBlock x:Name="FindCountText" Text="" VerticalAlignment="Center"
                                       Margin="8,0,0,0" FontSize="11.5" MinWidth="52"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <CheckBox x:Name="FindCaseBox" Content="区分大小写"
                                      Style="{StaticResource CheckBoxStyle}" Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      Checked="OnFindContextChanged" Unchecked="OnFindContextChanged" />
                            <Button x:Name="ReplaceToggle" Content="替换" Padding="10,4"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                                    VerticalAlignment="Center" ToolTip="展开 / 收起替换行"
                                    Click="OnReplaceToggleClick" />
                            <Button Content="&#xE711;" Style="{StaticResource FindMiniButtonStyle}"
                                    Margin="6,0,0,0" ToolTip="关闭（Esc）"
                                    Click="OnFindCloseClick" />
                        </StackPanel>
                        <StackPanel x:Name="ReplaceRow" Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="Collapsed">
                            <TextBox x:Name="ReplaceBox" Width="230" Height="28"
                                     Style="{StaticResource TextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="替换为（回车 = 替换当前并找下一个）"
                                     KeyDown="OnReplaceBoxKeyDown" />
                            <Button Content="替换" Padding="12,5" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="6,0,0,0" Click="OnReplaceClick" />
                            <Button Content="全部替换" Padding="12,5" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="6,0,0,0" Click="OnReplaceAllClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 编辑器宿主：每个标签一个 TextEditor，只显示激活的（代码后置按需创建） -->
                <Grid x:Name="EditorHost" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}"
                      PreviewMouseWheel="OnEditorHostPreviewMouseWheel" />

                <!-- 没有标签时的空背景：跟标签栏同色（不自动补无标题标签；右侧 + / 文件夹 / 控制台按钮照常可用） -->
                <Border x:Name="EmptyEditorPlaceholder" Grid.Row="2" Visibility="Collapsed"
                        Background="{DynamicResource HeaderBackgroundBrush}" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85">
                        <TextBlock Text="没有打开的标签" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Ctrl+N 新建 · Ctrl+O 打开文件 · Ctrl+Shift+O 打开文件夹"
                                   FontSize="11.5" Margin="0,7,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Markdown「实际效果预览」：编辑区下方，打开 .md 且设置里没关预览时才出现；
                     高度可拖（PaneSplitter 记忆），双击缝隙恢复默认高度 -->
                <core:PaneSplitter x:Name="PreviewSplitter" Grid.Row="3"
                                   Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="text-editor.Markdown预览与编辑区"
                                   Visibility="Collapsed" />
                <Border x:Name="PreviewPanel" Grid.Row="4" Visibility="Collapsed"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="12,6,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Markdown 预览" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="实时更新 · 本地图片会显示" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource TabMiniButtonStyle}"
                                    ToolTip="关闭预览（查看 → Markdown 预览，Ctrl+Shift+M）"
                                    Click="OnPreviewCloseClick" />
                        </Grid>
                        <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                                  IsToolBarVisible="False" IsSelectionEnabled="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Background="Transparent" Padding="0" />
                    </DockPanel>
                </Border>

            <!-- ── 底部控制台（左：输出 + 输入；右：控制台标签页列表，可选用 CMD / PowerShell） ── -->
            <core:PaneSplitter x:Name="TerminalSplitter" Grid.Row="5"
                               Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="text-editor.控制台与编辑区"
                               Visibility="Collapsed" />
            <Border x:Name="TerminalPanel" Grid.Row="6" Visibility="Collapsed"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：当前控制台（工具条 + 输出 + 输入行） -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="10,5,8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveConsole.Title}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveConsole.WorkingDirectory}" FontSize="11" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center"
                                           ToolTip="{Binding ActiveConsole.WorkingDirectory}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="清空" Padding="8,3" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ClearConsoleCommand}" ToolTip="清空当前控制台输出（Ctrl+L）" />
                                <Button Content="停止" Padding="8,3" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6,0,0,0" Command="{Binding StopConsoleCommand}"
                                        ToolTip="停止当前正在跑的命令（会杀子进程树）" />
                                <Button Content="&#xE711;" Style="{StaticResource TabMiniButtonStyle}"
                                        Margin="6,0,0,0" Command="{Binding CloseConsoleCommand}"
                                        ToolTip="关闭当前控制台标签页" />
                            </StackPanel>
                        </DockPanel>

                        <TextBox x:Name="ConsoleOutput" Grid.Row="1" Style="{StaticResource ConsoleOutputStyle}"
                                 Text="{Binding ActiveConsole.OutputText, Mode=OneWay}"
                                 TextChanged="OnConsoleOutputTextChanged" />

                        <DockPanel Grid.Row="2" Margin="10,0,8,8">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ActiveConsole.Prompt}"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button DockPanel.Dock="Right" Content="运行" Padding="12,4"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"
                                    Command="{Binding RunConsoleCommand}" ToolTip="运行输入的命令（回车）" />
                            <TextBox x:Name="ConsoleInput" Height="30" Style="{StaticResource TextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                     Text="{Binding ActiveConsole.Input, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnConsoleInputKeyDown"
                                     ToolTip="输入命令，回车执行；↑ / ↓ 翻命令历史；Ctrl+L 清屏" />
                        </DockPanel>
                    </Grid>

                    <!-- 右：控制台标签页列表（在这里选用哪个控制台） -->
                    <Border Grid.Column="1" Width="164"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="控制台" FontSize="11.5" FontWeight="SemiBold"
                                       Margin="10,7,8,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,6,6">
                                <Button Content="+ CMD" Height="26" Width="72" Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding NewCmdConsoleCommand}" ToolTip="新建 CMD 控制台"
                                        FontSize="11" />
                                <Button Content="+ PS" Height="26" Width="72" Margin="6,0,0,0" Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding NewPowerShellConsoleCommand}" ToolTip="新建 PowerShell 控制台"
                                        FontSize="11" />
                            </StackPanel>
                            <ListBox x:Name="ConsoleTabList" ItemsSource="{Binding Consoles}"
                                     SelectedItem="{Binding ActiveConsole, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="4,0,4,4"
                                     ItemContainerStyle="{StaticResource ConsoleTabItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding WorkingDirectory}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                           ToolTip="{Binding WorkingDirectory}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="&#xE711;"
                                                    Style="{StaticResource TabMiniButtonStyle}"
                                                    ToolTip="关闭这个控制台" VerticalAlignment="Center"
                                                    Click="OnConsoleTabCloseClick" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            </Grid>

            <!-- 偏好设置与编辑区的分隔条（设置面板开着才出现；拖动宽度随界面布局一起记住） -->
            <core:PaneSplitter Grid.Column="3" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="text-editor.偏好设置与编辑区"
                               Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}" />

            <!-- ── 偏好设置浮层（页内面板，Esc / × 关闭；宽度由所在列决定，可拖） ── -->
            <Border Grid.Column="4"
                    Margin="0,8,8,8" Padding="16,14"
                    Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="偏好设置" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource TabMiniButtonStyle}"
                                ToolTip="关闭（Esc）" Command="{Binding CloseSettingsCommand}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="字体" Style="{StaticResource SettingLabelStyle}" Margin="0,4,0,5" />
                            <ComboBox ItemsSource="{x:Static te:TextEditorConfig.FontPresets}"
                                      SelectedItem="{Binding Cfg.FontName}"
                                      Style="{StaticResource ComboBoxStyle}"
                                      ToolTip="等宽字体预设（系统里没装的会自动回退默认字体）" />

                            <TextBlock Text="字号" Style="{StaticResource SettingLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="{x:Static te:TextEditorConfig.MinFontSize}"
                                        Maximum="{x:Static te:TextEditorConfig.MaxFontSize}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Style="{StaticResource SliderStyle}" VerticalAlignment="Center"
                                        Value="{Binding Cfg.FontSize}" />
                                <TextBlock Grid.Column="1" MinWidth="38" TextAlignment="Right"
                                           VerticalAlignment="Center" FontSize="12"
                                           Text="{Binding Cfg.FontSize, StringFormat={}{0:0}px}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <TextBlock Text="行距" Style="{StaticResource SettingLabelStyle}"
                                       ToolTip="行与行之间的间距（1.0 = 默认紧凑行高，1.2 = 稍松一点）" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="{x:Static te:TextEditorConfig.MinLineSpacing}"
                                        Maximum="{x:Static te:TextEditorConfig.MaxLineSpacing}"
                                        TickFrequency="{x:Static te:TextEditorConfig.LineSpacingStep}"
                                        IsSnapToTickEnabled="True"
                                        Style="{StaticResource SliderStyle}" VerticalAlignment="Center"
                                        Value="{Binding Cfg.LineSpacing}" />
                                <TextBlock Grid.Column="1" MinWidth="42" TextAlignment="Right"
                                           VerticalAlignment="Center" FontSize="12"
                                           Text="{Binding Cfg.LineSpacing, StringFormat={}{0:0.00}×}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <TextBlock Text="界面缩放（编辑区文字）" Style="{StaticResource SettingLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="{x:Static te:TextEditorConfig.MinZoomPercent}"
                                        Maximum="{x:Static te:TextEditorConfig.MaxZoomPercent}"
                                        Style="{StaticResource SliderStyle}" VerticalAlignment="Center"
                                        Value="{Binding Cfg.ZoomPercent}" />
                                <TextBlock Grid.Column="1" MinWidth="42" TextAlignment="Right"
                                           VerticalAlignment="Center" FontSize="12"
                                           Text="{Binding Cfg.ZoomPercent, StringFormat={}{0:0.#}%}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <TextBlock Text="背景颜色（点击色板一起换文字颜色）" Style="{StaticResource SettingLabelStyle}" />
                            <ItemsControl ItemsSource="{x:Static te:TextEditorConfig.BackgroundPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="0,0,6,6"
                                                Style="{StaticResource ColorSwatchStyle}"
                                                Background="{Binding Background, Converter={StaticResource HexToBrush}}"
                                                ToolTip="{Binding Name}"
                                                Click="OnBackgroundPresetClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{Binding Cfg.BackgroundHex, Converter={StaticResource HexToBrush}}" />
                                <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                         Style="{StaticResource TextBoxStyle}"
                                         ToolTip="自定义背景色（#RRGGBB 或 #AARRGGBB）"
                                         Text="{Binding Cfg.BackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBlock Text="文字颜色" Style="{StaticResource SettingLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{Binding Cfg.ForegroundHex, Converter={StaticResource HexToBrush}}" />
                                <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                                         Style="{StaticResource TextBoxStyle}"
                                         ToolTip="自定义文字颜色（#RRGGBB 或 #AARRGGBB）"
                                         Text="{Binding Cfg.ForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Separator Margin="0,12" Background="{DynamicResource BorderBrush}" />

                            <CheckBox Content="自动保存（改完自动写回文件）" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.AutoSave}"
                                      ToolTip="编辑区一有改动，停手约 0.9 秒自动写回原文件；无标题标签要先 Ctrl+S 选一次位置" />
                            <CheckBox Content="显示行号" Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0"
                                      IsChecked="{Binding Cfg.ShowLineNumbers}"
                                      ToolTip="在编辑区左侧显示行号列" />
                            <CheckBox Content="自动换行" Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0"
                                      IsChecked="{Binding Cfg.WordWrap}" />
                            <CheckBox Content="Tab 键输入空格" Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0"
                                      IsChecked="{Binding Cfg.ConvertTabsToSpaces}" />

                            <TextBlock Text="缩进宽度" Style="{StaticResource SettingLabelStyle}" />
                            <ComboBox ItemsSource="{x:Static te:TextEditorConfig.IndentPresets}"
                                      SelectedItem="{Binding Cfg.IndentSize}"
                                      Style="{StaticResource ComboBoxStyle}" MaxWidth="120"
                                      HorizontalAlignment="Left"
                                      ToolTip="按 Tab / 自动缩进时用几个空格（关掉「Tab 键输入空格」则是一个制表符的显示宽度）" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= 状态栏（纯信息条） ================= -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,4" SnapsToDevicePixels="True">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CaretText}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="·" Margin="8,0" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource FaintTextBrush}" />
                    <TextBlock Text="{Binding CharCountText}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="·" Margin="8,0" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource FaintTextBrush}" />
                    <TextBlock Text="{Binding EncodingText}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               ToolTip="文件编码（打开时自动探测，保存按原编码写回）" />
                    <TextBlock Text="·" Margin="8,0" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource FaintTextBrush}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                               MaxWidth="360" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ActivePathText}" FontSize="11.5"
                           VerticalAlignment="Center" MaxWidth="420"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Cfg.ZoomPercent, StringFormat=缩放 {0:0.#}%}"
                           FontSize="11.5" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

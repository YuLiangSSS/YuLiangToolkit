<UserControl x:Class="YuLiangToolkit.Tools.PdfReader.Views.PdfReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E1014">

    <!-- PDF 阅读器界面：顶部一条工具条，下面整块都是阅读区。
         连续滚动（纵向 / 横向）用 ScrollViewer + Canvas，页面由代码后置**按需渲染、只保留可见页**；
         双页翻页用另一个 Canvas（左右两页并排 + 翻页滑动动画）。
         鼠标拖拽 / 惯性 / 键盘都在代码后置里（见 PdfReaderView.xaml.cs 与 docs/dev/pitfalls.md）。 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 顶部工具条 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="📄 打开 PDF…" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OpenPdfCommand}" VerticalAlignment="Center"
                        ToolTip="打开一个 PDF 文件（Ctrl+O）" />

                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileTitleText}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FilePathText}" FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                               ToolTip="{Binding FilePathText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ModeCombo" Width="122" Height="30"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedMode}"
                              ToolTip="{Binding ModeHint}" />

                    <CheckBox x:Name="InertiaCheckBox" Content="惯性" Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding Cfg.InertiaEnabled}"
                              ToolTip="连续滚动模式下，左键拖动松手后按甩动速度继续滑一段（越甩越快有上限）" />

                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="8,0"
                            Visibility="{Binding IsSpreadMode, Converter={StaticResource BoolToVis}}" />

                    <Button x:Name="ToolbarPrevButton" Width="32" Height="30" Padding="0"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                            Visibility="{Binding IsSpreadMode, Converter={StaticResource BoolToVis}}"
                            Click="OnPrevPageClick" ToolTip="上一屏（PgUp / ←）">
                        <Path Data="M 10,2 L 2,12 L 10,22" Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="9" Height="18" />
                    </Button>
                    <Button x:Name="ToolbarNextButton" Width="32" Height="30" Padding="0" Margin="5,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                            Visibility="{Binding IsSpreadMode, Converter={StaticResource BoolToVis}}"
                            Click="OnNextPageClick" ToolTip="下一屏（PgDn / → / 空格）">
                        <Path Data="M 2,2 L 10,12 L 2,22" Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="9" Height="18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 阅读区 ================= -->
        <Grid Grid.Row="1" x:Name="ViewportGrid" Background="#0E1014" ClipToBounds="True">

            <!-- 连续滚动（纵向 上→下 / 横向 左→右）：Canvas 尺寸 = 整条长带，只放可见页的 Image -->
            <ScrollViewer x:Name="ContinuousScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          Focusable="False"
                          PanningMode="None"
                          ScrollChanged="OnContinuousScrollChanged">
                <Canvas x:Name="PageCanvas" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="Transparent" />
            </ScrollViewer>

            <!-- ================= 双页翻页 ================= -->
            <Grid x:Name="SpreadHost" Visibility="Collapsed" Background="#0E1014">
                <Grid x:Name="SpreadViewport" Background="#0E1014" ClipToBounds="True">
                    <Canvas x:Name="SpreadCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Grid>

                <Button x:Name="PrevPageButton" Click="OnPrevPageClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="46" Height="76" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                        ToolTip="上一屏（PgUp / ←）">
                    <Path Data="M 10,2 L 2,12 L 10,22" Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="12" Height="24" />
                </Button>
                <Button x:Name="NextPageButton" Click="OnNextPageClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="46" Height="76" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        ToolTip="下一屏（PgDn / → / 空格）">
                    <Path Data="M 2,2 L 10,12 L 2,22" Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="12" Height="24" />
                </Button>
            </Grid>

            <!-- 阅读进度（细条，不参与命中测试） -->
            <Grid x:Name="ReadingProgressPanel" Height="3" VerticalAlignment="Bottom"
                  IsHitTestVisible="False" Background="#1A1F28">
                <Border x:Name="ReadingProgressFill" HorizontalAlignment="Left" Width="0"
                        Background="{DynamicResource AccentBrush}" />
            </Grid>

            <!-- 底部左侧：当前模式的操作提示 -->
            <Border x:Name="HintPanel" Background="#99000000" CornerRadius="10" Padding="10,4"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,16"
                    IsHitTestVisible="False">
                <TextBlock x:Name="HintText" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="滚轮滚动 · 左键按住拖动，松手惯性滑一段" />
            </Border>

            <!-- 底部中间：页码 -->
            <Border x:Name="PageIndicatorPanel" Background="#B0000000" CornerRadius="12"
                    Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,18" IsHitTestVisible="False">
                <TextBlock x:Name="PageIndicatorText" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" Text="第 1 / 1 页" />
            </Border>

            <!-- 错误提示（打开失败 / 某页渲染失败；几秒后自动消失） -->
            <Border x:Name="ErrorToast" Background="#E63A1F24" BorderBrush="#B08A4A4A"
                    BorderThickness="1" CornerRadius="10" Padding="14,8"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ErrorToastText" FontSize="11.5" MaxWidth="760" TextWrapping="Wrap"
                           Foreground="#FFFFB4B4" TextAlignment="Center" />
            </Border>

            <!-- 空状态：还没打开 PDF -->
            <Border x:Name="EmptyPanel" Background="#0E1014"
                    Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                    <TextBlock Text="📄" FontSize="46" HorizontalAlignment="Center" />
                    <TextBlock Text="打开一个 PDF，上下 / 左右滚动着看" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                               Text="三种阅读方式：纵向 上→下、横向 左→右（连续滚动），双页翻页（左右两页并排，一次翻过去）。&#10;连续模式用滚轮 / 左键拖动（松手带惯性）；双页模式用滚轮 / 方向键 / 空格 / 屏幕按钮翻页。" />
                    <Button Content="📄 打开 PDF…" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenPdfCommand}" HorizontalAlignment="Center"
                            Margin="0,20,0,0" Padding="20,9" />
                    <TextBlock x:Name="EmptyStatusText" FontSize="11.5" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="#FFB45A5A" Margin="0,14,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- 加载遮罩（打开 PDF / 读页数时显示） -->
            <Border x:Name="LoadingPanel" Background="#C0000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                    <TextBlock Text="正在打开 PDF…" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <ProgressBar Style="{StaticResource ProgressBarStyle}" IsIndeterminate="True"
                                 Height="6" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

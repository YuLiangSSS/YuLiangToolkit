<UserControl x:Class="YuLiangToolkit.Tools.PdfReader.Views.PdfReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E1014"
             Focusable="True">

    <UserControl.Resources>
        <!-- 目录面板里的一行：像列表项，悬停高亮 -->
        <Style x:Key="OutlineItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 小图标按钮（搜索上一个 / 下一个 / 清除） -->
        <Style x:Key="SmallIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- PDF 阅读器界面：顶部两行工具条（打开 / 搜索 / 目录 / 设置 / 阅读方式 / 缩放），
         下面整块是阅读区。连续滚动（纵向 / 横向）用 ScrollViewer + Canvas，页面按需渲染、只保留可见页；
         双页翻页用另一个 Canvas（左右两页并排 + 翻页滑动动画 + 缩放后拖动平移）。
         鼠标拖拽 / 惯性 / 键盘都在代码后置里（见 PdfReaderView.xaml.cs 与 docs/dev/pitfalls.md）。 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 顶部工具条 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel>
                <!-- 第一行：打开 / 文件信息 / 搜索 / 目录 / 设置 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Content="📄 打开 PDF…" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenPdfCommand}" VerticalAlignment="Center"
                            ToolTip="打开一个 PDF 文件（Ctrl+O）" />

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileTitleText}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FilePathText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   ToolTip="{Binding FilePathText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 文字搜索：输入框 + 命中计数 + 上一个 / 下一个 / 清除 -->
                        <Grid Width="186" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Height="28" Padding="8,0" VerticalContentAlignment="Center"
                                     Style="{StaticResource TextBoxStyle}"
                                     TextChanged="OnSearchTextChanged"
                                     PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                                     ToolTip="在全文中搜索文字（Ctrl+F；回车 = 下一个，Shift+回车 = 上一个，Esc = 清除）" />
                            <TextBlock Text="搜索文字 (Ctrl+F)" Margin="10,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                        <TextBlock x:Name="SearchCountText" MinWidth="78" FontSize="10.5" Margin="6,0,2,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button x:Name="SearchPrevButton" Style="{StaticResource SmallIconButtonStyle}"
                                Click="OnSearchPrevClick" ToolTip="上一个命中（Shift+Enter）" IsEnabled="False">
                            <Path Data="M 10,2 L 2,8 L 10,14" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="7" Height="14" />
                        </Button>
                        <Button x:Name="SearchNextButton" Style="{StaticResource SmallIconButtonStyle}"
                                Click="OnSearchNextClick" ToolTip="下一个命中（Enter）" IsEnabled="False">
                            <Path Data="M 2,2 L 10,8 L 2,14" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="7" Height="14" />
                        </Button>
                        <Button x:Name="SearchClearButton" Style="{StaticResource SmallIconButtonStyle}"
                                Click="OnSearchClearClick" ToolTip="清除搜索（Esc）">
                            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="9" Height="9" />
                        </Button>

                        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="6,0" />

                        <Button Content="📑 目录" Style="{StaticResource SecondaryButtonStyle}" Height="28"
                                Padding="10,0" Command="{Binding ToggleOutlineCommand}"
                                ToolTip="书签目录 / 大纲：点条目跳到对应页" />
                        <Button Content="⚙ 设置" Style="{StaticResource SecondaryButtonStyle}" Height="28"
                                Padding="10,0" Margin="6,0,0,0" Command="{Binding ToggleSettingsCommand}"
                                ToolTip="双页页面间距 / 文件关联 / 恢复默认设置" />
                    </StackPanel>
                </Grid>

                <!-- 第二行：阅读方式 / 惯性 / 缩放 / 双页翻页按钮 -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="阅读方式" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="ModeCombo" Width="122" Height="28"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedMode}"
                                  ToolTip="{Binding ModeHint}" />

                        <CheckBox x:Name="InertiaCheckBox" Content="惯性" Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Cfg.InertiaEnabled}"
                                  ToolTip="按住左键拖动松手后，按甩动速度继续滑一段（连续滚动 / 双页平移都生效）" />

                        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="12,0" />

                        <TextBlock Text="缩放" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button x:Name="ZoomOutButton" Width="28" Height="28" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ZoomOutCommand}" ToolTip="缩小 10%（Ctrl+滚轮也可以）">
                            <Path Data="M 3,8 L 13,8" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" Stretch="Uniform"
                                  Width="10" Height="10" />
                        </Button>
                        <TextBox x:Name="ZoomBox" Width="62" Height="28" Margin="5,0" TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding ZoomText, UpdateSourceTrigger=LostFocus}"
                                 PreviewKeyDown="OnZoomBoxPreviewKeyDown"
                                 ToolTip="缩放比例（25% ~ 800%）：回车或离开输入框生效" />
                        <Button x:Name="ZoomInButton" Width="28" Height="28" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ZoomInCommand}" ToolTip="放大 10%（Ctrl+滚轮也可以）">
                            <Path Data="M 3,8 L 13,8 M 8,3 L 8,13" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="10" Height="10" />
                        </Button>

                        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="12,0"
                                Visibility="{Binding IsSpreadMode, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsSpreadMode, Converter={StaticResource BoolToVis}}">
                            <Button x:Name="ToolbarPrevButton" Width="34" Height="28" Padding="0"
                                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                    Click="OnPrevPageClick" ToolTip="上一屏（PgUp / ←）">
                                <Path Data="M 10,2 L 2,12 L 10,22" Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="Uniform" Width="9" Height="18" />
                            </Button>
                            <Button x:Name="ToolbarNextButton" Width="34" Height="28" Padding="0" Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                    Click="OnNextPageClick" ToolTip="下一屏（PgDn / → / 空格）">
                                <Path Data="M 2,2 L 10,12 L 2,22" Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="Uniform" Width="9" Height="18" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="TextLayerHintText" Grid.Column="1" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" Margin="12,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= 阅读区 ================= -->
        <Grid Grid.Row="1" x:Name="ViewportGrid" Background="#0E1014" ClipToBounds="True">

            <!-- 连续滚动（纵向 上→下 / 横向 左→右）：Canvas 尺寸 = 整条长带，只放可见页的 Image -->
            <ScrollViewer x:Name="ContinuousScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          Focusable="False"
                          PanningMode="None"
                          ScrollChanged="OnContinuousScrollChanged">
                <Canvas x:Name="PageCanvas" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="Transparent" />
            </ScrollViewer>

            <!-- ================= 双页翻页 ================= -->
            <Grid x:Name="SpreadHost" Visibility="Collapsed" Background="#0E1014">
                <Grid x:Name="SpreadViewport" Background="#0E1014" ClipToBounds="True">
                    <Canvas x:Name="SpreadCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Grid>

                <Button x:Name="PrevPageButton" Click="OnPrevPageClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="46" Height="76" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                        ToolTip="上一屏（PgUp / ←）">
                    <Path Data="M 10,2 L 2,12 L 10,22" Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="12" Height="24" />
                </Button>
                <Button x:Name="NextPageButton" Click="OnNextPageClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="46" Height="76" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        ToolTip="下一屏（PgDn / → / 空格）">
                    <Path Data="M 2,2 L 10,12 L 2,22" Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="12" Height="24" />
                </Button>
            </Grid>

            <!-- 阅读进度（细条，不参与命中测试） -->
            <Grid x:Name="ReadingProgressPanel" Height="3" VerticalAlignment="Bottom"
                  IsHitTestVisible="False" Background="#1A1F28">
                <Border x:Name="ReadingProgressFill" HorizontalAlignment="Left" Width="0"
                        Background="{DynamicResource AccentBrush}" />
            </Grid>

            <!-- 底部左侧：当前模式的操作提示 -->
            <Border x:Name="HintPanel" Background="#99000000" CornerRadius="10" Padding="10,4"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,16"
                    IsHitTestVisible="False">
                <TextBlock x:Name="HintText" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="滚轮滚动 · 左键拖动带惯性 · Ctrl+滚轮缩放" />
            </Border>

            <!-- 底部中间：页码 -->
            <Border x:Name="PageIndicatorPanel" Background="#B0000000" CornerRadius="12"
                    Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,18" IsHitTestVisible="False">
                <TextBlock x:Name="PageIndicatorText" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" Text="第 1 / 1 页" />
            </Border>

            <!-- ================= 目录 / 书签面板（左侧浮层） ================= -->
            <Border x:Name="OutlinePanel" Width="300" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="12,12,0,0" Padding="14,12"
                    MaxHeight="{Binding ActualHeight, ElementName=ViewportGrid}"
                    Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsOutlineVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="📑 目录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource SmallIconButtonStyle}"
                                Click="OnCloseOutlineClick" ToolTip="关闭目录（Esc）">
                            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="9" Height="9" />
                        </Button>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="OutlineEmptyText" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,4,2,4"
                                       Text="这个 PDF 没有书签目录。" Visibility="Collapsed" />
                            <ItemsControl ItemsSource="{Binding OutlineEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource OutlineItemStyle}"
                                                Content="{Binding Title}"
                                                Padding="{Binding IndentPadding}"
                                                Tag="{Binding PageIndex}"
                                                Click="OnOutlineItemClick"
                                                ToolTip="跳到这一页" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ================= 设置面板（右侧浮层） ================= -->
            <Border x:Name="SettingsPanel" Width="350" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,12,12,0" Padding="16,14"
                    MaxHeight="{Binding ActualHeight, ElementName=ViewportGrid}"
                    Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="⚙ 阅读设置" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource SmallIconButtonStyle}"
                                Click="OnCloseSettingsClick" ToolTip="关闭设置（Esc）">
                            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="9" Height="9" />
                        </Button>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="双页页面间距" FontSize="11.5" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <TextBlock Text="左右两页之间的空隙：0 = 贴在一起，越大隔得越开" FontSize="10.5"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SpreadGapSlider" Grid.Column="0" Minimum="0" Maximum="64"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Style="{StaticResource SliderStyle}"
                                        Value="{Binding SpreadGapPixels, Mode=TwoWay}"
                                        ToolTip="0 ~ 64 像素" />
                                <TextBlock Grid.Column="1" Text="{Binding SpreadGapText}" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="46"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,10" />

                            <TextBlock Text="文件关联" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <CheckBox Content="双击 .pdf 文件用本工具打开" FontSize="11.5"
                                      IsChecked="{Binding IsFileAssociationEnabled}" />
                            <TextBlock Text="{Binding FileAssociationStatus}" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            <Button Content="打开 Windows「默认应用」设置" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="28" Padding="8,0" FontSize="10.5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding OpenDefaultAppsCommand}" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,10" />

                            <Button Content="恢复默认设置" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="30" HorizontalAlignment="Left"
                                    Command="{Binding ResetSettingsCommand}" />
                            <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="阅读方式回纵向、缩放 100%、双页间距 2 px、惯性开、滚轮 120；不会动「上次打开的文件夹」。" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 错误提示（打开失败 / 某页渲染失败；几秒后自动消失） -->
            <Border x:Name="ErrorToast" Background="#E63A1F24" BorderBrush="#B08A4A4A"
                    BorderThickness="1" CornerRadius="10" Padding="14,8"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ErrorToastText" FontSize="11.5" MaxWidth="760" TextWrapping="Wrap"
                           Foreground="#FFFFB4B4" TextAlignment="Center" />
            </Border>

            <!-- 空状态：还没打开 PDF -->
            <Border x:Name="EmptyPanel" Background="#0E1014"
                    Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                    <TextBlock Text="📄" FontSize="46" HorizontalAlignment="Center" />
                    <TextBlock Text="打开一个 PDF，上下 / 左右滚动着看" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                               Text="三种阅读方式：纵向 上→下、横向 左→右（连续滚动），双页翻页（左右两页并排，一次翻过去）。&#10;连续模式用滚轮 / 左键拖动（松手带惯性）；Ctrl+滚轮 / 工具条放大镜缩放；Ctrl+F 搜索文字，📑 目录看书签大纲。" />
                    <Button Content="📄 打开 PDF…" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenPdfCommand}" HorizontalAlignment="Center"
                            Margin="0,20,0,0" Padding="20,9" />
                    <TextBlock x:Name="EmptyStatusText" FontSize="11.5" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="#FFB45A5A" Margin="0,14,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- 加载遮罩（打开 PDF / 读页数时显示） -->
            <Border x:Name="LoadingPanel" Background="#C0000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                    <TextBlock Text="正在打开 PDF…" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <ProgressBar Style="{StaticResource ProgressBarStyle}" IsIndeterminate="True"
                                 Height="6" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="YuLiangToolkit.Tools.ScreenRecorder.Views.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择录制区域"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Cursor="Cross">

    <!-- 全屏半透明遮罩 + 框选。真正的“裁剪”靠 CombinedGeometry(Exclude)：
         整个屏幕压暗，框选出来的那一块保持亮（能看到要录的内容）。
         浮窗固定用深色配色（盖在任意应用上都要看得清），不跟随四套主题。 -->
    <Grid>
        <Canvas x:Name="RootCanvas" Background="Transparent" ClipToBounds="True">
            <Path x:Name="DimPath" Fill="#73000000" IsHitTestVisible="False" />
            <Rectangle x:Name="SelectionRect" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                       Fill="#1284B4FF" Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="SizeBadge" Background="#E610141A" CornerRadius="4" Padding="8,3"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <Border x:Name="HintPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                Background="#E610141A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="9" Padding="18,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="拖动鼠标框选录制区域" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="松开后可重新拖动 · Enter 确认 · Esc / 右键取消"
                               Foreground="#B8C0CC" FontSize="11.5" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button x:Name="ConfirmButton" Content="✓ 使用这个区域" Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnConfirmClick" IsEnabled="False" Padding="13,6" ToolTip="确认框选（也可以按 Enter）" />
                    <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClick"
                            Margin="8,0,0,0" ToolTip="取消（也可以按 Esc / 右键）" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

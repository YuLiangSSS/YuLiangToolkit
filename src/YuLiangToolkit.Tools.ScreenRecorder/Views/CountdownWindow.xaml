<Window x:Class="YuLiangToolkit.Tools.ScreenRecorder.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="准备录制"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- 深色固定配色是刻意的：倒计时浮窗要盖在任意应用上，不跟随四套主题（浅色主题下会看不清）。 -->
    <Border x:Name="Root" Background="#F210141A" BorderBrush="#33FFFFFF" BorderThickness="1"
            CornerRadius="14" Padding="40,24,40,22" Cursor="Hand" MouseLeftButtonUp="OnRootMouseLeftButtonUp">
        <StackPanel>
            <TextBlock x:Name="NumberText" Text="3" FontSize="64" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" LineHeight="68" />
            <TextBlock Text="即将开始录制" Foreground="White" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,2,0,0" />
            <TextBlock Text="点击这里 / 按 Esc 取消倒计时" Foreground="#A8B0BC" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>

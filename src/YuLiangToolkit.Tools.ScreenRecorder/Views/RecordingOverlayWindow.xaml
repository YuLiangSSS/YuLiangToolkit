<Window x:Class="YuLiangToolkit.Tools.ScreenRecorder.Views.RecordingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制控制条"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- 置顶小控制条：显示计时 / 来源 / 停止按钮，可拖动。
         注意：gdigrab 是 GDI 截屏，控制条在录制区域里时可能被一起录进去；
         全屏录制想完全干净，可以在设置里关掉「录制时显示控制条」，改用 F8 停止。

         这里的深色固定配色是**刻意的**：浮窗要盖在任意应用 / 任意主题（包括半透明主题）上，
         用主题 token 会在浅色主题下变成浅底白字看不清；工具页本身仍然全部用 DynamicResource。 -->
    <Border x:Name="Root" Background="#F210141A" BorderBrush="#44FFFFFF" BorderThickness="1"
            CornerRadius="10" Padding="13,9" MouseLeftButtonDown="OnDragAreaMouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse Width="10" Height="10" Fill="{DynamicResource DangerBrush}"
                     VerticalAlignment="Center" Margin="0,0,11,0" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="SourceText" Text="录制中" FontSize="10" Foreground="#A8B0BC"
                           TextTrimming="CharacterEllipsis" MaxWidth="220" />
            </StackPanel>

            <Button Grid.Column="2" Content="停止" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="16,0,0,0" Padding="14,6" Click="OnStopClick"
                    ToolTip="停止录制并生成文件（默认也可以按 F8；热键冲突时可在设置里关掉）" />
        </Grid>
    </Border>
</Window>

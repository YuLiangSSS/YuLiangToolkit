<UserControl x:Class="YuLiangToolkit.Tools.MediaEditor.Views.MediaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="{DynamicResource WindowBackgroundBrush}">

    <!-- 剪辑工具（media-editor）
         布局照 docs/dev/layout.md：左侧设置（内部可滚）｜分隔条｜右侧预览，主区域｜分隔条｜底部日志。
         不做逐帧实时预览：时间轴用抽样缩略图；“生成预览”导出低清 mp4 再用系统播放器看。 -->

    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,0" />
        </Style>
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="ThumbButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  core:ScrollChaining.Enabled="True">
        <StackPanel Margin="28,22,28,26">

            <!-- ===== 页头 ===== -->
            <StackPanel>
                <TextBlock Text="✂️ 剪辑工具" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="简易视频 / GIF 剪辑：选文件后生成时间轴缩略图，拖动播放头设起点 / 终点，把要保留的片段逐个加进列表（可排序），最后导出 MP4 / MKV / MOV / AVI / WebM 或 GIF。不做实时渲染预览，但可以一键生成低清预览片段，用系统播放器确认效果。" />
            </StackPanel>

            <!-- ===== 主区域（设置 | 预览）与日志：上下可拖 ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="700" MinHeight="520" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="210" MinHeight="150" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="430" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="430" MinWidth="330" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== 左：设置 ===== -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True">
                            <StackPanel Margin="18,16,18,18">

                                <!-- ① 源文件 -->
                                <TextBlock Text="① 源文件" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PickInputButton" Content="选择视频 / GIF…" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding PickInputCommand}" Padding="14,6" />
                                    <Button Content="重新读取" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ReloadInputCommand}" Margin="8,0,0,0" />
                                    <Button Content="打开文件" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding OpenInputCommand}" Margin="8,0,0,0" />
                                    <Button Content="所在文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding RevealInputCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding InputPath}" FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                        Padding="12,10" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding MediaSummary}" FontSize="11.5" TextWrapping="Wrap"
                                               LineHeight="19" />
                                </Border>

                                <!-- ② 时间轴 / 缩略图 -->
                                <TextBlock Text="② 时间轴（点缩略图跳转）" Style="{StaticResource SectionTitleStyle}" />
                                <Slider x:Name="PositionSlider" Minimum="0" Maximum="{Binding Media.DurationSeconds}"
                                        Value="{Binding PositionSeconds, Mode=TwoWay}"
                                        SmallChange="0.1" LargeChange="1" Style="{StaticResource SliderStyle}"
                                        Margin="0,10,0,0" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PositionText}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="起点 = 播放头" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                                Command="{Binding SetStartCommand}" />
                                        <Button Content="终点 = 播放头" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                                Command="{Binding SetEndCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding Thumbnails}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ThumbButtonStyle}"
                                                        Command="{Binding DataContext.SelectThumbnailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <Image Source="{Binding Image}" Width="128" Height="72"
                                                               Stretch="UniformToFill" />
                                                        <TextBlock Text="{Binding TimeText}" FontSize="10" HorizontalAlignment="Center"
                                                                   Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="缩略图数量" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThumbnailCountOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedThumbnailCount}" Style="{StaticResource ComboBoxStyle}"
                                              MinWidth="90" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                                    <Button Grid.Column="3" Content="刷新缩略图" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                            Command="{Binding GenerateThumbnailsCommand}" />
                                </Grid>
                                <TextBlock Text="缩略图是按总时长平均抽样的，只用于快速定位；精确时间可以在下面直接输入。"
                                           Style="{StaticResource HintTextStyle}" />

                                <!-- ③ 片段 -->
                                <TextBlock Text="③ 保留片段（按列表顺序拼接）" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="起点" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox x:Name="StartBox" Grid.Column="1" Text="{Binding StartInputText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" Margin="8,0,14,0" />
                                    <TextBlock Grid.Column="2" Text="终点" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox x:Name="EndBox" Grid.Column="3" Text="{Binding EndInputText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" Margin="8,0,0,0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="AddSegmentButton" Content="＋ 添加片段" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AddSegmentCommand}" />
                                    <Button Content="更新选中" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding UpdateSegmentCommand}" Margin="8,0,0,0" />
                                    <Button Content="删除选中" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DeleteSegmentCommand}" Margin="8,0,0,0" />
                                    <Button Content="恢复整段" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding RestoreFullSegmentCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding EditedDurationText}" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="上移" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                                Command="{Binding MoveSegmentUpCommand}" />
                                        <Button Content="下移" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                                Command="{Binding MoveSegmentDownCommand}" Margin="6,0,0,0" />
                                        <Button Content="清空" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                                Command="{Binding ClearSegmentsCommand}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                                <ListBox ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}"
                                         Style="{StaticResource FileListStyle}" Height="150" Margin="0,8,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RangeText}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="输入格式：12.5、00:12.500、1:02:03.500 都认；导出前至少要留一个片段，超范围的片段会提示。"
                                           Style="{StaticResource HintTextStyle}" />

                                <!-- ④ 导出设置 -->
                                <TextBlock Text="④ 导出设置" Style="{StaticResource SectionTitleStyle}" />
                                <ComboBox x:Name="FormatCombo" ItemsSource="{Binding FormatOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedFormat}" Style="{StaticResource ComboBoxStyle}"
                                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                          Margin="0,8,0,0" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="输出帧率" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding FpsOptions}" DisplayMemberPath="Label"
                                                  SelectedItem="{Binding SelectedFps}" Style="{StaticResource ComboBoxStyle}"
                                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                                  Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="输出宽度" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding WidthOptions}" DisplayMemberPath="Label"
                                                  SelectedItem="{Binding SelectedWidth}" Style="{StaticResource ComboBoxStyle}"
                                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                                  Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="编码器" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />
                                    <ComboBox x:Name="CodecCombo" ItemsSource="{Binding CodecOptions}" DisplayMemberPath="Label"
                                              SelectedIndex="{Binding SelectedCodecIndex, Mode=TwoWay}"
                                              Style="{StaticResource ComboBoxStyle}"
                                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                              Margin="0,5,0,0" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="速率控制" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox ItemsSource="{Binding RateModeOptions}" DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedRateMode}" Style="{StaticResource ComboBoxStyle}"
                                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                                      Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="{Binding IsQualityMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="画质（CRF / CQ）" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="0" Maximum="51" SmallChange="1" LargeChange="3"
                                                        Value="{Binding Cfg.Quality}" Style="{StaticResource SliderStyle}"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Cfg.Quality}" FontSize="10.5"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="{Binding IsBitrateMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="目标码率" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="1" Maximum="100" SmallChange="1" LargeChange="5"
                                                        Value="{Binding Cfg.BitrateMbps}" Style="{StaticResource SliderStyle}"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Cfg.BitrateMbps, StringFormat={}{0} Mbps}"
                                                           FontSize="10.5" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Content="保留原音轨" Style="{StaticResource CheckBoxStyle}"
                                                  IsChecked="{Binding Cfg.KeepAudio}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="音频码率" FontSize="10.5" Margin="18,0,8,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding AudioBitrateOptions}" DisplayMemberPath="Label"
                                                  SelectedItem="{Binding SelectedAudioBitrate}" Style="{StaticResource ComboBoxStyle}"
                                                  MinWidth="110" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsGif, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="GIF 选项（无音轨）" FontSize="11.5" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="颜色数" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox ItemsSource="{Binding GifColorOptions}" DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedGifColors}" Style="{StaticResource ComboBoxStyle}"
                                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                                      Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="抖动" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox ItemsSource="{Binding DitherOptions}" DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedDither}" Style="{StaticResource ComboBoxStyle}"
                                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                                      Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="无限循环播放（不勾 = 只播一遍）" Style="{StaticResource CheckBoxStyle}"
                                              IsChecked="{Binding Cfg.GifLoop}" Margin="0,10,0,0" />
                                </StackPanel>

                                <TextBlock Text="输出位置" FontSize="11.5" FontWeight="SemiBold" Margin="0,14,0,0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Cfg.OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />
                                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="文件名前缀" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Cfg.FilePrefix, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />
                                </Grid>
                                <CheckBox Content="导出后自动打开输出文件夹" Style="{StaticResource CheckBoxStyle}"
                                          IsChecked="{Binding Cfg.OpenFolderAfterExport}" Margin="0,10,0,0" />

                                <!-- FFmpeg 状态 -->
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                        Padding="12,10" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="FFmpeg（探测 / 缩略图 / 导出都依赖它）" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FFmpegStatusText}" FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="选择 FFmpeg…" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding BrowseFFmpegCommand}" FontSize="11.5" />
                                            <Button Content="下载 FFmpeg" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenFfmpegDownloadCommand}" Margin="8,0,0,0" FontSize="11.5" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 左右分隔条 -->
                    <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                       Key="media-editor.设置与预览" />

                    <!-- ===== 右：预览 / 导出 ===== -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="180" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="预览 / 导出" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EditedDurationText}" FontSize="10.5" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                    Margin="0,10,0,0" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                    <TextBlock Text="选择文件后，点时间轴缩略图查看画面" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="PreviewButton" Content="生成预览（低清 10 秒）" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding GeneratePreviewCommand}" />
                                <Button Content="打开预览" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenPreviewCommand}" Margin="8,0,0,0" />
                                <Button Content="输出文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenOutputFolderCommand}" Margin="8,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                <Button x:Name="ExportButton" Content="开始导出" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ExportCommand}" Height="46" FontSize="15" FontWeight="SemiBold" />
                                <Grid Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Center"
                                                 Style="{StaticResource ProgressBarStyle}" />
                                    <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CancelCommand}" FontSize="11" Padding="10,4" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LastOutputPath}" FontSize="10" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                           ToolTip="{Binding LastOutputPath}" />
                                <Button Content="打开上次导出" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding OpenLastOutputCommand}" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="提示：预览是另存一个低清短 mp4 再用系统播放器打开，不是实时渲染；导出会按当前片段列表重新编码（裁剪点前后会重建关键帧）。" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 主区域 / 日志 上下分隔条 -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="media-editor.主区域与日志" />

                <!-- ===== 运行日志 ===== -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="50" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,12,16,8">
                            <TextBlock Text="运行日志" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="打开配置文件夹" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                        Command="{Binding OpenConfigFolderCommand}" />
                                <Button Content="清空日志" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                        Command="{Binding ClearLogCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" Style="{StaticResource LogTextBoxStyle}"
                                 Margin="16,0,16,0" core:ScrollChaining.Enabled="True" />
                    </Grid>
                </Border>
            </Grid>

            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="14,11" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="小提示" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="① 缩略图 / 预览 / 中间调色板都在 Cache\media-editor\，可在「主页设置 → 清理缓存」清掉。② 剪辑导出会重新编码；片段越多、越长越慢。③ GIF 不能实时预览，生成预览时输出的是低清 mp4（最长 10 秒），方便快速确认。④ 片段按列表顺序拼接，可上移 / 下移；起止时间支持 12.5、00:12.500、1:02:03.500。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="YuLiangToolkit.Tools.NotificationLog.Views.NotificationLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:notify="clr-namespace:YuLiangToolkit.Core.Notifications;assembly=YuLiangToolkit.Core"
             Background="Transparent">

    <UserControl.Resources>
        <notify:ThemeBrushNameConverter x:Key="KeyToBrush" />
    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🔔 通知管理" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Text="所有工具发过的通知都记在这里（快捷键操作、秒表、以后新加的工具都会自动进来）。可按来源与类型筛选、搜关键词，逐条删除或一键清空。" />
        </StackPanel>

        <!-- ===================== 主区域 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：历史列表 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 工具条：筛选 + 清空 -->
                    <StackPanel Grid.Row="0" Margin="18,14,18,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- ⚠ 用 ItemTemplate 而不是 DisplayMemberPath：SourceFilter 是 record，
                                 不加模板时 ComboBox 会显示成 "SourceFilter { Id = *, Name = ... }"。 -->
                            <ComboBox Grid.Column="0" Style="{StaticResource ComboBoxStyle}" MinWidth="120"
                                      ItemsSource="{Binding SourceFilters}"
                                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                      ToolTip="按来源筛选（新工具的通知会自动出现在这里）">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}" MinWidth="110"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding KindFilters}"
                                      SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                                      ToolTip="按类型筛选" />

                            <Grid Grid.Column="2" Margin="8,0,8,0">
                                <TextBox Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                         ToolTip="搜标题 / 正文 / 来源" />
                                <TextBlock Text="搜索…" IsHitTestVisible="False" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding Keyword, Converter={StaticResource EmptyToVis}}" />
                            </Grid>

                            <!-- ⚠ 只挂 Click、不挂 Command：确认框由代码后置处理，
                                 两个都挂会执行两次（先 Command 后 Click）。 -->
                            <Button Grid.Column="3" Content="清空全部" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnClearAllClick"
                                    ToolTip="清空所有通知历史（会再确认一次）" />
                        </Grid>

                        <TextBlock Text="{Binding SummaryText}" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="14,0,10,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="12,9" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 类型色条 -->
                                            <Border Grid.Column="0" CornerRadius="2" Margin="0,1,0,1"
                                                    Background="{Binding KindBrushKey, Converter={StaticResource KeyToBrush}}" />

                                            <!-- 时间 + 来源 -->
                                            <StackPanel Grid.Column="1" Margin="10,0,12,0" MinWidth="96">
                                                <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SourceText}" FontSize="10.5"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>

                                            <!-- 标题 + 正文 -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Record.Title}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding BodyText}" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="32"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- 通道标记 -->
                                            <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       Foreground="{DynamicResource FaintTextBrush}"
                                                       Text="{Binding Record.DeliveredViaText}"
                                                       ToolTip="实际送达的通道" />

                                            <!-- 删除 -->
                                            <Button Grid.Column="4" Content="✕" Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,3" FontSize="11" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="删除这一条" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="380"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="🔔" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="还没有通知记录。任何工具发出通知（比如按快捷键操作秒表）都会自动记到这里。"
                                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="清掉筛选条件" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Center" Margin="0,12,0,0"
                                Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>

                    <!-- 状态条 -->
                    <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11"
                               Margin="18,0,18,12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="notification-history.列表与设置" />

            <!-- ===== 右：设置 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="设置" FontSize="14" FontWeight="SemiBold"
                               Margin="18,16,18,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="18,0,18,18">

                            <CheckBox Content="记住历史（重启后还在）" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding RememberHistory, Mode=TwoWay}"
                                      ToolTip="关掉后历史只在本次运行有效，已有的历史文件会被删除" />

                            <TextBlock Text="最多保留多少条" FontSize="11.5" Margin="0,16,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="100" Maximum="5000"
                                        SmallChange="100" LargeChange="500"
                                        IsSnapToTickEnabled="True" TickFrequency="100"
                                        Value="{Binding Capacity, Mode=TwoWay}"
                                        Style="{StaticResource SliderStyle}" />
                                <TextBlock Grid.Column="1" MinWidth="60" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding CapacityText}" />
                            </Grid>
                            <TextBlock FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="超出上限时会丢掉最旧的记录。" />

                            <!-- 通知设置（用于「已清空」这类本工具自己的提示） -->
                            <TextBlock Text="通知" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <notify:NotificationSettingsView DataContext="{Binding Cfg.Notification}" />

                            <!-- 日志 -->
                            <TextBlock Text="运行日志" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     Style="{StaticResource LogTextBoxStyle}" Height="110"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     core:ScrollChaining.Enabled="True" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

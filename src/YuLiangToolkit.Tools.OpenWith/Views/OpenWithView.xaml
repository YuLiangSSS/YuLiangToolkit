<UserControl x:Class="YuLiangToolkit.Tools.OpenWith.Views.OpenWithView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <!-- 打开方式（open-with）：
         布局约定见 docs/dev/layout.md：
           · 左右：登记开关（*）｜ core:PaneSplitter（Key=open-with.登记与映射）｜文件类型映射（固定像素）；
           · 上下：主区域（固定像素行）｜ core:PaneSplitter（Key=open-with.主区域与日志）｜运行日志（固定像素行）；
           · 整页包在 ScrollViewer 里，卡片 ClipToBounds，内部列表 / 日志挂 ScrollChaining。 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  core:ScrollChaining.Enabled="True">
        <StackPanel Margin="28,22,28,26">

            <!-- ===== 页头 ===== -->
            <StackPanel>
                <TextBlock Text="🗂️ 打开方式" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="把凉雨工具集登记进 Windows 右键 → 打开方式：列表里会出现 3 个入口 —— 按文件类型自动分流、以文本方式打开、以压缩包方式打开。启用后，任意文件右键 → 打开方式 都能选到本工具；「按文件类型」会自动把 PDF / 图片 / Word / Excel / PPT / 压缩包 / 音视频 / 文本交给对应工具。" />
            </StackPanel>

            <!-- ===== 主区域（登记 + 映射）与运行日志：上下可拖 ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <!-- 主区域：左右可拖，所以两块固定像素宽 / 高（整页 ScrollViewer 兜住溢出） -->
                    <RowDefinition Height="580" MinHeight="430" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="190" MinHeight="120" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="540" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== 左：登记开关 + 三个入口说明 ===== -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True">
                            <StackPanel Margin="18,16,18,18">
                                <TextBlock Text="登记到系统" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="只写当前用户（HKCU）的打开方式列表，不需要管理员权限；不改任何文件的默认程序（默认程序仍由系统「默认应用」决定）。" />

                                <!-- 开关已经统一放到 主页设置 → 打开方式关联，这里只显示状态 + 修复 / 清理 -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="当前状态：" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="已登记" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="未登记" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsRegistered, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>

                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="开关在 主页设置 → 打开方式关联（只有 Release / 发布版可打开；Debug 构建固定关闭）。本页只做状态检查、修复和清理。" />

                                <!-- 状态说明 -->
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                        Padding="12,10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StateMessage}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding UpToDateText}" FontSize="10.5" TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="修复 / 刷新" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding RepairCommand}"
                                            IsEnabled="{Binding IsBuildSupported}"
                                            ToolTip="重建入口副本、把注册表命令刷成当前程序路径（程序更新 / 换目录后点一下；Debug 构建不可用）" />
                                    <Button Content="清理关联" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ClearAssociationCommand}" Margin="8,0,0,0"
                                            ToolTip="立即删掉注册表里本工具的打开方式入口和入口副本 exe（Debug 构建也能用）" />
                                    <Button Content="打开「默认应用」设置" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding OpenDefaultAppsCommand}" Margin="8,0,0,0"
                                            ToolTip="想把某个后缀默认交给本工具时，在系统设置里选一次（默认程序由 Windows 保护，本工具不硬抢）" />
                                </StackPanel>

                                <TextBlock Text="列表里会出现的 3 个入口" FontSize="12" FontWeight="SemiBold"
                                           Margin="0,18,0,8" />

                                <ItemsControl ItemsSource="{Binding OpenerRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                                    Padding="12,9" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Hint}" FontSize="11" TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="主程序路径" FontSize="11" Margin="0,12,0,5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding MainExecutablePath, Mode=OneWay}"
                                         Style="{StaticResource TextBoxStyle}" IsReadOnly="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         Padding="10,7" MinHeight="34"
                                         ToolTip="{Binding MainExecutablePath}" />

                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="· 入口列表按 exe 路径去重，所以「以文本方式 / 以压缩包方式」各自用一个小入口副本（和主程序同目录）；程序更新或换目录后点「修复 / 刷新」即可。" />
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="· 刚启用时资源管理器的「打开方式」列表可能要等几秒才刷新；还不行就重启资源管理器。" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 左右分隔条：拖动改「登记开关」与「文件类型映射」的宽度（双击恢复这一处） -->
                    <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                       Key="open-with.登记与映射" />

                    <!-- ===== 右：按文件类型打开的映射表 + 模拟 ===== -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="18,14,18,8">
                                <TextBlock Text="按文件类型打开（自动模式）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="自动模式按扩展名选工具；下面没列出的扩展名会用文本编辑器兜底（自动保存会暂停，避免误写陌生文件）。" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" Margin="14,0,14,0"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          core:ScrollChaining.Enabled="True">
                                <ItemsControl ItemsSource="{Binding TargetRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                                    Padding="12,9" Margin="4,0,4,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding EmojiIcon}" FontSize="15"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ToolName}"
                                                                   FontSize="12.5" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ExtensionsCountText}"
                                                                   FontSize="10.5" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Hint}" FontSize="10.5" TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding ExtensionsText}" FontSize="10.5"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 模拟 -->
                            <Border Grid.Row="2" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                    Padding="12,10" Margin="18,0,18,12">
                                <StackPanel>
                                    <TextBlock Text="模拟：选一个文件看看会交给哪个工具" FontSize="11.5"
                                               FontWeight="SemiBold" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SimulationPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextBoxStyle}"
                                                 ToolTip="填一个文件路径（或点「浏览…」），点「模拟」只显示分流结果，不会真的打开文件" />
                                        <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding BrowseSimulationFileCommand}" />
                                        <Button Grid.Column="2" Content="模拟" Margin="8,0,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding SimulateCommand}" />
                                    </Grid>
                                    <TextBlock Text="{Binding SimulationResult}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,7,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 上下分隔条：拖动改「主区域」与「运行日志」的高度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="open-with.主区域与日志" />

                <!-- ===== 运行日志 ===== -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="70" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,12,18,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearLogCommand}" />
                        </Grid>
                        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                                 Style="{StaticResource LogTextBoxStyle}" Margin="14,0,14,12"
                                 core:ScrollChaining.Enabled="True" />
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="YuLiangToolkit.Tools.TextConverter.Views.TextConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:controls="clr-namespace:YuLiangToolkit.Core.Controls;assembly=YuLiangToolkit.Core"
             xmlns:notify="clr-namespace:YuLiangToolkit.Core.Notifications;assembly=YuLiangToolkit.Core"
             Background="Transparent">

    <UserControl.Resources>
        <notify:ThemeBrushNameConverter x:Key="KeyToBrush" />

        <!-- 改键框（显式给出，不依赖 Core 的隐式默认样式） -->
        <Style x:Key="HotkeyBoxLocalStyle" TargetType="controls:HotkeyBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:HotkeyBox">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" MinHeight="28">
                            <Grid>
                                <TextBlock Text="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}}"
                                           Margin="10,0,24,0" VerticalAlignment="Center" FontSize="12"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,9,0" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsCapturing" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="360" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🔤 文本转换器" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Text="把文字转成各种样子。也可以在下面自己绑快捷键：在 QQ / 浏览器 / 任何输入框里选中文字，按一下就就地转换（牛马 → 🐮🐴）。" />
        </StackPanel>

        <!-- ===================== 主区域 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== 上：输入 / 结果 ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- 输入 -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,12,16,8">
                            <TextBlock Text="原文" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding InputSummary}" FontSize="10.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <TextBox Grid.Row="1" Margin="16,0,16,0"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontSize="13"
                                 core:ScrollChaining.Enabled="True" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,16,14">
                            <Button Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearCommand}" Margin="0,0,8,0" />
                            <Button Content="转换 ↓" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ConvertCommand}" MinWidth="100" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 分隔条 -->
                <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="text-converter.原文与结果" />

                <!-- 结果 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,12,16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="结果" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox Style="{StaticResource ComboBoxStyle}" MinWidth="180" Margin="12,0,0,0"
                                          ItemsSource="{Binding ConversionOptions}"
                                          SelectedItem="{Binding SelectedConversion, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontSize="12" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="1" Margin="16,0,16,0"
                                 Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding Result, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontSize="13"
                                 core:ScrollChaining.Enabled="True" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,16,14">
                            <Button Content="复制" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CopyResultCommand}" Margin="0,0,8,0" />
                            <Button Content="拿回去再转" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding UseResultAsInputCommand}" />
                            <TextBlock Text="{Binding SelectedConversionDescription}" FontSize="10.5"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 下：自定义快捷键 ===== -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,12,0,0"
                    ClipToBounds="True">
                <StackPanel>
                    <Grid Margin="16,12,16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="自定义快捷键" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ShortcutSummary}" FontSize="10.5" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="启用快捷键" Style="{StaticResource CheckBoxStyle}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      IsChecked="{Binding Cfg.ShortcutsEnabled, Mode=TwoWay}" />
                            <CheckBox Content="转换后还原剪贴板" Style="{StaticResource CheckBoxStyle}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      IsChecked="{Binding Cfg.RestoreClipboard, Mode=TwoWay}"
                                      ToolTip="不弄丢你原来复制的东西" />
                            <Button Content="+ 添加快捷键" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="14,5" Command="{Binding AddShortcutCommand}" Margin="0,0,8,0" />
                            <Button Content="测试通知" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,5" Command="{Binding SendTestNotificationCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock FontSize="11" Margin="16,0,16,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="用法：先选中要转换的文字，再按你设的快捷键。没选中会弹通知提示。转换走「复制 → 转换 → 粘贴」，所以目标程序要支持 Ctrl+C / Ctrl+V。" />

                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <ItemsControl ItemsSource="{Binding ShortcutRows}" Margin="16,0,16,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="10,8" Margin="0,0,0,6"
                                            Opacity="{Binding RowOpacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <controls:HotkeyBox Grid.Column="0" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                                ComboText="{Binding Entry.Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                IsCaptureEnabled="{Binding Entry.Enabled}" />

                                            <ComboBox Grid.Column="1" Margin="10,0,0,0"
                                                      Style="{StaticResource ComboBoxStyle}"
                                                      ItemsSource="{Binding DataContext.ConversionOptions,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedValue="{Binding Entry.ConversionId, Mode=TwoWay}"
                                                      SelectedValuePath="Id">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Display}" FontSize="12" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Button Grid.Column="2" Content="{Binding StateText}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="8,0,0,0" Padding="10,4" FontSize="11"
                                                    Command="{Binding DataContext.ToggleShortcutCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Entry}"
                                                    ToolTip="点一下开 / 关这条" />

                                            <Button Grid.Column="3" Content="✕"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="8,0,0,0" Padding="8,3" FontSize="11"
                                                    Command="{Binding DataContext.RemoveShortcutCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Entry}"
                                                    ToolTip="删除这条快捷键" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="还没有自定义快捷键。点「+ 添加快捷键」，然后点左边的框按下组合键（例如 Ctrl+Shift+T），再选要做哪种转换。"
                               FontSize="11.5" Margin="16,6,16,12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding NoShortcuts, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Margin="16,0,16,12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

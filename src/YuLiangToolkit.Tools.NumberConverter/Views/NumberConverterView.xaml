<UserControl x:Class="YuLiangToolkit.Tools.NumberConverter.Views.NumberConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             PreviewKeyDown="OnPreviewKeyDown">

    <!-- 数字转换器（number-converter）。
         布局约定见 docs/dev/layout.md：
           · 页面级两块「左（输入 + 口味）｜ 右（结果）」左右分栏，中间一条竖分隔条
             （Key=number-converter.输入与结果）；
           · 左列内部「输入 ↔ 口味」是一条横分隔条（Key=number-converter.输入与口味）。
         两块都能拖、尺寸自动记住（Config\layout.json），双击分隔条恢复这一处。
         颜色全部 {DynamicResource}，控件样式全部来自 App.xaml。 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  core:ScrollChaining.Enabled="True">
        <Grid Margin="28,16,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== 页头 ===================== -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="🔢 数字转换器" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="输入一个数字，同时得到它的各种写法：中文小写 / 大写、人民币金额大写（写支票、转账备注）、英文念法（one thousand 或 a thousand、one hundred and twenty-three）、序数词、罗马数字、千分位、二·八·十六进制、科学计数法、逐位念号码。也能反过来把「壹拾贰圆叁角肆分」读回 12.34。" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="440" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- ===================== 左：输入（上） + 口味（下） ===================== -->
                <Grid Grid.Column="0" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="336" MinHeight="270" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="300" MinHeight="230" />
                    </Grid.RowDefinitions>

                    <!-- ===== 输入 ===== -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="96" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="要转换的数字" FontSize="13" FontWeight="SemiBold" />

                            <TextBox x:Name="InputBox" Grid.Row="1" Style="{StaticResource TextBoxStyle}" Margin="0,10,0,0"
                                     FontSize="20" MinHeight="46"
                                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                     Text="{Binding Cfg.Input, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="阿拉伯数字（可带千分位逗号、科学计数法 1e6），或者中文数字 / 中文金额（一百二十三、壹拾贰圆叁角肆分）" />

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SummaryText}" FontSize="11.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding SummaryText, Converter={StaticResource EmptyToVisInverse}}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="清空" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ClearCommand}" />
                                    <Button Content="复制全部" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                            Command="{Binding CopyAllCommand}" ToolTip="把所有结果拼成「标题：内容」复制到剪贴板" />
                                </StackPanel>
                            </Grid>

                            <!-- 示例：点一下直接填进输入框（自带滚动，卡片拖矮了也不会被裁） -->
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0"
                                          core:ScrollChaining.Enabled="True">
                                <StackPanel>
                                    <TextBlock Text="试试这些（点一下填入）" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Samples}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Value}"
                                                        Command="{Binding DataContext.UseSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Value}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip="{Binding Hint}"
                                                        Margin="0,0,6,6" Padding="10,4" FontSize="11.5"
                                                        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 输入错误提示（红色小字，不弹窗） -->
                            <TextBlock Grid.Row="4" Text="{Binding ErrorText}" FontSize="11.5" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding ErrorText, Converter={StaticResource EmptyToVisInverse}}" />
                        </Grid>
                    </Border>

                    <!-- 上下分隔条：拖「输入」与「口味」的高度（双击恢复这一处） -->
                    <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                       Key="number-converter.输入与口味" />

                    <!-- ===== 口味（怎么念 / 怎么写） ===== -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True">
                            <StackPanel>
                                <TextBlock Text="写法口味" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock FontSize="10.5" Margin="0,4,0,12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="改一下立即重算，并且自动存进配置（没有保存按钮）" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="金额单位" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding CurrencyOptions}"
                                              SelectedItem="{Binding Cfg.Currency}"
                                              Style="{StaticResource ComboBoxStyle}" Margin="12,0,0,0" MinWidth="90"
                                              HorizontalAlignment="Left"
                                              ToolTip="支票 / 财务常写「圆」，合同 / 发票也常写「元」" />
                                </Grid>

                                <CheckBox Content="元后角为零、分有值时补「零」（壹仟陆佰捌拾圆零叁角贰分）"
                                          IsChecked="{Binding Cfg.ZeroOnJiaoGap}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,12,0,0" />
                                <CheckBox Content="角有值、分为零时写「整」（壹拾贰圆叁角整）"
                                          IsChecked="{Binding Cfg.WholeAfterJiao}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0" />

                                <CheckBox Content="英式：百位后加 and（one hundred and twenty-three）"
                                          IsChecked="{Binding Cfg.EnglishUseAnd}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,14,0,0"
                                          ToolTip="关掉是美式：one hundred twenty-three" />
                                <CheckBox Content="开头的 1 念 a（1000 → a thousand、1000000 → a million）"
                                          IsChecked="{Binding Cfg.EnglishUseA}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0"
                                          ToolTip="只影响带量级的百万 / 十亿 / 万亿…；单独的 100 / 123 仍念 one hundred / one hundred and twenty-three" />
                                <CheckBox Content="十位与个位之间加连字符（twenty-three）"
                                          IsChecked="{Binding Cfg.EnglishHyphenate}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0"
                                          ToolTip="关掉是 twenty three" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 左右分隔条：拖「输入区」与「结果区」的宽度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="number-converter.输入与结果" />

                <!-- ===================== 右：结果 ===================== -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="160" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,14,18,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="转换结果" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="单击一行复制" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,0,8,0">
                            <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource FileListStyle}"
                                     core:ScrollChaining.Enabled="True"
                                     ToolTip="单击某一行，把它的内容复制到剪贴板"
                                     PreviewMouseLeftButtonUp="OnResultClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13"
                                                       TextWrapping="Wrap" Margin="4,0,0,0"
                                                       FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                       ToolTip="{Binding Hint}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="左边输入一个数字，这里会同时列出中文大小写、人民币金额、英文念法、罗马数字、进制等写法。"
                                       Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                                       Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                        </Grid>

                        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="18,8,18,12" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

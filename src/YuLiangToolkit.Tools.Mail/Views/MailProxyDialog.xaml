<Window x:Class="YuLiangToolkit.Tools.Mail.Views.MailProxyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络代理"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock Text="网络代理" VerticalAlignment="Center" Margin="14,0" FontSize="12.5" FontWeight="SemiBold" />
                <Button Content="×" HorizontalAlignment="Right" Style="{StaticResource WindowCloseButtonStyle}"
                        Click="OnCloseClick" />
            </Grid>
            <Border Grid.Row="1" Padding="24,16,24,18">
                <StackPanel>
            <TextBlock Text="网络代理" FontSize="17" FontWeight="SemiBold" />
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,12"
                       Text="Gmail 等境外邮箱在部分网络下「浏览器能打开、IMAP 直连却超时」。默认跟随 Windows 系统代理（和 Chrome 同一个），并遵守系统代理的例外列表（如 QQ 自动直连）。" />

            <TextBlock Text="代理模式" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
            <ComboBox x:Name="ModeCombo" Style="{StaticResource ComboBoxStyle}" SelectionChanged="OnModeChanged">
                <ComboBoxItem Tag="auto" Content="自动（跟随 Windows 系统代理）" />
                <ComboBoxItem Tag="direct" Content="直连（不使用代理）" />
                <ComboBoxItem Tag="custom" Content="自定义代理" />
            </ComboBox>
            <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />

            <StackPanel x:Name="CustomPanel" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="代理服务器" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <TextBox x:Name="HostBox" Style="{StaticResource TextBoxStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="端口" FontSize="11" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,8,10" />
                    <TextBox x:Name="PortBox" Grid.Column="2" Style="{StaticResource TextBoxStyle}" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock Text="代理类型" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,5" />
                <ComboBox x:Name="TypeCombo" Style="{StaticResource ComboBoxStyle}" SelectionChanged="OnTypeChanged">
                    <ComboBoxItem Tag="http" Content="HTTP 代理" />
                    <ComboBoxItem Tag="socks5" Content="SOCKS5 代理" />
                </ComboBox>
            </StackPanel>

            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="说明：HTML 富文本预览里的远程图片由 WebView2 自己走系统代理，和这里的 IMAP 代理解析是两套；如果图片加载不出来，检查系统代理是否正常。" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnCancelClick" />
                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick" />
            </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

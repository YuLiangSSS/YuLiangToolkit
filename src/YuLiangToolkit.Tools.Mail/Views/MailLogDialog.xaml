<Window x:Class="YuLiangToolkit.Tools.Mail.Views.MailLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行日志"
        Width="760" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock Text="运行日志" VerticalAlignment="Center" Margin="14,0" FontSize="12.5" FontWeight="SemiBold" />
                <Button Content="×" HorizontalAlignment="Right" Style="{StaticResource WindowCloseButtonStyle}"
                        Click="OnCloseClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,12,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="账号连接 / 拉取结果、错误原因都在这里；不会打印授权码。窗口开着时新日志会实时出现。"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                 Style="{StaticResource LogTextBoxStyle}" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" FontSize="11.5"
                 VerticalContentAlignment="Top" Padding="10,8" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="打开配置文件夹" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenConfigFolderCommand}" />
                    <Button Content="打开数据文件夹" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding OpenDataFolderCommand}" />
                    <Button Content="清空日志" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding ClearLogCommand}" />
                    <Button Content="关闭" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

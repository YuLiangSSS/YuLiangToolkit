<UserControl x:Class="YuLiangToolkit.Tools.Mail.Views.MailCollectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <UserControl.Resources>
        <!-- App.xaml 里没有 PasswordBox 样式；这里补一个跟 TextBoxStyle 观感一致的局部样式
             （和「压缩包工具」的 ArchivePasswordBoxStyle 同源，用主题画刷，四套主题都不会白底黑字）。 -->
        <Style x:Key="MailPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Background="Transparent"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 布局（v0.42.0 起的可拖拽约定，见 docs/dev/layout.md）：
         整页 =「标题 / 工具条 / 主区域 / 日志」，主区域里三栏 =「账号 | 合并收件列表 | 详情·设置」；
         账号栏与收件列表、收件列表与右栏、主区域与日志之间都有 core:PaneSplitter，拖动即可调大小，
         松手自动记住（Config\layout.json），双击缝隙恢复这一处；全部恢复默认：主页设置 →「界面布局 → 恢复默认布局」。
         右栏的「邮件详情 / 账号设置」是互斥页签（同一块地方切换显示），所以它们之间不需要分隔条；
         邮箱阅读是常驻操作，所以整页撑满可视高度（主区域 *，日志固定行可拖），不像长表单那样整页滚动。 -->
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />                                  <!-- 标题 -->
            <RowDefinition Height="Auto" />                                  <!-- 工具条 -->
            <RowDefinition Height="*" MinHeight="220" />                     <!-- 三栏主区域（可上下拖） -->
            <RowDefinition Height="12" />                                    <!-- 主区域 / 日志 -->
            <RowDefinition Height="140" MinHeight="90" />                    <!-- 日志（可上下拖） -->
        </Grid.RowDefinitions>

        <!-- ===== 标题 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="📬 邮箱代收" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="IMAP 只读代收：把多个邮箱的收件箱合并成一个列表，支持筛选 / 搜索 / 看正文与附件；授权码 · 应用专用密码用 Windows DPAPI 加密。" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="12,8"
                    VerticalAlignment="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxWidth="340"
                    Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextWrapping="Wrap" />
                    <TextBlock Text="只读 IMAP · 不改已读 / 不删邮件 · 授权码 DPAPI 加密"
                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 工具条 ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <WrapPanel>
                <Button Content="刷新全部" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding RefreshAllCommand}"
                        ToolTip="逐个连接启用的账号，拉取每个收件箱最近的邮件并合并（只读）" />
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,8"
                        Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
                <Button Content="测试选中账号" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding TestConnectionCommand}" />
                <Button Content="新增账号" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding AddAccountCommand}" />
                <Button Content="删除选中账号" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,20,8"
                        Command="{Binding DeleteAccountCommand}" IsEnabled="{Binding HasSelectedAccount}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,20,8" VerticalAlignment="Center">
                    <TextBlock Text="每个账号取最近" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding Cfg.FetchCount, UpdateSourceTrigger=PropertyChanged}" Width="54" Margin="8,0"
                             Style="{StaticResource TextBoxStyle}" ToolTip="5 ~ 200；Gmail 建议 30~50" />
                    <TextBlock Text="封" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <CheckBox Content="打开工具时自动刷新" IsChecked="{Binding Cfg.RefreshOnOpen}"
                          Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,8" VerticalAlignment="Center" />

                <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="16,0,0,8"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </WrapPanel>
        </Border>

        <!-- ===== 三栏主区域 ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />   <!-- 左：账号 -->
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="200" />     <!-- 中：合并收件列表 -->
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.6*" MinWidth="240" />  <!-- 右：详情 / 账号设置（随窗口伸缩） -->
            </Grid.ColumnDefinitions>

            <!-- ===== 左栏：账号列表 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="📥 账号" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AccountsSummary}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋" Padding="9,2" VerticalAlignment="Top"
                                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddAccountCommand}"
                                ToolTip="新增账号" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                 Style="{StaticResource FileListStyle}" Margin="8,0,8,8"
                                 core:ScrollChaining.Enabled="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled}" Style="{StaticResource CheckBoxStyle}"
                                                  VerticalAlignment="Top" Margin="0,1,8,0"
                                                  ToolTip="勾选 = 参与代收（取消勾选只跳过这个账号，配置保留）" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="还没有账号：点左上角「＋」或工具条「新增账号」开始"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="20,6,16,0" VerticalAlignment="Top"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="16,0,16,10">
                        <WrapPanel>
                            <Button Content="编辑账号" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"
                                    Command="{Binding ShowSettingsTabCommand}" IsEnabled="{Binding HasSelectedAccount}" />
                            <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6"
                                    Command="{Binding DeleteAccountCommand}" IsEnabled="{Binding HasSelectedAccount}" />
                        </WrapPanel>
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="选中账号 → 点「编辑账号」改服务器 / 授权码。" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 账号栏 / 收件列表：左右分隔条 -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="mail-collector.账号与收件列表" />

            <!-- ===== 中栏：合并收件列表 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,12,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="📬 收件箱（合并）" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MessagesSummary}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Top" Command="{Binding RefreshAllCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="16,8,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                                      DisplayMemberPath="Label" Style="{StaticResource ComboBoxStyle}"
                                      ToolTip="只看某个账号的邮件" />
                            <CheckBox Grid.Column="1" Content="只看未读" IsChecked="{Binding OnlyUnread}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="按主题 / 发件人 / 账号名搜索；空格分隔多个关键词需同时命中" />
                            <TextBlock Text="搜索主题 / 发件人 / 账号…" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                      DisplayMemberPath="Label" Style="{StaticResource ComboBoxStyle}"
                                      ToolTip="收件列表排序：日期 / 发件人 / 主题 / 账号 / 是否未读 / 大小" />
                            <Button Grid.Column="1" Content="{Binding SortDirectionText}" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ToggleSortDirectionCommand}"
                                    ToolTip="{Binding SortDirectionToolTip}" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <ListBox ItemsSource="{Binding VisibleMessages}" SelectedItem="{Binding SelectedMessage}"
                                 Style="{StaticResource FileListStyle}" Margin="8,0,8,8"
                                 core:ScrollChaining.Enabled="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding UnreadMark}" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Subject}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding DateText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top"
                                                           Margin="8,1,0,0" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding FromText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="110"
                                                           ToolTip="{Binding FromText}" />
                                                <Border Background="{DynamicResource TagChipBackgroundBrush}" CornerRadius="4"
                                                        Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AccountBadge}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="70"
                                                               ToolTip="{Binding AccountBadge}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="还没有邮件：填好账号后点「刷新全部」，这里会合并显示各邮箱最近的收件"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="22,10,22,0" VerticalAlignment="Top"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasVisibleMessages, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 收件列表 / 右栏：左右分隔条 -->
            <core:PaneSplitter Grid.Column="3" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="mail-collector.收件列表与邮件详情" />

            <!-- ===== 右栏：邮件详情 / 账号设置（互斥页签） ===== -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="16,10,16,6">
                        <RadioButton Content="✉ 邮件详情" GroupName="mail-right-tab" Style="{StaticResource RadioButtonStyle}"
                                     IsChecked="{Binding ShowDetailTab, Mode=TwoWay}" Margin="0,0,18,0" />
                        <RadioButton Content="⚙ 账号设置" GroupName="mail-right-tab" Style="{StaticResource RadioButtonStyle}"
                                     IsChecked="{Binding ShowSettingsTab, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 邮件详情 -->
                    <Grid Grid.Row="1" Visibility="{Binding ShowDetailTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="60" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding DetailSubject}" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="16,4,16,0" MaxHeight="48" />
                        <StackPanel Grid.Row="1" Margin="16,6,16,0">
                            <TextBlock FontSize="11" TextWrapping="Wrap">
                                <Run Text="发件人：" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{Binding DetailFrom, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                                <Run Text="收件人：" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{Binding DetailTo, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                                <Run Text="时间：" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{Binding DetailDate, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding DetailStatus}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,6,16,0">
                            <Button Content="复制正文" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CopyBodyCommand}" />
                            <CheckBox Content="纯文本" IsChecked="{Binding ForcePlainText}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="14,0,0,0" VerticalAlignment="Center"
                                      ToolTip="有 HTML 正文时也强制用纯文本显示（不喜欢的排版 / 可疑邮件可以切过来）" />
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="12,6,12,0">
                            <TextBox x:Name="PlainBody" Text="{Binding MessageBodyText, Mode=OneWay}" IsReadOnly="True"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     core:ScrollChaining.Enabled="True" FontSize="12"
                                     Visibility="{Binding ShowPlainBody, Converter={StaticResource BoolToVis}}" />
                            <Grid x:Name="HtmlHost"
                                  Visibility="{Binding ShowHtmlPreview, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Grid.Row="4" Text="{Binding AttachmentsSummary}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,6,16,0" />
                        <ScrollViewer Grid.Row="5" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Margin="12,2,12,10"
                                      core:ScrollChaining.Enabled="True">
                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="保存" Padding="10,2" Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="另存为…（附件只在内存里解码，不写 Data 目录）" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 账号设置 -->
                    <Grid Grid.Row="1" Visibility="{Binding ShowSettingsTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="16,4,16,4">
                            <TextBlock Text="账号设置" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="选中账号后在这里改；所有改动自动保存，没有「保存」按钮。授权码只在本机 DPAPI 加密保存。" />
                        </StackPanel>
                        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True">
                            <StackPanel Margin="16,4,16,14">
                                <StackPanel IsEnabled="{Binding HasSelectedAccount}">
                                <TextBlock Text="服务商预设（选好自动填服务器 / 端口）" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                          DisplayMemberPath="Name" Style="{StaticResource ComboBoxStyle}"
                                          HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                                <Button Content="{Binding HelpButtonText}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenHelpCommand}"
                                        Visibility="{Binding HasPresetHelp, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding PresetHintText}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Margin="0,6,0,0" />

                                <TextBlock Text="显示名称（可选）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,5" />
                                <TextBox Text="{Binding SelectedAccount.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" ToolTip="只在界面里显示，例如「主力 Gmail」" />

                                <TextBlock Text="邮箱地址（同时是登录用户名）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,5" />
                                <Grid>
                                    <TextBox x:Name="EmailBox" Text="{Binding SelectedAccount.Email, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />
                                    <TextBlock Text="例如 fantasyuliang@qq.com" IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Visibility="{Binding Text, ElementName=EmailBox, Converter={StaticResource EmptyToVis}}" />
                                </Grid>

                                <TextBlock Text="授权码 / 应用专用密码" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,5" />
                                <PasswordBox x:Name="PasswordInput" Style="{StaticResource MailPasswordBoxStyle}"
                                             PasswordChanged="OnPasswordChanged"
                                             ToolTip="QQ 邮箱 = 授权码；Gmail = 16 位应用专用密码（不是登录密码）；本机 DPAPI 加密保存，界面只显示圆点" />
                                <TextBlock Text="已保存的授权码只显示为圆点；重新输入会覆盖（不会显示明文）。"
                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="IMAP 服务器" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding SelectedAccount.Host, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextBoxStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="端口" FontSize="11" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,6,10" />
                                    <TextBox Grid.Column="2" Text="{Binding SelectedAccount.Port, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" VerticalAlignment="Bottom" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox Content="使用 SSL" IsChecked="{Binding SelectedAccount.UseSsl}"
                                              Style="{StaticResource CheckBoxStyle}" Margin="0,0,16,0" />
                                    <CheckBox Content="参与代收" IsChecked="{Binding SelectedAccount.Enabled}"
                                              Style="{StaticResource CheckBoxStyle}" />
                                </StackPanel>

                                <Button Content="测试选中账号" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Command="{Binding TestConnectionCommand}" />
                                </StackPanel>

                                <!-- ===== 网络代理（全局，不随账号禁用） ===== -->
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.6" Margin="0,16,0,12" />
                                <TextBlock Text="网络代理" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           Text="Gmail 等境外邮箱在部分网络下「浏览器能打开、IMAP 直连却超时」——这里默认跟随 Windows 系统代理（和 Chrome 用同一个），并遵守系统代理的例外列表（如 QQ 会自动直连）。" />
                                <ComboBox ItemsSource="{Binding ProxyModeOptions}" SelectedItem="{Binding SelectedProxyMode}"
                                          DisplayMemberPath="Label" Style="{StaticResource ComboBoxStyle}" />
                                <TextBlock Text="{Binding ProxyStatusText}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Visibility="{Binding ShowCustomProxy, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="代理服务器" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                            <TextBox Text="{Binding Cfg.Proxy.Host, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextBoxStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="端口" FontSize="11" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,6,10" />
                                        <TextBox Grid.Column="2" Text="{Binding Cfg.Proxy.Port, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource TextBoxStyle}" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding ProxyTypeOptions}" SelectedItem="{Binding SelectedProxyType}"
                                              DisplayMemberPath="Label" Style="{StaticResource ComboBoxStyle}" Margin="0,8,0,0" />
                                </StackPanel>
                                <Button Content="刷新代理状态" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Command="{Binding RefreshProxyStatusCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 主区域 / 日志：上下分隔条 -->
        <core:PaneSplitter Grid.Row="3" Style="{StaticResource PaneSplitterHorizontalStyle}"
                           Key="mail-collector.主区域与日志" />

        <!-- ===== 日志 ===== -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,10,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="账号连接 / 拉取结果、错误原因都在这里；不会打印授权码" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="打开配置文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenConfigFolderCommand}" />
                        <Button Content="打开数据文件夹" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="清空日志" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding ClearLogCommand}" />
                    </StackPanel>
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                         Style="{StaticResource LogTextBoxStyle}" Margin="12,0,12,10"
                         core:ScrollChaining.Enabled="True" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

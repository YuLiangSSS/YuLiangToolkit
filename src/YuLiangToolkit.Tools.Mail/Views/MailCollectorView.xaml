<UserControl x:Class="YuLiangToolkit.Tools.Mail.Views.MailCollectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <!-- 布局（Foxmail 风格，v0.42.0 起可拖拽）：
         左边账号 | 中间收件列表 | 右边整块阅读区（HTML 富文本 / 纯文本 / 附件）；
         账号 / 收件列表、收件列表 / 阅读区之间各一条 core:PaneSplitter，拖动可调大小、松手记住；
         账号编辑、网络代理、日志都改成弹窗，不再占用主界面（双击账号 = 编辑，工具条有「网络代理」「日志」）。 -->
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
        </Grid.RowDefinitions>

        <!-- ===== 标题 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="📬 邮箱代收" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="IMAP 只读代收：多个邮箱合并列表、HTML 富文本阅读（Ctrl+滚轮缩放）、筛选 / 搜索 / 排序、附件打开与保存；授权码用 Windows DPAPI 加密。" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="12,8"
                    VerticalAlignment="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxWidth="340"
                    Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextWrapping="Wrap" />
                    <TextBlock Text="只读 IMAP · 不改已读 / 不删邮件 · 授权码 DPAPI 加密"
                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 工具条 ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <WrapPanel>
                <Button Content="刷新全部" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding RefreshAllCommand}"
                        ToolTip="逐个连接启用的账号，拉取每个收件箱最近的邮件并合并（只读）" />
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,8"
                        Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
                <Button Content="新增账号" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Click="OnAddAccountClick" ToolTip="弹出账号设置窗口，可同时选择服务商预设" />
                <Button Content="编辑选中" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Click="OnEditAccountClick" IsEnabled="{Binding HasSelectedAccount}"
                        ToolTip="也可以双击左侧账号直接打开" />
                <Button Content="删除选中" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,8"
                        Command="{Binding DeleteAccountCommand}" IsEnabled="{Binding HasSelectedAccount}" />
                <Button Content="网络代理" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Click="OnProxyClick" ToolTip="Gmail 直连超时时设置系统代理 / 自定义代理" />
                <Button Content="日志" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,20,8"
                        Click="OnLogClick" />

                <StackPanel Orientation="Horizontal" Margin="0,0,20,8" VerticalAlignment="Center">
                    <TextBlock Text="每个账号取最近" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding Cfg.FetchCount, UpdateSourceTrigger=PropertyChanged}" Width="54" Margin="8,0"
                             Style="{StaticResource TextBoxStyle}" ToolTip="5 ~ 200；Gmail 建议 30~50" />
                    <TextBlock Text="封" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <CheckBox Content="打开工具时自动刷新" IsChecked="{Binding Cfg.RefreshOnOpen}"
                          Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,8" VerticalAlignment="Center" />

                <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="16,0,0,8"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </WrapPanel>
        </Border>

        <!-- ===== 主区域：账号 | 收件列表 | 阅读区 ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="330" MinWidth="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：账号 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="📥 账号" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AccountsSummary}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋" Padding="9,2" VerticalAlignment="Top"
                                Style="{StaticResource SecondaryButtonStyle}" Click="OnAddAccountClick"
                                ToolTip="新增账号" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                 Style="{StaticResource FileListStyle}" Margin="8,0,8,8"
                                 core:ScrollChaining.Enabled="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="OnAccountDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled}" Style="{StaticResource CheckBoxStyle}"
                                                  VerticalAlignment="Top" Margin="0,1,8,0"
                                                  ToolTip="勾选 = 参与代收（取消勾选只跳过这个账号，配置保留）" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="还没有账号：点「＋」新增"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="20,6,16,0" VerticalAlignment="Top"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="16,0,16,10">
                        <WrapPanel>
                            <Button Content="编辑" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"
                                    Click="OnEditAccountClick" IsEnabled="{Binding HasSelectedAccount}" />
                            <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6"
                                    Command="{Binding DeleteAccountCommand}" IsEnabled="{Binding HasSelectedAccount}" />
                        </WrapPanel>
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="双击账号可编辑服务器 / 授权码 / 预设。" />
                    </StackPanel>
                </Grid>
            </Border>

            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="mail-collector.账号与收件列表" />

            <!-- ===== 中：收件列表 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,12,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="📬 收件箱（合并）" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MessagesSummary}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Top" Command="{Binding RefreshAllCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="16,8,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                                      DisplayMemberPath="Label" Style="{StaticResource ComboBoxStyle}"
                                      ToolTip="只看某个账号的邮件" />
                            <CheckBox Grid.Column="1" Content="只看未读" IsChecked="{Binding OnlyUnread}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="按主题 / 发件人 / 账号名搜索；空格分隔多个关键词需同时命中" />
                            <TextBlock Text="搜索主题 / 发件人 / 账号…" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="16,8,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                  DisplayMemberPath="Label" Style="{StaticResource ComboBoxStyle}"
                                  ToolTip="收件列表排序：日期 / 发件人 / 主题 / 账号 / 是否未读 / 大小" />
                        <Button Grid.Column="1" Content="{Binding SortDirectionText}" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleSortDirectionCommand}"
                                ToolTip="{Binding SortDirectionToolTip}" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <ListBox ItemsSource="{Binding VisibleMessages}" SelectedItem="{Binding SelectedMessage}"
                                 Style="{StaticResource FileListStyle}" Margin="8,0,8,8"
                                 core:ScrollChaining.Enabled="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding UnreadMark}" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Subject}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding DateText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top"
                                                           Margin="8,1,0,0" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding FromText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="110"
                                                           ToolTip="{Binding FromText}" />
                                                <Border Background="{DynamicResource TagChipBackgroundBrush}" CornerRadius="4"
                                                        Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AccountBadge}" FontSize="9.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="70"
                                                               ToolTip="{Binding AccountBadge}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="还没有邮件：填好账号后点「刷新全部」，这里会合并显示各邮箱最近的收件"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="22,10,22,0" VerticalAlignment="Top"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasVisibleMessages, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>

            <core:PaneSplitter Grid.Column="3" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="mail-collector.收件列表与邮件详情" />

            <!-- ===== 右：整块阅读区 ===== -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding DetailSubject}" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="18,14,18,0" MaxHeight="56" />
                    <StackPanel Grid.Row="1" Margin="18,6,18,0">
                        <TextBlock FontSize="11.5" TextWrapping="Wrap">
                            <Run Text="发件人：" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run Text="{Binding DetailFrom, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0">
                            <Run Text="收件人：" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run Text="{Binding DetailTo, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0">
                            <Run Text="时间：" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run Text="{Binding DetailDate, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding DetailStatus}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="18,6,18,0">
                        <Button Content="复制正文" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CopyBodyCommand}" />
                        <CheckBox Content="纯文本" IsChecked="{Binding ForcePlainText}"
                                  Style="{StaticResource CheckBoxStyle}" Margin="14,0,0,0" VerticalAlignment="Center"
                                  ToolTip="有 HTML 正文时也强制用纯文本显示" />
                        <TextBlock Text="Ctrl + 滚轮缩放" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="14,6,14,0">
                        <TextBox x:Name="PlainBody" Text="{Binding MessageBodyText, Mode=OneWay}" IsReadOnly="True"
                                 Style="{StaticResource LogTextBoxStyle}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="10,8"
                                 core:ScrollChaining.Enabled="True" FontSize="12"
                                 Visibility="{Binding ShowPlainBody, Converter={StaticResource BoolToVis}}" />
                        <Grid x:Name="HtmlHost"
                              Visibility="{Binding ShowHtmlPreview, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <Grid Grid.Row="4" Margin="18,6,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AttachmentsSummary}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="全部保存" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SaveAllAttachmentsCommand}"
                                IsEnabled="{Binding HasAttachments}"
                                ToolTip="选一个文件夹，把当前邮件的所有附件都存进去" />
                    </Grid>
                    <ScrollViewer Grid.Row="5" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="14,2,14,12"
                                  core:ScrollChaining.Enabled="True">
                        <ItemsControl ItemsSource="{Binding Attachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="打开" Padding="10,2" Margin="8,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="保存到临时目录后用默认程序打开（不写 Data 目录）" />
                                        <Button Grid.Column="2" Content="保存" Padding="10,2" Margin="8,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="另存为…" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

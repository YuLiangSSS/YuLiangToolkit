<UserControl x:Class="YuLiangToolkit.Tools.Kps.Views.Controls.KeyGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             Focusable="False">
    <!-- 键位网格的宿主：行 / 格子全部由 code-behind 按 LayoutRows 动态生成（每格独立做缩放 / 发光 / 音符动画，
         不订阅全局渲染事件），所以这里只放一个竖排 StackPanel。
         控件本身不写死 Width/Height：Overlay 用 SizeToContent 按内容量尺寸。 -->
    <StackPanel x:Name="RowsHost"
                Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" />
</UserControl>

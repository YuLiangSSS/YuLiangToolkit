<UserControl x:Class="YuLiangToolkit.Tools.Kps.Views.KpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YuLiangToolkit.Tools.Kps.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,26">
            <TextBlock Text="🎹 KPS 按键统计" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                       Text="实时 KPS / 每键计数 / 键位可视化 + 置顶透明 Overlay。功能灵感来自开源项目 DmNote（GPL-3.0），本实现为独立重写。" />

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="骨架页面（正在开发）" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Cfg.FilePath}" FontSize="10.5" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

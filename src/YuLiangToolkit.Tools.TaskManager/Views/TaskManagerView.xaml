<UserControl x:Class="YuLiangToolkit.Tools.TaskManager.Views.TaskManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:models="clr-namespace:YuLiangToolkit.Tools.TaskManager.Models"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.TaskManager.Views">

    <UserControl.Resources>
        <!-- 表头末尾那一列用它占位：ListBox 给滚动条预留的宽度（见 ScrollBarWidthConverter 的说明） -->
        <views:ScrollBarWidthConverter x:Key="ScrollBarWidth" />

        <!-- ===================== 进程列表 DataGrid 深色样式 =====================
             沿用 ExcelViewer 的深色 DataGrid 写法（同样的主题 token），差别：
             · HeadersVisibility=Column（不要左侧行号列）
             · 允许用户拖列宽（CanUserResizeColumns=True，默认就是拖列头之间的竖线）
             · 允许点列头排序（CanUserSortColumns=True，排序由 VM 的 Cfg.SortMode 驱动会有冲突，
               这里改成 DataGrid 自己的排序：绑定一列后由集合视图排序；详见下面 SortMemberPath）
             列头内容里带「总占用」百分比（图4 那种），通过绑定 Overview 的文本实现。 -->
        <Style x:Key="ProcessCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Height" Value="30" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListRowSelectedBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 列头：深色底 + 可拖动分隔线；内容由各列自己的 Header 提供（带总占用） -->
        <Style x:Key="ProcessColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style x:Key="ProcessDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="CellStyle" Value="{StaticResource ProcessCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource ProcessRowStyle}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ProcessColumnHeaderStyle}" />
        </Style>
    </UserControl.Resources>

    <!-- 布局（v0.42.0 起）：标题区 / 系统概览是纯信息条、不可拖；下面「进程区（左进程列表 + 右详情）」
         与「性能曲线」按 docs/dev/layout.md 拆成固定像素行 + 每个相邻边界一条 core:PaneSplitter。
         整页包在 ScrollViewer 里，拖完页面总高度会变、自己出滚动条；
         卡片内部只让列表 / 详情这类能滚的内容吃掉 * 行，别在控件上写死 Height。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,26">

            <!-- ===== 标题区（纯信息条，不放分隔条） ===== -->
            <StackPanel>
                <TextBlock Text="🖥️ 任务管理器" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="看整机 CPU / 内存 / GPU / 硬盘读写的实时占用与走势，列出每个进程的 PID、CPU、内存、GPU 与占用端口（列宽可拖、点列头排序）；可以结束任务、查看进程详情。进程按设定间隔自动刷新，随时可以暂停。" />
            </StackPanel>

            <!-- ===== 系统概览（只读信息条，不放分隔条） ===== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" ClipToBounds="True">
                <StackPanel>
                    <!-- 标题行：左边标题，右边运行时间 / 进程数 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="系统概览" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="运行时间 " FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Overview.UptimeText}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="  ·  " FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Overview.ProcessCountText}" FontSize="11" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Grid>

                    <!-- 四项指标：CPU / 内存 / GPU 带进度条；硬盘只有读写速度（性能计数器不可用时显示「不可用」） -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU -->
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <Grid>
                                <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.CpuText}" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Overview.CpuPercent, Mode=OneWay}"
                                         Style="{StaticResource ProgressBarStyle}" Margin="0,7,0,0" />
                        </StackPanel>

                        <!-- 内存 -->
                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                            <Grid>
                                <TextBlock Text="内存" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.MemoryPercentText}" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Overview.MemoryPercent, Mode=OneWay}"
                                         Style="{StaticResource ProgressBarStyle}" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding Overview.MemoryText}" FontSize="10.5" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- GPU -->
                        <StackPanel Grid.Column="2" Margin="0,0,18,0">
                            <Grid>
                                <TextBlock Text="GPU" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.GpuText}" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Overview.GpuPercent, Mode=OneWay}"
                                         Style="{StaticResource ProgressBarStyle}" Margin="0,7,0,0" />
                            <TextBlock FontSize="10.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="显存 " /><Run Text="{Binding Overview.GpuMemoryText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- 硬盘读写：按物理磁盘分别显示（例如 C: / D: 各一条），不再只给一个总和；
                              性能计数器不可用 / 第一次采样还没基准时回退成总读写 -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="硬盘" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding Overview.Disks}" Margin="0,7,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="10.5" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayText}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run
                                                Text="  读 " Foreground="{DynamicResource TextSecondaryBrush}" /><Run
                                                Text="{Binding ReadText, Mode=OneWay}" /><Run
                                                Text="  写 " Foreground="{DynamicResource TextSecondaryBrush}" /><Run
                                                Text="{Binding WriteText, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding Overview.HasPerDiskActivity, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock FontSize="11.5" Margin="0,7,0,0" TextTrimming="CharacterEllipsis">
                                    <Run Text="读 " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding Overview.DiskReadText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="11.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                                    <Run Text="写 " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding Overview.DiskWriteText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 硬件信息（CPU 型号 · 显卡型号 · 系统版本） -->
                    <TextBlock Text="{Binding Overview.HardwareText}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <!-- 固定磁盘（分区）容量：一项一张小卡，宽度不够自动换行 -->
                    <ItemsControl ItemsSource="{Binding Overview.Volumes}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="12,8" Margin="0,0,8,4" MinWidth="220">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PercentText}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"
                                                     Style="{StaticResource ProgressBarStyle}" Margin="0,6,0,0" />
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding UsedText}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding FreeText}" FontSize="10.5"
                                                       Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 进程区（左进程列表 / 右详情） + 性能曲线（上下可拖） ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <!-- 进程区：占大头（原来 520），往下延伸到原来「开机启动」的位置；用户想要它「大」 -->
                    <RowDefinition Height="640" MinHeight="380" />
                    <RowDefinition Height="12" />
                    <!-- 性能曲线：默认 300，可拖高 / 拖矮 -->
                    <RowDefinition Height="300" MinHeight="200" />
                </Grid.RowDefinitions>

                <!-- 进程区：左列表 *（随窗口缩放）+ 右详情固定像素，中间竖缝可拖 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="360" MinWidth="280" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== 左：进程列表 ===== -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 工具条：搜索 / 排序 / 降序 / 隐藏系统进程 / 刷新间隔 / 刷新 / 暂停（窄了自动换行） -->
                            <WrapPanel Grid.Row="0" Margin="18,14,18,8">
                                <TextBlock Text="进程" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Margin="0,0,14,6" />
                                <!-- 搜索框加长：名称 / PID / 端口都能搜，空格分词（每个词都要命中） -->
                                <TextBox x:Name="SearchBox" Width="330" Margin="0,0,10,6"
                                         Style="{StaticResource TextBoxStyle}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="搜索进程名 / PID / 路径 / 端口；多个关键词用空格分隔（每个词都要命中，如 chrome 443）" />
                                <TextBlock Text="排序" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,6"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="SortCombo" MinWidth="90" Margin="0,0,10,6"
                                          ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedSort}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ToolTip="按 CPU / 内存 / GPU / 名称 / PID / 端口数排序（也可直接点列表列头排序）" />
                                <CheckBox x:Name="DescendingCheckBox" Content="降序" Margin="0,0,14,6"
                                          IsChecked="{Binding SortDescending}"
                                          Style="{StaticResource CheckBoxStyle}"
                                          ToolTip="从大到小（名称按字母倒序）" />
                                <CheckBox x:Name="HideSystemCheckBox" Content="隐藏系统进程" Margin="0,0,14,6"
                                          IsChecked="{Binding HideSystemProcesses}"
                                          Style="{StaticResource CheckBoxStyle}"
                                          ToolTip="系统目录里的 / 读不到路径的进程不显示" />
                                <TextBlock Text="间隔" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,6"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="RefreshIntervalCombo" MinWidth="84" Margin="0,0,10,6"
                                          ItemsSource="{Binding RefreshIntervalOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedRefreshInterval}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ToolTip="自动刷新间隔" />
                                <Button x:Name="RefreshButton" Content="刷新" Margin="0,0,10,6"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="立刻采样一次（暂停时也能用）" />
                                <Button x:Name="PauseButton" Content="{Binding PauseButtonText}" Margin="0,0,10,6"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding TogglePauseCommand}"
                                        ToolTip="{Binding MonitorStateText}" />
                                <!-- 普通权限时显示：点了弹 UAC，以管理员身份重启并自动回到本页（管理员权限下隐藏） -->
                                <Button x:Name="ElevateButton" Content="以管理员身份重启" Margin="0,0,0,6"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RestartElevatedCommand}"
                                        Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVis}}"
                                        ToolTip="结束管理员权限进程需要管理员权限；会弹 UAC，重启后自动回到本页" />
                            </WrapPanel>

                            <!-- ===== 进程列表（DataGrid：列宽可拖、点列头排序、列头带总占用） =====
                                 · 列头显示「总占用」：CPU / 内存 / GPU 三列头右侧带上整机当前占用百分比（图4 那种）；
                                 · 拖动列头之间的竖线改列宽；点列头排序（DataGrid 自己排，基于 SortMemberPath）；
                                 · 数据行与列头由 DataGrid 统一处理，不再手写表头对齐。 -->
                            <DataGrid x:Name="ProcessDataGrid" Grid.Row="1" Margin="8,0"
                                      Style="{StaticResource ProcessDataGridStyle}"
                                      ItemsSource="{Binding ProcessView}"
                                      SelectedItem="{Binding SelectedProcess}"
                                      PreviewMouseRightButtonDown="OnProcessGridPreviewMouseRightButtonDown"
                                      ToolTip="单击选中（右侧显示详情），右键可结束任务 / 打开位置 / 复制；拖列头竖线改列宽，点列头排序">
                                <!-- 列定义：SortMemberPath 对应 ProcessInfo 的属性；列头内容带「总占用」百分比（图4 那种）。
                                     Width="SizeToCells" + 允许拖动 = 起始按内容给宽，用户再拉；名称列 * 吃掉剩余。 -->
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Width="*" MinWidth="140"
                                                        Binding="{Binding Name}" SortMemberPath="Name">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="FontSize" Value="12.5" />
                                                <Setter Property="ToolTip" Value="{Binding Path}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="PID" Width="70" MinWidth="54"
                                                        Binding="{Binding PidText}" SortMemberPath="Pid">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="12.5" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Width="90" MinWidth="72"
                                                        Binding="{Binding CpuText}" SortMemberPath="CpuPercent">
                                        <DataGridTextColumn.Header>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="CPU" FontSize="11" />
                                                <TextBlock Text="{Binding DataContext.Overview.CpuText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="12.5" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Width="110" MinWidth="85"
                                                        Binding="{Binding MemoryText}" SortMemberPath="WorkingSetBytes">
                                        <DataGridTextColumn.Header>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="内存" FontSize="11" />
                                                <TextBlock Text="{Binding DataContext.Overview.MemoryPercentText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="12.5" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Width="80" MinWidth="64"
                                                        Binding="{Binding GpuText}" SortMemberPath="GpuPercent">
                                        <DataGridTextColumn.Header>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="GPU" FontSize="11" />
                                                <TextBlock Text="{Binding DataContext.Overview.GpuText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="12.5" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="GPU 内存" Width="95" MinWidth="70"
                                                        Binding="{Binding GpuMemoryText}" SortMemberPath="GpuMemoryBytes">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="12.5" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="端口" Width="150" MinWidth="90"
                                                        Binding="{Binding PortsText}" SortMemberPath="PortCount">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="12.5" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding PortsText}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>

                                <!-- 右键菜单：必须套 DarkContextMenuStyle + 隐式 DarkMenuLeafItemStyle / DarkMenuSeparatorStyle
                                     （AGENTS.md 硬性规则 13），右键时由代码后置先把该行选中 -->
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource DarkMenuLeafItemStyle}" />
                                            <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource DarkMenuSeparatorStyle}" />
                                        </ContextMenu.Resources>

                                        <MenuItem Header="结束任务" Command="{Binding KillSelectedCommand}" />
                                        <MenuItem Header="打开文件位置" Command="{Binding OpenProcessLocationCommand}" />
                                        <Separator />
                                        <MenuItem Header="复制 PID" Command="{Binding CopyPidCommand}" />
                                        <MenuItem Header="复制路径" Command="{Binding CopyPathCommand}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- 左右分隔条：拖动改「进程列表」与「进程详情」的宽度（双击恢复这一处） -->
                    <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                       Key="task-manager.进程与详情" />

                    <!-- ===== 右：进程详情 ===== -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,14,18,10">
                                <TextBlock Text="进程详情" FontSize="13" FontWeight="SemiBold" />
                            </Grid>

                            <!-- 详情内容比卡片高时自己滚，滚到头交给页面 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          core:ScrollChaining.Enabled="True">
                                <Grid Margin="18,0,18,18">
                                    <!-- 未选中时的提示 -->
                                    <TextBlock Text="在左边的进程列表里选一个进程，这里会显示它的路径、用户、启动时间、线程数、占用端口等详细信息。"
                                               Visibility="{Binding HasSelectedProcess, Converter={StaticResource InverseBoolToVis}}"
                                               TextWrapping="Wrap" MaxWidth="300"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               IsHitTestVisible="False" />

                                    <!-- 选中项详情 -->
                                    <StackPanel Visibility="{Binding HasSelectedProcess, Converter={StaticResource BoolToVis}}">

                                        <!-- 进程名 + PID / CPU / 内存 / GPU / GPU 内存 -->
                                        <TextBlock Text="{Binding SelectedProcess.Name}" FontSize="16" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedProcess.Path}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                <TextBlock Text="PID" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SelectedProcess.PidText}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                <TextBlock Text="CPU" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SelectedProcess.CpuText}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                <TextBlock Text="内存" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SelectedProcess.MemoryText}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                <TextBlock Text="GPU" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SelectedProcess.GpuText}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                <TextBlock Text="GPU 内存" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SelectedProcess.GpuMemoryText}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <!-- 操作按钮 -->
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="结束任务" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding KillSelectedCommand}"
                                                    Margin="0,0,8,8"
                                                    ToolTip="先试 Process.Kill()，失败再试 taskkill，最后 wmic；系统关键进程会被拦下" />
                                            <Button Content="打开文件位置" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenProcessLocationCommand}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="复制 PID" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding CopyPidCommand}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="复制路径" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding CopyPathCommand}"
                                                    Margin="0,0,8,8" />
                                        </WrapPanel>

                                        <!-- 端口占用 -->
                                        <TextBlock Text="端口占用" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,0" />
                                        <TextBlock Text="{Binding SelectedPortSummaryText}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,4,0,6"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="10,8">
                                            <ItemsControl ItemsSource="{Binding SelectedPorts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayText}" FontSize="11"
                                                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                                   TextWrapping="Wrap" Margin="0,1"
                                                                   ToolTip="{Binding DisplayText}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <!-- 详细信息 -->
                                        <TextBlock Text="详细信息" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,0" />
                                        <StackPanel Margin="0,7,0,0">
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,5">
                                                <Run Text="路径：" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding SelectedPathText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,5">
                                                <Run Text="用户：" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding SelectedUserText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,5">
                                                <Run Text="启动时间：" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding SelectedStartTimeText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,5">
                                                <Run Text="优先级：" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding SelectedPriorityText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,5">
                                                <Run Text="窗口标题：" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding SelectedWindowText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,5">
                                                <Run Text="线程数：" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding SelectedThreadText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,5">
                                                <Run Text="句柄数：" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding SelectedHandleText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,5">
                                                <Run Text="虚拟内存：" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding SelectedVirtualText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 读取详情失败时的说明（没有错误就整行隐藏） -->
                                        <TextBlock Text="{Binding SelectedDetailsError}" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding SelectedDetailsError, Converter={StaticResource EmptyToVisInverse}}"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 上下分隔条：拖动改「进程区」与「性能曲线」的高度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="task-manager.进程区与性能" />

                <!-- ===== 性能曲线（CPU / 内存 / GPU / 磁盘，各一张卡：实时折线 + 关键数值） ===== -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,14,18,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="性能" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="最近约 2 分钟实时走势（跟随上面的刷新间隔）"
                                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <!-- 四张性能卡：每张 = 标题（带当前数值）+ 实时折线 + 底部详情 -->
                        <Grid Grid.Row="1" Margin="18,4,18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CPU -->
                            <Border Grid.Column="0" Background="{DynamicResource InputBackgroundBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,10" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="60" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="CPU" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PerfCpuDetail}" FontSize="11.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="4" ClipToBounds="True">
                                        <views:PerformanceGraph x:Name="CpuGraph" Series="Cpu" History="{Binding History}" />
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="{Binding Overview.CpuName}" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Overview.CpuName}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>

                            <!-- 内存 -->
                            <Border Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,10" Margin="6,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="60" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="内存" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PerfMemoryDetail}" FontSize="11.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="4" ClipToBounds="True">
                                        <views:PerformanceGraph x:Name="MemoryGraph" Series="Memory" History="{Binding History}" />
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="{Binding Overview.MemoryText}" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>

                            <!-- GPU -->
                            <Border Grid.Column="2" Background="{DynamicResource InputBackgroundBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,10" Margin="6,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="60" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="GPU" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PerfGpuDetail}" FontSize="11.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="4" ClipToBounds="True">
                                        <views:PerformanceGraph x:Name="GpuGraph" Series="Gpu" History="{Binding History}" />
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="{Binding Overview.GpuName}" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Overview.GpuName}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>

                            <!-- 磁盘 -->
                            <Border Grid.Column="3" Background="{DynamicResource InputBackgroundBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,10" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="60" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="磁盘" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PerfDiskDetail}" FontSize="11.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="4" ClipToBounds="True">
                                        <views:PerformanceGraph x:Name="DiskGraph" Series="Disk" History="{Binding History}" />
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="曲线高度按读写速度相对 100 MB/s 显示"
                                               FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

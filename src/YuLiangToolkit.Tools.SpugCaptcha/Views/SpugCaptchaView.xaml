<UserControl x:Class="YuLiangToolkit.Tools.SpugCaptcha.Views.SpugCaptchaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <!-- 布局模板照 VideoToAudioView / SampleView：外层 ScrollViewer + 卡片（CardStyle）。
         样式全部来自 App.xaml（CardStyle / TextBoxStyle / LogTextBoxStyle / PrimaryButtonStyle /
         SecondaryButtonStyle），颜色一律 DynamicResource，换主题时自动跟随。 -->
    <!-- 布局（v0.41.0 起可拖拽）：整页是「标题 / 主区域（短信 | 邮箱 + 验证码验证） / 日志」几块，
         短信与邮箱两栏可左右拖、主区域与日志可上下拖 —— 分隔条是 core:PaneSplitter，拖动即可调大小
         （蓝线 + ↔ / ↕ 光标），松手自动记住（Config\layout.json），双击缝隙恢复这一处；
         全部恢复默认：主页设置 →「界面布局 → 恢复默认布局」。约定见 docs/dev/layout.md。
         ⚠ 可拖的上下两块（主区域 / 日志）是固定像素行，所以整页仍在 ScrollViewer 里滚动。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,22,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />                <!-- 标题 -->
                <RowDefinition Height="580" MinHeight="470" /> <!-- 主区域：短信 | 邮箱 + 验证码验证（两栏可左右拖） -->
                <RowDefinition Height="12" />                  <!-- 主区域 / 日志 分隔条（上下可拖） -->
                <RowDefinition Height="260" MinHeight="160" /> <!-- 发送 / 验证信息（日志） -->
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="📨 Spug 验证码测试" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="联调 Spug 推送助手（push.spug.cc）的短信 / 邮箱验证码模板：粘贴控制台复制的模板 URL、填收件人、点「发送验证码」，收到后把验证码填到底部「验证」。Spug 没有校验接口，验证由本工具在本地比对。" />
            </StackPanel>

            <!-- ===== 主区域：短信 / 邮箱两栏 + 验证码验证 ===== -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="240" />   <!-- 短信 / 邮箱两栏（随主区域伸缩） -->
                    <RowDefinition Height="Auto" />                <!-- 验证码验证 -->
                </Grid.RowDefinitions>

                <!-- ===== 左右两栏：短信 / 邮箱（可左右拖） ===== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" />       <!-- 左：短信，随窗口缩放 -->
                        <ColumnDefinition Width="12" />                     <!-- 左右分隔条 -->
                        <ColumnDefinition Width="440" MinWidth="320" />     <!-- 右：邮箱（可拖宽） -->
                    </Grid.ColumnDefinitions>

                    <!-- 左栏：短信（内容比栏高时内部滚动，滚到头再交给整页） -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                    <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📱 短信验证码" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="支持 Spug 的 ${code} 与 ${code} ${number} 两种短信模板（${number} 是有效分钟数，由服务端替换）。" />

                        <TextBlock Text="推送 URL（模板编码）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,6" />
                        <Grid>
                            <TextBox x:Name="SmsUrlBox" Text="{Binding Cfg.SmsUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="从 Spug 控制台复制完整调用地址，例如 https://push.spug.cc/sms/你的模板编码" />
                            <TextBlock Text="https://push.spug.cc/sms/模板编码" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding Text, ElementName=SmsUrlBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="手机号" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="PhoneBox" Text="{Binding Cfg.Phone, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" ToolTip="接收短信的手机号（11 位，接口的 to 参数）" />
                                <TextBlock Text="例如 13800138000" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding Text, ElementName=PhoneBox, Converter={StaticResource EmptyToVis}}" />
                            </Grid>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="有效分钟数" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SmsMinutesBox" Text="{Binding Cfg.SmsMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Width="180" HorizontalAlignment="Left"
                                         ToolTip="模板含 ${number} 时必填（有效分钟数）；模板只含 ${code} 时留空则不传 number" />
                                <TextBlock Text="例如 5（可留空）" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding Text, ElementName=SmsMinutesBox, Converter={StaticResource EmptyToVis}}" />
                            </Grid>
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="86,6,0,0"
                                   Text="模板含 ${number} 时必填；只含 ${code} 的模板留空即可（不传 number）。" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="验证码（可选）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SmsCodeBox" Text="{Binding SmsCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" MaxLength="6"
                                         ToolTip="想指定验证码就填这里（4~6 位数字或字母）；留空则每次随机生成 6 位数字" />
                                <TextBlock Text="留空则随机生成" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding Text, ElementName=SmsCodeBox, Converter={StaticResource EmptyToVis}}" />
                            </Grid>
                        </Grid>

                        <Button x:Name="SendSmsButton" Content="发送验证码" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SendSmsCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />

                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                            <TextBlock Text="{Binding SmsStatusText}" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    </Border>
                    </ScrollViewer>

                    <!-- 左右分隔条：拖动改「短信」与「邮箱」两栏的宽度（双击恢复这一处） -->
                    <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                       Key="spug-captcha.短信与邮箱" />

                    <!-- 右栏：邮箱（内容比栏高时内部滚动，滚到头再交给整页） -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                    <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="✉️ 邮箱验证码" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Spug 官方中文 / 英文邮件模板靠两个不同的模板 URL 区分；接口固定需要 scene / code / minute 三个参数。" />

                        <TextBlock Text="推送 URL（模板编码）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,6" />
                        <Grid>
                            <TextBox x:Name="MailUrlBox" Text="{Binding Cfg.MailUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="从 Spug 控制台复制完整调用地址，例如 https://push.spug.cc/mail/你的模板编码" />
                            <TextBlock Text="https://push.spug.cc/mail/模板编码" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding Text, ElementName=MailUrlBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="邮箱" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="EmailBox" Text="{Binding Cfg.Email, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" ToolTip="接收邮件的邮箱（接口的 to 参数）" />
                                <TextBlock Text="例如 you@example.com" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding Text, ElementName=EmailBox, Converter={StaticResource EmptyToVis}}" />
                            </Grid>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="验证场景" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="MailSceneBox" Text="{Binding Cfg.MailScene, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" ToolTip="Spug 的 scene 参数，最多 12 个字符，不能含链接 / 域名" />
                                <TextBlock Text="登录验证" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding Text, ElementName=MailSceneBox, Converter={StaticResource EmptyToVis}}" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="有效分钟" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                            <Grid Grid.Column="3">
                                <TextBox x:Name="MailMinutesBox" Text="{Binding Cfg.MailMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" ToolTip="Spug 的 minute 参数，支持数字或中文数字（如 5 / 五分钟）" />
                                <TextBlock Text="5" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding Text, ElementName=MailMinutesBox, Converter={StaticResource EmptyToVis}}" />
                            </Grid>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="验证码（可选）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="MailCodeBox" Text="{Binding MailCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" MaxLength="6"
                                         ToolTip="想指定验证码就填这里（4~6 位数字或字母）；留空则每次随机生成 6 位数字" />
                                <TextBlock Text="留空则随机生成" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding Text, ElementName=MailCodeBox, Converter={StaticResource EmptyToVis}}" />
                            </Grid>
                        </Grid>

                        <Button x:Name="SendMailButton" Content="发送验证码" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SendMailCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />

                        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                            <TextBlock Text="{Binding MailStatusText}" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    </Border>
                    </ScrollViewer>
                </Grid>

                <!-- ===== 验证码验证（本地比对） ===== -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" ClipToBounds="True">
                    <StackPanel>
                    <TextBlock Text="🔐 验证码验证" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="输入手机 / 邮箱收到的验证码，点「验证」——本工具把输入和刚成功发出的验证码做本地比对（Spug 没有校验验证码的接口）。" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="VerifyCodeBox" Text="{Binding VerifyCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStyle}" MaxLength="6"
                                     ToolTip="收到短信 / 邮件后，把其中的验证码填到这里" />
                            <TextBlock Text="输入收到的验证码（4~6 位）" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding Text, ElementName=VerifyCodeBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                        <Button x:Name="VerifyButton" Grid.Column="1" Content="验证" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding VerifyCommand}" Margin="10,0,0,0" />
                        <Button Grid.Column="2" Content="清空日志" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearLogCommand}" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding PendingHintText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <TextBlock Text="{Binding VerifyResultText}" FontSize="15" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastVerifySucceeded}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastVerifyFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            </Grid>

            <!-- 上下分隔条：拖动改「主区域（短信 / 邮箱 + 验证）」与「日志」的高度（双击恢复这一处） -->
            <core:PaneSplitter Grid.Row="2" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="spug-captcha.主区域与日志" />

            <!-- ===== 发送 / 验证信息（日志） ===== -->
            <!-- 日志框放 * 行、删掉写死的 Height=170（区域拖高 / 拖矮时只有日志跟着伸缩）。 -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />                <!-- 标题 -->
                        <RowDefinition Height="Auto" />                <!-- 说明 -->
                        <RowDefinition Height="*" MinHeight="60" />    <!-- 日志（随区域伸缩） -->
                        <RowDefinition Height="Auto" />                <!-- 底部提示 -->
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📋 发送 / 验证信息" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="这里显示每次调用的时间、通道、Spug 返回的 msg / request_id、失败原因和本地验证结果；URL 里的模板编码会打码显示。" />
                    <TextBox x:Name="LogBox" Grid.Row="2" Text="{Binding LogText, Mode=OneWay}" Style="{StaticResource LogTextBoxStyle}"
                             Margin="0,10,0,0" MinHeight="60" core:ScrollChaining.Enabled="True" />
                    <TextBlock Grid.Row="3" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="提示：接口返回「请求成功」只代表 Spug 已受理，不代表短信 / 邮件一定送达；可凭 request_id 到 Spug 发送记录查看最终投递结果。" />
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>

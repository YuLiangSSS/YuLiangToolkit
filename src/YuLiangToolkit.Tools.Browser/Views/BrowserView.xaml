<UserControl x:Class="YuLiangToolkit.Tools.Browser.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YuLiangToolkit.Tools.Browser.ViewModels"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="{DynamicResource WindowBackgroundBrush}"
             Focusable="False">

    <!-- 网页浏览器（多标签页）：标签条（上方 / 左侧两种位置，ViewModel.IsTabBarTop 决定显示哪条）
         + 浏览器工具条（前进 / 后退 / 刷新 / 主页 / 地址栏 / 切换标签栏位置）+ 网页区域。
         ⚠ 每个标签页一个 WebView2 实例（在 BrowserView.xaml.cs 里按 ActiveTab 创建），
         全部叠在 WebHost 里、只显示激活那个 —— WebView2 是独立的原生窗口（HwndHost）：
         WPF 的控件盖不住它，所以「内核启动中 / 出错」提示只在激活标签还没创建出内核时显示；
         状态文字放工具条右边。 -->

    <UserControl.Resources>
        <!-- 工具条上的小图标按钮（Segoe Fluent Icons / MDL2 字形） -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签条上的小按钮（+ 新建标签、× 关闭标签）：比工具条按钮更紧凑 -->
        <Style x:Key="TabMiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddressTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- ================= 标签条（上方横排 / 左侧竖排共用） ================= -->

        <!-- 标签内容：加载点 + 标题 + 关闭按钮；选中 = 卡片底色，悬停 = 行悬停色 -->
        <DataTemplate x:Key="TabItemTemplate" DataType="{x:Type vm:BrowserTab}">
            <Border x:Name="Root" Margin="2,3" Padding="9,5"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="Transparent" SnapsToDevicePixels="True">
                <Grid ToolTip="{Binding Header}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 加载中 = 主题色小圆点 -->
                    <Ellipse x:Name="LoadingDot" Grid.Column="0" Width="7" Height="7"
                             Margin="0,0,7,0" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />

                    <TextBlock Grid.Column="1" Text="{Binding Header}" VerticalAlignment="Center"
                               MaxWidth="148" TextTrimming="CharacterEllipsis" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Button x:Name="CloseButton" Grid.Column="2" Content="&#xE711;"
                            Style="{StaticResource TabMiniButtonStyle}" Margin="5,0,0,0"
                            ToolTip="关闭标签页（Ctrl+W，中键点击也行）"
                            Click="OnTabCloseClick" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter TargetName="LoadingDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 标签的容器：去掉 ListBoxItem 默认底色 / 边框，全部交给上面的模板画
            （IsSelected 由 ListBox 自己维护，模板里用 RelativeSource 读取） -->
        <Style x:Key="TabItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签列表公共外观；排布方向（横 / 竖）由用它的位置自己给 ItemsPanel，
             事件（中键关标签 / 双击空白新建）挂在实例上 -->
        <Style x:Key="TabListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemTemplate" Value="{StaticResource TabItemTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabItemContainerStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
            <Setter Property="SelectedItem" Value="{Binding ActiveTab, Mode=TwoWay}" />
        </Style>

        <!-- 网页里右键弹出的菜单（右键事件接管，见 BrowserView.xaml.cs）。
             ⚠ 这里必须用自定义模板：WPF 默认的 ContextMenu / MenuItem 模板会给每个菜单项留一条
             「图标列」白底竖条（深色主题下非常突兀），只设 Background 是盖不掉的。 -->
        <Style x:Key="BrowserContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowserMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                           Margin="28,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowserMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        </Style>

        <!-- ================= 齿轮菜单（历史 / 下载 / 缩放 / 设置） ================= -->
        <Style x:Key="FlyoutActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="PanelSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="PanelTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- 侧栏顶部两个标签页签：当前那个用强调色 -->
        <Style x:Key="PanelHistoryTabStyle" TargetType="Button" BasedOn="{StaticResource PanelTabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHistoryPanel}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelDownloadsTabStyle" TargetType="Button" BasedOn="{StaticResource PanelTabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDownloadsPanel}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelBookmarksTabStyle" TargetType="Button" BasedOn="{StaticResource PanelTabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBookmarksPanel}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelResourcesTabStyle" TargetType="Button" BasedOn="{StaticResource PanelTabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsResourcesPanel}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 书签一行的「打开」按钮：透明铺满左侧，悬停才亮底色 -->
        <Style x:Key="BookmarkOpenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ListRowHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 书签一行：标题 / 地址 + 新标签页打开 + 删除 -->
        <DataTemplate x:Key="BookmarkItemTemplate">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BookmarkOpenButtonStyle}"
                        Command="{Binding DataContext.OpenBookmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" ToolTip="{Binding Url}">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Url}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新标签页" Style="{StaticResource PanelSmallButtonStyle}" Margin="6,0,4,0"
                            ToolTip="在新标签页打开这个书签"
                            Command="{Binding DataContext.OpenBookmarkInNewTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="&#xE711;" Style="{StaticResource TabMiniButtonStyle}"
                            ToolTip="删除这个书签"
                            Command="{Binding DataContext.RemoveBookmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 嗅探资源一行：文件名 / 类型 / 大小 / 尺寸 / 地址 + 打开 / 下载 / 复制 -->
        <DataTemplate x:Key="ResourceItemTemplate">
            <Grid Margin="2,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding Url}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding KindGlyph}" FontSize="11" />
                    <TextBlock Text="{Binding KindText}" FontSize="10.5" Margin="4,0,0,0"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding SizeText}" FontSize="10.5" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding DimensionText}" FontSize="10.5" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{Binding Url}" FontSize="10" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding Url}" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="打开" Style="{StaticResource PanelSmallButtonStyle}" Width="54"
                            ToolTip="在新标签页打开"
                            Command="{Binding DataContext.OpenResourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="下载" Style="{StaticResource PanelSmallButtonStyle}" Width="54"
                            ToolTip="读取原始字节并另存为"
                            Command="{Binding DataContext.DownloadResourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="复制" Style="{StaticResource PanelSmallButtonStyle}" Width="54"
                            ToolTip="复制资源地址"
                            Command="{Binding DataContext.CopyResourceUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 历史记录一行：标题 / 地址 / 时间 -->
        <DataTemplate x:Key="HistoryItemTemplate">
            <StackPanel Margin="2,3">
                <TextBlock Text="{Binding DisplayTitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding Url}" />
                <TextBlock Text="{Binding Url}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding VisitedText}" FontSize="10" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- 下载一行：文件名 / 状态 / 进度 / 操作按钮 -->
        <DataTemplate x:Key="DownloadItemTemplate">
            <StackPanel Margin="2,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding FilePath}" />
                    <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="10.5"
                               Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <ProgressBar Height="6" Margin="0,5,0,0" Maximum="1"
                             Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Style="{StaticResource ProgressBarStyle}"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding ProgressText}" FontSize="10.5" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Content="打开文件" Style="{StaticResource PanelSmallButtonStyle}"
                            Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}"
                            Command="{Binding DataContext.OpenDownloadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="打开文件夹" Style="{StaticResource PanelSmallButtonStyle}"
                            Command="{Binding DataContext.OpenDownloadFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="取消下载" Style="{StaticResource PanelSmallButtonStyle}"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 上方标签条（IsTabBarTop = false 时整条隐藏） ================= -->
        <Border x:Name="TopTabStrip" Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="6,2" SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTabBarTop}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE710;" ToolTip="新建标签页（Ctrl+T）"
                        Style="{StaticResource TabMiniButtonStyle}" Margin="4,0,2,0"
                        VerticalAlignment="Center" Command="{Binding NewTabCommand}" />
                <ListBox x:Name="TopTabList" Style="{StaticResource TabListBoxStyle}"
                         ItemsSource="{Binding Tabs}"
                         PreviewMouseDown="OnTabListMouseDown"
                         MouseDoubleClick="OnTabListDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= 主区域 = 左侧标签条 + （工具条 + 网页） ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧标签条（IsTabBarLeft = false 时整列收起；Auto 列在子元素 Collapsed 后自动为 0 宽） -->
            <Border x:Name="LeftTabStrip" Grid.Column="0" Width="178"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabBarLeft}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,9,8,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="标签页" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Content="&#xE710;" ToolTip="新建标签页（Ctrl+T）"
                                Style="{StaticResource TabMiniButtonStyle}"
                                Command="{Binding NewTabCommand}" />
                    </Grid>

                    <ListBox x:Name="LeftTabList" Grid.Row="1" Style="{StaticResource TabListBoxStyle}"
                             ItemsSource="{Binding Tabs}"
                             PreviewMouseDown="OnTabListMouseDown"
                             MouseDoubleClick="OnTabListDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ================= 浏览器工具条 ================= -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackButton" Content="&#xE72B;" ToolTip="后退（Alt+←）"
                                    Style="{StaticResource NavButtonStyle}" Command="{Binding BackCommand}" />
                            <Button x:Name="ForwardButton" Content="&#xE72A;" ToolTip="前进（Alt+→）"
                                    Style="{StaticResource NavButtonStyle}" Command="{Binding ForwardCommand}" />
                            <Button x:Name="RefreshButton" Content="&#xE72C;" ToolTip="刷新当前页（F5 / Ctrl+R）"
                                    Style="{StaticResource NavButtonStyle}" Command="{Binding RefreshCommand}" />
                            <Button x:Name="HomeButton" Content="&#xE80F;" ToolTip="回到主页（配置里的 HomePage）"
                                    Style="{StaticResource NavButtonStyle}" Command="{Binding HomeCommand}" />
                        </StackPanel>

                        <!-- 地址栏：回车 = 前往；地址栏里输入不是网址的内容会自动用搜索引擎搜 -->
                        <TextBox x:Name="AddressBox" Grid.Column="1" Margin="8,0"
                                 Style="{StaticResource AddressTextBoxStyle}"
                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnAddressKeyDown"
                                 GotKeyboardFocus="OnAddressGotKeyboardFocus"
                                 LostKeyboardFocus="OnAddressLostKeyboardFocus"
                                 ToolTip="{Binding PageTitle}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 收藏当前页：空心星 / 实心星由 IsCurrentPageBookmarked 切换 -->
                            <Button x:Name="BookmarkButton" Width="30" Margin="0,0,4,0"
                                    ToolTip="收藏当前页（再点一次取消收藏）"
                                    Command="{Binding ToggleBookmarkCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Setter Property="Content" Value="&#xE734;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentPageBookmarked}" Value="True">
                                                <Setter Property="Content" Value="&#xE735;" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="GoButton" Content="前往" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,6" Command="{Binding GoCommand}" />
                            <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <!-- 缩放不是 100% 时才显示（Ctrl + 滚轮 / 齿轮菜单里调） -->
                            <TextBlock Text="{Binding ZoomText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding IsZoomed, Converter={StaticResource BoolToVis}}"
                                       ToolTip="页面缩放（Ctrl + 鼠标滚轮调整）" />
                            <!-- 切换标签栏位置：上方 ⇄ 左侧（⇄ 用 Segoe UI Symbol，Fluent Icons 里没有这个字形） -->
                            <Button x:Name="ToggleTabSideButton" Content="&#x21C4;" Margin="8,0,0,0"
                                    Style="{StaticResource NavButtonStyle}" Width="30"
                                    FontFamily="Segoe UI Symbol" FontSize="14"
                                    ToolTip="切换标签栏位置：上方 / 左侧"
                                    Command="{Binding ToggleTabBarSideCommand}" />
                            <!-- 齿轮：浏览器设置 / 历史记录 / 下载 / 缩放（就在切换标签栏按钮右边） -->
                            <Button x:Name="GearButton" Content="&#xE713;" Margin="2,0,0,0"
                                    Style="{StaticResource NavButtonStyle}" Width="30"
                                    ToolTip="浏览器设置：历史记录 / 下载 / 页面缩放 / 主页 / 启动恢复"
                                    Click="OnGearClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 网页区域 + 右侧面板（历史记录 / 下载） ================= -->
                <Grid Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <!-- 面板关着时列宽 0 且分隔条收起；打开时按 LayoutMemory 记忆的宽度恢复 -->
                        <ColumnDefinition Width="{Binding IsSidePanelOpen, Converter={StaticResource BoolToPaneLength}, ConverterParameter=12}" />
                        <ColumnDefinition Width="{Binding IsSidePanelOpen, Converter={StaticResource BoolToPaneLength}, ConverterParameter=340}"
                                          MinWidth="{Binding IsSidePanelOpen, Converter={StaticResource BoolToPaneLength}, ConverterParameter=240}" />
                    </Grid.ColumnDefinitions>

                    <!-- 网页区域：每个标签的 WebView2 由代码后置在激活时创建（共享内核环境，Cookie 互通） -->
                    <Grid Grid.Column="0">
                        <Grid x:Name="WebHost" />

                        <!-- 激活标签的内核还没建好 / 启动失败的提示（创建出 WebView2 之后会被原生窗口盖住） -->
                        <StackPanel x:Name="StartupHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="560" Margin="24">
                            <TextBlock Text="🌐" FontSize="38" HorizontalAlignment="Center" />
                            <TextBlock x:Name="StartupHintText" Text="正在启动 Chromium 内核…" Margin="0,12,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="网页由 Microsoft Edge WebView2（Chromium）渲染"
                                       Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- 网页区 / 右侧面板 分隔条（页面级区块边界，可拖、双击复位、自动记忆） -->
                    <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                       Key="browser.网页与侧栏"
                                       Visibility="{Binding IsSidePanelOpen, Converter={StaticResource BoolToVis}}" />

                    <!-- 右侧面板：历史记录 / 下载 / 书签 / 资源嗅探 -->
                    <Border Grid.Column="2" Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                            Visibility="{Binding IsSidePanelOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="10,8,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="历史记录" Style="{StaticResource PanelHistoryTabStyle}"
                                            Command="{Binding ShowHistoryCommand}" />
                                    <Button Content="下载" Style="{StaticResource PanelDownloadsTabStyle}"
                                            Command="{Binding ShowDownloadsCommand}" />
                                    <Button Content="书签" Style="{StaticResource PanelBookmarksTabStyle}"
                                            Command="{Binding ShowBookmarksCommand}" />
                                    <Button Content="资源" Style="{StaticResource PanelResourcesTabStyle}"
                                            Command="{Binding ShowResourcesCommand}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="&#xE711;" ToolTip="关闭面板"
                                        Style="{StaticResource TabMiniButtonStyle}"
                                        Command="{Binding CloseSidePanelCommand}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="6,0,6,8">
                                <!-- 历史记录 -->
                                <Grid Visibility="{Binding IsHistoryPanel, Converter={StaticResource BoolToVis}}">
                                    <ListBox x:Name="HistoryList" ItemsSource="{Binding History}"
                                             Style="{StaticResource FileListStyle}"
                                             ItemTemplate="{StaticResource HistoryItemTemplate}"
                                             SelectionChanged="OnHistoryListSelectionChanged"
                                             core:ScrollChaining.Enabled="True" />
                                    <TextBlock Text="还没有浏览记录" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- 下载 -->
                                <Grid Visibility="{Binding IsDownloadsPanel, Converter={StaticResource BoolToVis}}">
                                    <ListBox ItemsSource="{Binding Downloads}"
                                             Style="{StaticResource FileListStyle}"
                                             ItemTemplate="{StaticResource DownloadItemTemplate}"
                                             core:ScrollChaining.Enabled="True" />
                                    <TextBlock Text="还没有下载记录&#x0a;（网页里点下载后会出现在这里）"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Downloads.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- 书签 -->
                                <Grid Visibility="{Binding IsBookmarksPanel, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  core:ScrollChaining.Enabled="True">
                                        <ItemsControl ItemsSource="{Binding Bookmarks}"
                                                      ItemTemplate="{StaticResource BookmarkItemTemplate}" />
                                    </ScrollViewer>
                                    <TextBlock Text="还没有收藏&#x0a;（点地址栏右边的 ☆ 收藏当前页）"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Bookmarks.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- 资源嗅探（图片 / 音频 / 视频） -->
                                <Grid Visibility="{Binding IsResourcesPanel, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Content="🔍 重新嗅探当前页"
                                            Style="{StaticResource PanelSmallButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,0,0,6"
                                            ToolTip="先跑网页内爬虫（DOM / 背景图 / performance），网络请求由内核自动抓"
                                            Command="{Binding RefreshResourcesCommand}" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  core:ScrollChaining.Enabled="True">
                                        <ItemsControl ItemsSource="{Binding Resources}"
                                                      ItemTemplate="{StaticResource ResourceItemTemplate}" />
                                    </ScrollViewer>
                                    <TextBlock Grid.Row="1" Text="还没有嗅探到资源&#x0a;（图片 / 音频 / 视频；点上面重新嗅探）"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Resources.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 齿轮菜单（Popup：独立顶层窗口，能盖在 WebView2 原生窗口上面） ================= -->
        <Popup x:Name="GearPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=GearButton}" Placement="Bottom"
               HorizontalOffset="-336" VerticalOffset="6">
            <Border Width="374" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="14"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="🌐 浏览器设置" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Ctrl + 滚轮缩放页面" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>

                    <!-- 页面缩放 -->
                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="页面缩放" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="也支持 Ctrl + 鼠标滚轮 / Ctrl+加号减号" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="−" Width="28" ToolTip="缩小 10%"
                                    Style="{StaticResource PanelSmallButtonStyle}"
                                    Command="{Binding ZoomOutCommand}" />
                            <TextBlock Grid.Column="2" Text="{Binding ZoomText}" Width="56"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button Grid.Column="3" Content="+" Width="28" ToolTip="放大 10%"
                                    Style="{StaticResource PanelSmallButtonStyle}"
                                    Command="{Binding ZoomInCommand}" />
                            <Button Grid.Column="4" Content="重置" ToolTip="恢复 100%"
                                    Style="{StaticResource PanelSmallButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding ZoomResetCommand}" />
                        </Grid>
                    </Border>

                    <!-- 历史记录 / 下载 / 书签 / 清空 -->
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="📜 历史记录" Style="{StaticResource FlyoutActionButtonStyle}"
                                Click="OnGearHistoryClick" />
                        <Button Content="⬇ 下载" Style="{StaticResource FlyoutActionButtonStyle}"
                                Click="OnGearDownloadsClick" />
                        <Button Content="🔖 书签" Style="{StaticResource FlyoutActionButtonStyle}"
                                Click="OnGearBookmarksClick" />
                        <Button Content="🧲 资源嗅探" Style="{StaticResource FlyoutActionButtonStyle}"
                                Click="OnGearResourcesClick" />
                        <Button Content="🗑 清空浏览记录" Style="{StaticResource FlyoutActionButtonStyle}"
                                Command="{Binding ClearHistoryCommand}" />
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12" />

                    <!-- 启动恢复 -->
                    <TextBlock Text="启动时" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <CheckBox Content="恢复上次打开的标签页" IsChecked="{Binding RestoreLastSession, Mode=TwoWay}"
                              Style="{StaticResource CheckBoxStyle}" />
                    <TextBlock Text="只恢复标签（标题 / 网址），点哪个标签才加载哪个页面；关掉后每次打开只进主页。"
                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,5,0,0" />

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12" />

                    <!-- 默认主页 -->
                    <TextBlock Text="默认主页" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding HomePageDraft, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" Height="32"
                                 ToolTip="输入完整网址，例如 https://www.google.com/" />
                        <Button Grid.Column="1" Content="保存" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,6" Margin="8,0,0,0"
                                Command="{Binding SaveHomePageCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding HomePageHint}" FontSize="10.5" Margin="0,5,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="恢复默认主页（Google）" Style="{StaticResource FlyoutActionButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="{Binding ResetHomePageCommand}" />

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12" />
                    <TextBlock FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="说明：扩展、代理、PDF 阅读器这类 Chromium 设置由 WebView2 决定，本项目加不了；这里提供的是 WebView2 开放的能力。" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

<UserControl x:Class="YuLiangToolkit.Tools.Browser.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             Focusable="False">

    <!-- 网页浏览器：上面是浏览器工具条（前进 / 后退 / 刷新 / 主页 / 地址栏），
         下面整块是网页区域（WebView2 = Chromium 内核，在 BrowserView.xaml.cs 里动态创建）。
         ⚠ WebView2 是独立的原生窗口（HwndHost）：WPF 的控件盖不住它，
         所以启动提示 / 错误提示只在「还没创建出内核」时显示；状态文字放工具条右边。 -->

    <UserControl.Resources>
        <!-- 工具条上的小图标按钮（Segoe Fluent Icons / MDL2 字形） -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddressTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- 网页里右键弹出的菜单（WebView2 的默认菜单已关掉，见 BrowserView.xaml.cs） -->
        <Style x:Key="BrowserContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style x:Key="BrowserMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 浏览器工具条 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="&#xE72B;" ToolTip="后退（Alt+←）"
                            Style="{StaticResource NavButtonStyle}" Command="{Binding BackCommand}" />
                    <Button x:Name="ForwardButton" Content="&#xE72A;" ToolTip="前进（Alt+→）"
                            Style="{StaticResource NavButtonStyle}" Command="{Binding ForwardCommand}" />
                    <Button x:Name="RefreshButton" Content="&#xE72C;" ToolTip="刷新当前页（F5 / Ctrl+R）"
                            Style="{StaticResource NavButtonStyle}" Command="{Binding RefreshCommand}" />
                    <Button x:Name="HomeButton" Content="&#xE80F;" ToolTip="回到主页（配置里的 HomePage）"
                            Style="{StaticResource NavButtonStyle}" Command="{Binding HomeCommand}" />
                </StackPanel>

                <!-- 地址栏：回车 = 前往；地址栏里输入不是网址的内容会自动用搜索引擎搜 -->
                <TextBox x:Name="AddressBox" Grid.Column="1" Margin="8,0"
                         Style="{StaticResource AddressTextBoxStyle}"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnAddressKeyDown"
                         GotKeyboardFocus="OnAddressGotKeyboardFocus"
                         ToolTip="{Binding PageTitle}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="GoButton" Content="前往" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,6" Command="{Binding GoCommand}" />
                    <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               MaxWidth="260" TextTrimming="CharacterEllipsis"
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 网页区域 ================= -->
        <Grid Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" ClipToBounds="True">
            <!-- WebView2 控件由代码后置在加载时创建（工具页被切走 / 切回来要重启内核） -->
            <Grid x:Name="WebHost" />

            <!-- 内核启动中 / 启动失败的提示（创建出 WebView2 之后会被原生窗口盖住） -->
            <StackPanel x:Name="StartupHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="560" Margin="24">
                <TextBlock Text="🌐" FontSize="38" HorizontalAlignment="Center" />
                <TextBlock x:Name="StartupHintText" Text="正在启动 Chromium 内核…" Margin="0,12,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="网页由 Microsoft Edge WebView2（Chromium）渲染"
                           Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

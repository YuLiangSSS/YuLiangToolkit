<UserControl x:Class="YuLiangToolkit.Tools.ScreenPen.Views.ScreenPenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:controls="clr-namespace:YuLiangToolkit.Core.Controls;assembly=YuLiangToolkit.Core"
             xmlns:local="clr-namespace:YuLiangToolkit.Tools.ScreenPen"
             Background="Transparent">
    <UserControl.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <Style x:Key="HotkeyBoxLocalStyle" TargetType="controls:HotkeyBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:HotkeyBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" MinHeight="28">
                            <Grid>
                                <TextBlock Text="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}}"
                                           Margin="10,0,24,0" VerticalAlignment="Center" FontSize="12.5"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                           Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,9,0" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsCapturing" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="460" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="✏️ 屏幕画笔" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Text="Epic Pen 风格桌面透明批注：覆盖层上画笔、荧光笔、橡皮、直线、矩形、椭圆、箭头、文字；支持白板 / 黑板、额外调色板与全局快捷键。画笔内容可被截图工具捕获，打开截图时会自动暂停画笔输入。" />
            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Text="默认快捷键：Ctrl+Shift+F6 显示 / 隐藏 · Ctrl+Shift+F7 绘制 / 鼠标穿透 · Ctrl+Shift+F8 清空 · Ctrl+Shift+F9 撤销" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.75*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- 左：操作台 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Content="{Binding ToggleButtonText}" Command="{Binding ToggleOverlayCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="40" FontSize="14" />
                        <TextBlock Text="{Binding ModeText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AnnotationText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,3,0,0" />

                        <TextBlock Text="工具" FontWeight="SemiBold" FontSize="13" Margin="0,20,0,8" />
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="2" Height="56" Command="{Binding DataContext.SelectToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Key}" ToolTip="{Binding Hotkey}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Glyph}" FontSize="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="预设颜色 / 额外调色板" FontWeight="SemiBold" FontSize="13" Margin="0,20,0,8" />
                        <ItemsControl ItemsSource="{Binding Cfg.PaletteColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" Margin="2"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            BorderBrush="#88FFFFFF" BorderThickness="1"
                                            Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="更多颜色…" Command="{Binding OpenPaletteCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="30" />
                            <Button Content="恢复默认调色板" Command="{Binding ResetPaletteCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="30" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="批注操作" FontWeight="SemiBold" FontSize="13" Margin="0,20,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="撤销" Command="{Binding UndoCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Width="70" />
                            <Button Content="重做" Command="{Binding RedoCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Width="70" Margin="8,0,0,0" />
                            <Button Content="清空" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Width="70" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="screen-pen.操作与设置" />

            <!-- 右：设置 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="快捷键" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="全局快捷键在其它窗口也生效；可在「主页设置 → 快捷键」统一查看冲突。" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <CheckBox Content="启用这个工具的全部快捷键" IsChecked="{Binding Cfg.EnableGlobalHotkeys}" Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,8" />

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="显示 / 隐藏" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Column="1" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                ComboText="{Binding Cfg.ToggleOverlayHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsCaptureEnabled="{Binding Cfg.EnableGlobalHotkeys}" />
                            <CheckBox Grid.Column="2" Content="启用" IsChecked="{Binding Cfg.ToggleOverlayHotkeyEnabled}" Style="{StaticResource CheckBoxStyle}" Margin="6,0,0,0" />
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="绘制 / 鼠标穿透" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Column="1" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                ComboText="{Binding Cfg.ToggleInputHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsCaptureEnabled="{Binding Cfg.EnableGlobalHotkeys}" />
                            <CheckBox Grid.Column="2" Content="启用" IsChecked="{Binding Cfg.ToggleInputHotkeyEnabled}" Style="{StaticResource CheckBoxStyle}" Margin="6,0,0,0" />
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="清空" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Column="1" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                ComboText="{Binding Cfg.ClearHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsCaptureEnabled="{Binding Cfg.EnableGlobalHotkeys}" />
                            <CheckBox Grid.Column="2" Content="启用" IsChecked="{Binding Cfg.ClearHotkeyEnabled}" Style="{StaticResource CheckBoxStyle}" Margin="6,0,0,0" />
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="撤销" VerticalAlignment="Center" />
                            <controls:HotkeyBox Grid.Column="1" Style="{StaticResource HotkeyBoxLocalStyle}"
                                                ComboText="{Binding Cfg.UndoHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsCaptureEnabled="{Binding Cfg.EnableGlobalHotkeys}" />
                            <CheckBox Grid.Column="2" Content="启用" IsChecked="{Binding Cfg.UndoHotkeyEnabled}" Style="{StaticResource CheckBoxStyle}" Margin="6,0,0,0" />
                        </Grid>

                        <TextBlock Text="画笔" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,8" />
                        <TextBlock Text="画笔粗细" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Minimum="1" Maximum="40" Value="{Binding Cfg.PenThickness, Mode=TwoWay}" Margin="0,2,0,0" />
                        <TextBlock Text="荧光笔粗细" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        <Slider Minimum="4" Maximum="60" Value="{Binding Cfg.HighlighterThickness, Mode=TwoWay}" Margin="0,2,0,0" />

                        <TextBlock Text="覆盖层" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,8" />
                        <CheckBox Content="显示屏幕上的悬浮工具栏" IsChecked="{Binding Cfg.ShowToolbar}" Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,6" />
                        <CheckBox Content="YuLiangToolkit 启动时显示屏幕画笔" IsChecked="{Binding Cfg.StartVisible}" Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="背景模式" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="透明" Command="{Binding SetBackdropCommand}" CommandParameter="none" Style="{StaticResource SecondaryButtonStyle}" Height="30" Width="64" />
                            <Button Content="白板" Command="{Binding SetBackdropCommand}" CommandParameter="whiteboard" Style="{StaticResource SecondaryButtonStyle}" Height="30" Width="64" Margin="8,0,0,0" />
                            <Button Content="黑板" Command="{Binding SetBackdropCommand}" CommandParameter="blackboard" Style="{StaticResource SecondaryButtonStyle}" Height="30" Width="64" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Cfg.BackdropName}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="YuLiangToolkit.Tools.ScreenPen.Views.ScreenPenOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YuLiangToolkit.Tools.ScreenPen"
        Title="屏幕画笔"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove">
    <Grid x:Name="Root" Background="#01000000">
        <local:ScreenPenCanvas x:Name="Canvas" />
        <Canvas x:Name="TextLayer" IsHitTestVisible="True">
            <TextBox x:Name="TextEditor" Width="260" MinHeight="38"
                     Visibility="Collapsed"
                     AcceptsReturn="False"
                     Background="#E61E1E1E"
                     Foreground="White"
                     BorderBrush="#FF32ADE6"
                     BorderThickness="1"
                     Padding="6,4"
                     FontFamily="Microsoft YaHei UI"
                     FontSize="18"
                     KeyDown="OnTextEditorKeyDown"
                     LostKeyboardFocus="OnTextEditorLostKeyboardFocus" />
        </Canvas>
        <Border x:Name="ModeHint" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,16,0,0" Padding="12,6" CornerRadius="6"
                Background="#D91E1E1E" BorderBrush="#6632ADE6" BorderThickness="1"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="ModeHintText" Foreground="#FFF0F0F0" FontSize="13" />
        </Border>
    </Grid>
</Window>

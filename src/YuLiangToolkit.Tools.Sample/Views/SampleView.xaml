<UserControl x:Class="YuLiangToolkit.Tools.Sample.Views.SampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YuLiangToolkit.Tools.Sample.ViewModels"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.Sample.Views"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <UserControl.Resources>
        <!-- 表头末尾那一列用它占位：ListBox 给滚动条预留的宽度（见 ScrollBarWidthConverter 的说明） -->
        <views:ScrollBarWidthConverter x:Key="ScrollBarWidth" />
    </UserControl.Resources>

    <!-- 说明：本文件是新功能的界面模板。用到的样式（CardStyle / TextBoxStyle / ComboBoxStyle …）
         全部来自 App.xaml（见 AGENTS.md）。 -->

    <!-- 布局模板（v0.42.0 起）：本页同时是「可拖拽区块布局」的模板写法 —— **每个相邻的功能区块之间**都放 core:PaneSplitter
         （竖缝左右拖 / 横缝上下拖；平时只有一条很淡的提示线，可在 主页设置 → 界面布局 → 分隔条提示线 调，0 = 完全看不见；
         鼠标移到缝隙上才亮起蓝线、光标变 ↔ / ↕；松手自动记住、双击复位），列表 / 日志 / 预览框一律放 * 行、不写死高度。
         详见 docs/dev/layout.md，新功能照抄。 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,26">

            <!-- 标题 -->
            <StackPanel>
                <TextBlock Text="🧪 框架示例" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="演示两套轮子：① 选项（Checkbox / Textbox / 下拉框 / 滑块）改一下就写进 Config\sample-framework\config.json；② 资源文件放在 Data\sample-framework\ 里用 ToolStorage 读写。写新功能时复制本项目即可。" />
            </StackPanel>

            <!-- ===== 上半部分：左配置控件 / 右 JSON 实时预览（左右可拖；左边这一列里 ①/② 两张卡还能上下拖） =====
                 左右分栏的标准写法：主设置区 = *（随窗口缩放）+ 分隔条独占一列（12 宽）+ 预览列 = 固定像素；
                 同一列里上下堆叠的卡片之间也各放一条横缝 —— 相邻两块之间都要能拖，别把两块合成一个可拖块。
                 拖动缝隙改大小，双击恢复这一处（全部恢复：主页设置 → 界面布局）。 -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="390" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- 左侧设置列：①/② 两张卡上下堆叠 —— 上下可拖，所以两块都得是固定像素行（拖动只改这两块，
                     这一列的总高不变）；外面仍套 ScrollViewer + ScrollChaining：以后卡片变多、比视口高时这一列
                     自己滚，滚到头再交给整页（内层 ScrollViewer 会无条件吃掉滚轮，所以必须挂 ScrollChaining）。
                     MinHeight 是「还能用」的下限（拖小了内容按 ClipToBounds 裁掉、不会溢到隔壁 / 下一块）。 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              core:ScrollChaining.Enabled="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="305" MinHeight="240" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="155" MinHeight="110" />
                        </Grid.RowDefinitions>

                        <!-- ① 强类型配置 -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                            <StackPanel>
                                <TextBlock Text="① 强类型配置（改一下 → 自动存 config.json）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Config\sample-framework\config.json"
                                           FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,12" />

                                <TextBlock Text="备注（Textbox，输入即保存）" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <!-- x:Name 会变成 UI 自动化里的 AutomationId，写自动化测试/脚本时用得上 -->
                                <TextBox x:Name="NoteBox" Text="{Binding Cfg.Note, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <CheckBox x:Name="EnableCheckBox" Content="启用某功能（Checkbox）" IsChecked="{Binding Cfg.EnableFeature}"
                                              Style="{StaticResource CheckBoxStyle}" Margin="0,0,22,0" />
                                    <CheckBox x:Name="FastModeCheckBox" Content="高速模式（计算属性也参与持久化联动）" IsChecked="{Binding Cfg.ModeIsFast}"
                                              Style="{StaticResource CheckBoxStyle}" />
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="模式" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox x:Name="ModeCombo" Grid.Column="1" ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedMode}" Style="{StaticResource ComboBoxStyle}"
                                              MinWidth="140" />
                                    <TextBlock Grid.Column="2" Text="重复次数" VerticalAlignment="Center" Margin="24,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox x:Name="RepeatBox" Grid.Column="3" Text="{Binding Cfg.Repeat, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" Width="64" Margin="10,0,0,0" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="阈值" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                            Value="{Binding Cfg.Threshold}" Style="{StaticResource SliderStyle}"
                                            ToolTip="拖动过程中也会即时保存（防抖 400ms 合并写入）" />
                                    <TextBlock Grid.Column="2" Text="{Binding Cfg.Threshold, StringFormat={}{0:0.00}}"
                                               VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>

                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Text="提示：勾选 / 输入后不用点任何「保存」；关掉功能或退出程序时还会强制落盘一次，防抖窗口内的改动也不会丢。" />
                            </StackPanel>
                        </Border>

                        <!-- 上下分隔条：拖动改「① 强类型配置」与「② 动态配置」的高度（双击恢复这一处） -->
                        <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                           Key="sample-framework.强类型与动态配置" />

                        <!-- ② 动态配置 -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                            <StackPanel>
                                <TextBlock Text="② 动态配置（不建类也能存 → options.json）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,12"
                                           Text="XAML 里直接绑定索引器：{Binding Dyn[键名]}；代码里用 Dyn.GetInt/GetBool/SetValue" />

                                <!-- TargetNullValue=False：键还不存在时复选框拿到 false 而不是 null，点一下就是勾上 -->
                                <CheckBox x:Name="QuickFlagCheckBox" Content="快速开关（Dyn[quickFlag]）"
                                          IsChecked="{Binding Dyn[quickFlag], TargetNullValue=False}"
                                          Style="{StaticResource CheckBoxStyle}" />
                                <TextBox x:Name="QuickNoteBox" Text="{Binding Dyn[quickNote], UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Margin="0,12,0,0"
                                         ToolTip="随便输点什么，观察右边 options.json 的变化" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- 左右分隔条：拖动改「主设置区」与「配置文件预览」的宽度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="sample-framework.主设置与预览" />

                <!-- 右侧：配置文件实时预览。内部也是 Auto + *：标题行 Auto、预览框吃掉剩下的高度（不写死 Height） -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="120" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="配置文件实时预览" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="打开配置文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right" Command="{Binding OpenConfigFolderCommand}" />
                        </Grid>

                        <TextBox Grid.Row="1" Text="{Binding ConfigPreview, Mode=OneWay}" IsReadOnly="True"
                                 Style="{StaticResource LogTextBoxStyle}" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 core:ScrollChaining.Enabled="True" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== ③ 功能数据文件夹（上块） + ④ 通用交互演示（下块）：上下可拖 =====
                 上下两块都是固定像素行（拖动一条缝 = 一块变高、另一块变矮），所以整页仍在 ScrollViewer 里滚动；
                 卡片内部只让「列表 / 日志」这类内容吃掉多出来的高度（* 行），别在控件上写死 Height。 -->
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="300" MinHeight="240" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="280" MinHeight="250" />
                </Grid.RowDefinitions>

                <!-- ===== ③ 数据文件夹 ===== -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,14,18,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="③ 功能数据文件夹（Data\sample-framework\）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StoragePathText}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="打开文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenDataFolderCommand}" />
                                <Button Content="导入文件…" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding ImportFileCommand}" ToolTip="把外部文件拷贝进 Data 文件夹（重名自动加序号）" />
                                <Button Content="生成示例文件" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding GenerateFileCommand}" />
                                <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding RefreshFilesCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- ===== 文件列表（表头 + 数据行）=====
                             表头写在 ListBox 自己的 ControlTemplate 里，与数据行**同处一列**，
                             所以窗口怎么缩放两者都同宽，不需要监听布局事件。
                             两个边距把差异补平（都是量出来的，别凭感觉改）：
                             · 左边距 33 = 行内容的缩进（外边距10 + 内边距10 + 强调条3 + 内容左边距9 + 列表边框1）
                             · 右边距 = 滚动条宽度（绑定里扣掉）：ListBox 无论有没有滚动条都会预留这一段，
                               不扣的话表头会比数据行宽一条，「大小 / 修改时间」就错开了。
                             数据行的 ColumnDefinitions 必须与表头**一字不差**，且数值列都左对齐，
                             这样「大小」的“大”和「376 B」的“3”落在同一条竖线上。
                             ⚠ 列表放在 * 行里（不写死 Height）：卡片被拖高 / 拖矮时列表自己伸缩。 -->
                        <ListBox x:Name="FileListBox" Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                 Margin="8,0"
                                 core:ScrollChaining.Enabled="True"
                                 ToolTip="单击选中，下面的按钮作用于选中项">
                            <!-- 行样式等沿用全局 FileListStyle，只替换模板（保持与其它列表一致） -->
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource FileListStyle}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBox">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- 表头：宽度 = 列表宽度 − 滚动条宽度（见 ScrollBarWidthWidthConverter） -->
                                                    <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="33,0,21,6" HorizontalAlignment="Stretch"
                                                          DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="132" />
                                                            <ColumnDefinition Width="132" />
                                                            <!-- ListBox 给滚动条预留的位置，表头也留一份，否则右边两列错位 -->
                                                            <ColumnDefinition Width="{Binding Converter={StaticResource ScrollBarWidth}}" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="HeaderName" Text="文件名" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock x:Name="HeaderSize" Grid.Column="1" Text="大小" FontSize="11"
                                                                   HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock x:Name="HeaderTime" Grid.Column="2" Text="修改时间" FontSize="11"
                                                                   HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding DataSummary}" FontSize="11"
                                                                   HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Grid>

                                                    <!-- 数据行（可滚动）
                                                         ⚠ x:Name 必须叫 "ScrollViewer"：ItemsControl/ListBox 是按模板里
                                                         这个名字找「滚动宿主」的，不起名就等于没有滚动宿主 ——
                                                         表现是滚轮完全不起作用（事件也不会到 ListBox 的 PreviewMouseWheel，
                                                         实测 0 次），排查起来很费劲。 -->
                                                    <ScrollViewer x:Name="ScrollViewer" Grid.Row="1" Focusable="False"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  Padding="0" Background="Transparent">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- ⚠ 这串宽度必须与模板里的表头**一字不差**（包括最后那列） -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="132" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RelativePath}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,10,18,14">
                            <Button Content="在资源管理器中显示" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RevealSelectedCommand}" />
                            <Button Content="删除选中" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding DeleteSelectedCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 上下分隔条：拖动改「文件列表」与「交互演示（日志）」的高度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="sample-framework.文件列表与交互日志" />

                <!-- ===== ④ 任务与日志（IsBusy / Progress / Log / 取消） =====
                     内部 Auto + *：标题 / 进度 / 状态 / 按钮都是自然高度，只有日志框吃掉剩下的高度。 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="48" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="④ 通用交互演示（忙碌状态 / 进度 / 日志 / 取消）"
                                   FontSize="13" FontWeight="SemiBold" />
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                         Style="{StaticResource ProgressBarStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="12,0,0,0" MinWidth="70"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="0,9,0,0" TextWrapping="Wrap" FontSize="12" />
                        <TextBox Grid.Row="3" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                 Style="{StaticResource LogTextBoxStyle}" Margin="0,10,0,0"
                                 core:ScrollChaining.Enabled="True" />
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="模拟长任务" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SimulateTaskCommand}" />
                            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding CancelCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 复制模板提示 ===== -->
            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="把本功能当模板" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="复制 src\YuLiangToolkit.Tools.Sample 整个文件夹 → 改名 → 改 csproj 里的 AssemblyName/RootNamespace → 加进 YuLiangToolkit.sln 与主项目引用，即得到一个新功能；把 SampleTool.cs / SampleConfig.cs / SampleViewModel.cs / SampleView.xaml 里的 Id 与内容换成自己的即可。详细步骤见 AGENTS.md。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

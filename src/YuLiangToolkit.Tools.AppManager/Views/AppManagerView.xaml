<UserControl x:Class="YuLiangToolkit.Tools.AppManager.Views.AppManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <!-- 应用管理器（app-manager）。
         布局约定见 docs/dev/layout.md：
           · 主区域（左列表 * ｜ 竖分隔条 ｜ 右详情 固定宽）与「运行日志」上下堆叠，中间一条横分隔条；
           · 列表 / 日志放 * 行、不写死高度；整页 ScrollViewer + 内层 ScrollChaining，卡片 ClipToBounds。
         样式全部来自 App.xaml（CardStyle / TextBoxStyle / ComboBoxStyle / SecondaryButtonStyle …）。 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  core:ScrollChaining.Enabled="True">
        <StackPanel Margin="28,22,28,26">

            <!-- ===== 页头 ===== -->
            <StackPanel>
                <TextBlock Text="🧩 应用管理器" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="和 Windows「设置 → 应用 → 安装的应用」看的是同一份数据（注册表卸载项）。可以按驱动器筛选、按名称 / 安装日期 / 占用大小 / 发布者排序并切换正逆序；每个应用右侧直接「卸载」「修改」，交给安装程序自己的界面确认。" />
                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{Binding StatsText}" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <!-- ① 主区域：左列表 / 竖分隔条 / 右详情（左右可拖） -->
                    <RowDefinition Height="520" MinHeight="360" />
                    <RowDefinition Height="12" />
                    <!-- ② 运行日志 -->
                    <RowDefinition Height="170" MinHeight="110" />
                </Grid.RowDefinitions>

                <!-- ===================== ① 主区域 ===================== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="520" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="360" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== 左：筛选工具条 + 应用列表 ===== -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="140" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 卡标题 + 刷新 -->
                            <Grid Grid.Row="0" Margin="18,14,18,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="已安装的应用" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="注册表卸载项（HKLM / HKLM-WOW6432Node / HKCU），只读读取"
                                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                        ToolTip="重新读一遍注册表（刚卸载完会自动重扫）" />
                            </Grid>

                            <!-- 搜索 + 驱动器筛选 -->
                            <Grid Grid.Row="1" Margin="18,0,18,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="搜索" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,14,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}"
                                         ToolTip="按应用名 / 发布者 / 版本筛选（忽略大小写）" />
                                <TextBlock Grid.Column="2" Text="驱动器" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                <ComboBox x:Name="DriveCombo" Grid.Column="3" MinWidth="176"
                                          ItemsSource="{Binding DriveOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedDrive}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ToolTip="按应用装在哪块盘筛选；没写安装目录的老软件归到「未记录位置」" />
                            </Grid>

                            <!-- 排序：依据 + 方向 -->
                            <Grid Grid.Row="2" Margin="18,0,18,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="排序依据" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="SortCombo" Grid.Column="1" Margin="8,0,10,0" MinWidth="118"
                                          ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedSort}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ToolTip="没记安装日期 / 占用大小的应用会统一排在最后" />
                                <Button Grid.Column="2" Content="{Binding SortDirectionText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ToggleSortDirectionCommand}"
                                        ToolTip="{Binding SortDirectionHint}" />
                                <TextBlock Grid.Column="3" Text="{Binding StatsText}" Margin="14,0,0,0"
                                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding StatsText}" />
                            </Grid>

                            <!-- 表头：与数据行的列定义一字不差（右边距补平 ListBox 行缩进 / 滚动条） -->
                            <Grid Grid.Row="3" Margin="0,0,0,0" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="110" />
                                </Grid.RowDefinitions>
                                <!-- 表头：与数据行的列定义一字不差（左边距 50 = 行缩进 10 + 行内边距 10 + 强调条 3 + 内容左边距 9 + 列表边框 1 + 图标列 32+10 − 表头自身对齐；右边距 26 补平滚动条预留）
                                     位置列 92 宽是为了放得下「未记录位置」五个字，别擅自改窄 -->
                                <Grid Grid.Row="0" Margin="50,0,26,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="应用" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="大小" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="安装日期" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="位置" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="操作" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </Grid>

                                <!-- 列表（* 行）+ 空状态占位 -->
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="AppList" ItemsSource="{Binding VisibleApps}"
                                             SelectedItem="{Binding SelectedApp}"
                                             SelectionMode="Single"
                                             Style="{StaticResource FileListStyle}"
                                             core:ScrollChaining.Enabled="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ToolTip="单击选中，右侧看详情；每行右边可以直接卸载 / 修改">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="140" />
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="132" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 名称 + 副标题（发布者 · 版本），左边带 32px 图标 -->
                                                    <Grid Grid.Column="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Image x:Name="IconImage" Source="{Binding Icon}" Width="32" Height="32"
                                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock x:Name="IconPlaceholder" Text="🧩" FontSize="18"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
                                                            <TextBlock Text="{Binding SubtitleText}" FontSize="10.5" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       ToolTip="{Binding DetailText}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11.5"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding InstallDateText}" FontSize="11.5"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding DriveText}" FontSize="11.5"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                                    <!-- 行内操作：卸载 / 修改（右侧）；正在运行时显示「运行中…」 -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="卸载" Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="10,4" FontSize="11.5" Margin="0,0,6,0"
                                                                IsEnabled="{Binding CanUninstall}"
                                                                ToolTip="{Binding UninstallHintText}"
                                                                Command="{Binding DataContext.UninstallCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="修改" Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="10,4" FontSize="11.5"
                                                                IsEnabled="{Binding CanModify}"
                                                                ToolTip="{Binding ModifyHintText}"
                                                                Command="{Binding DataContext.ModifyCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter TargetName="NameText" Property="Opacity" Value="0.62" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="{Binding EmptyHint}"
                                               Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVis}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                               Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                                </Grid>
                            </Grid>

                            <!-- 状态栏 -->
                            <Grid Grid.Row="4" Margin="18,8,18,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Width="90"
                                                 Style="{StaticResource ProgressBarStyle}" Margin="0,0,10,0"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CancelCommand}"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                            ToolTip="中止本次扫描" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 左右分隔条：拖「应用列表」与「详情」的宽度（双击恢复这一处） -->
                    <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                       Key="app-manager.列表与详情" />

                    <!-- ===== 右：选中应用详情 + 卸载 / 修改 + 设置 ===== -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      core:ScrollChaining.Enabled="True">
                            <StackPanel Margin="18,16,18,18">
                                <TextBlock Text="{Binding SelectedDetailTitle}" FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="在左侧点一行，这里显示完整信息" FontSize="10.5" Margin="0,4,0,12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                    <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedApp.SubtitleText}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="大小" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedApp.SizeText}" FontSize="11"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="1" Text="安装日期" FontSize="11" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedApp.InstallDateText}"
                                                           FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2" Text="位置" FontSize="11" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedApp.App.InstallLocation}"
                                                           FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding SelectedApp.App.InstallLocation, Converter={StaticResource EmptyToVisInverse}}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="未记录安装位置"
                                                           FontSize="11" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding SelectedApp.App.InstallLocation, Converter={StaticResource EmptyToVis}}" />
                                                <TextBlock Grid.Row="3" Text="来源" FontSize="11" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedApp.App.RegistryScope}"
                                                           FontSize="11" Margin="0,5,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 卸载 / 修改（大按钮） -->
                                    <Button Content="卸载" Style="{StaticResource PrimaryButtonStyle}" Margin="0,14,0,0"
                                            HorizontalAlignment="Stretch" IsEnabled="{Binding CanUninstallSelected}"
                                            ToolTip="{Binding UninstallSelectedHint}"
                                            Command="{Binding UninstallCommand}"
                                            CommandParameter="{Binding SelectedApp}" />
                                    <Button Content="修改 / 修复" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch" IsEnabled="{Binding CanModifySelected}"
                                            ToolTip="{Binding ModifySelectedHint}"
                                            Command="{Binding ModifyCommand}"
                                            CommandParameter="{Binding SelectedApp}" />

                                    <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="会调用这个应用自己登记的卸载 / 修改程序，确认步骤在它的界面里完成。本工具不做静默卸载，也不删除任何文件。" />
                                </StackPanel>

                                <!-- ===== 显示与行为设置 ===== -->
                                <TextBlock Text="显示与行为" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,8" />
                                <CheckBox Content="显示未记录大小的应用" IsChecked="{Binding Cfg.ShowUnknownSize}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,9"
                                          ToolTip="注册表里没写 EstimatedSize 的老软件会显示大小为「未知」；关掉后它们会从列表里消失" />
                                <CheckBox Content="卸载 / 修改前先确认" IsChecked="{Binding Cfg.ConfirmBeforeRun}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,9"
                                          ToolTip="确认框会列出应用名和真正要执行的命令行" />
                                <CheckBox Content="操作结束后自动重扫" IsChecked="{Binding Cfg.RescanAfterRun}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="0,0,0,9"
                                          ToolTip="卸载程序退出后自动重新读一遍列表，卸掉的项会消失" />
                                <CheckBox Content="打开页面时自动扫描" IsChecked="{Binding Cfg.AutoScanOnOpen}"
                                          Style="{StaticResource CheckBoxStyle}"
                                          ToolTip="截图冒烟模式（YLT_SHOT）下会自动跳过" />

                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                        Padding="12,10" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="数据从哪来" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="· 名称 / 发布者 / 版本 / 大小 / 安装日期 / 安装位置都来自注册表卸载项，和「设置 → 应用」同一份数据。" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="· 系统组件、补丁更新与同名重复项（32 / 64 位各一条）在扫描时已经过滤掉。" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="· 「大小」是注册表记录的估算值（EstimatedSize），不是实时统计磁盘占用。" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="· 没记安装日期 / 大小的应用，不论正序逆序都排在最后。" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding ConfigPathText}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           ToolTip="配置文件路径" />
                                <Button Content="打开配置文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                        Command="{Binding OpenConfigFolderCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 上下分隔条：主区域 ↔ 运行日志 -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="app-manager.主区域与日志" />

                <!-- ===================== ② 运行日志 ===================== -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="70" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="清空日志" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearLogCommand}" />
                        </Grid>
                        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                 Style="{StaticResource LogTextBoxStyle}" Margin="0,10,0,0"
                                 FontSize="11" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 core:ScrollChaining.Enabled="True" />
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="YuLiangToolkit.Tools.Games.Snake.Views.SnakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.Games.Snake.Views"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent" Focusable="True">

    <!-- 贪吃蛇：左「棋盘」/ 右「联机 + 排行榜 + 设置」。键盘：方向键 / WASD 转向，Shift 加速，空格开始。 -->

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🐍" FontSize="24" VerticalAlignment="Center" />
                <TextBlock Text="贪吃蛇" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                        Visibility="{Binding IsBoosting, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="加速中" FontSize="10.5" Foreground="White" />
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding ResultText}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                       Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="360" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 棋盘 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="200" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="14,10,14,6">
                        <Button Content="开始游戏" Style="{StaticResource PrimaryButtonStyle}" MinWidth="90"
                                Command="{Binding StartCommand}" />
                        <Button Content="停止" Style="{StaticResource SecondaryButtonStyle}" MinWidth="66" Margin="8,0,0,0"
                                Command="{Binding StopCommand}" />
                        <TextBlock Text="{Binding NetBadgeText}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </WrapPanel>

                    <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" ClipToBounds="True">
                        <views:SnakeBoardView x:Name="Board"
                                              Frame="{Binding Frame}"
                                              MyId="{Binding MyPlayerId}"
                                              BoardBrush="{DynamicResource InputBackgroundBrush}"
                                              GridBrush="{DynamicResource BorderBrush}" />
                    </Border>

                    <TextBlock Grid.Row="2" FontSize="10.5" TextWrapping="Wrap" Margin="14,8,14,12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="方向键 / WASD 转向 · 按住 Shift 加速 · 空格 开始 / 重开 · 吃果子加分，撞墙 / 撞蛇 / 撞自己看边缘规则" />
                </Grid>
            </Border>

            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="snake.棋盘与侧栏" />

            <!-- 侧栏 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          core:ScrollChaining.Enabled="True">
                <StackPanel>
                    <!-- 联机 -->
                    <Border Style="{StaticResource CardStyle}" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="联机（局域网）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NetBadgeText}" HorizontalAlignment="Right" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <StackPanel Visibility="{Binding CanJoin, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="玩家名" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                             Text="{Binding Cfg.PlayerName, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="端口" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource TextBoxStyle}"
                                             Text="{Binding Cfg.ListenPort, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="0 = 自动挑" FontSize="10" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                                <Button Content="开房间（当房主）" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" Command="{Binding StartHostCommand}" />
                                <TextBox Style="{StaticResource TextBoxStyle}" Margin="0,8,0,0"
                                         Text="{Binding Cfg.LastJoinAddress, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="对方发来的地址，例如 192.168.1.5:5310" />
                                <Button Content="加入房间" Style="{StaticResource PrimaryButtonStyle}" Margin="0,6,0,0"
                                        HorizontalAlignment="Stretch" Command="{Binding JoinRoomCommand}" />
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0" Visibility="{Binding CanLeave, Converter={StaticResource BoolToVis}}">
                                <Button Content="离开房间" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Command="{Binding LeaveRoomCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding NoticeText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 排行榜 -->
                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="排行榜（吃果 60% · 存活 20% · 连吃 20%）" FontSize="13" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Players}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 玩法设置 -->
                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="玩法设置（房主 / 单机可改）" FontSize="13" FontWeight="SemiBold" />

                            <ComboBox ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedMode}" Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,8,0,0" IsEnabled="{Binding CanJoin}" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="棋盘宽" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource TextBoxStyle}" Margin="0,4,4,0"
                                             Text="{Binding BoardWidth, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanJoin}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="棋盘高" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource TextBoxStyle}" Margin="4,4,0,0"
                                             Text="{Binding BoardHeight, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanJoin}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="人数上限" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource TextBoxStyle}" Margin="0,4,4,0"
                                             Text="{Binding MaxPlayers, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanJoin}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="命数" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource TextBoxStyle}" Margin="4,4,0,0"
                                             Text="{Binding Lives, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanJoin}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="果子上限" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource TextBoxStyle}" Margin="0,4,4,0"
                                             Text="{Binding MaxFruits, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanJoin}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="共享果区域数" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource TextBoxStyle}" Margin="4,4,0,0"
                                             Text="{Binding RegionCount, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanJoin}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="限时（秒，0=不限）" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource TextBoxStyle}" Margin="0,4,4,0"
                                             Text="{Binding TimeLimitSeconds, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanJoin}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="倒计时（秒）" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource TextBoxStyle}" Margin="4,4,0,0"
                                             Text="{Binding CountdownSeconds, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanJoin}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="爬行速度（格/秒）" FontSize="10.5" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Slider Minimum="2" Maximum="24" SmallChange="1" LargeChange="2" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,4,0,0" Style="{StaticResource SliderStyle}"
                                    Value="{Binding Speed}" IsEnabled="{Binding CanJoin}" />

                            <TextBlock Text="边缘规则" FontSize="10.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding EdgeOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedEdge}" Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,4,0,0" IsEnabled="{Binding CanJoin}" />

                            <CheckBox Content="开启加速（按住 Shift）" Margin="0,10,0,0" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding SpeedBoostEnabled}" />
                            <TextBlock Text="加速倍率" FontSize="10.5" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Slider Minimum="1.2" Maximum="4" SmallChange="0.2" LargeChange="0.5" TickFrequency="0.2"
                                    IsSnapToTickEnabled="True" Margin="0,4,0,0" Style="{StaticResource SliderStyle}"
                                    Value="{Binding SpeedBoostMultiplier}" IsEnabled="{Binding SpeedBoostEnabled}" />

                            <CheckBox Content="重生保留原蛇身长度" Margin="0,10,0,0" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding RespawnKeepsLength}" />
                            <TextBlock Text="重生无敌时间（秒）" FontSize="10.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"
                                     Text="{Binding RespawnInvincibleSeconds, UpdateSourceTrigger=LostFocus}" />
                            <CheckBox Content="出生光爆（重生瞬间炸开 3×3，之后可穿过）" Margin="0,7,0,0" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding SpawnBombEnabled}" />
                            <CheckBox Content="共享果：没吃到就断 combo" Margin="0,7,0,0" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding ComboBreaksOnMiss}" />
                        </StackPanel>
                    </Border>

                    <!-- AI -->
                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="电脑对手（AI）" FontSize="13" FontWeight="SemiBold" />

                            <TextBlock Text="AI 数量" FontSize="10.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"
                                     Text="{Binding AiCount, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanJoin}" />

                            <TextBlock Text="每个电脑的算法（1~10，越高越聪明）" FontSize="10.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding AiSlots}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedLevel}"
                                                      Style="{StaticResource ComboBoxStyle}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Description}" FontSize="9.5" TextWrapping="Wrap"
                                                       Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

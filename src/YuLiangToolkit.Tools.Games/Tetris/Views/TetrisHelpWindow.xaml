<Window x:Class="YuLiangToolkit.Tools.Games.Tetris.Views.TetrisHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游玩说明 · 俄罗斯方块"
        Width="1000"
        SizeToContent="Height"
        MaxHeight="900"
        MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- 「俄罗斯方块 · 游玩说明」对话框：内容来自 TetrisHelpContent（纯数据），这里只排版。
         正文是**左右两栏**（左：按键操作；右：暂停与重开 / 计分 / 小技巧），
         内容按估算高度自动分配，尽量一屏看完；实在放不下时整块可滚动。
         颜色 / 卡片 / 按钮全部走 App.xaml 的动态资源，六套主题自动跟随。 -->

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 标题 ===== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🧱 俄罗斯方块 · 游玩说明" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- ===== 正文：两栏（放不下时滚动） ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="0" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="18,4,18,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LeftColumn" Grid.Column="0" />
                    <StackPanel x:Name="RightColumn" Grid.Column="2" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ===== 底部 ===== -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="按 Esc 关闭 · 打开说明时游戏会自动暂停，关掉后点「继续」接着玩" FontSize="11"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Content="关闭" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88"
                    HorizontalAlignment="Right" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>

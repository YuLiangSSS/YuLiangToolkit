<UserControl x:Class="YuLiangToolkit.Tools.Games.Tetris.Views.TetrisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.Games.Tetris.Views"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown">

    <!-- 「俄罗斯方块」（tetris）。布局约定见 docs/dev/layout.md：
           · 左列「棋盘（*）」｜ 竖分隔条 ｜ 右列；
           · 右列「分数 + 预览（*）｜ 横分隔条 ｜ 设置（固定像素高）」；
           相邻区块之间各有一条 core:PaneSplitter（Key=tetris.*），可分别拖动 / 双击复位。
         ⚠ 整页**不进 ScrollViewer**：棋盘要按窗口高度伸缩（一屏看全、不用滚），
           页面根是「页头 Auto + 主体 * + 按钮条 Auto」的 Grid。
         样式全部来自 App.xaml；底板 / 网格 / 文字颜色走 {DynamicResource} 主题 token，
         只有七种方块的颜色是数据色（TetrominoPalette，深浅主题都看得清）。 -->

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="340" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 页头 ===== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🧱 俄罗斯方块" FontSize="21" FontWeight="SemiBold" />

            <!-- 玩法切换：单人 / 联机互攻 / 联机比分数（联机时才出现房间卡） -->
            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                <RadioButton Content="单人" Style="{StaticResource RadioButtonStyle}"
                             IsChecked="{Binding SoloModeIsChecked}" GroupName="tetris-mode"
                             VerticalAlignment="Center" />
                <RadioButton Content="联机 · 垃圾行互攻" Style="{StaticResource RadioButtonStyle}" Margin="18,0,0,0"
                             IsChecked="{Binding GarbageModeIsChecked}" GroupName="tetris-mode"
                             VerticalAlignment="Center"
                             ToolTip="1 对 1：自己消 2/3/4 行，就给对手底部塞 1/2/4 行垃圾行；谁先被顶死谁输" />
                <RadioButton Content="联机 · 各自计分" Style="{StaticResource RadioButtonStyle}" Margin="18,0,0,0"
                             IsChecked="{Binding ScoreModeIsChecked}" GroupName="tetris-mode"
                             VerticalAlignment="Center"
                             ToolTip="1 对 1：双方各一块棋盘、互不干扰（出块序列一样），比谁分高" />
            </WrapPanel>

            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{Binding ModeHintText}" />
        </StackPanel>

        <!-- ===== 主体：左棋盘 / 右信息栏（左右可拖） ===== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="336" MinWidth="272" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：棋盘卡（棋盘 + 暂停 / 结束遮罩都在这张卡里） ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="240" />
                    </Grid.RowDefinitions>

                    <!-- 卡头：状态 + 暂停 / 重开 -->
                    <Grid Grid.Row="0" Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ComboText}" FontSize="11.5" Margin="0,5,0,0"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Visibility="{Binding ComboText, Converter={StaticResource EmptyToVisInverse}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding PauseButtonText}" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding PauseCommand}" MinWidth="66"
                                    ToolTip="暂停 / 继续（Esc 或 P）" />
                            <Button Content="重新开始" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding NewGameCommand}"
                                    IsEnabled="{Binding CanRestartGame}"
                                    ToolTip="开一局新的（R）；联机时要房主才能重开" />
                        </StackPanel>
                    </Grid>

                    <!-- 棋盘本体 + 遮罩层 -->
                    <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" ClipToBounds="True">
                        <Grid>
                            <views:TetrisBoardView x:Name="BoardArea"
                                                   State="{Binding BoardState}"
                                                   BoardBrush="{DynamicResource InputBackgroundBrush}"
                                                   GridBrush="{DynamicResource BorderBrush}"
                                                   BorderBrush="{DynamicResource BorderBrush}" />

                            <!-- 遮罩：还没开始 / 暂停 / 结束 -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" Opacity="0.94"
                                    Visibility="{Binding OverlayVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="360" Margin="24">
                                    <TextBlock Text="{Binding OverlayTitle}" FontSize="22" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding OverlayHint}" FontSize="12" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,12,0,0" LineHeight="19"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Content="开始游戏" Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,18,0,0" HorizontalAlignment="Center" MinWidth="120"
                                            Command="{Binding StartOrResumeCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 竖分隔条：棋盘 ↔ 信息栏 -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="tetris.棋盘与信息栏" />

            <!-- ===== 右列：本局 / 联机房间（仅联机时）/ 设置 =====
                 联机房间行用 BoolToPaneLength 跟着「是不是联机」收放（行高 + 分隔条一起隐藏），
                 单人不占地方。 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="{Binding RoomPanelVisible, Converter={StaticResource BoolToPaneLength}, ConverterParameter=286}"
                                   MinHeight="{Binding RoomPanelVisible, Converter={StaticResource BoolToPaneLength}, ConverterParameter=196}" />
                    <RowDefinition Height="{Binding RoomPanelVisible, Converter={StaticResource BoolToPaneLength}, ConverterParameter=12}" />
                    <RowDefinition Height="188" MinHeight="140" />
                </Grid.RowDefinitions>

                <!-- ===== 分数 / 预览 =====
                     ⚠ 卡片里是固定高度的几小块（分数 / 等级 / 暂存 / 接下来），
                     外面套 ScrollViewer：被拖得比内容还矮时自己滚，不会把「接下来」裁掉一半。 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="16,14,16,14">
                            <TextBlock Text="本局" FontSize="13" FontWeight="SemiBold" />

                            <!-- 分数 / 最高分 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="分数" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ScoreText}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Visibility="{Binding IsNetMode, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="最高分" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding HighScoreText}" FontSize="14" Margin="0,6,0,0"
                                               Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!-- 等级 / 消行（和分数并成一行，窄一点也放得下） -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="等级 " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LevelText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="  ·  已消 " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LinesText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- 暂存 + 接下来：横向并排，省一半高度（联机时右边那块本来就很挤） -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="暂存 C" FontSize="10.5" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <views:TetrominoPoolView Height="40"
                                                             Orientation="Horizontal"
                                                             Placeholder="空"
                                                             Items="{Binding HeldPieces}"
                                                             HintBrush="{DynamicResource FaintTextBrush}"
                                                             SlotBrush="{DynamicResource InputBackgroundBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                            Visibility="{Binding Cfg.ShowNext, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="接下来" FontSize="10.5" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <views:TetrominoPoolView Height="40"
                                                             Orientation="Horizontal"
                                                             Placeholder="—"
                                                             Items="{Binding NextPieces}"
                                                             HintBrush="{DynamicResource FaintTextBrush}"
                                                             SlotBrush="{DynamicResource InputBackgroundBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- 联机：垃圾行提示（只在互攻模式出现） -->
                            <TextBlock Text="{Binding MyGarbageText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding MyGarbageText, Converter={StaticResource EmptyToVisInverse}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 横分隔条：本局信息 ↔ 联机房间（单人时整块收起） -->
                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="tetris.信息与房间"
                                   Visibility="{Binding RoomPanelVisible, Converter={StaticResource BoolToVis}}" />

                <!-- ===== 联机房间（1 对 1）：开房 / 加入 / 分享地址 / 对手棋盘 ===== -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True"
                        Visibility="{Binding RoomPanelVisible, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="16,12,16,14">
                            <Grid>
                                <TextBlock Text="联机房间（1 对 1）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NetBadgeText}" HorizontalAlignment="Right" FontSize="11.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NetBadgeBrushKey}" Value="SuccessBrush">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- 还没联机：玩家名 / 端口 / 开房 / 加入 -->
                            <StackPanel Visibility="{Binding CanJoinNet, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="玩家名" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" ToolTip="对方看到的名字（留空 = 系统用户名）" />
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="端口" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding ListenPortText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" ToolTip="0 = 让系统自动挑一个空闲端口" />
                                    <TextBlock Grid.Column="2" Text="0 = 自动挑" VerticalAlignment="Center" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" />
                                </Grid>

                                <Button Content="开房间（等好友连进来）" Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                        Command="{Binding StartHostCommand}" IsEnabled="{Binding CanJoinNet}" />

                                <TextBlock Text="加入房间（填对方发来的地址）" FontSize="11" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding JoinAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Margin="0,4,0,0"
                                         ToolTip="例如 192.168.1.5:5310、[::1]:5310、穿透域名:端口" />
                                <Button Content="加入房间" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" Command="{Binding JoinRoomCommand}"
                                        IsEnabled="{Binding CanJoinNet}" />
                                <Button Content="只观战（对战位满了也能看）" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                        Command="{Binding JoinSpectatorCommand}" IsEnabled="{Binding CanJoinNet}"
                                        ToolTip="以观战身份进入房间：能看两边棋盘，不能操作" />
                            </StackPanel>

                            <!-- 联机中：身份 / 分享地址（房主）/ 观战名单 / 离开 -->
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding CanLeaveNet, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding NetRoleText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding NetRoleText, Converter={StaticResource EmptyToVisInverse}}" />
                                <StackPanel Visibility="{Binding HasShareAddresses, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="把地址复制发给好友" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding ShareAddresses}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AddressText}" FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailText}" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="复制" Style="{StaticResource SecondaryButtonStyle}"
                                                            FontSize="11" Padding="8,2" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding AddressText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 观战者名单（房主与观战者都看得到） -->
                                <TextBlock Text="{Binding SpectatorCountText}" FontSize="10.5" TextWrapping="Wrap"
                                           Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />

                                <Button Content="{Binding LeaveNetText}" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                        Command="{Binding LeaveRoomCommand}" IsEnabled="{Binding CanLeaveNet}" />
                            </StackPanel>

                            <!-- 状态一句话 -->
                            <TextBlock Text="{Binding NetNoticeText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NetNoticeBrushKey}" Value="SuccessBrush">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NetNoticeBrushKey}" Value="DangerBrush">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 对手：分数 + 垃圾行 + 棋盘缩略图 -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding OpponentPanelVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding OpponentTitleText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding GuestScoreText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding OpponentGarbageText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Visibility="{Binding OpponentGarbageText, Converter={StaticResource EmptyToVisInverse}}" />

                                <!-- 对手棋盘缩略图：同一个自绘控件，按比例缩小（200 高左右，不占太多地方） -->
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"
                                        Height="150" Margin="0,6,0,0" ClipToBounds="True">
                                    <views:TetrisBoardView State="{Binding GuestBoardState}"
                                                           BoardBrush="{DynamicResource InputBackgroundBrush}"
                                                           GridBrush="{DynamicResource BorderBrush}"
                                                           BorderBrush="{DynamicResource BorderBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 横分隔条：联机房间 ↔ 设置（单人时跟着房间一起收起） -->
                <core:PaneSplitter Grid.Row="3" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="tetris.房间与设置"
                                   Visibility="{Binding RoomPanelVisible, Converter={StaticResource BoolToVis}}" />

                <!-- ===== 设置 ===== -->
                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="16,12,16,14">
                            <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="改一下立即生效并自动保存（没有保存按钮）" FontSize="10.5" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <CheckBox Content="显示幽灵方块（落点预览）" Margin="0,10,0,0"
                                      IsChecked="{Binding Cfg.ShowGhost}" Style="{StaticResource CheckBoxStyle}" />
                            <CheckBox Content="显示网格线" Margin="0,7,0,0"
                                      IsChecked="{Binding Cfg.ShowGrid}" Style="{StaticResource CheckBoxStyle}" />
                            <CheckBox Content="显示接下来 3 块" Margin="0,7,0,0"
                                      IsChecked="{Binding Cfg.ShowNext}" Style="{StaticResource CheckBoxStyle}" />
                            <CheckBox Content="切走窗口时自动暂停" Margin="0,7,0,0"
                                      IsChecked="{Binding Cfg.PauseOnLostFocus}" Style="{StaticResource CheckBoxStyle}"
                                      ToolTip="关掉后切走程序窗口也继续下落（危险，建议开着）" />

                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="起始等级" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Cfg.StartLevel}" FontSize="12" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <Slider Minimum="1" Maximum="20" SmallChange="1" LargeChange="2"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                    Value="{Binding Cfg.StartLevel}" Style="{StaticResource SliderStyle}"
                                    ToolTip="下一局开始时的等级（1 最慢，20 最快）；等级还会按消行数往上走" />

                            <TextBlock FontSize="10.5" TextWrapping="Wrap" LineHeight="17" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="键盘：← → 移动 · ↓ 软降 · ↑ / X 顺时针旋转 · Z 逆时针旋转 · 空格 硬降 · C 暂存 · Esc / P 暂停 · R 重开" />

                            <!-- 电脑对手（联机模式下代替真人） -->
                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"
                                    Padding="10,8" Margin="0,10,0,0"
                                    Visibility="{Binding AiPanelVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="电脑对手" FontSize="12" FontWeight="SemiBold" />
                                        <CheckBox Content="开" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  IsChecked="{Binding AiEnabled}"
                                                  ToolTip="开：联机模式下由电脑操作对手那份棋盘（等于「你 vs 电脑」）" />
                                    </Grid>
                                    <ComboBox Height="30" Margin="0,8,0,0" Style="{StaticResource ComboBoxStyle}"
                                              DisplayMemberPath="Label"
                                              ItemsSource="{Binding AiDifficultyOptions}"
                                              SelectedItem="{Binding SelectedAiDifficulty}"
                                              IsEnabled="{Binding AiEnabled}" />
                                    <TextBlock Text="{Binding AiDifficultyHint}" FontSize="10.5" TextWrapping="Wrap"
                                               Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding AiOpponentText}" FontSize="10.5" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 操作按钮条（纯信息条，占页面最后一行 Auto，不做成可拖块） ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="←" Style="{StaticResource SecondaryButtonStyle}" Width="52"
                        Command="{Binding MoveLeftCommand}" ToolTip="左移（←）" />
                <Button Content="→" Style="{StaticResource SecondaryButtonStyle}" Width="52" Margin="8,0,0,0"
                        Command="{Binding MoveRightCommand}" ToolTip="右移（→）" />
                <Button Content="↓ 软降" Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" Margin="8,0,0,0"
                        Command="{Binding SoftDropCommand}" ToolTip="软降一格（↓）" />
                <Button Content="↻ 顺时针" Style="{StaticResource SecondaryButtonStyle}" MinWidth="86" Margin="8,0,0,0"
                        Command="{Binding RotateClockwiseCommand}" ToolTip="顺时针旋转（↑ / X）" />
                <Button Content="↺ 逆时针" Style="{StaticResource SecondaryButtonStyle}" MinWidth="86" Margin="8,0,0,0"
                        Command="{Binding RotateCounterClockwiseCommand}" ToolTip="逆时针旋转（Z）" />
                <Button Content="硬降" Style="{StaticResource PrimaryButtonStyle}" MinWidth="76" Margin="8,0,0,0"
                        Command="{Binding HardDropCommand}" ToolTip="直接落到底（空格）" />
                <Button Content="暂存" Style="{StaticResource SecondaryButtonStyle}" MinWidth="66" Margin="8,0,0,0"
                        Command="{Binding HoldCommand}" ToolTip="暂存当前方块（C，一手只能换一次）" />
                <Button Content="？ 游玩说明" Style="{StaticResource SecondaryButtonStyle}" MinWidth="112" Margin="20,0,0,0"
                        Click="OnHelpClick" ToolTip="怎么玩、每个键干什么（也可以按 F1）" />
            </WrapPanel>

            <TextBlock Grid.Column="1" Text="{Binding StoragePathText}" FontSize="10.5" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="360"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       ToolTip="各局分数只记最高分，存在 exe 旁边的 Config\tetris\config.json" />
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="YuLiangToolkit.Tools.Diary.Views.DiaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <!-- 「日记本」工具页。
         布局：整页 = 页头 + 「左：历史日记列表 ｜ 右：日记编辑区」两栏，两栏之间一条 core:PaneSplitter（宽度可拖、自动记忆）。
         富文本编辑区是白底黑字（跟真实写作一样，换主题也不跟着变）；颜色一律 DynamicResource。 -->

    <UserControl.Resources>
        <!-- 工具条小按钮 -->
        <Style x:Key="DiaryToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- 加粗 / 斜体这类「当前选区有没有这个格式」的切换按钮 -->
        <Style x:Key="DiaryToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字颜色的小色块 -->
        <Style x:Key="DiaryColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 心情 emoji 小按钮 -->
        <Style x:Key="DiaryEmojiButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题输入框：大号、无边框，像写在纸上 -->
        <Style x:Key="DiaryTitleBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DiaryFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="360" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="📔 日记本" FontSize="21" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Margin="0,5,30,0"
                           Text="给自己写日记：左边是历史日记（按日期排、可搜索），右边边写边自动保存。支持富文本（加粗 / 颜色 / 标题 / 列表 / 图片，跟邮箱编辑器一样）和普通文本两种写法；也可以给每天记一个心情。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <CheckBox Content="{Binding SortText}" Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center"
                          IsChecked="{Binding SortNewestFirst, Mode=TwoWay}" Margin="0,0,14,0"
                          ToolTip="勾选 = 最新创建的在上面；取消 = 最早的在上面" />
                <Button Content="＋ 新建日记" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NewCommand}" MinWidth="112"
                        ToolTip="写一篇今天的日记（Ctrl+N）" />
            </StackPanel>
        </Grid>

        <!-- ===================== 主区域：列表 ｜ 编辑区 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="322" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：历史日记列表 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 搜索 + 统计 -->
                    <StackPanel Grid.Row="0" Margin="16,14,16,8">
                        <Grid>
                            <TextBox Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                                     ToolTip="搜标题或正文" />
                            <TextBlock Text="搜索日记…" IsHitTestVisible="False" Margin="12,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding Keyword, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                        <TextBlock Text="{Binding SummaryText}" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 列表 -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 Style="{StaticResource FileListStyle}" Margin="6,0,6,4"
                                 core:ScrollChaining.Enabled="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 日期徽标 -->
                                        <Border Grid.Column="0" Width="46" Margin="0,0,10,0" CornerRadius="6"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                VerticalAlignment="Center">
                                            <StackPanel Margin="0,5">
                                                <TextBlock Text="{Binding DateDay}" FontSize="18" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding DateMonth}" FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 标题 + 摘要 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Snippet}" FontSize="11" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- 心情 + 时间 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Mood}" FontSize="16" HorizontalAlignment="Right"
                                                       Visibility="{Binding HasMood, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource FaintTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态：一篇都没有 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="240"
                                    Visibility="{Binding HasAnyEntry, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="📔" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="还没有日记。写下第一篇吧，之后都按日期存在这里。"
                                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="＋ 新建日记" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,12,0,0" Command="{Binding NewCommand}" />
                        </StackPanel>

                        <!-- 空状态：搜不到 -->
                        <TextBlock Text="没有匹配的日记，换个关键词试试。" FontSize="12" TextWrapping="Wrap"
                                   TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   MaxWidth="240" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- 状态 -->
                    <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11" Margin="16,0,16,10"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- 左右分隔条 -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="diary.列表与编辑区" />

            <!-- ===== 右：编辑区 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <!-- 未选中的空状态 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                                Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="📝" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="从左边选一篇接着写，或者点右上角「＋ 新建日记」。"
                                   FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 选中一篇时的编辑器 -->
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />   <!-- 标题 + 心情 -->
                            <RowDefinition Height="Auto" />   <!-- 工具条 + 保存 / 删除 -->
                            <RowDefinition Height="*" MinHeight="160" /> <!-- 正文 -->
                            <RowDefinition Height="Auto" />   <!-- 底部统计 -->
                        </Grid.RowDefinitions>

                        <!-- 标题 + 心情 -->
                        <Grid Grid.Row="0" Margin="22,16,22,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <TextBox x:Name="TitleBox" Style="{StaticResource DiaryTitleBoxStyle}"
                                             Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnTitleChanged"
                                             ToolTip="给这一篇起个标题（可留空）" />
                                    <TextBlock Text="无标题" IsHitTestVisible="False" FontSize="19" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}"
                                               Visibility="{Binding DraftTitle, Converter={StaticResource EmptyToVis}}" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedFullDateText}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                                <TextBlock Text="心情" Style="{StaticResource DiaryFieldLabelStyle}" Margin="0,0,6,0" />
                                <Button Content="😀" Tag="😀" Style="{StaticResource DiaryEmojiButtonStyle}" Click="OnMoodClick" />
                                <Button Content="😊" Tag="😊" Style="{StaticResource DiaryEmojiButtonStyle}" Click="OnMoodClick" />
                                <Button Content="😐" Tag="😐" Style="{StaticResource DiaryEmojiButtonStyle}" Click="OnMoodClick" />
                                <Button Content="😔" Tag="😔" Style="{StaticResource DiaryEmojiButtonStyle}" Click="OnMoodClick" />
                                <Button Content="😡" Tag="😡" Style="{StaticResource DiaryEmojiButtonStyle}" Click="OnMoodClick" />
                                <Button Content="🥳" Tag="🥳" Style="{StaticResource DiaryEmojiButtonStyle}" Click="OnMoodClick" />
                                <Button Content="✕" Style="{StaticResource DiaryEmojiButtonStyle}" FontSize="13"
                                        Click="OnClearMoodClick" ToolTip="清除心情" />
                            </StackPanel>
                        </Grid>

                        <!-- 工具条 + 保存 / 删除 -->
                        <Grid Grid.Row="1" Margin="22,0,22,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- 写法切换 -->
                                <RadioButton x:Name="RichModeRadio" Content="富文本" Style="{StaticResource RadioButtonStyle}"
                                             IsChecked="True" Margin="0,0,10,0" Checked="OnFormatChanged"
                                             ToolTip="可以加粗 / 改颜色 / 插图片（像邮箱编辑器）" />
                                <RadioButton x:Name="PlainModeRadio" Content="普通文本" Style="{StaticResource RadioButtonStyle}"
                                             Margin="0,0,12,0" Checked="OnFormatChanged"
                                             ToolTip="只写纯文字，不解析任何格式" />

                                <!-- 富文本工具条 -->
                                <WrapPanel x:Name="RichToolbar" VerticalAlignment="Center"
                                           Visibility="{Binding SelectedEntry.IsRichText, Converter={StaticResource BoolToVis}}">
                                    <ToggleButton x:Name="BoldToggle" Content="B" FontWeight="Bold"
                                                  Style="{StaticResource DiaryToggleButtonStyle}" ToolTip="加粗（Ctrl+B）" Click="OnBoldClick" />
                                    <ToggleButton x:Name="ItalicToggle" Content="I" FontStyle="Italic"
                                                  Style="{StaticResource DiaryToggleButtonStyle}" ToolTip="斜体（Ctrl+I）" Click="OnItalicClick" />
                                    <ToggleButton x:Name="UnderlineToggle" Content="U"
                                                  Style="{StaticResource DiaryToggleButtonStyle}" ToolTip="下划线（Ctrl+U）" Click="OnUnderlineClick" />
                                    <ToggleButton x:Name="StrikeToggle" Content="S"
                                                  Style="{StaticResource DiaryToggleButtonStyle}" ToolTip="删除线" Click="OnStrikeClick" />
                                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="2,3,8,3" />
                                    <ComboBox x:Name="FormatBlockCombo" Style="{StaticResource ComboBoxStyle}" Width="88" Height="28"
                                              Margin="0,0,6,0" SelectionChanged="OnFormatBlockChanged" ToolTip="段落样式">
                                        <ComboBoxItem Content="正文" Tag="p" IsSelected="True" />
                                        <ComboBoxItem Content="大标题" Tag="h1" />
                                        <ComboBoxItem Content="中标题" Tag="h2" />
                                        <ComboBoxItem Content="小标题" Tag="h3" />
                                    </ComboBox>
                                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="2,3,8,3" />
                                    <Button Background="#E5484D" Style="{StaticResource DiaryColorSwatchStyle}" Click="OnColorClick" Tag="#E5484D" ToolTip="红色" />
                                    <Button Background="#F5A623" Style="{StaticResource DiaryColorSwatchStyle}" Click="OnColorClick" Tag="#F5A623" ToolTip="橙色" />
                                    <Button Background="#2FB344" Style="{StaticResource DiaryColorSwatchStyle}" Click="OnColorClick" Tag="#2FB344" ToolTip="绿色" />
                                    <Button Background="#2F6FDB" Style="{StaticResource DiaryColorSwatchStyle}" Click="OnColorClick" Tag="#2F6FDB" ToolTip="蓝色" />
                                    <Button Background="#8E5AD9" Style="{StaticResource DiaryColorSwatchStyle}" Click="OnColorClick" Tag="#8E5AD9" ToolTip="紫色" />
                                    <Button Background="#1F2733" Style="{StaticResource DiaryColorSwatchStyle}" Click="OnColorClick" Tag="#1F2733" ToolTip="黑色" />
                                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="2,3,8,3" />
                                    <Button Content="•" Style="{StaticResource DiaryToolButtonStyle}" FontSize="16" Click="OnBulletsClick" ToolTip="无序列表" />
                                    <Button Content="1." Style="{StaticResource DiaryToolButtonStyle}" Click="OnNumberingClick" ToolTip="有序列表" />
                                    <Button Content="≡左" Style="{StaticResource DiaryToolButtonStyle}" Click="OnAlignLeftClick" ToolTip="左对齐" />
                                    <Button Content="≡中" Style="{StaticResource DiaryToolButtonStyle}" Click="OnAlignCenterClick" ToolTip="居中" />
                                    <Button Content="≡右" Style="{StaticResource DiaryToolButtonStyle}" Click="OnAlignRightClick" ToolTip="右对齐" />
                                    <Button Content="🖼" Style="{StaticResource DiaryToolButtonStyle}" Click="OnInsertImageClick" ToolTip="插入图片" />
                                    <Button Content="🧹" Style="{StaticResource DiaryToolButtonStyle}" Click="OnClearFormatClick" ToolTip="清除选中文字的格式" />
                                </WrapPanel>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="💾 保存" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveCommand}"
                                        Margin="0,0,8,0" ToolTip="也可以按 Ctrl+S" />
                                <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeleteCommand}"
                                        ToolTip="删除这一篇（会先确认）" />
                            </StackPanel>
                        </Grid>

                        <!-- 正文编辑区：白底黑字 -->
                        <Grid Grid.Row="2" Margin="22,0,22,0">
                            <RichTextBox x:Name="Editor" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         Background="#FFFFFF" Foreground="#1F2733" BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1" Padding="16,12" FontSize="14"
                                         FontFamily="Segoe UI, Microsoft YaHei UI" AcceptsTab="True"
                                         SpellCheck.IsEnabled="False"
                                         SelectionChanged="OnEditorSelectionChanged" PreviewKeyDown="OnEditorPreviewKeyDown"
                                         PreviewDragOver="OnEditorDragOver" PreviewDrop="OnEditorDrop"
                                         TextChanged="OnEditorTextChanged" />
                            <TextBox x:Name="PlainBox" Visibility="Collapsed" TextWrapping="Wrap" AcceptsReturn="True"
                                     Background="#FFFFFF" Foreground="#1F2733" BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" Padding="16,12" FontSize="14"
                                     FontFamily="Segoe UI, Microsoft YaHei UI" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     TextChanged="OnEditorTextChanged" PreviewKeyDown="OnPlainKeyDown" />
                        </Grid>

                        <!-- 底部统计 -->
                        <Grid Grid.Row="3" Margin="22,8,22,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding WordCountText}" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="·" FontSize="11.5" Margin="8,0" Foreground="{DynamicResource FaintTextBrush}" />
                                <TextBlock Text="{Binding SavedText}" FontSize="11.5"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SelectedUpdatedText}" FontSize="10.5"
                                       Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="YuLiangToolkit.Tools.Live2D.Views.PetFoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大白饭团 · 投喂层"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- 说明：投喂层是盖住主屏工作区的透明全屏窗口（背景全透明、无边框、不进任务栏、不抢焦点）。
         画面 = 一个 Canvas（饭团 + 撒出来的米粒），没有 XAML 控件树，全部由代码往 Canvas 里加子元素。
         鼠标穿透不靠窗口自身：代码后置用 40ms 轮询 GetCursorPos + WS_EX_TRANSPARENT 动态开关
         （鼠标在饭团上 / 正在拖才收鼠标，其余位置直接穿透到下面的窗口，见 PetWindow 同款做法）。 -->

    <Canvas x:Name="FoodCanvas"
            Background="Transparent"
            ClipToBounds="True"
            MouseLeftButtonDown="OnFoodMouseLeftButtonDown"
            MouseMove="OnFoodMouseMove"
            MouseLeftButtonUp="OnFoodMouseLeftButtonUp" />
</Window>

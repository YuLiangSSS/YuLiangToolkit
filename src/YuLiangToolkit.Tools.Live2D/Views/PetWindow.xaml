<Window x:Class="YuLiangToolkit.Tools.Live2D.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live2D 桌宠"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnPetMouseLeftButtonDown"
        MouseLeftButtonUp="OnPetMouseLeftButtonUp"
        MouseMove="OnPetMouseMove"
        MouseWheel="OnPetMouseWheel"
        MouseDoubleClick="OnPetMouseDoubleClick">

    <!-- 说明：独立透明窗口，背景全透明、无边框、不进任务栏。
         画面 = Image 绑定桌宠专用渲染器的 WriteableBitmap（每帧由会话帧循环更新 Source）。
         透明区域的鼠标穿透靠 WS_EX_TRANSPARENT（见代码后置），不靠窗口自身。 -->

    <Window.ContextMenu>
        <!-- 右键菜单：显隐 / 置顶 / 点击穿透 / 缩放重置 / 居中 / 打开测试页 / 隐藏。
             独立窗口不套 App.xaml 里的样式，这里显式用主题 token（DynamicResource）保持四套主题协调。 -->
        <ContextMenu x:Name="PetMenu"
                     Background="{DynamicResource CardBackgroundBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Opened="OnPetMenuOpened">
            <MenuItem x:Name="MenuItemTopMost" Header="置顶显示" IsCheckable="True"
                      Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuTopMostClick" />
            <MenuItem x:Name="MenuItemClickThrough" Header="透明区域点击穿透" IsCheckable="True"
                      Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuClickThroughClick"
                      ToolTip="鼠标在模型透明区域时直接穿透到下面的窗口" />
            <Separator />
            <MenuItem Header="缩放重置（420 像素宽）" Foreground="{DynamicResource TextPrimaryBrush}"
                      Click="OnMenuResetSizeClick" />
            <MenuItem Header="居中" Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuCenterClick" />
            <Separator />
            <!-- 动捕 / 身体晃动：勾选状态跟配置，改完立即写回并让会话应用（关掉时摄像头立刻释放） -->
            <MenuItem x:Name="MenuItemMocap" Header="摄像头动捕：开 / 关" IsCheckable="True"
                      Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuMocapClick"
                      ToolTip="打开后桌宠会跟随摄像头里的头部转动 / 眨眼 / 张嘴（会请求摄像头权限）" />
            <MenuItem Header="重新校准表情" Foreground="{DynamicResource TextPrimaryBrush}"
                      Click="OnMenuResetMocapCalibrationClick"
                      ToolTip="眨眼 / 张嘴的自动基准清零（换环境 / 光线后点一下）" />
            <MenuItem x:Name="MenuItemSway" Header="身体晃动：开 / 关" IsCheckable="True"
                      Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuSwayClick"
                      ToolTip="用一组身体 / 物理参数让模型持续摆动（画面里能直接看到头发跟着甩）" />
            <MenuItem x:Name="MenuItemMusic" Header="音乐跟唱：开 / 关" IsCheckable="True"
                      Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuMusicClick"
                      ToolTip="用 Windows 回环采集系统正在播放的声音驱动嘴型 / 摇晃（不申请麦克风、不录音、不保存）" />
            <Separator />
            <!-- 动作 / 语音：随机说话、随机姿势、跳一段舞、停止演示 -->
            <MenuItem Header="说句话" Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuSaySomethingClick"
                      ToolTip="随机说一句（Windows 自带 TTS 本地合成，不联网）" />
            <MenuItem Header="换个姿势" Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuRandomGestureClick"
                      ToolTip="随机播一个手势 / 姿势" />
            <MenuItem Header="跳个舞" Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuRandomDanceClick"
                      ToolTip="随机跳一段舞（约 3 秒）" />
            <MenuItem Header="停止动作" Foreground="{DynamicResource TextPrimaryBrush}" Click="OnMenuStopDemosClick"
                      ToolTip="停止手势 / 表演 / 舞蹈，把身体交还手动参数与物理" />
            <Separator />
            <MenuItem Header="打开测试工具页" Foreground="{DynamicResource TextPrimaryBrush}"
                      Click="OnMenuOpenToolPageClick"
                      ToolTip="把主窗口切到「桌面 → Live2D 桌宠」测试台" />
            <Separator />
            <MenuItem Header="隐藏桌宠（可在测试页重新打开）" Foreground="{DynamicResource TextPrimaryBrush}"
                      Click="OnMenuHideClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root" Background="Transparent">
        <!-- 只旋转模型位图（RenderTransform）：支点在底部中央，像不倒翁一样整身轻倾。
             窗口大小 / 透明区域 / 点击穿透 / 拖动逻辑都不受影响。 -->
        <Image x:Name="PetImage" Stretch="Fill" IsHitTestVisible="False"
               RenderTransformOrigin="0.5,1"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <RotateTransform x:Name="PetLeanTransform" Angle="0" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>

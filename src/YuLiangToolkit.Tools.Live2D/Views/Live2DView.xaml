<UserControl x:Class="YuLiangToolkit.Tools.Live2D.Views.Live2DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent"
             Focusable="False">

    <!-- 说明：Live2D 桌宠测试台。整页 = 标题 / 主区域（预览 + 右侧信息参数部件） / 下排（动作 / 表情 / 物理 / 桌宠） / 日志。
         布局硬性要求（docs/dev/layout.md）：每个相邻区块之间都放 core:PaneSplitter，别写死大小；
         列表 / 日志这类内容放 * 行，拖小/拖大都能自己伸缩；卡片被拖得比内容矮时靠内部滚动 + ClipToBounds 兜住。
         颜色一律走主题 token（{DynamicResource}），不写死浅色/深色。 -->

    <UserControl.Resources>
        <!-- 卡片内小标题 / 说明 / 设置项标签：统一字号与颜色，避免每处重复写 -->
        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardSubTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 卡片内的滚动宿主：滚到头交给整页（ScrollChaining） -->
        <Style x:Key="CardScrollerStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="core:ScrollChaining.Enabled" Value="True" />
        </Style>
        <!-- 下排窄卡片里的小按钮（列表行 / 工具按钮）：比 SecondaryButtonStyle 更紧凑，不把行撑高 -->
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <!-- 面部测试卡里的一行参数：显示名 + 滑杆（Min/Max 用模型参数自带的）+ 当前值 -->
        <DataTemplate x:Key="FaceParameterRowTemplate">
            <Grid Margin="0,1" MinHeight="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" FontSize="11" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Id}" />
                <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding Value, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                        VerticalAlignment="Center" ToolTip="{Binding Id}" />
                <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:0.00}}"
                           Style="{StaticResource SettingValueStyle}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />                                  <!-- 标题 -->
                <RowDefinition Height="600" MinHeight="430" />                   <!-- 主区域：预览 | 信息/参数/部件 -->
                <RowDefinition Height="12" />                                    <!-- 主区域 / 下排分隔条 -->
                <RowDefinition Height="330" MinHeight="220" />                   <!-- 下排：动作 / 表情 / 物理 / 桌宠 -->
                <RowDefinition Height="12" />                                    <!-- 下排 / 动捕分隔条 -->
                <RowDefinition Height="380" MinHeight="260" />                   <!-- 摄像头动捕卡 -->
                <RowDefinition Height="12" />                                    <!-- 动捕 / 身体晃动分隔条 -->
                <RowDefinition Height="360" MinHeight="250" />                   <!-- 身体晃动测试卡 -->
                <RowDefinition Height="12" />                                    <!-- 身体晃动 / 面部测试分隔条 -->
                <RowDefinition Height="380" MinHeight="250" />                   <!-- 面部测试卡（眼 / 嘴 / 舌头） -->
                <RowDefinition Height="12" />                                    <!-- 面部测试 / 音乐跟唱分隔条 -->
                <RowDefinition Height="360" MinHeight="240" />                   <!-- 音乐跟唱 · 律动卡 -->
                <RowDefinition Height="12" />                                    <!-- 音乐跟唱 / 手臂姿势分隔条 -->
                <RowDefinition Height="380" MinHeight="260" />                   <!-- 手臂 & 姿势（动作演示）卡 -->
                <RowDefinition Height="12" />                                    <!-- 手臂姿势 / 说话分隔条 -->
                <RowDefinition Height="380" MinHeight="260" />                   <!-- 说话 / 轻对话卡 -->
                <RowDefinition Height="12" />                                    <!-- 说话 / 日志分隔条 -->
                <RowDefinition Height="200" MinHeight="130" />                   <!-- 日志 -->
            </Grid.RowDefinitions>

            <!-- ==================================================== 标题 ==================================================== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🐟 Live2D 桌宠 · 模型测试台" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="内置 DeepSeek「大肥鱼」Live2D 模型：逐项调试参数 / 部件 / 动作 / 表情 / 物理 / 眼睛跟随，随时放出透明置顶的桌面宠物。所有改动自动保存，没有「保存」按钮。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Content="{Binding PetButtonText}" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding TogglePetCommand}" MinWidth="98" />
                    <Button Content="重新加载模型" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding ReloadModelCommand}" />
                </StackPanel>
            </Grid>

            <!-- ==================================================== 主区域 ==================================================== -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="398" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左：预览卡 ===== -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />                          <!-- 工具条 -->
                            <RowDefinition Height="*" MinHeight="120" />             <!-- 预览画布 -->
                            <RowDefinition Height="Auto" />                          <!-- 命中提示 / 状态 -->
                        </Grid.RowDefinitions>

                        <!-- 预览工具条：适应窗口 / 棋盘格 / 统计 / 帧率 / 渲染倍率（WrapPanel：预览被拖窄时自动折行） -->
                        <WrapPanel Grid.Row="0" Margin="14,12,14,8">
                            <Button Content="适应窗口" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"
                                    Click="OnResetViewClick" ToolTip="恢复默认缩放 / 位置（滚轮缩放、拖动平移）" />
                            <CheckBox Content="棋盘格" Style="{StaticResource CheckBoxStyle}" Margin="0,0,12,6"
                                      IsChecked="{Binding PreviewCheckerboard}" ToolTip="透明区域显示棋盘格" />
                            <CheckBox Content="统计" Style="{StaticResource CheckBoxStyle}" Margin="0,0,12,6"
                                      IsChecked="{Binding ShowPreviewStats}" ToolTip="左下角显示 FPS / 网格 / 三角形 / 耗时" />
                            <TextBlock Text="帧率" Style="{StaticResource SettingLabelStyle}" Margin="0,0,6,6" />
                            <ComboBox ItemsSource="{Binding FpsOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding FpsLimit, Mode=TwoWay}"
                                      Style="{StaticResource ComboBoxStyle}" Width="124" Height="28" Margin="0,0,12,6" />
                            <TextBlock Text="倍率" Style="{StaticResource SettingLabelStyle}" Margin="0,0,6,6" />
                            <ComboBox ItemsSource="{Binding RenderScaleOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding RenderScale, Mode=TwoWay}"
                                      Style="{StaticResource ComboBoxStyle}" Width="112" Height="28" Margin="0,0,0,6"
                                      ToolTip="预览渲染分辨率倍率：越低越省 CPU / GPU" />
                        </WrapPanel>

                        <!-- 预览画布：背景（棋盘格 / 纯色）→ 模型位图 → 统计 / 加载 / 错误层。
                             鼠标：滚轮缩放、左键拖动平移、移动 = 眼睛跟随、单击 = 命中的网格信息。 -->
                        <Border x:Name="PreviewHost" Grid.Row="1" Margin="14,0,14,0" CornerRadius="8"
                                ClipToBounds="True" Background="{DynamicResource InputBackgroundBrush}"
                                MouseWheel="OnPreviewMouseWheel"
                                MouseMove="OnPreviewMouseMove"
                                MouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                                MouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
                                MouseLeave="OnPreviewMouseLeave"
                                SizeChanged="OnPreviewSizeChanged">
                            <Grid>
                                <!-- 纯色底 -->
                                <Rectangle Fill="{DynamicResource InputBackgroundBrush}" IsHitTestVisible="False" />
                                <!-- 棋盘格（半透明白格叠加，跟主题色混出来，四套主题都协调） -->
                                <Rectangle x:Name="CheckerOverlay" Opacity="0.055" IsHitTestVisible="False"
                                           Visibility="{Binding PreviewCheckerboard, Converter={StaticResource BoolToVis}}">
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="Transparent">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,26,26" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Brush="White">
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,13,13" />
                                                                <RectangleGeometry Rect="13,13,13,13" />
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- 模型画面（代码后置每帧更新 Source；适应窗口时只渲染模型占的那块再等比放大显示）。
                                     RenderTransformOrigin="0.5,1" + RotateTransform = 以脚为支点的整身轻倾（只转位图，不转背景 / 文字）。 -->
                                <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,1"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderOptions.EdgeMode="Aliased">
                                    <Image.RenderTransform>
                                        <RotateTransform x:Name="PreviewLeanTransform" Angle="0" />
                                    </Image.RenderTransform>
                                </Image>

                                <!-- 模型名 / 状态角标 -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                        Background="{DynamicResource CardBackgroundBrush}" Opacity="0.88"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="8,4" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding ModelStatusText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>

                                <!-- 左下角统计 -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                        Background="{DynamicResource CardBackgroundBrush}" Opacity="0.88"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="8,4" IsHitTestVisible="False"
                                        Visibility="{Binding ShowPreviewStats, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PreviewStatsText}" FontSize="10.5"
                                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding EyeTargetText}" FontSize="10.5" Margin="0,2,0,0"
                                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource FaintTextBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- 加载中：铺一层卡片色 + 进度条（不写死黑色蒙层，四套主题都合适） -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" Opacity="0.94"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="260">
                                        <TextBlock Text="正在加载 Live2D 模型…" FontSize="13" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LoadProgressText}" FontSize="11.5" Margin="0,5,0,10"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding LoadProgress, Mode=OneWay}"
                                                     Style="{StaticResource ProgressBarStyle}" />
                                        <TextBlock Margin="0,10,0,0" FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="第一次加载要解码 5 张纹理，需要 1~3 秒" />
                                    </StackPanel>
                                </Border>

                                <!-- 加载失败：错误信息 + 重试 / 换模型 -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" Opacity="0.94"
                                        Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" MaxWidth="380">
                                        <TextBlock Text="模型加载失败" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LoadErrorText}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                                            <Button Content="重试" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding ReloadModelCommand}" Margin="0,0,8,8" />
                                            <Button Content="选择模型文件夹…" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding ChooseModelFolderCommand}" Margin="0,0,8,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 命中提示 + 缩放手势提示 -->
                        <Grid Grid.Row="2" Margin="14,8,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedDrawableText}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip="{Binding SelectedDrawableText}" />
                            <Button Grid.Column="1" Content="清除高亮" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,4" Command="{Binding ClearSelectedDrawableCommand}"
                                    Visibility="{Binding HasSelectedDrawable, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 左右分隔条：拖动改「预览」与右侧信息区的宽度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="live2d.预览与右侧" />

                <!-- ===== 右：模型信息 / 参数 / 部件（三张卡都能和相邻的上下拖） ===== -->
                <ScrollViewer Grid.Column="2" Style="{StaticResource CardScrollerStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="272" MinHeight="180" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="322" MinHeight="210" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="300" MinHeight="190" />
                        </Grid.RowDefinitions>

                        <!-- ① 模型信息卡 -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="16,12,16,4">
                                    <Grid>
                                        <TextBlock Text="模型信息" Style="{StaticResource CardHeaderStyle}" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="10.5" MaxWidth="210"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Text="{Binding ModelStatusText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding CurrentModelSourceText}" Style="{StaticResource CardSubTextStyle}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CurrentModelSourceText}" />
                                    <TextBlock Text="{Binding LoadErrorText}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" Style="{StaticResource CardScrollerStyle}" Margin="16,2,8,0">
                                    <ItemsControl ItemsSource="{Binding InfoRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1.5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5"
                                                               TextWrapping="Wrap" ToolTip="{Binding Value}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Margin="16,6,16,10">
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding BuiltInModelPathText}">
                                        <Run Text="内置模型：" /><Run Text="{Binding BuiltInModelPathText, Mode=OneWay}" />
                                    </TextBlock>
                                    <WrapPanel Margin="0,5,0,0">
                                        <Button Content="重新加载" Style="{StaticResource SecondaryButtonStyle}"
                                                FontSize="11" Padding="8,4" Margin="0,0,6,6"
                                                Command="{Binding ReloadModelCommand}" />
                                        <Button Content="选择文件夹…" Style="{StaticResource SecondaryButtonStyle}"
                                                FontSize="11" Padding="8,4" Margin="0,0,6,6"
                                                Command="{Binding ChooseModelFolderCommand}" />
                                        <Button Content="用内置模型" Style="{StaticResource SecondaryButtonStyle}"
                                                FontSize="11" Padding="8,4" Margin="0,0,6,6"
                                                Command="{Binding UseBuiltInModelCommand}" />
                                        <Button Content="打开模型目录" Style="{StaticResource SecondaryButtonStyle}"
                                                FontSize="11" Padding="8,4" Margin="0,0,0,6"
                                                Command="{Binding OpenModelFolderCommand}" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="纹理上限" Style="{StaticResource SettingLabelStyle}" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding TextureSizeOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding TextureMaxSize, Mode=TwoWay}"
                                                  Style="{StaticResource ComboBoxStyle}" Width="150" Height="26" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 上下分隔条：模型信息 / 参数 -->
                        <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                           Key="live2d.模型信息与参数" />

                        <!-- ② 参数卡：搜索 + cdi3 分组折叠滑块（展开才生成行，509 个也流畅） -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="80" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="16,12,16,6">
                                    <TextBlock Text="参数" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="{Binding ParameterTotalText}" HorizontalAlignment="Right" FontSize="10.5"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="16,0,16,6">
                                    <TextBox Style="{StaticResource TextBoxStyle}" Height="30"
                                             Text="{Binding ParameterSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="按参数 Id / 中文名搜索（命中分组自动展开）" />
                                    <TextBlock Text="搜索参数（Id / 中文名）…" Margin="11,0,0,0" IsHitTestVisible="False"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding ParameterSearchText, Converter={StaticResource EmptyToVis}}" />
                                </Grid>

                                <!-- 列表：只有这一行可伸缩（*），滚到底也不会钻到下面按钮底下；底部留 8px 呼吸空间 -->
                                <ScrollViewer Grid.Row="2" Style="{StaticResource CardScrollerStyle}" Margin="16,0,6,8"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ParameterGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,2">
                                                    <CheckBox Content="{Binding HeaderText}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              Style="{StaticResource CheckBoxStyle}" FontSize="11.5" Margin="0,3,0,2"
                                                              ToolTip="勾选展开 / 取消折叠这一组参数" />
                                                    <ItemsControl ItemsSource="{Binding Rows}"
                                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                                  Margin="0,2,0,4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1" MinHeight="24">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="42" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" ToolTip="{Binding Id}" />
                                                                    <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                            Value="{Binding Value, Mode=TwoWay}"
                                                                            Style="{StaticResource SliderStyle}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:0.00}}"
                                                                               Style="{StaticResource SettingValueStyle}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 底部按钮固定 Auto 行（不浮动、不覆盖列表） -->
                                <Border Grid.Row="3" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"
                                        Margin="16,0,16,0" Padding="0,6,0,8">
                                    <Button Content="一键全部重置" Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Command="{Binding ResetParametersCommand}"
                                            ToolTip="所有参数回默认值，动作 / 表情也停掉" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 上下分隔条：参数 / 部件 -->
                        <core:PaneSplitter Grid.Row="3" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                           Key="live2d.参数与部件" />

                        <!-- ③ 部件卡：147 个部件的不透明度滑块（分组折叠）+ 全部显示 -->
                        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="70" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="16,12,16,6">
                                    <TextBlock Text="部件" Style="{StaticResource CardHeaderStyle}" />
                                    <TextBlock Text="{Binding PartTotalText}" HorizontalAlignment="Right" FontSize="10.5"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>

                                <ScrollViewer Grid.Row="1" Style="{StaticResource CardScrollerStyle}" Margin="16,0,6,8"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PartGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,2">
                                                    <CheckBox Content="{Binding HeaderText}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              Style="{StaticResource CheckBoxStyle}" FontSize="11.5" Margin="0,3,0,2"
                                                              ToolTip="勾选展开 / 取消折叠这一组部件" />
                                                    <ItemsControl ItemsSource="{Binding Rows}"
                                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                                  Margin="0,2,0,4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1" MinHeight="24">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="108" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="42" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" ToolTip="{Binding Id}" />
                                                                    <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                                            Value="{Binding Opacity, Mode=TwoWay}"
                                                                            Style="{StaticResource SliderStyle}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:0.00}}"
                                                                               Style="{StaticResource SettingValueStyle}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 底部按钮固定 Auto 行（不浮动、不覆盖列表） -->
                                <Border Grid.Row="2" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"
                                        Margin="16,0,16,0" Padding="0,6,0,8">
                                    <Button Content="全部显示" Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Command="{Binding ResetPartsCommand}" ToolTip="所有部件不透明度恢复 1" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- 上下分隔条：主区域 / 下排 -->
            <core:PaneSplitter Grid.Row="2" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="live2d.主区域与下排" />

            <!-- ==================================================== 下排四张卡 ==================================================== -->
            <Grid Grid.Row="3" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                </Grid.ColumnDefinitions>

                <!-- ① 动作卡 -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="56" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,12,14,4">
                            <TextBlock Text="动作" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="{Binding MotionSummaryText}" HorizontalAlignment="Right" FontSize="10.5"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="14,0,14,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CurrentMotionName}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding CurrentMotionName}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding MotionTimeText}" Style="{StaticResource SettingValueStyle}" Margin="0,0,8,0" />
                                    <Button Content="停止" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3"
                                            Command="{Binding StopMotionCommand}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding MotionProgress, Mode=OneWay}"
                                         Style="{StaticResource ProgressBarStyle}" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- 动作列表：行内播放键 + 名字 + 时长 + 循环勾选（紧凑行，窄卡片也放得下） -->
                        <ScrollViewer Grid.Row="2" Style="{StaticResource CardScrollerStyle}" Margin="10,0,4,0">
                            <ItemsControl ItemsSource="{Binding Motions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="▶" Width="24" Height="21" Padding="0" FontSize="9"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    ToolTip="播放这个动作"
                                                    Command="{Binding DataContext.PlayMotionCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Margin="5,0,3,0"
                                                       VerticalAlignment="Center" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" MinWidth="0"
                                                       ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <CheckBox Grid.Column="3" Style="{StaticResource CheckBoxStyle}" Margin="5,0,0,0"
                                                      IsChecked="{Binding Loop, Mode=TwoWay}" ToolTip="循环播放这个动作" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" Margin="12,4,12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="待机动作" Style="{StaticResource SettingLabelStyle}" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding IdleMotionOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedIdleMotion, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}" Height="26" />
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="淡入淡出" Style="{StaticResource SettingLabelStyle}" Margin="0,0,6,0" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05"
                                        Value="{Binding MotionFadeSeconds, Mode=TwoWay}"
                                        Style="{StaticResource SliderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding MotionFadeSeconds, StringFormat={}{0:0.00}s}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 左右分隔条：动作 / 表情 -->
                <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="live2d.动作与表情" />

                <!-- ② 表情卡：单选切换（官方语义：同一时间只有一个表情）+ 淡入淡出时长 + 全部清除 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="56" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,12,14,4">
                            <TextBlock Text="表情" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="{Binding ExpressionSummaryText}" HorizontalAlignment="Right" FontSize="10.5"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="14,0,14,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="淡入淡出" Style="{StaticResource SettingLabelStyle}" Margin="0,0,6,0" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05"
                                        Value="{Binding ExpressionFadeSeconds, Mode=TwoWay}"
                                        Style="{StaticResource SliderStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ExpressionFadeSeconds, StringFormat={}{0:0.00}s}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>
                            <Button Content="全部清除" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"
                                    HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding ClearExpressionsCommand}" />
                        </StackPanel>

                        <!-- 表情列表：单选切换（点新的 = 切换，点当前 = 取消），按钮直接铺满行宽 -->
                        <ScrollViewer Grid.Row="2" Style="{StaticResource CardScrollerStyle}" Margin="10,0,4,6">
                            <ItemsControl ItemsSource="{Binding Expressions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CompactButtonStyle}" Margin="0,1" MinHeight="24"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.ToggleExpressionCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="点一下激活（同一时间只有一个表情），再点当前激活的取消回默认">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" MinWidth="0" />
                                                <TextBlock Grid.Column="1" Text="✓ 当前" FontSize="10" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 左右分隔条：表情 / 物理 -->
                <core:PaneSplitter Grid.Column="3" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="live2d.表情与物理" />

                <!-- ③ 物理与跟随卡（内容较高，内部滚动） -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <ScrollViewer Style="{StaticResource CardScrollerStyle}">
                        <StackPanel Margin="14,12,14,12">
                            <TextBlock Text="物理与眼睛跟随" Style="{StaticResource CardHeaderStyle}" />

                            <CheckBox Content="物理演算（头发 / 尾巴摆动）" Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                      IsChecked="{Binding PhysicsEnabled}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="物理强度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05"
                                        Value="{Binding PhysicsStrength, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding PhysicsStrength, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>

                            <CheckBox Content="全身轻晃（以脚为轴）" Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0"
                                      IsChecked="{Binding BodyLeanEnabled}"
                                      ToolTip="整个人以脚为支点左右轻倾（不倒翁式，不是扭腰）；关掉后角度平滑归零" />
                            <CheckBox Content="待机动画" Style="{StaticResource CheckBoxStyle}" Margin="0,6,0,0"
                                      IsChecked="{Binding IdleEnabled}" />
                            <CheckBox Content="自动眨眼" Style="{StaticResource CheckBoxStyle}" Margin="0,6,0,0"
                                      IsChecked="{Binding AutoBlink}" />
                            <CheckBox Content="眼睛跟随鼠标" Style="{StaticResource CheckBoxStyle}" Margin="0,6,0,0"
                                      IsChecked="{Binding EyeTracking}" />

                            <!-- 鼠标跟随灵敏度：横向 / 抬头 / 低头 / 纵向偏移（向下看跟不到 → 调大低头灵敏度） -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="横向灵敏度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="0.3" Maximum="3" SmallChange="0.05"
                                        Value="{Binding EyeTrackingHorizontalGain, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" ToolTip="鼠标左右移动时头 / 眼睛转的幅度：不够跟手就调大" />
                                <TextBlock Grid.Column="2" Text="{Binding EyeTrackingHorizontalGain, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="抬头灵敏度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="0.3" Maximum="3" SmallChange="0.05"
                                        Value="{Binding EyeTrackingUpGain, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" ToolTip="鼠标在模型上方时头 / 眼睛抬起的幅度" />
                                <TextBlock Grid.Column="2" Text="{Binding EyeTrackingUpGain, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="低头灵敏度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="0.3" Maximum="3" SmallChange="0.05"
                                        Value="{Binding EyeTrackingDownGain, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" ToolTip="鼠标在模型下方时头 / 眼睛低头的幅度：向下看跟不到就调大这个" />
                                <TextBlock Grid.Column="2" Text="{Binding EyeTrackingDownGain, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="纵向偏移" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="-0.5" Maximum="0.5" SmallChange="0.01"
                                        Value="{Binding EyeTrackingVerticalOffset, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" ToolTip="整体视线偏上 / 偏下一点点（0 = 不偏）" />
                                <TextBlock Grid.Column="2" Text="{Binding EyeTrackingVerticalOffset, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="平滑度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="0.05" Maximum="1" SmallChange="0.01"
                                        Value="{Binding EyeTrackingSmoothing, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding EyeTrackingSmoothing, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="头转幅度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="0.2" Maximum="1.5" SmallChange="0.05"
                                        Value="{Binding EyeTrackingHeadStrength, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding EyeTrackingHeadStrength, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="眼球幅度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="0.2" Maximum="1.5" SmallChange="0.05"
                                        Value="{Binding EyeTrackingEyeStrength, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding EyeTrackingEyeStrength, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="身体幅度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1.5" SmallChange="0.05"
                                        Value="{Binding EyeTrackingBodyStrength, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding EyeTrackingBodyStrength, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>

                            <Separator Margin="0,10,0,8" Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="调试视图（只影响测试台预览）" FontSize="11.5" FontWeight="SemiBold" />
                            <CheckBox Content="网格包围盒" Style="{StaticResource CheckBoxStyle}" Margin="0,6,0,0"
                                      IsChecked="{Binding ShowDrawableBounds}" />
                            <CheckBox Content="蒙版范围（染红）" Style="{StaticResource CheckBoxStyle}" Margin="0,4,0,0"
                                      IsChecked="{Binding ShowMaskRanges}" />
                            <CheckBox Content="高亮点击命中的网格" Style="{StaticResource CheckBoxStyle}" Margin="0,4,0,0"
                                      IsChecked="{Binding HighlightPickedDrawable}" />
                            <CheckBox Content="蒙版缓冲可视化（需先点中网格）" Style="{StaticResource CheckBoxStyle}" Margin="0,4,0,0"
                                      IsChecked="{Binding ShowMaskBuffer}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 左右分隔条：物理 / 桌宠 -->
                <core:PaneSplitter Grid.Column="5" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="live2d.物理与桌宠" />

                <!-- ④ 桌宠卡 -->
                <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <ScrollViewer Style="{StaticResource CardScrollerStyle}">
                        <StackPanel Margin="14,12,14,12">
                            <Grid>
                                <TextBlock Text="桌面宠物" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PetStateText}" />
                            </Grid>
                            <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,4,0,0"
                                       Text="透明置顶的小窗：拖动移动、滚轮缩放、右键菜单、透明区域点击穿透、眼睛跟随全局鼠标。" />

                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="{Binding PetButtonText}" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding TogglePetCommand}" Margin="0,0,8,8" />
                                <Button Content="居中" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CenterPetCommand}" Margin="0,0,8,8" />
                                <Button Content="重置位置" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ResetPetPositionCommand}" Margin="0,0,8,8" />
                            </WrapPanel>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="宽度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="160" Maximum="1000" SmallChange="10"
                                        Value="{Binding PetWidth, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding PetWidth, StringFormat={}{0:0}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="不透明度" Style="{StaticResource SettingLabelStyle}" />
                                <Slider Grid.Column="1" Minimum="0.2" Maximum="1" SmallChange="0.05"
                                        Value="{Binding PetOpacity, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding PetOpacity, StringFormat={}{0:0.00}}"
                                           Style="{StaticResource SettingValueStyle}" />
                            </Grid>

                            <CheckBox Content="置顶显示" Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0"
                                      IsChecked="{Binding Cfg.PetTopMost, Mode=TwoWay}" />
                            <CheckBox Content="透明区域点击穿透" Style="{StaticResource CheckBoxStyle}" Margin="0,4,0,0"
                                      IsChecked="{Binding Cfg.PetClickThrough, Mode=TwoWay}"
                                      ToolTip="鼠标在模型透明区域时直接穿透到下面的窗口" />
                            <CheckBox Content="启动程序时自动放出桌宠" Style="{StaticResource CheckBoxStyle}" Margin="0,4,0,0"
                                      IsChecked="{Binding Cfg.AutoStartPet, Mode=TwoWay}" />

                            <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,8,0,0"
                                       Text="提示：右键桌宠窗口有「居中 / 置顶 / 点击穿透 / 关闭」等菜单；要回到这个测试页，从主窗口侧边栏「桌面 → Live2D 桌宠」进来。" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 上下分隔条：下排 / 摄像头动捕 -->
            <core:PaneSplitter Grid.Row="4" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="live2d.下排与动捕" />

            <!-- ==================================================== 摄像头面部动捕 ==================================================== -->
            <Border Grid.Row="5" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <!-- 标题 + 总开关 + 刷新设备 -->
                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷 摄像头面部动捕" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="{Binding MocapToggleText}" FontSize="10.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,4,0,0"
                                       Text="用系统自带摄像头 + Windows FaceAnalysis 驱动头部 / 眨眼 / 张嘴。只有打开开关才会请求摄像头权限；预览只在窗口里显示，不保存任何画面。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <CheckBox Content="启用摄像头动捕" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding MocapEnabled, Mode=TwoWay}" Margin="0,0,12,0" />
                            <Button Content="刷新设备" Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding RefreshCamerasCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 主体：左设置 / 右预览 + 状态（高度不够时内部滚动，不裁内容） -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource CardScrollerStyle}" Margin="0,10,0,0">
                        <Grid Margin="18,0,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="360" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：设备与参数 -->
                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="摄像头" Style="{StaticResource SettingLabelStyle}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MocapCameraOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedMocapCamera, Mode=TwoWay}"
                                              Style="{StaticResource ComboBoxStyle}" Height="28"
                                              ToolTip="设备名就是系统里看到的名字；优先内置摄像头，手机 / 虚拟摄像头需手动选" />
                                </Grid>
                                <TextBlock Text="{Binding CameraListSummary}" Style="{StaticResource CardSubTextStyle}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CameraListSummary}" />

                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox Content="镜像画面" Style="{StaticResource CheckBoxStyle}" Margin="0,0,18,6"
                                              IsChecked="{Binding MocapMirror, Mode=TwoWay}"
                                              ToolTip="前置摄像头镜像（像照镜子）；想「自己的右手 = 模型右手」就保持开" />
                                    <CheckBox Content="显示摄像头预览" Style="{StaticResource CheckBoxStyle}" Margin="0,0,18,6"
                                              IsChecked="{Binding MocapShowPreview, Mode=TwoWay}" />
                                    <TextBlock Text="帧率" Style="{StaticResource SettingLabelStyle}" Margin="0,0,6,6" />
                                    <ComboBox ItemsSource="{Binding MocapFpsOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding MocapFps, Mode=TwoWay}"
                                              Style="{StaticResource ComboBoxStyle}" Width="140" Height="28" Margin="0,0,0,6" />
                                </WrapPanel>

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="平滑" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.9" SmallChange="0.01"
                                            Value="{Binding MocapSmoothing, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding MocapSmoothing, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>

                                <Separator Margin="0,8,0,8" Background="{DynamicResource BorderBrush}" />
                                <WrapPanel>
                                    <CheckBox Content="驱动头部" Style="{StaticResource CheckBoxStyle}" Margin="0,0,18,6"
                                              IsChecked="{Binding MocapHeadEnabled, Mode=TwoWay}" />
                                    <CheckBox Content="驱动眨眼" Style="{StaticResource CheckBoxStyle}" Margin="0,0,18,6"
                                              IsChecked="{Binding MocapBlinkEnabled, Mode=TwoWay}" />
                                    <CheckBox Content="驱动张嘴" Style="{StaticResource CheckBoxStyle}" Margin="0,0,18,6"
                                              IsChecked="{Binding MocapMouthEnabled, Mode=TwoWay}" />
                                </WrapPanel>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="头部强度" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1.5" SmallChange="0.05"
                                            Value="{Binding MocapHeadStrength, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding MocapHeadStrength, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="眼球强度" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1.5" SmallChange="0.05"
                                            Value="{Binding MocapEyeStrength, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding MocapEyeStrength, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="张嘴幅度" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1.5" SmallChange="0.05"
                                            Value="{Binding MocapMouthStrength, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding MocapMouthStrength, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="重新校准表情" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                            Command="{Binding ResetMocapCalibrationCommand}"
                                            ToolTip="眨眼 / 张嘴的自动基准清零（换环境 / 光线后点一下）" />
                                    <Button Content="校准中性位" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                            Command="{Binding CalibrateMocapNeutralCommand}"
                                            ToolTip="把当前「有脸」的位置当成正前方（换座位 / 换摄像头后眼角不正时用）" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- 右：摄像头预览小窗（只显示不存盘）+ 状态行 -->
                            <StackPanel Grid.Column="2">
                                <Border Width="288" Height="162" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid x:Name="MocapPreviewHost">
                                        <Image x:Name="MocapPreviewImage" Stretch="Uniform" IsHitTestVisible="False" />
                                        <Canvas x:Name="MocapFaceOverlay" IsHitTestVisible="False"
                                                Width="{Binding ActualWidth, ElementName=MocapPreviewHost}"
                                                Height="{Binding ActualHeight, ElementName=MocapPreviewHost}">
                                            <Rectangle x:Name="MocapFaceRect" Stroke="{DynamicResource AccentBrush}"
                                                       StrokeThickness="2" Visibility="Collapsed" />
                                        </Canvas>
                                        <TextBlock x:Name="MocapPreviewPlaceholder" Text="等待摄像头画面…"
                                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="16" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding MocapStatusText}" FontSize="11.5" TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding MocapErrorText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Visibility="{Binding HasMocapError, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,8,0,0"
                                           Text="预览框 = 摄像头画面（镜像已按设置处理），上面跟踪人脸框；只有启用动捕 + 显示预览时才会有画面。" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 上下分隔条：摄像头动捕 / 身体晃动 -->
            <core:PaneSplitter Grid.Row="6" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="live2d.动捕与身体晃动" />

            <!-- ==================================================== 身体晃动测试 ==================================================== -->
            <Border Grid.Row="7" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="🌊 身体晃动测试" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,4,0,0"
                                       Text="用一组身体 / 腰部 / 物理输入参数做正弦晃动，右侧实时显示参数与 5 秒折线图：能直观看到「身体晃 → AngleX → 物理带动 FrontHairX1（头发）」的链条。注意：和摄像头动捕同时开启时，头部优先跟脸（晃动不做头部补偿），腰身 / 物理仍由晃动驱动。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="开启身体晃动" Style="{StaticResource CheckBoxStyle}"
                                  IsChecked="{Binding BodySwayEnabled, Mode=TwoWay}" VerticalAlignment="Top" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource CardScrollerStyle}" Margin="0,10,0,0">
                        <Grid Margin="18,0,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400" MinWidth="320" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：晃动参数 -->
                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="晃动模式" Style="{StaticResource SettingLabelStyle}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SwayModeOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedSwayMode, Mode=TwoWay}"
                                              Style="{StaticResource ComboBoxStyle}" Height="28" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="幅度（°）" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="30" SmallChange="0.5"
                                            Value="{Binding BodySwayAmplitude, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BodySwayAmplitude, StringFormat={}{0:0.0}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="速度（Hz）" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="2" SmallChange="0.05"
                                            Value="{Binding BodySwaySpeed, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BodySwaySpeed, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="头部补偿" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05"
                                            Value="{Binding BodySwayHeadFollow, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center"
                                            ToolTip="0 = 头部完全跟着身体晃；1 = 头尽量保持朝前（反向补偿）" />
                                    <TextBlock Grid.Column="2" Text="{Binding BodySwayHeadFollow, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <CheckBox Content="连腰部 / 腿部一起晃" Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0"
                                          IsChecked="{Binding BodySwayIncludeHips, Mode=TwoWay}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="摇一摇（3 秒）" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                                            Command="{Binding ShakeSwayCommand}" ToolTip="临时演示：按当前模式 / 幅度 / 速度晃 3 秒" />
                                    <Button Content="停" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                            Command="{Binding StopSwayCommand}" ToolTip="停止演示并关闭身体晃动" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SwayDemoRemainingText}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- 右：5 秒滚动折线图 + 参数实时值 -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="120" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="最近 5 秒参数曲线（每条按自身幅度缩放，同一时间轴）" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Grid Grid.Row="1" Margin="0,6,0,0" ClipToBounds="True">
                                            <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}"
                                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                                            <Canvas x:Name="SwayChart" ClipToBounds="True" SizeChanged="OnSwayChartSizeChanged">
                                                <Polyline x:Name="SwayLineBodyX" Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="1.6" StrokeLineJoin="Round" />
                                                <Polyline x:Name="SwayLineAngleX" Stroke="{DynamicResource SuccessBrush}"
                                                          StrokeThickness="1.6" StrokeLineJoin="Round" />
                                                <Polyline x:Name="SwayLineHeadX" Stroke="{DynamicResource DangerBrush}"
                                                          StrokeThickness="1.6" StrokeLineJoin="Round" />
                                                <Polyline x:Name="SwayLineFrontHair" Stroke="{DynamicResource FaintTextBrush}"
                                                          StrokeThickness="1.6" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Grid>
                                        <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                            <Rectangle Width="10" Height="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="ParamBodyAngleX" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                            <Rectangle Width="10" Height="3" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="AngleX" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                            <Rectangle Width="10" Height="3" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="ParamAngleX" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                            <Rectangle Width="10" Height="3" Fill="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="FrontHairX1（物理输出）" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding SwayValuesText}" FontSize="11" Margin="0,10,0,0"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Style="{StaticResource CardSubTextStyle}" Margin="0,6,0,0"
                                           Text="参数值每 100ms 刷新一次；头发参数（FrontHairX1 等）数值本身只有零点几度，曲线里按自身幅度放大了。它们的摆动由物理计算、会比身体慢半拍 —— 这正是「身体晃 → 角度 → 物理带动头发」的证据。" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 上下分隔条：身体晃动 / 面部测试 -->
            <core:PaneSplitter Grid.Row="8" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="live2d.身体晃动与面部" />

            <!-- ==================================================== 面部测试（眼 / 嘴 / 舌头） ==================================================== -->
            <Border Grid.Row="9" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="😛 面部测试" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="{Binding FaceSummaryText}" FontSize="10.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,4,0,0"
                                       Text="直接读写模型参数（滑杆范围 = 参数自身的 Min/Max，改完立刻生效）。注意：动捕 / 眼睛跟随 / 表情正在接管这些参数时会被每帧驱动覆盖 —— 想手动调就先关掉对应功能（或先点下面的预设看效果）。" />
                        </StackPanel>
                    </Grid>

                    <!-- 预设按钮：一键摆表情 -->
                    <WrapPanel Grid.Row="1" Margin="18,8,18,2">
                        <Button Content="😛 吐舌头" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ApplyFacePresetCommand}" CommandParameter="tongue"
                                ToolTip="TongueOut=1 + 张嘴一点（重点：验证舌头参数）" />
                        <Button Content="😲 张嘴" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ApplyFacePresetCommand}" CommandParameter="open" />
                        <Button Content="😗 撅嘴" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ApplyFacePresetCommand}" CommandParameter="pucker" />
                        <Button Content="😊 微笑" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ApplyFacePresetCommand}" CommandParameter="smile" />
                        <Button Content="😉 眨眼" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ApplyFacePresetCommand}" CommandParameter="wink" />
                        <Button Content="🙄 翻白眼" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ApplyFacePresetCommand}" CommandParameter="rolleyes" />
                        <Button Content="😐 重置面部" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ApplyFacePresetCommand}" CommandParameter="reset"
                                ToolTip="把这一卡里的面部参数都恢复默认值" />
                    </WrapPanel>

                    <!-- 三列分组：眼睛 / 嘴 / 舌头（卡内整体滚动，不动整页高度；窄窗口靠列 MinWidth 兜住） -->
                    <ScrollViewer Grid.Row="2" Style="{StaticResource CardScrollerStyle}" Margin="18,4,18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" MinWidth="240" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" MinWidth="180" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="👁 眼睛" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding FaceEyeParameters}"
                                              ItemTemplate="{StaticResource FaceParameterRowTemplate}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="👄 嘴" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding FaceMouthParameters}"
                                              ItemTemplate="{StaticResource FaceParameterRowTemplate}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="👅 舌头（重点）" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding FaceTongueParameters}"
                                              ItemTemplate="{StaticResource FaceParameterRowTemplate}" />
                                <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,8,0,0"
                                           Text="「😛 吐舌头」预设 = TongueOut 拉满 + 嘴张开一点；舌头没伸出来时先确认动捕 / 眼控 / 表情没在接管，或直接点预设。" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 上下分隔条：面部测试 / 音乐跟唱 -->
            <core:PaneSplitter Grid.Row="10" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="live2d.面部与音乐" />

            <!-- ==================================================== 音乐跟唱 · 律动 ==================================================== -->
            <Border Grid.Row="11" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎵 音乐跟唱 · 律动" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="{Binding MusicStatusText}" FontSize="10.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,4,0,0"
                                       Text="用 Windows 回环采集系统正在播放的声音来驱动嘴型 / 轻倾：不申请麦克风、不录音、不保存。识别不完美时可用「强制」模式；纯音乐不跟唱、只整身轻倾（以脚为轴）；采集失败会显示原因（如没有播放设备 / 被独占）。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="启用音乐跟唱 / 律动" Style="{StaticResource CheckBoxStyle}"
                                  IsChecked="{Binding MusicReactiveEnabled, Mode=TwoWay}" VerticalAlignment="Top"
                                  ToolTip="用 Windows 回环采集系统正在播放的声音（不申请麦克风、不录音、不保存）" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource CardScrollerStyle}" Margin="0,10,0,0">
                        <Grid Margin="18,0,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420" MinWidth="340" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：识别设置 -->
                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="识别模式" Style="{StaticResource SettingLabelStyle}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MusicModeOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedMusicMode, Mode=TwoWay}"
                                              Style="{StaticResource ComboBoxStyle}" Height="28"
                                              ToolTip="自动识别：按多特征判断；强制跟唱 / 强制纯音乐：识别不准时手动指定" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="识别灵敏度" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0.3" Maximum="3" SmallChange="0.05"
                                            Value="{Binding MusicReactiveSensitivity, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" ToolTip="越大越容易判成「带歌词」；识别不出来可以调大" />
                                    <TextBlock Grid.Column="2" Text="{Binding MusicReactiveSensitivity, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="嘴型幅度" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1.5" SmallChange="0.05"
                                            Value="{Binding MusicLipSyncStrength, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" ToolTip="跟唱时嘴张开 / 合拢的幅度倍率" />
                                    <TextBlock Grid.Column="2" Text="{Binding MusicLipSyncStrength, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="摇晃幅度" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1.5" SmallChange="0.05"
                                            Value="{Binding MusicSwayStrength, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" ToolTip="跟随节拍摇晃身体 / 头部摆动的幅度倍率" />
                                    <TextBlock Grid.Column="2" Text="{Binding MusicSwayStrength, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox Content="全身轻倾（跟节拍）" Style="{StaticResource CheckBoxStyle}" Margin="0,0,18,6"
                                              IsChecked="{Binding MusicSwayEnabled, Mode=TwoWay}"
                                              ToolTip="有歌时整身左右轻倾（以脚为轴，比日常轻晃更快），不是扭腰" />
                                    <CheckBox Content="轻微点头" Style="{StaticResource CheckBoxStyle}" Margin="0,0,18,6"
                                              IsChecked="{Binding MusicHeadBobEnabled, Mode=TwoWay}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,6,0,0"
                                           Text="识别依据：YIN 基频 + 共振峰 + 立体声中心声道占比 + 音节调制 + 时序滞后（不是音量阈值）。「全身轻倾」= 有歌时整身左右轻倾（以脚为轴，比日常轻晃更快），不是扭腰；本功能只读取系统正在播放的声音，不会打开麦克风。" />
                            </StackPanel>

                            <!-- 右：状态 + 实时数据 -->
                            <StackPanel Grid.Column="2">
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding MusicStatusText}" FontSize="12" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding MusicConfidenceText}" FontSize="10.5"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding MusicMediaText}" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding MusicMediaText}" />
                                        <TextBlock Grid.Row="2" Text="{Binding MusicBodyLeanText}" FontSize="11" Margin="0,4,0,0"
                                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   ToolTip="以脚为支点的整身左右轻倾（渲染层旋转）；有歌时比日常轻晃更快、幅度略大" />
                                        <TextBlock Grid.Row="3" Text="{Binding MusicErrorText}" FontSize="11" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                                   Visibility="{Binding HasMusicError, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Row="4" FontSize="10.5" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap"
                                                   Text="实时数据每 100ms 刷新；没在放音乐时显示静音，采集本身仍在正常运行。" />
                                    </Grid>
                                </Border>

                                <!-- 实时数据：2 列 × 4 行（数值 + 小进度条） -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="RMS" Style="{StaticResource SettingLabelStyle}" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="8" VerticalAlignment="Center"
                                                     Style="{StaticResource ProgressBarStyle}" Value="{Binding MusicRms, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MusicRms, StringFormat={}{0:0.00}}"
                                                   Style="{StaticResource SettingValueStyle}" />
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="2" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="人声分数" Style="{StaticResource SettingLabelStyle}" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="8" VerticalAlignment="Center"
                                                     Style="{StaticResource ProgressBarStyle}" Value="{Binding MusicVocalScore, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MusicVocalScore, StringFormat={}{0:0.00}}"
                                                   Style="{StaticResource SettingValueStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="置信度" Style="{StaticResource SettingLabelStyle}" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="8" VerticalAlignment="Center"
                                                     Style="{StaticResource ProgressBarStyle}" Value="{Binding MusicConfidence, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MusicConfidence, StringFormat={}{0:0.00}}"
                                                   Style="{StaticResource SettingValueStyle}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="2" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="节拍强度" Style="{StaticResource SettingLabelStyle}" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="8" VerticalAlignment="Center"
                                                     Style="{StaticResource ProgressBarStyle}" Value="{Binding MusicBeatStrength, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MusicBeatStrength, StringFormat={}{0:0.00}}"
                                                   Style="{StaticResource SettingValueStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="中心声道" Style="{StaticResource SettingLabelStyle}" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="8" VerticalAlignment="Center"
                                                     Style="{StaticResource ProgressBarStyle}" Value="{Binding MusicCenterRatio, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MusicCenterRatio, StringFormat={}{0:0.00}}"
                                                   Style="{StaticResource SettingValueStyle}" />
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.Column="2" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="音节调制" Style="{StaticResource SettingLabelStyle}" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="8" VerticalAlignment="Center"
                                                     Style="{StaticResource ProgressBarStyle}" Value="{Binding MusicSyllabic, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MusicSyllabic, StringFormat={}{0:0.00}}"
                                                   Style="{StaticResource SettingValueStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="3" Grid.Column="0" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="音高（YIN）" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding MusicPitchText}" Style="{StaticResource SettingValueStyle}"
                                                   HorizontalAlignment="Left" />
                                    </Grid>
                                    <Grid Grid.Row="3" Grid.Column="2" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="BPM" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding MusicBpmText}" Style="{StaticResource SettingValueStyle}"
                                                   HorizontalAlignment="Left" />
                                    </Grid>
                                </Grid>

                                <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,8,0,0"
                                           Text="提示：识别不准时切「强制跟唱 / 强制纯音乐」；纯音乐模式不会跟唱。所有数值只用于本地驱动模型，不保存音频、不上传。" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 上下分隔条：音乐跟唱 / 手臂 & 姿势 -->
            <core:PaneSplitter Grid.Row="12" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="live2d.音乐与手臂" />

            <!-- ==================================================== 手臂 & 姿势（动作演示） ==================================================== -->
            <Border Grid.Row="13" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="200" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖐 手臂 &amp; 姿势" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="{Binding ActionStatusText}" FontSize="10.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,4,0,0"
                                       Text="手臂参数可直接拖（范围取参数自身 Min/Max）；动作播放时会覆盖手动值 —— 想手动调先点「⏹ 停止所有演示」。手势 / 表演 / 舞蹈 / 待机随机小动作都走运行时动作系统，和呼吸、眨眼、物理叠加。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="🎲 随机动作" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,0"
                                    Command="{Binding RandomActionCommand}"
                                    ToolTip="随机播一个手势或表演" />
                            <Button Content="⏹ 停止所有演示" Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding StopAllDemosCommand}"
                                    ToolTip="停止手势 / 表演 / 舞蹈 / 摇晃演示，把身体交还手动参数与物理" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource CardScrollerStyle}" Margin="0,10,0,0">
                        <Grid Margin="18,0,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="430" MinWidth="360" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：手臂 / 肩膀参数 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="左臂" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding LeftArmParameters}"
                                              ItemTemplate="{StaticResource FaceParameterRowTemplate}" />
                                <TextBlock Text="右臂" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,4" />
                                <ItemsControl ItemsSource="{Binding RightArmParameters}"
                                              ItemTemplate="{StaticResource FaceParameterRowTemplate}" />
                                <TextBlock Text="肩膀" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,4" />
                                <ItemsControl ItemsSource="{Binding ShoulderParameters}"
                                              ItemTemplate="{StaticResource FaceParameterRowTemplate}" />
                            </StackPanel>

                            <!-- 右：手势 / 表演 / 舞蹈 / 待机灵动 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="手势（点一下就播）" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <ItemsControl ItemsSource="{Binding GestureActions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Style="{StaticResource CompactButtonStyle}"
                                                    Margin="0,0,6,6"
                                                    Command="{Binding DataContext.PlayGestureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="表演（多步小剧情）" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,5" />
                                <ItemsControl ItemsSource="{Binding Performances}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Style="{StaticResource CompactButtonStyle}"
                                                    Margin="0,0,6,6"
                                                    Command="{Binding DataContext.PlayPerformanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="舞蹈" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="模式" Style="{StaticResource SettingLabelStyle}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DanceModeOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedDanceMode, Mode=TwoWay}"
                                              Style="{StaticResource ComboBoxStyle}" Height="26" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="跳个舞" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,0"
                                                Command="{Binding StartDanceCommand}" />
                                        <Button Content="停" Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding StopDanceCommand}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="舞蹈速度" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="2" SmallChange="0.05"
                                            Value="{Binding DanceSpeed, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding DanceSpeed, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>

                                <Separator Margin="0,8,0,6" Background="{DynamicResource BorderBrush}" />
                                <TextBlock Text="待机灵动（比默认待机更生动）" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <CheckBox Content="待机随机小动作（更生动）" Style="{StaticResource CheckBoxStyle}"
                                          IsChecked="{Binding IdleRandomGestureEnabled, Mode=TwoWay}" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="间隔（秒）" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="8" Maximum="60" SmallChange="1"
                                            Value="{Binding IdleRandomGestureIntervalSeconds, Mode=TwoWay}"
                                            Style="{StaticResource SliderStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding IdleRandomGestureIntervalSeconds, StringFormat={}{0:0}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>

                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Text="{Binding ActiveGestureText}" Style="{StaticResource CardSubTextStyle}"
                                               Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding ActivePerformanceText}" Style="{StaticResource CardSubTextStyle}"
                                               Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding ActiveDanceText}" Style="{StaticResource CardSubTextStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 上下分隔条：手臂 & 姿势 / 说话 -->
            <core:PaneSplitter Grid.Row="14" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="live2d.手臂与说话" />

            <!-- ==================================================== 说话 / 轻对话 ==================================================== -->
            <Border Grid.Row="15" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="200" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬 说话 / 轻对话" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="{Binding SpeechStatusText}" FontSize="10.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="540" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,4,0,0"
                                       Text="默认用微软 Edge 在线神经网络语音（晓伊 · 少女音，默认软妹；也可换晓晓/晓北等，断网自动回退 Windows 本地语音）。在线只把要说的文本发给微软、不保存音频。说话时桌宠头顶显示气泡、嘴型跟着发音变化，声音 / 口型 / 气泡同时出现；轻对话是离线关键词匹配（未知输入 → 随机软妹回复），以后可以换成 LLM。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="🎲 随便说一句" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,0"
                                    Command="{Binding RandomSayCommand}" />
                            <Button Content="⏹ 停止" Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding StopSpeakingCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource CardScrollerStyle}" Margin="0,10,0,0">
                        <Grid Margin="18,0,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="460" MinWidth="380" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：语音设置 + 输入 -->
                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="语音" Style="{StaticResource SettingLabelStyle}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding VoiceOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"
                                              Style="{StaticResource ComboBoxStyle}" Height="26"
                                              ToolTip="系统里安装的 TTS 语音；空 = 自动中文女声" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="试听" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,0"
                                                Command="{Binding TryVoiceCommand}" />
                                        <Button Content="重新检测" Style="{StaticResource CompactButtonStyle}"
                                                Click="OnReloadVoicesClick" ToolTip="重新枚举系统语音（刚装了语音包时用）" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SpeechVoiceError}" FontSize="10.5" Margin="0,3,0,0"
                                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasSpeechVoiceError, Converter={StaticResource BoolToVis}}" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="语速" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0.6" Maximum="1.6" SmallChange="0.05"
                                            Value="{Binding SpeechRate, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" ToolTip="0.6 ~ 1.6 倍速" />
                                    <TextBlock Grid.Column="2" Text="{Binding SpeechRate, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音调" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="-20" Maximum="40" SmallChange="1"
                                            Value="{Binding SpeechPitchPercent, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" ToolTip="默认 12 = 软妹音；越大越尖" />
                                    <TextBlock Grid.Column="2" Text="{Binding SpeechPitchPercent, StringFormat={}{0:0}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音量" Style="{StaticResource SettingLabelStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05"
                                            Value="{Binding SpeechVolume, Mode=TwoWay}" Style="{StaticResource SliderStyle}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding SpeechVolume, StringFormat={}{0:0.00}}"
                                               Style="{StaticResource SettingValueStyle}" />
                                </Grid>

                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox Content="显示聊天气泡" Style="{StaticResource CheckBoxStyle}" Margin="0,0,16,6"
                                              IsChecked="{Binding SpeechBubbleEnabled, Mode=TwoWay}"
                                              ToolTip="说话时在桌宠头顶显示气泡（透明置顶不抢焦点、点击穿透）" />
                                    <CheckBox Content="说话自动小动作" Style="{StaticResource CheckBoxStyle}" Margin="0,0,16,6"
                                              IsChecked="{Binding SpeechAutoGesture, Mode=TwoWay}"
                                              ToolTip="每次说话随机配一个小手势，更生动" />
                                    <CheckBox Content="空闲随机自言自语" Style="{StaticResource CheckBoxStyle}" Margin="0,0,16,6"
                                              IsChecked="{Binding SpeechIdleChatterEnabled, Mode=TwoWay}"
                                              ToolTip="页面 / 桌宠可见且没在说话、没放音乐时，约 60~120 秒说一句" />
                                </WrapPanel>

                                <TextBox Text="{Binding SpeechInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="54" MaxHeight="70" Margin="0,4,0,0" Padding="8,6"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         ToolTip="输入想听的话；「发送对话」会按关键词回一句（离线，不联网）" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="说出来" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,6"
                                            Command="{Binding SpeakCommand}" />
                                    <Button Content="发送对话" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"
                                            Command="{Binding SendChatCommand}"
                                            ToolTip="先显示你的话，0.3~0.8 秒后小凉按关键词回一句并说出来" />
                                    <Button Content="⏹ 停止" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"
                                            Command="{Binding StopSpeakingCommand}" />
                                    <Button Content="清空聊天" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,6"
                                            Command="{Binding ClearChatCommand}" />
                                </WrapPanel>

                                <TextBlock Text="预设台词" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,4" />
                                <WrapPanel>
                                    <Button Content="你好呀" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,6"
                                            Command="{Binding SpeakPresetCommand}" CommandParameter="你好呀" />
                                    <Button Content="今天也要开心喔" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,6"
                                            Command="{Binding SpeakPresetCommand}" CommandParameter="今天也要开心喔" />
                                    <Button Content="主人辛苦啦" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,6"
                                            Command="{Binding SpeakPresetCommand}" CommandParameter="主人辛苦啦" />
                                    <Button Content="抱抱～" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,6"
                                            Command="{Binding SpeakPresetCommand}" CommandParameter="抱抱～" />
                                    <Button Content="晚安，做个好梦" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,6"
                                            Command="{Binding SpeakPresetCommand}" CommandParameter="晚安，做个好梦" />
                                    <Button Content="想我了吗？" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,6"
                                            Command="{Binding SpeakPresetCommand}" CommandParameter="想我了吗？" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- 右：聊天记录 -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="聊天记录" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Text="（最近 20 条 · 离线关键词轻对话，不联网）" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Margin="0,5,0,0" Padding="4" MinHeight="150">
                                    <ListBox ItemsSource="{Binding ChatMessages}" Background="Transparent"
                                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="176">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Role}" FontSize="10.5" Margin="4,1,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11.5"
                                                               TextWrapping="Wrap" Margin="0,0,4,0"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,6,0,0"
                                           Text="「发送对话」= 先显示你的文字，然后按关键词回一句并说出来；关键词表在 ViewModel 里（问候 / 累了 / 开心 / 难过 / 晚安 / 喜欢你 / 吃饭 / 音乐 / 摸头 / 工作），未知输入随机软妹回复。以后接 LLM 只需替换 PickChatReply。" />
                                <TextBlock Style="{StaticResource CardSubTextStyle}" Margin="0,6,0,0"
                                           Text="气泡：桌宠头顶居中、跟随拖动 / 缩放 / 多屏边界夹取，说话结束约 1.5 秒自动淡出；透明置顶不抢焦点、点击穿透，不挡操作。" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 上下分隔条：说话 / 日志 -->
            <core:PaneSplitter Grid.Row="16" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="live2d.说话与日志" />

            <!-- ==================================================== 日志 ==================================================== -->
            <Border Grid.Row="17" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="50" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="日志" Style="{StaticResource CardHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="清空日志" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearLogCommand}" />
                            <Button Content="截图" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding TakeScreenshotCommand}"
                                    ToolTip="把当前画面存成 PNG（Data\live2d\screenshots）" />
                            <Button Content="打开截图文件夹" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding OpenScreenshotFolderCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" Style="{StaticResource LogTextBoxStyle}" Margin="0,10,0,0"
                             core:ScrollChaining.Enabled="True"
                             Text="{Binding LogText, Mode=OneWay}" />

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding LastScreenshotText}" FontSize="10.5" Margin="12,0,0,0"
                                   MaxWidth="360" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}"
                                   ToolTip="{Binding LastScreenshotText}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

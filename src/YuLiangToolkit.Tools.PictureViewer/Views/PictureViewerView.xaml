<UserControl x:Class="YuLiangToolkit.Tools.PictureViewer.Views.PictureViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.PictureViewer.Views"
             Background="#0E1014">

    <UserControl.Resources>
        <views:HexToBrushConverter x:Key="HexToBrush" />
        <!-- 调色板小方块：模板里只画一个带描边的色块，Background 由绑定的颜色给 -->
        <Style x:Key="PaletteSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 工具条第 2 行的文件夹路径：看着像普通文字，但可以点开资源管理器 -->
        <Style x:Key="FolderPathLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 图片连续阅读器界面：顶部一条工具条，下面整块都是「长带」。
         图片本身没有间距、没有卡片：一张接一张拼起来，滚轮 / 拖拽 / 中键锚点都在代码后置里（见 docs/dev/pitfalls.md）。 -->

    <Grid>
        <Grid.RowDefinitions>
            <!-- 普通模式：工具条占一行；全屏时高度归零，工具条变浮层（见下面 Border 的 DataTrigger） -->
            <RowDefinition x:Name="ToolbarRow" Height="{Binding ToolbarRowHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 顶部工具条 ================= -->
        <Border x:Name="ToolbarBorder">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <!-- 全屏：工具条浮在阅读区顶部（圆角半透明卡片 + 阴影），不占阅读高度 -->
                        <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Panel.ZIndex" Value="60" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="Margin" Value="10,10,10,0" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="#33FFFFFF" />
                            <Setter Property="Background" Value="#F0141720" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!-- 全屏时鼠标闲置自动缩回去 -->
                        <DataTrigger Binding="{Binding IsToolbarVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="📂 打开文件夹…" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ImageCountTextBlock" Text="{Binding ImageCountText}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <!-- 点这一行路径 = 在资源管理器里打开当前图片所在文件夹 -->
                    <Button x:Name="FolderPathButton" Style="{StaticResource FolderPathLinkStyle}"
                            FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                            IsEnabled="{Binding HasFolder}"
                            Command="{Binding OpenFolderInExplorerCommand}"
                            Margin="0,3,0,0" HorizontalAlignment="Left">
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock Text="{Binding FolderPathText}" FontSize="10.5" />
                                <TextBlock Text="点击在资源管理器里打开这个文件夹" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button.ToolTip>
                        <TextBlock Text="{Binding FolderPathText}" TextTrimming="CharacterEllipsis" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 缩放：百分比输入框 + 两个放大镜（− / +）。
                         100% = 程序默认的铺满基准（不是图片原始像素 1:1），输入框可以自由改数字（25~800）。 -->
                    <TextBox x:Name="ZoomBox" Width="60" TextAlignment="Center"
                             Style="{StaticResource TextBoxStyle}"
                             Text="{Binding ZoomText, UpdateSourceTrigger=LostFocus}"
                             PreviewKeyDown="OnZoomBoxPreviewKeyDown"
                             ToolTip="缩放比例（25% ~ 800%）：回车或离开输入框生效" />
                    <Button x:Name="ZoomOutButton" Width="32" Height="30" Padding="0" Margin="4,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ZoomOutCommand}" ToolTip="缩小 10%">
                        <Path Data="M 9,3 A 6,6 0 1 0 9,15 A 6,6 0 1 0 9,3 M 13.5,13.5 L 18,18 M 6,9 L 12,9"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent"
                              Stretch="Uniform" Width="17" Height="17" />
                    </Button>
                    <Button x:Name="ZoomInButton" Width="32" Height="30" Padding="0" Margin="4,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ZoomInCommand}" ToolTip="放大 10%">
                        <Path Data="M 9,3 A 6,6 0 1 0 9,15 A 6,6 0 1 0 9,3 M 13.5,13.5 L 18,18 M 6,9 L 12,9 M 9,6 L 9,12"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent"
                              Stretch="Uniform" Width="17" Height="17" />
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="10,0" />

                    <!-- 阅读方式会越来越多（现在 6 种），工具条只留「当前方式」按钮，点它打开设置面板去切换。
                         这样以后再加方式不用动工具条布局。 -->
                    <TextBlock Text="阅读方式" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="ModeButton" Content="{Binding CurrentModeText}"
                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="104"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip="{Binding ModeHint}" />
                    <Button Content="⚙ 设置" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding ToggleSettingsCommand}" ToolTip="阅读方式 / 缩放 / 滚轮步长 / 中键判定 / 离屏释放 / 最近浏览" />
                    <Button Content="🕘 最近" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding ToggleRecentCommand}" ToolTip="最近打开过的图片文件夹（点一下重新打开；上限在 ⚙ 设置 里调）" />
                    <Button x:Name="FullscreenButton" Width="34" Height="30" Padding="0" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleFullscreenCommand}"
                            ToolTip="{Binding FullscreenTooltip}">
                        <TextBlock Text="{Binding FullscreenGlyph}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 长带视口 ================= -->
        <Grid Grid.Row="1" x:Name="ViewportGrid" Background="#0E1014" ClipToBounds="True">

            <!-- 滚轮不交给 ScrollViewer 自己滚（它只会上下滚），三种方向统一由代码后置处理；
                 滚动条也藏掉，底部那条细进度条就是「读到哪了」。 -->
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          Focusable="False"
                          PanningMode="None"
                          ScrollChanged="OnImageScrollViewerScrollChanged">
                <StackPanel x:Name="ImageStrip" Orientation="Vertical" Margin="0" />
            </ScrollViewer>

            <!-- ================= 翻页 / 单张视图（连续模式时藏起来） ================= -->
            <Grid x:Name="PagedHost" Visibility="Collapsed" Background="#0E1014">
                <Grid x:Name="PagedViewport" Background="#0E1014" ClipToBounds="True">
                    <!-- 图片全部由代码后置摆在 Canvas 上（翻页动画要按页宽平移） -->
                    <Canvas x:Name="PagedCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Grid>

                <Button x:Name="PrevPageButton" Click="OnPrevPageClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="46" Height="76" Padding="0" FontSize="24"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Path Data="M 10,2 L 2,12 L 10,22" Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="12" Height="24" />
                </Button>
                <Button x:Name="NextPageButton" Click="OnNextPageClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="46" Height="76" Padding="0" FontSize="24"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Path Data="M 2,2 L 10,12 L 2,22" Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="12" Height="24" />
                </Button>

                <!-- 页码 / 翻页按钮提示 -->
                <Border x:Name="PageIndicatorPanel" Background="#B0000000" CornerRadius="12"
                        Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,18" IsHitTestVisible="False">
                    <TextBlock x:Name="PageIndicatorText" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
            </Grid>

            <!-- 阅读进度（细条，不参与命中测试） -->
            <Grid x:Name="ReadingProgressPanel" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="#1A1F28">
                <Border x:Name="ReadingProgressFill" HorizontalAlignment="Left" Width="0"
                        Background="{DynamicResource AccentBrush}" />
            </Grid>

            <!-- 中键锚点指示器：锚点固定不动，鼠标离开锚点越远滚得越快 -->
            <Canvas x:Name="AnchorLayer" IsHitTestVisible="False">
                <Grid x:Name="AnchorIndicator" Width="44" Height="44" Visibility="Collapsed">
                    <Ellipse Width="44" Height="44" Fill="#33000000" Stroke="#B3FFFFFF" StrokeThickness="2" />
                    <Line x:Name="ArrowUp" X1="22" Y1="13" X2="22" Y2="6"
                          Stroke="#CCFFFFFF" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line x:Name="ArrowDown" X1="22" Y1="31" X2="22" Y2="38"
                          Stroke="#CCFFFFFF" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Line x:Name="ArrowLeft" X1="13" Y1="22" X2="6" Y2="22"
                          Stroke="#CCFFFFFF" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    <Line x:Name="ArrowRight" X1="31" Y1="22" X2="38" Y2="22"
                          Stroke="#CCFFFFFF" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    <Ellipse Width="5" Height="5" Fill="#CCFFFFFF" />
                </Grid>
            </Canvas>

            <!-- 全屏进入提示（几秒后自动消失）：告诉用户怎么退出 / 怎么叫出工具条 -->
            <Border x:Name="FullscreenHintPanel" Background="#CC000000" CornerRadius="10" Padding="12,6"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,44"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock FontSize="11" Foreground="#CCFFFFFF"
                           Text="F11 / Esc 退出全屏 · 鼠标移到顶部显示工具条" />
            </Border>

            <!-- 空状态：还没打开文件夹 -->
            <Border x:Name="EmptyPanel" Background="#0E1014"
                    Visibility="{Binding HasPages, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="🖼️" FontSize="46" HorizontalAlignment="Center" />
                    <TextBlock Text="打开一个图片文件夹，连续滚动看图" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                               Text="阅读方式在顶部「阅读方式」按钮 / ⚙ 设置里切换：连续滚动（纵向、横向左右）适合条漫 / 长图；双页翻页（左→右 / 右→左）和单页浏览适合漫画。&#10;滚轮滚动 · 左键按住拖动画面 · 单击中键留锚点 / 按住中键快速滚动 · 翻页模式可用左右按钮 / 方向键。" />
                    <Button Content="📂 打开文件夹…" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenFolderCommand}" HorizontalAlignment="Center"
                            Margin="0,20,0,0" Padding="20,9" />
                </StackPanel>
            </Border>

            <!-- 加载遮罩（扫描文件夹 / 读图片尺寸时显示） -->
            <Border x:Name="LoadingPanel" Background="#C0000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                    <TextBlock Text="正在加载图片…" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                               Margin="0,8,0,10" />
                    <ProgressBar Style="{StaticResource ProgressBarStyle}" Minimum="0" Maximum="1"
                                 Value="{Binding Progress}" />
                </StackPanel>
            </Border>

            <!-- 最近浏览（工具条 🕘 最近 打开；点一条重新打开那个文件夹） -->
            <Border x:Name="RecentPanel" Width="380" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,12,0" Padding="14,12" MaxHeight="{Binding ActualHeight, ElementName=ViewportGrid}"
                    Style="{StaticResource CardStyle}" Panel.ZIndex="90"
                    Visibility="{Binding IsRecentVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="🕘 最近浏览" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="清空" Style="{StaticResource SecondaryButtonStyle}" Height="24"
                                    Padding="8,0" FontSize="10.5" Command="{Binding ClearRecentCommand}"
                                    ToolTip="清空最近浏览记录（不会删本地文件夹）" />
                            <Button Content="✕" Style="{StaticResource SecondaryButtonStyle}" Width="24" Height="24"
                                    Padding="0" FontSize="10" Margin="6,0,0,0"
                                    Command="{Binding ToggleRecentCommand}" ToolTip="关闭最近浏览（Esc）" />
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="最多记多少条在 ⚙ 设置 → 最近浏览（0 ~ 100，0 = 不记录）。" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding RecentEmptyText}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,6,2,6"
                                       Visibility="{Binding HasRecentItems, Converter={StaticResource InverseBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding RecentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,4"
                                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Path}" ToolTip="{Binding Path}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 设置面板（浮在右上角；改一下自动存）。阅读方式越来越多，切换统一放这里。 -->
            <Border x:Name="SettingsPanel" Width="380" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,12,0" Padding="16,14" Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer MaxHeight="{Binding ActualHeight, ElementName=ViewportGrid}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="⚙ 阅读设置" FontSize="14" FontWeight="SemiBold" />

                        <TextBlock Text="阅读方式" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,12,0,6" />
                        <ComboBox x:Name="ModeCombo" Style="{StaticResource ComboBoxStyle}" Height="32"
                                  ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedMode}"
                                  ToolTip="连续滚动：纵向 / 横向左右；翻页 / 单张：双页左右、单页浏览" />
                        <TextBlock Text="{Binding ModeHint}" FontSize="10.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />

                        <!-- 最近浏览：上限 0 = 不记录；改小会立刻裁掉多余的老记录 -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10" />
                        <TextBlock Text="最近浏览" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RecentSectionHint}" FontSize="10.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Style="{StaticResource SliderStyle}"
                                    Value="{Binding RecentLimit, Mode=TwoWay}"
                                    ToolTip="最多记多少条最近浏览（0 = 不记录并清空列表）" />
                            <TextBlock Grid.Column="1" Text="{Binding RecentLimitText}" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="46"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <!-- 翻页 / 单张模式专属设置 -->
                        <StackPanel Visibility="{Binding IsPagedMode, Converter={StaticResource BoolToVis}}">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10" />
                            <TextBlock Text="翻页设置" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="滚轮在翻页模式里做什么" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,6" />
                            <ComboBox Style="{StaticResource ComboBoxStyle}" Height="32"
                                      ItemsSource="{Binding WheelActionOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedWheelAction}"
                                      ToolTip="翻页 = 滚一格翻一张；缩放 = 和 Ctrl+滚轮一样" />
                            <CheckBox Content="翻页时滑动动画"
                                      IsChecked="{Binding Cfg.PageTurnAnimation}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                      ToolTip="关掉 = 直接换图；开着 = 整页滑过去（约 0.2 秒）" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10" />

                        <CheckBox Content="拖动惯性（松手后继续滑一会儿）"
                                  IsChecked="{Binding Cfg.InertiaEnabled}"
                                  Style="{StaticResource CheckBoxStyle}"
                                  ToolTip="关掉 = 松手即停；开着 = 按甩动速度继续滑一段、逐渐减速" />

                        <CheckBox Content="滚轮惯性（滚一格继续滑一段）"
                                  IsChecked="{Binding Cfg.WheelInertiaEnabled}"
                                  Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                  ToolTip="滚一下滚轮后按滚轮步长再滑一段并减速停下，滚一下能滚很远；和上面的拖动惯性是两个独立设置，只对连续滚动方向生效" />

                        <CheckBox Content="惯性越滑越快（连续甩动会叠加）"
                                  IsChecked="{Binding Cfg.InertiaAccelerate}"
                                  Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                  ToolTip="手机漫画 App 的手感：下一次甩动时把还在滑的速度加上去、不重置；有速度上限，不会失控" />

                        <CheckBox Content="离屏图片自动释放（省内存）"
                                  IsChecked="{Binding Cfg.AutoUnloadOffscreen}"
                                  Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0" />

                        <!-- 窗口 / 多开：单实例 = 双击图片复用已打开窗口；关掉 = 每次新开（启动级设置） -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,10" />
                        <TextBlock Text="窗口 / 多开" FontSize="11.5" FontWeight="SemiBold" />
                        <CheckBox x:Name="SingleInstanceCheckBox" Content="单实例模式（再双击图片复用同一个窗口）"
                                  IsChecked="{Binding SingleInstanceEnabled}"
                                  Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0" />
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="关掉 = 每次双击图片 / 启动程序都新开一个窗口（多实例）。这是启动级设置：改完下次启动生效，当前已经开着的窗口不受影响。" />

                        <!-- 图片边框：内边框 → 填充 → 外边框，颜色都是 RGBA -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,10" />
                        <TextBlock Text="图片边框" FontSize="11.5" FontWeight="SemiBold" />
                        <CheckBox Content="显示图片边框（隔开相邻两张图）"
                                  IsChecked="{Binding BorderEnabled}"
                                  Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0" />
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="从内到外：内边框 → 填充 → 外边框；粗细单位像素，0 = 不画这一层。颜色用 RGBA（0~255，A = 透明度），也可以点调色板快速选。" />

                        <!-- 内边框 -->
                        <TextBlock Text="内边框颜色" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}" VerticalAlignment="Center"
                                    Background="{Binding BorderInnerColorEditor.Hex, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="R" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderInnerColorEditor.R, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="G" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderInnerColorEditor.G, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="B" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderInnerColorEditor.B, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="A" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderInnerColorEditor.A, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="粗细" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Width="52" />
                            <Slider Width="190" Minimum="0" Maximum="32" VerticalAlignment="Center"
                                    Style="{StaticResource SliderStyle}" Value="{Binding BorderInnerSize}" />
                            <TextBlock Text="{Binding BorderInnerSize, StringFormat={}{0} px}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding BorderPalette}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PaletteSwatchStyle}"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Command="{Binding DataContext.PickInnerBorderColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 填充 -->
                        <TextBlock Text="填充颜色" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}" VerticalAlignment="Center"
                                    Background="{Binding BorderFillColorEditor.Hex, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="R" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderFillColorEditor.R, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="G" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderFillColorEditor.G, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="B" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderFillColorEditor.B, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="A" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderFillColorEditor.A, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="宽度" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Width="52" />
                            <Slider Width="190" Minimum="0" Maximum="128" VerticalAlignment="Center"
                                    Style="{StaticResource SliderStyle}" Value="{Binding BorderFillSize}" />
                            <TextBlock Text="{Binding BorderFillSize, StringFormat={}{0} px}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding BorderPalette}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PaletteSwatchStyle}"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Command="{Binding DataContext.PickFillColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 外边框 -->
                        <TextBlock Text="外边框颜色" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}" VerticalAlignment="Center"
                                    Background="{Binding BorderOuterColorEditor.Hex, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="R" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderOuterColorEditor.R, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="G" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderOuterColorEditor.G, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="B" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderOuterColorEditor.B, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="A" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,3,0" />
                            <TextBox Width="42" Padding="4,0" TextAlignment="Center" Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding BorderOuterColorEditor.A, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="粗细" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Width="52" />
                            <Slider Width="190" Minimum="0" Maximum="32" VerticalAlignment="Center"
                                    Style="{StaticResource SliderStyle}" Value="{Binding BorderOuterSize}" />
                            <TextBlock Text="{Binding BorderOuterSize, StringFormat={}{0} px}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding BorderPalette}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PaletteSwatchStyle}"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Command="{Binding DataContext.PickOuterBorderColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="滚轮一格（像素，20 ~ 600）" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,6" />
                        <TextBox Text="{Binding Cfg.WheelStepPixels, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" Width="110" HorizontalAlignment="Left" />

                        <TextBlock Text="单点中键 / 按住中键 的判定（毫秒，60 ~ 2000）" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,6" />
                        <TextBox Text="{Binding Cfg.MiddleHoldMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStyle}" Width="110" HorizontalAlignment="Left" />
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="按下到松开小于这个值 = 单点（锚点留下，再按任意键消失）；大于等于 = 按住（一松手锚点就消失）。" />

                        <!-- 文件关联：双击 / 右键「打开方式」直接用本工具打开这张图，并加载它所在的文件夹。
                             只写 HKCU，不需要管理员；最终用哪个程序由 Windows 的「默认应用」决定。 -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,10" />
                        <TextBlock Text="文件关联" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="把 .jpg / .jpeg / .png / .bmp / .gif / .webp / .tif / .tiff 登记到本工具：之后双击图片（或在「打开方式」里选本工具）会直接打开这张图，并加载它所在文件夹的全部图片。" />
                        <CheckBox x:Name="AssociateCheckBox" Content="关联图片后缀（双击用本工具打开）"
                                  IsChecked="{Binding IsFileAssociationEnabled}"
                                  Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding FileAssociationStatus}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="打开 Windows 默认应用设置"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenDefaultAppsCommand}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="ResetSettingsButton" Content="恢复默认设置" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ResetSettingsCommand}" Margin="0,0,8,0"
                                    ToolTip="阅读方式回到纵向、缩放 100%、边框颜色 / 粗细等全部回默认（不影响文件关联和已打开的图片）" />
                            <Button Content="关闭" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CloseSettingsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

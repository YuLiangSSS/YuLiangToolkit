<UserControl x:Class="YuLiangToolkit.Tools.Calendar.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:notify="clr-namespace:YuLiangToolkit.Core.Notifications;assembly=YuLiangToolkit.Core"
             Background="Transparent"
             Focusable="True">

    <UserControl.Resources>
        <notify:ThemeBrushNameConverter x:Key="KeyToBrush" />
    </UserControl.Resources>

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="📅 日历" FontSize="21" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Text="月视图日历：点某天选中，方向键挪一天/一周、PgUp/PgDn 换月、Home 回今天。窗口右上角的日期也是点一下就能看日历。" />
        </StackPanel>

        <!-- ===================== 主区域 ===================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：月视图 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="200" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 月份标题 + 导航 -->
                    <Grid Grid.Row="0" Margin="20,16,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding MonthTitle}" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="‹" Style="{StaticResource SecondaryButtonStyle}"
                                    Width="34" Height="30" Padding="0" FontSize="15"
                                    Command="{Binding PreviousMonthCommand}" Margin="0,0,6,0"
                                    ToolTip="上一个月（PgUp）" />
                            <Button Content="今天" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,4" Command="{Binding TodayCommand}" Margin="0,0,6,0"
                                    ToolTip="回到今天（Home）" />
                            <Button Content="›" Style="{StaticResource SecondaryButtonStyle}"
                                    Width="34" Height="30" Padding="0" FontSize="15"
                                    Command="{Binding NextMonthCommand}"
                                    ToolTip="下一个月（PgDn）" />
                        </StackPanel>
                    </Grid>

                    <!-- 表头 + 网格：整块铺满可用区域（左右上下都撑开），格子按 7×6 均分，
                         跟着窗口缩放自适应；不画灰底，只在悬停 / 选中 / 今天时给底色。 -->
                    <Grid Grid.Row="1" Margin="16,4,16,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 星期表头：与下面 7 列严格对齐（同一个 * 均分方式） -->
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding WeekHeader}" Margin="0,0,0,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Padding="0,2"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 42 格：均分整块区域（Columns/Rows 都是 * 均分，格子随窗口变大变小） -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnDayClick" Focusable="False"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Padding="0" Margin="1"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" ToolTip="{Binding ToolTip}"
                                            Tag="{Binding Date}">
                                        <Button.Template>
                                            <!-- 平常**没有任何底色**（透明），只有今天 / 选中 / 悬停才给颜色 -->
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Cell"
                                                        Background="{Binding FillKey, Converter={StaticResource KeyToBrush}}"
                                                        BorderBrush="{Binding BorderKey, Converter={StaticResource KeyToBrush}}"
                                                        BorderThickness="{Binding BorderThickness}"
                                                        CornerRadius="6" Margin="1"
                                                        SnapsToDevicePixels="True">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding DayText}"
                                                                   FontSize="13"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding ForegroundKey, Converter={StaticResource KeyToBrush}}" />
                                                        <!-- 第二行：节日 / 节气 / 农历 -->
                                                        <TextBlock Text="{Binding SubText}"
                                                                   FontSize="9.5"
                                                                   Margin="0,1,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding SubText, Converter={StaticResource EmptyToVisInverse}}"
                                                                   Foreground="{Binding SubForegroundKey, Converter={StaticResource KeyToBrush}}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Cell" Property="Background"
                                                                Value="{DynamicResource CardHoverBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 状态条 -->
                    <Grid Grid.Row="2" Margin="20,0,20,14">
                        <TextBlock Text="{Binding SelectedDateText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="calendar.日历与设置" />

            <!-- ===== 右：设置 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="设置" FontSize="14" FontWeight="SemiBold"
                               Margin="18,16,18,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                        <StackPanel Margin="18,0,18,18">

                            <CheckBox Content="每周从周一开始（关掉 = 从周日开始）"
                                      Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding Cfg.MondayFirst, Mode=TwoWay}" />
                            <CheckBox Content="周末用强调色标出" Style="{StaticResource CheckBoxStyle}"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding Cfg.HighlightWeekend, Mode=TwoWay}" />
                            <CheckBox Content="格子里显示上/下月的日期" Style="{StaticResource CheckBoxStyle}"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding Cfg.ShowDaysOfOtherMonths, Mode=TwoWay}" />
                            <CheckBox Content="第二行显示农历 / 节气（关掉 = 只显示节日与节气）"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0"
                                      IsChecked="{Binding Cfg.ShowLunar, Mode=TwoWay}" />

                            <!-- 键盘说明 -->
                            <TextBlock Text="键盘" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="←→ 挪一天&#10;↑↓ 挪一周&#10;PgUp / PgDn 换月&#10;Home 回到今天" />

                            <!-- 日志 -->
                            <TextBlock Text="运行日志" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,6" />
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     Style="{StaticResource LogTextBoxStyle}" Height="110"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     core:ScrollChaining.Enabled="True" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

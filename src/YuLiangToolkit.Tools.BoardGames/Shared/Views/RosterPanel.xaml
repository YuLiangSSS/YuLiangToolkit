<UserControl x:Class="YuLiangToolkit.Tools.BoardGames.Shared.Views.RosterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core">

    <!-- 「登场安排 / 房间成员」两张卡片（两个棋牌游戏共用；对外仍是一个 UserControl）。
         DataContext = 游戏 VM（继承 BoardGameRoomViewModelBase）；绑定名必须与基类一字不差。
         卡片 A「上场安排」：身份提示 + 两个上场席位 + 交换/清空 + 开始下一局 / 结束本局（作废）。
         卡片 B「房间成员」：成员列表（可滚动）在前，自动上场 / 补位方式设置在后。
         这样 1280×820 首屏能同时看到「房间 + 上场安排 + 谁在等上场」。 -->
    <StackPanel>

        <!-- ================= 卡片 A：上场安排 ================= -->
        <Border Style="{StaticResource CardStyle}" Padding="14,12">
            <StackPanel>
                <TextBlock Text="上场安排" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <!-- 本端身份 + 一句说明 -->
                <TextBlock Text="{Binding MyRoleText}" FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding SeatStatusText}" FontSize="10.5" Margin="0,2,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- 先手位 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SeatOneSideText}" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <!-- 房主可改：下拉选人；对局中 / 别人看：只读名字 -->
                    <ComboBox Grid.Column="1" Height="32" Style="{StaticResource ComboBoxStyle}"
                              ItemsSource="{Binding SeatOneChoices}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedSeatOneOption}"
                              Visibility="{Binding CanEditSeats, Converter={StaticResource BoolToVis}}"
                              ToolTip="选一个人坐先手位（也可以选「空位」）" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding CanEditSeats, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding SeatOneName}" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SeatOneOnlineText}" FontSize="10.5" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SeatOneOnline}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 后手位 -->
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SeatTwoSideText}" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" Height="32" Style="{StaticResource ComboBoxStyle}"
                              ItemsSource="{Binding SeatTwoChoices}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedSeatTwoOption}"
                              Visibility="{Binding CanEditSeats, Converter={StaticResource BoolToVis}}"
                              ToolTip="选一个人坐后手位（也可以选「空位」）" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding CanEditSeats, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding SeatTwoName}" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SeatTwoOnlineText}" FontSize="10.5" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SeatTwoOnline}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 交换 / 清空（房主可改席位时） -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="{Binding CanEditSeats, Converter={StaticResource BoolToVis}}">
                    <Button Content="交换座位" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                            Padding="12,3" Command="{Binding SwapSeatsCommand}"
                            ToolTip="把两个人换边（先手 ↔ 后手）" />
                    <Button Content="清空座位" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                            Padding="12,3" Margin="8,0,0,0" Command="{Binding ClearSeatsCommand}"
                            ToolTip="两个席位都空出来，等房主重新安排" />
                </StackPanel>

                <!-- 房主控制：开始下一局 / 结束本局（作废） -->
                <StackPanel Visibility="{Binding HostControlsVisible, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,8" />
                    <Button Content="{Binding StartNextGameText}" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch" Command="{Binding StartNextGameCommand}"
                            IsEnabled="{Binding CanStartNextGame}"
                            Visibility="{Binding ShowStartNextGameButton, Converter={StaticResource BoolToVis}}"
                            ToolTip="两个席位都安排上在线的选手后开始对局" />
                    <Button Content="{Binding AbortGameText}" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch" Margin="0,6,0,0" Command="{Binding AbortGameCommand}"
                            Visibility="{Binding CanAbortGame, Converter={StaticResource BoolToVis}}"
                            ToolTip="对局进行中才可作废（作废不算上场次数）" />
                </StackPanel>

                <!-- 观战提示（客户端 / 房主自己不下场时） -->
                <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="6" Padding="8,6"
                        Margin="0,9,0,0"
                        Visibility="{Binding IsSpectator, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SpectatorHintText}" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ================= 卡片 B：房间成员 + 自动轮换设置 ================= -->
        <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Text="房间成员" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding MemberCountText}" HorizontalAlignment="Right" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" ToolTip="当前人数 / 房间上限" />
                </Grid>

                <!-- 成员列表（可滚动；滚到头把滚轮交给外层页面） -->
                <ListBox ItemsSource="{Binding Members}" MaxHeight="170" Margin="0,8,0,0"
                         Background="Transparent" BorderThickness="0" Focusable="False"
                         core:ScrollChaining.Enabled="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="2,2" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding NameText}" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RoleText}" FontSize="10.5" Margin="8,1,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SeatText}" FontSize="10.5" Margin="8,1,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding GamesPlayedText}" FontSize="10.5" Margin="8,1,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OnlineText}" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 自动轮换设置（只有房主能改） -->
                <StackPanel Visibility="{Binding HostControlsVisible, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,9,0,8" />

                    <TextBlock Text="自动上场" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox Height="32" Margin="0,4,0,0" Style="{StaticResource ComboBoxStyle}"
                              ItemsSource="{Binding AutoRotateModeOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedAutoRotateMode}"
                              ToolTip="一局结束后怎么换人" />

                    <Grid Margin="0,6,0,0" Visibility="{Binding AutoRotateEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="补位方式" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" Height="32" Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding AutoPickModeOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedAutoPickMode}"
                                  ToolTip="从没上场的人里怎么挑" />
                    </Grid>

                    <TextBlock Text="{Binding AutoRotateHintText}" FontSize="10.5" Margin="0,5,0,0"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

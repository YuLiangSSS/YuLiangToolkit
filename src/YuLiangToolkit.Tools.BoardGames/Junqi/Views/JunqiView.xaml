<UserControl x:Class="YuLiangToolkit.Tools.BoardGames.Junqi.Views.JunqiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.BoardGames.Junqi.Views"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent">

    <!-- 军棋：左「棋盘」/ 右「房间 + 规则」。棋盘与侧栏可左右拖。 -->

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎖️" FontSize="24" VerticalAlignment="Center" />
                <TextBlock Text="军棋" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MoveCountText}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding VariantDescriptionText}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" MinWidth="290" />
            </Grid.ColumnDefinitions>

            <!-- 棋盘 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="240" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="16,12,16,8">
                        <Button Content="自动布阵" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88"
                                Command="{Binding AutoDeployCommand}" />
                        <Button Content="开始对局" Style="{StaticResource SecondaryButtonStyle}" MinWidth="88" Margin="8,0,0,0"
                                Command="{Binding StartGameCommand}" />
                        <Button Content="认输" Style="{StaticResource SecondaryButtonStyle}" MinWidth="66" Margin="8,0,0,0"
                                Command="{Binding ResignCommand}" />
                        <Button Content="重开" Style="{StaticResource SecondaryButtonStyle}" MinWidth="66" Margin="8,0,0,0"
                                Command="{Binding ResetCommand}" />
                        <Button Content="四方自动布阵" Style="{StaticResource PrimaryButtonStyle}" MinWidth="104" Margin="8,0,0,0"
                                Command="{Binding FourDeployCommand}"
                                Visibility="{Binding IsFourKingdoms, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ResultText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding ResultText, Converter={StaticResource EmptyToVisInverse}}" />
                    </WrapPanel>

                    <Border Grid.Row="1" Background="{DynamicResource InputBackgroundBrush}" ClipToBounds="True">
                        <Grid>
                            <!-- 二人军棋棋盘 -->
                            <views:JunqiBoardView x:Name="BoardArea"
                                                  State="{Binding Cells}"
                                                  Visibility="{Binding IsFourKingdoms, Converter={StaticResource InverseBoolToVis}}"
                                                  BoardBrush="{DynamicResource InputBackgroundBrush}"
                                                  RailBrush="{DynamicResource TextSecondaryBrush}"
                                                  RoadBrush="{DynamicResource BorderBrush}"
                                                  CampBrush="{DynamicResource CardBackgroundBrush}"
                                                  TextBrush="{DynamicResource TextPrimaryBrush}" />

                            <!-- 四国军棋棋盘（13×13） -->
                            <views:JunqiFourBoardView x:Name="FourBoardArea"
                                                  State="{Binding FourCells}"
                                                  Visibility="{Binding IsFourKingdoms, Converter={StaticResource BoolToVis}}"
                                                  BoardBrush="{DynamicResource InputBackgroundBrush}"
                                                  RailBrush="{DynamicResource TextSecondaryBrush}"
                                                  RoadBrush="{DynamicResource BorderBrush}"
                                                  CampBrush="{DynamicResource CardBackgroundBrush}"
                                                  TextBrush="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="junqi.棋盘与侧栏" />

            <!-- 侧栏 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          core:ScrollChaining.Enabled="True">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="房间" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ModeBadgeText}" HorizontalAlignment="Right" FontSize="11.5"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModeBadgeBrushKey}" Value="SuccessBrush">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <StackPanel Visibility="{Binding CanJoin, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="玩家名" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="端口" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding ListenPortText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextBoxStyle}" />
                                    <TextBlock Grid.Column="2" Text="0 = 自动挑" VerticalAlignment="Center" FontSize="10"
                                               Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                                <Button Content="开房间" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" Command="{Binding StartHostCommand}" />
                                <TextBox Text="{Binding JoinAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" Margin="0,8,0,0"
                                         ToolTip="对方发来的地址，例如 192.168.1.5:5310" />
                                <Button Content="加入房间" Style="{StaticResource PrimaryButtonStyle}" Margin="0,6,0,0"
                                        HorizontalAlignment="Stretch" Command="{Binding JoinRoomCommand}" />
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0" Visibility="{Binding CanLeave, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SeatSummaryText}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ItemsControl ItemsSource="{Binding ShareAddresses}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" FontSize="11.5" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Content="复制" Style="{StaticResource SecondaryButtonStyle}"
                                                        FontSize="11" Padding="8,2"
                                                        Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="离开房间" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" Command="{Binding LeaveRoomCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding NoticeText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 玩法 / 换人 -->
                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="玩法" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding VariantOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedVariant}" Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,8,0,0" IsEnabled="{Binding CanJoin}" />
                            <TextBlock Text="{Binding VariantDescriptionText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,12,0,0"
                            Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="换人方式（房主设置）" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding AutoRotateOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedAutoRotate}" Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="{Binding AutoRotateHintText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding AutoPickOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedAutoPick}" Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="电脑对手" FontSize="13" FontWeight="SemiBold" />
                                <CheckBox Content="单机时对面由电脑接管" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" FontSize="11"
                                          IsChecked="{Binding AiEnabled}" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding AiDifficultyOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedAiDifficulty}" Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,8,0,0" IsEnabled="{Binding AiEnabled}" />
                            <TextBlock Text="{Binding AiDifficultyHint}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding AiOpponentText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="规则速查" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock FontSize="10.5" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="司令 &gt; 军长 &gt; 师长 &gt; 旅长 &gt; 团长 &gt; 营长 &gt; 连长 &gt; 排长 &gt; 工兵；同级同归于尽。炸弹碰谁都同归于尽；地雷只有工兵能排；军旗被碰即输。铁路可走多格，工兵能在铁路上拐弯；行营里的棋子不能被吃；大本营里的棋子不能再动。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="YuLiangToolkit.Tools.BoardGames.Xiangqi.Views.XiangqiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             xmlns:shared="clr-namespace:YuLiangToolkit.Tools.BoardGames.Shared.Views"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.BoardGames.Xiangqi.Views"
             Background="Transparent">

    <!-- 「联机中国象棋」界面。整体一页（外层 ScrollViewer），布局：
         标题行 → 左棋盘卡 + 右侧栏（摆棋与让子 → 房间 → 成员/席位 → 对局 → 设置 + 房间聊天）→ 下方跨列棋谱。
         布局（可拖拽；v0.41.0 起 / v0.42.0 补齐所有区块缝隙，每两块各有一条缝、不共用）：
           ① 主体内部「棋盘 | 侧栏」是竖分隔条（左右拖）；
           ② 侧栏内部「信息区 | 聊天」是横分隔条（上下拖）；
           ③ 页面级「主体（棋盘 + 侧栏）| 棋谱」是横分隔条（上下拖）。
         拖动即调大小（悬停亮蓝线 + ↔ / ↕ 光标），松手自动记住（Config\layout.json），
         双击分隔条只恢复这一处；全部恢复默认：主页设置 →「界面布局 → 恢复默认布局」。
         约定见 docs/dev/layout.md。
         ⚠ 外层是 ScrollViewer：卡片内部不要用 Height="*" 的行；可上下拖的两块用固定像素行
         （拖完页面总高度会变、外层自己出滚动条）；侧栏信息区内部自己滚动；棋盘用 Viewbox 缩放；
         棋盘卡里的按钮不能被折叠线裁掉。 -->
    <ScrollViewer x:Name="OuterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RootPanel" Margin="28,22,28,26">

            <!-- ============ 标题行 ============ -->
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🀄" FontSize="24" VerticalAlignment="Center" />
                    <TextBlock Text="联机中国象棋" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"
                            Padding="9,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeBadgeText}" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModeBadgeBrushKey}" Value="SuccessBrush">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ModeBadgeBrushKey}" Value="DangerBrush">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding MyRoleText}" FontSize="12" Margin="14,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="自由摆棋 · 让子 / 让先 · 多人观战 · 房主安排上场 · 中文记谱 · 悔棋 / 认输 / 求和 / 断线自动重连" />
            </StackPanel>

            <!-- ============ 页面级上下两块：主体（上）/ 棋谱（下） ============ -->
            <Grid Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="908" MinHeight="620" />   <!-- 主体（棋盘 + 侧栏；拖动时与棋谱此消彼长） -->
                    <RowDefinition Height="12" />                    <!-- 主体 / 棋谱 分隔条独占一行 -->
                    <RowDefinition Height="260" MinHeight="180" />   <!-- 棋谱（拖动改高矮；列表跟着伸缩） -->
                </Grid.RowDefinitions>

            <!-- ============ 主体：左棋盘 + 右侧栏（左右可拖） ============
                 ClipToBounds：把页面级分隔条往上拖、把主体拖得比棋盘卡还矮时，卡片被裁在主体行内，
                 不会溢到下面的分隔条 / 棋谱上（拖回去就恢复）。 -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />     <!-- 左：棋盘（随窗口缩放、吸收宽度变化） -->
                    <ColumnDefinition Width="12" />                  <!-- 棋盘 / 侧栏 分隔条独占一列 -->
                    <ColumnDefinition Width="392" MinWidth="300" />   <!-- 右：侧栏（固定宽度、可拖） -->
                </Grid.ColumnDefinitions>

                <!-- ===== 左：棋盘卡（轮次 / 手数 / 结果 / 将军 / 操作按钮都压在这张卡里） ===== -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding TurnText}" FontSize="13.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding CheckText}" FontSize="12" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding CheckText, Converter={StaticResource EmptyToVisInverse}}" />
                        </Grid>

                        <!-- 棋盘固定设计尺寸 500×565，用 Viewbox 按可用空间缩放（大窗口放大、小窗口缩小）：
                             上限 637×720 —— 既让棋盘填满左侧卡（1500 宽时约 637×720，不再两边空一大片），
                             又让整张棋盘卡和右侧栏（默认信息区 596 + 12 + 聊天 300）高度接近，两栏不会一边一大片空白。 -->
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center"
                                 MaxWidth="637" MaxHeight="720" Margin="0,8,0,0">
                            <views:XiangqiBoardView x:Name="BoardView" Width="500" Height="565"
                                                    State="{Binding BoardState}"
                                                    Flipped="{Binding IsFlipped}"
                                                    Interactive="{Binding IsBoardInteractive}" />
                        </Viewbox>

                        <!-- 棋盘朝向：观战 → 观战视角下拉；坐席玩家 → 说明文字（自动跟随所执一方）；
                             同机双人 / 离线 → 手动「翻转棋盘」。 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MoveCountText}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ResultText}" FontSize="11.5" FontWeight="SemiBold"
                                           Margin="12,0,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Visibility="{Binding ResultText, Converter={StaticResource EmptyToVisInverse}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Width="152" Height="30" Style="{StaticResource ComboBoxStyle}"
                                          ItemsSource="{Binding SpectatorViewOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedSpectatorViewSide}"
                                          Visibility="{Binding ShowSpectatorViewOption, Converter={StaticResource BoolToVis}}"
                                          ToolTip="观战视角：红方在下 / 黑方在下（会记住）" />
                                <TextBlock Text="{Binding ViewSideHintText}" FontSize="11" TextWrapping="Wrap"
                                           VerticalAlignment="Center" MaxWidth="220"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding ViewSideHintText, Converter={StaticResource EmptyToVisInverse}}" />
                                <Button Content="翻转棋盘" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4" FontSize="11.5" VerticalAlignment="Center"
                                        Command="{Binding FlipBoardCommand}"
                                        Visibility="{Binding ShowManualFlipButton, Converter={StaticResource BoolToVis}}"
                                        ToolTip="同机双人 / 离线时可手动翻转棋盘" />
                            </StackPanel>
                        </Grid>

                        <!-- 操作按钮：压进棋盘卡，首屏不会被裁掉；观战 / 离线时整排隐藏。
                             「再来一局」只有同机双人 / 联机坐席客户端玩家可见；房主用 RosterPanel 的「开始下一局」。 -->
                        <WrapPanel Margin="0,8,0,0" Orientation="Horizontal"
                                   Visibility="{Binding ShowPlayerActions, Converter={StaticResource BoolToVis}}">
                            <Button Content="悔棋" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                                    Margin="0,0,8,8" Padding="10,5"
                                    Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                                    ToolTip="同机双人直接撤；联机需要对手 / 房主同意" />
                            <Button Content="认输" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                                    Margin="0,0,8,8" Padding="10,5"
                                    Command="{Binding ResignCommand}" IsEnabled="{Binding CanResign}"
                                    ToolTip="联机时由房主判负并广播" />
                            <Button Content="求和" Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                                    Margin="0,0,8,8" Padding="10,5"
                                    Command="{Binding OfferDrawCommand}" IsEnabled="{Binding CanOfferDraw}"
                                    ToolTip="联机时请对手 / 房主同意和棋" />
                            <Button Content="{Binding RematchButtonText}" Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="12" Margin="0,0,8,8" Padding="10,5"
                                    Command="{Binding RematchCommand}" IsEnabled="{Binding CanRematch}"
                                    Visibility="{Binding ShowRematchButton, Converter={StaticResource BoolToVis}}"
                                    ToolTip="同机双人：直接重开；联机客户端玩家：请求房主开始下一局" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 棋盘 / 侧栏 分隔条：左右拖动改棋盘区与右侧栏的宽度（双击恢复这一处） -->
                <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                                   Key="xiangqi.棋盘与侧栏" />

                <!-- ===== 右栏：上部信息区（摆棋 / 房间 / 成员 / 对局 / 设置）+ 下部聊天 =====
                     摆棋卡在未开局时排最上面；信息区与聊天之间是横分隔条：上下拖即可改两块的高矮。
                     信息区用 * 行、聊天固定 300：页面级分隔条把主体拖高/拖矮时由信息区吸收，
                     聊天高度保持不变。默认信息区 = 908−12−300 = 596 ≈「摆棋与让子」卡（约 587）
                     刚好整张露完，裁切线落在两张卡之间的空隙里、不会把下一张「房间」卡切一半；
                     内容更多时信息区自己滚动。 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="280" />     <!-- 信息区（拖动时与聊天此消彼长） -->
                        <RowDefinition Height="12" />                    <!-- 信息区 / 聊天 分隔条独占一行 -->
                        <RowDefinition Height="300" MinHeight="220" />   <!-- 聊天（拖动改高矮） -->
                    </Grid.RowDefinitions>

                    <!-- 信息区（* 行）里的内容自己滚动，滚到头再交给整页（ScrollChaining） -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  core:ScrollChaining.Enabled="True">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 房间（共享面板：开房 / 加入 / 地址分享 / 离开；房间聊天在信息区下方的横分隔条下面） -->
                    <shared:RoomPanel Grid.Row="1" Margin="0,12,0,0" />

                    <!-- 成员 / 席位 / 房主安排上场 / 自动轮换（共享面板；开始对局只在这里） -->
                    <shared:RosterPanel Grid.Row="2" Margin="0,12,0,0" />

                    <!-- ===== 对局 ===== -->
                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="对局" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ModeBadgeText}" HorizontalAlignment="Right"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <!-- 断线 / 对局暂停（红底状态块，基类统一维护） -->
                            <Border Background="#3A1F22" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                    Visibility="{Binding IsGamePaused, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding GamePauseStatusText}" FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="{Binding ReconnectStatusText}" FontSize="10.5" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding TurnText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding CheckText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding CheckText, Converter={StaticResource EmptyToVisInverse}}" />
                            <TextBlock Text="{Binding ResultText}" FontSize="12.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SuccessBrush}"
                                       Visibility="{Binding ResultText, Converter={StaticResource EmptyToVisInverse}}" />
                            <TextBlock Text="{Binding SeatStatusText}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 摆棋与让子（未开局时是主操作，排右栏最上面；开局后收起成一行摘要） ===== -->
                    <Border x:Name="SetupCardBorder" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0"
                            Visibility="{Binding ShowSetupCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="摆棋与让子" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SetupSummaryText}" HorizontalAlignment="Right"
                                           FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="240"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <!-- 展开态（未开局 / 主动重新摆棋）：调色板 + 让子 + 让先 -->
                            <StackPanel Visibility="{Binding ShowSetupControls, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding IsSetupAllowed}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="默认开局" Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Command="{Binding ApplyDefaultSetupCommand}"
                                            ToolTip="一键恢复标准象棋布局（红方在下、黑方在上）" />
                                    <Button Grid.Column="2" Content="清空棋盘" Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Command="{Binding ClearSetupCommand}"
                                            ToolTip="清空后可以从调色板自由摆子" />
                                </Grid>

                                <TextBlock Text="调色板：选一枚棋子，再点棋盘落子（选「删」再点 = 删掉那格）"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,12,0,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ListBox ItemsSource="{Binding PaletteItems}" SelectedItem="{Binding SelectedPalette}"
                                         Background="Transparent" BorderThickness="0" Focusable="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,6,6" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Chip" Width="42" Height="38" CornerRadius="6"
                                                                Background="{DynamicResource InputBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chip" Property="Background"
                                                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Chip" Property="BorderBrush"
                                                                        Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="Chip" Property="Background"
                                                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayChar}" FontSize="18" FontWeight="Bold"
                                                       ToolTip="{Binding ToolTip}" FontFamily="Microsoft YaHei">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRed}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDelete}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="让子方" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" Height="32" Style="{StaticResource ComboBoxStyle}"
                                              ItemsSource="{Binding HandicapGiverOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedHandicapGiver}"
                                              ToolTip="从哪一方去掉被让的棋子" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HandicapPresets}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}" Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,6,6" Padding="10,5" FontSize="12"
                                                    ToolTip="{Binding Description}"
                                                    Command="{Binding DataContext.ApplyHandicapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="让先步数" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="5" TickFrequency="1"
                                            IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                            Style="{StaticResource SliderStyle}"
                                            Value="{Binding OpeningFreeMoves, Mode=TwoWay}"
                                            ToolTip="被让方（让子方的对面）开局可以连走几步；0 = 不让先" />
                                </Grid>
                                <TextBlock Text="{Binding OpeningFreeMovesText}" FontSize="10.5" TextWrapping="Wrap"
                                           Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="房主默认坐席" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" Height="32" Style="{StaticResource ComboBoxStyle}"
                                              ItemsSource="{Binding HostSideOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedHostSide}"
                                              IsEnabled="{Binding CanEditPreferredSeat}"
                                              ToolTip="房主开房时默认坐先手位（红）或后手位（黑）；进房间后不能改，下次开房生效" />
                                </Grid>

                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"
                                        Padding="10,8" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SetupStatusText}" FontSize="11.5" TextWrapping="Wrap"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSetupError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SetupFenText}" FontFamily="Consolas" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Button Content="{Binding ApplySetupAndStartText}" Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                        Command="{Binding ApplySetupAndStartCommand}"
                                        Visibility="{Binding ShowApplySetupButton, Converter={StaticResource BoolToVis}}"
                                        ToolTip="离线 / 同机双人：用当前摆棋开一局；联机时由右侧「房间成员」里的开始按钮开局" />
                            </StackPanel>

                            <!-- 收起态（对局进行中 / 已结束）：一行摘要 + 重新摆棋（二次确认） -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding ShowSetupCollapsedSummary, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SetupSummaryText}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Content="重新摆棋（会结束本局）" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,8,0,0" HorizontalAlignment="Stretch" FontSize="12" Padding="6,5"
                                        Command="{Binding RequestRestartSetupCommand}"
                                        Visibility="{Binding ShowRestartSetupButton, Converter={StaticResource BoolToVis}}"
                                        ToolTip="结束当前对局并回到摆棋（会先问一次）" />
                                <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding CanRestartSetup, Converter={StaticResource InverseBoolToVis}}"
                                           Text="联机对局中摆棋已锁定；房主可在右侧「房间成员」里点「结束本局（作废）」后重新摆棋。" />

                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding IsRestartSetupConfirming, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="确定结束当前对局、重新摆棋吗？" FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="确定结束" Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Stretch" FontSize="12" Padding="6,6"
                                                Command="{Binding ConfirmRestartSetupCommand}" />
                                        <Button Grid.Column="2" Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Stretch" FontSize="12" Padding="6,6"
                                                Command="{Binding CancelRestartSetupCommand}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== 设置 ===== -->
                    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Content="走法提示" Style="{StaticResource CheckBoxStyle}"
                                          IsChecked="{Binding ShowLegalMoves}"
                                          ToolTip="选中棋子时高亮它可以走的点" />
                                <CheckBox Grid.Column="2" Content="最后一步" Style="{StaticResource CheckBoxStyle}"
                                          IsChecked="{Binding ShowLastMove}"
                                          ToolTip="标记上一步的起点与终点" />
                                <CheckBox Grid.Row="2" Content="显示坐标" Style="{StaticResource CheckBoxStyle}"
                                          IsChecked="{Binding ShowCoordinates}" />
                            </Grid>
                            <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="棋子朝向会跟随你所执的一方（执红红在下、执黑黑在下）；观战可在棋盘下方切换红 / 黑视角，同机双人与离线可手动翻转。" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    </ScrollViewer>

                    <!-- 信息区 / 聊天 分隔条：上下拖动改两块高度（双击恢复这一处） -->
                    <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                       Key="xiangqi.侧栏信息与聊天" />

                    <!-- 房间聊天（共享面板；固定行里聊天记录放 * 行，拖分隔条时记录区跟着变高矮） -->
                    <shared:ChatPanel Grid.Row="2" />
                </Grid>
            </Grid>

            <!-- 主体 / 棋谱 分隔条：上下拖动改「棋盘 + 侧栏」与「棋谱」的高度（双击恢复这一处） -->
            <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                               Key="xiangqi.主体与棋谱" />

            <!-- ============ 棋谱（页面级块，跨两列；内容多时列表自己滚动） ============ -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />              <!-- 标题 + 复制 -->
                        <RowDefinition Height="*" MinHeight="96" />  <!-- 棋谱列表（伸缩，MinHeight 兜底） -->
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="棋谱（中文记谱）" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Content="复制棋谱" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                                HorizontalAlignment="Right" Command="{Binding CopyNotationCommand}" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding MoveLines}" MinHeight="96" Margin="0,10,0,0"
                             Background="Transparent" BorderThickness="0" Focusable="False"
                             core:ScrollChaining.Enabled="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="Margin" Value="10,1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="{DynamicResource CardHoverBackgroundBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" FontFamily="Microsoft YaHei" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

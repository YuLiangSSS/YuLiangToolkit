<UserControl x:Class="YuLiangToolkit.Tools.BoardGames.Go.Views.GoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YuLiangToolkit.Tools.BoardGames.Go.Views"
             xmlns:shared="clr-namespace:YuLiangToolkit.Tools.BoardGames.Shared.Views"
             xmlns:core="clr-namespace:YuLiangToolkit.Core.Mvvm;assembly=YuLiangToolkit.Core"
             Background="Transparent">

    <!-- 围棋：左「棋盘 + 对局操作」/ 右「房间 + 成员 + 设置 + 聊天」。
         房间 / 成员 / 聊天复用棋牌共享面板（联机、观战、房主安排上场、自动换人都走同一套）。 -->

    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="360" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚫" FontSize="24" VerticalAlignment="Center" />
                <TextBlock Text="围棋" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusBadgeText}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="{Binding MySideText}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding NoticeText}" FontSize="11.5" Margin="14,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 左：棋盘 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TurnText}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MoveCountText}" FontSize="12" Margin="14,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CaptureText}" FontSize="12" Margin="14,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ResultText}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"
                                   TextWrapping="Wrap" MaxWidth="260"
                                   Visibility="{Binding ResultText, Converter={StaticResource EmptyToVisInverse}}" />
                    </Grid>

                    <!-- 棋盘填满剩余空间（不撑高整页，按钮条永远在屏幕内） -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <views:GoBoardView x:Name="Board" Width="620" Height="620"
                                           State="{Binding Cells}"
                                           BoardSize="{Binding Cfg.BoardSize}"
                                           BoardBrush="#E3B778"
                                           LineBrush="#3A2A16" />
                    </Viewbox>

                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="停一手" Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" Margin="0,0,8,0"
                                Command="{Binding PassCommand}" IsEnabled="{Binding CanPlayNow}" />
                        <Button Content="悔棋" Style="{StaticResource SecondaryButtonStyle}" MinWidth="66" Margin="0,0,8,0"
                                Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
                        <Button Content="数子" Style="{StaticResource SecondaryButtonStyle}" MinWidth="66" Margin="0,0,8,0"
                                Command="{Binding ScoreCommand}" IsEnabled="{Binding CanScore}" />
                        <Button Content="认输" Style="{StaticResource SecondaryButtonStyle}" MinWidth="66" Margin="0,0,8,0"
                                Command="{Binding ResignCommand}" IsEnabled="{Binding CanResignPlay}" />
                        <Button Content="新开一局" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" Margin="0,0,8,0"
                                Command="{Binding StartLocalCommand}" />
                        <Button Content="复制棋谱" Style="{StaticResource SecondaryButtonStyle}" MinWidth="80" Margin="0,0,8,0"
                                Command="{Binding CopyMovesCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <core:PaneSplitter Grid.Column="1" Style="{StaticResource PaneSplitterVerticalStyle}"
                               Key="go.棋盘与侧栏" />

            <!-- 右：房间 / 成员 / 设置 / 聊天 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="240" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="260" MinHeight="160" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              core:ScrollChaining.Enabled="True">
                    <StackPanel>
                        <shared:RoomPanel />
                        <shared:RosterPanel Margin="0,12,0,0" />

                        <!-- 设置 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="棋盘" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" Height="30" Margin="10,0,0,0"
                                              Style="{StaticResource ComboBoxStyle}" DisplayMemberPath="Label"
                                              ItemsSource="{Binding BoardSizeOptions}"
                                              SelectedItem="{Binding SelectedBoardSize}"
                                              IsEnabled="{Binding CanJoin}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="贴目" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" Height="30" Margin="10,0,0,0"
                                              Style="{StaticResource ComboBoxStyle}" DisplayMemberPath="Label"
                                              ItemsSource="{Binding KomiOptions}"
                                              SelectedItem="{Binding SelectedKomi}"
                                              IsEnabled="{Binding CanJoin}" />
                                </Grid>

                                <!-- 电脑对手 -->
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6"
                                        Padding="10,8" Margin="0,10,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="电脑对手" FontSize="12" FontWeight="SemiBold" />
                                            <CheckBox Content="开" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      IsChecked="{Binding AiEnabled}"
                                                      ToolTip="开：同机模式下你执黑与电脑下（电脑执白）" />
                                        </Grid>
                                        <ComboBox Height="30" Margin="0,8,0,0" Style="{StaticResource ComboBoxStyle}"
                                                  DisplayMemberPath="Label"
                                                  ItemsSource="{Binding AiDifficultyOptions}"
                                                  SelectedItem="{Binding SelectedAiDifficulty}"
                                                  IsEnabled="{Binding AiEnabled}" />
                                        <TextBlock Text="{Binding AiDifficultyHint}" FontSize="10.5" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding AiOpponentText}" FontSize="10.5" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="规则：提子 / 禁自杀 / 禁打劫（不能立刻回提）· 双方连续停一手即终局 · 中国规则数子（白方加贴目）。联机时不能悔棋（会不同步）。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <core:PaneSplitter Grid.Row="1" Style="{StaticResource PaneSplitterHorizontalStyle}"
                                   Key="go.侧栏信息与聊天" />

                <shared:ChatPanel Grid.Row="2" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>

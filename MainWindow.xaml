<Window x:Class="YuLiangToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:YuLiangToolkit.App.Views"
        xmlns:core="clr-namespace:YuLiangToolkit.Core.Controls;assembly=YuLiangToolkit.Core"
        Title="YuLiang 工具集"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual">
    <!-- 自定义窗口框架：CaptionHeight=0（整窗为客户区，窗口按钮必然可点），
         标题栏拖拽/双击最大化由代码手动处理；边缘缩放仍由 ResizeBorderThickness 提供 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- 全屏时这几行的高度会被代码改成 0（藏掉标题栏 / 工具条 / 状态栏），退出全屏再还原 -->
            <RowDefinition x:Name="TitleRow" Height="40" />
            <RowDefinition x:Name="ToolbarRow" Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（手动拖拽 + 双击最大化） -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}"
                MouseLeftButtonDown="OnTitleBarMouseLeftDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="🧰" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="YuLiang 工具集" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="WindowButtonsPanel" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}"
                            Content="&#xE921;" Click="OnMinimizeClick" ToolTip="最小化" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}"
                            Content="&#xE922;" Click="OnMaximizeClick" ToolTip="最大化 / 还原" />
                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                            Content="&#xE8BB;" Click="OnCloseClick" ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具条：浏览器式「← 后退 / → 前进」+ 可点击分层面包屑（主页 > 类别 > … > 工具） -->
        <Border Grid.Row="1" Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 后退 / 前进：按「访问顺序」在主页 / 类别页 / 工具页之间跳，和浏览器一样；
                     没有可回退 / 前进的页面时按钮变灰（IsEnabled 绑 CanGoBack / CanGoForward）。
                     全屏时整行被藏掉，逻辑不受影响 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="←" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}"
                            Width="34" Height="30" Padding="0" FontSize="15" Margin="0,0,6,0"
                            ToolTip="后退：回到上一个页面（主页 / 类别页 / 工具页都算）" />
                    <Button Content="→" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}"
                            Width="34" Height="30" Padding="0" FontSize="15"
                            ToolTip="前进：回到后退之前所在的页面" />
                </StackPanel>

                <!-- 面包屑：祖先项可点（标签芯片样式），当前项高亮且不可点 -->
                <ScrollViewer Grid.Column="1" VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="›" FontSize="14" Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}" />
                                    <!-- 祖先层级：点一下跳回去 -->
                                    <Button Content="{Binding DisplayText}" Style="{StaticResource TagChipButtonStyle}"
                                            Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsClickable, Converter={StaticResource BoolToVis}}" />
                                    <!-- 当前项：高亮、不可点 -->
                                    <Border Background="#1D2735" BorderBrush="#2C3B52" BorderThickness="1"
                                            CornerRadius="11" Padding="10,4"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding DisplayText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 主体：侧边栏 + 内容 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- 全屏时把它改成 0，把侧边栏让出去 -->
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="功能列表" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="22,16,0,8" />
                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                             Style="{StaticResource SidebarListStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Emoji}" FontSize="15" Width="26" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />

            <!-- 左下角迷你播放条：开着「后台播放」切到别的页面时浮出来。
                 它的 DataContext 是那个后台工具的 ViewModel（不是 MainViewModel），
                 所以“显示与否”要绕回 Window 的 DataContext 取。 -->
            <views:MiniPlayerPanel Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                   Margin="12,0,0,12" Panel.ZIndex="20"
                                   DataContext="{Binding MiniPanelSource}"
                                   Visibility="{Binding DataContext.MiniPanelVisible,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,7">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <!-- 鼠标粒子覆盖层：铺满整个窗口（含标题栏 / 状态栏），不吃鼠标事件。
             IsActive 绑主页设置里的 ParticlesEnabled（默认开，存 Config\shell\config.json）；
             自定义颜色：总开关 + 两种颜色 + 各自是否启用（只启用一种 = 单色粒子），见 2.16。 -->
        <core:ParticleOverlay Grid.RowSpan="4" Panel.ZIndex="900"
                              IsHitTestVisible="False"
                              IsActive="{Binding ParticlesEnabled}"
                              UseCustomColors="{Binding ParticleCustomColorsEnabled}"
                              Color1="{Binding ParticleColor1Value}"
                              Color2="{Binding ParticleColor2Value}"
                              UseColor1="{Binding ParticleColor1Enabled}"
                              UseColor2="{Binding ParticleColor2Enabled}" />
    </Grid>
</Window>

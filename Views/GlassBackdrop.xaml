<UserControl x:Class="YuLiangToolkit.App.Views.GlassBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" ClipToBounds="True"
             UseLayoutRounding="True">
    <!--
      半透明界面风格的**窗口背景层**（v0.43.0，由原来的 LiquidBackdrop 升级而来）。

      用量：放在 MainWindow 的 RootGrid 最底层、铺满四行（标题栏 / 工具条 / 主体 / 状态栏），
      只有半透明风格（液态玻璃 / 毛玻璃 / 亚克力）才显示；默认深色风格下 Visibility=Collapsed，
      代码后置也会停掉动画（见 GlassBackdrop.xaml.cs）。

      从下往上叠六层：
        ① 底色：BackdropBaseBrush（每套主题一个渐变；没背景图时就是“舞台”）；
        ② 背景图：用户在「主页设置 → 背景图」里选的图片，铺满窗口 / 完整显示两种铺法都不拉伸；
        ③ 压暗层：BackdropImageScrimBrush（背景图亮的时候也保证白字读得清）；
        ④ 颗粒层：BackdropNoiseBrush（亚克力 = 细噪点，其它主题 = 透明）；
        ⑤ 流动光晕：液态玻璃专属的彩色光斑（其它主题隐藏；不可见时动画会停，不白跑 CPU）；
        ⑥ 顶部柔光 + 暗角：给玻璃“接光 / 有厚度”的感觉（三套半透明风格共用）。

      ⚠ 刻意**不用大范围高斯模糊动画**：只有静态的背景图会按主题加 BlurEffect（毛玻璃重、亚克力轻、
        液态玻璃不模糊），且用 BitmapCache 缓存结果；光晕动画只动 TranslateTransform / Opacity（最便宜）。
    -->
    <UserControl.Resources>
        <!-- 云间天上：平底云朵轮廓（Viewbox 缩放，纯色填充，靠不同大小 / 明度做层次） -->
        <PathGeometry x:Key="CloudShape"
                      Figures="M0,44 C0,26 14,14 32,14 C38,2 54,-4 70,0 C80,-12 104,-12 116,2 C134,-4 152,6 154,24 C170,26 180,36 180,44 Z" />

        <!-- 云间天上：星星用固定像素的平铺画刷，窗口怎么拉都不会变形 / 变大 -->
        <DrawingBrush x:Key="StarFieldBrush" TileMode="Tile" Stretch="None"
                      Viewport="0,0,220,160" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#E9F1FF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="18,22" RadiusX="1.2" RadiusY="1.2" />
                                <EllipseGeometry Center="86,60" RadiusX="0.8" RadiusY="0.8" />
                                <EllipseGeometry Center="150,30" RadiusX="1.4" RadiusY="1.4" />
                                <EllipseGeometry Center="196,110" RadiusX="0.9" RadiusY="0.9" />
                                <EllipseGeometry Center="42,132" RadiusX="1.1" RadiusY="1.1" />
                                <EllipseGeometry Center="118,140" RadiusX="0.7" RadiusY="0.7" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D9FFF4D6">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="55,88" RadiusX="1.6" RadiusY="1.6" />
                                <EllipseGeometry Center="170,72" RadiusX="1.8" RadiusY="1.8" />
                                <EllipseGeometry Center="112,18" RadiusX="1.3" RadiusY="1.3" />
                                <EllipseGeometry Center="202,42" RadiusX="1" RadiusY="1" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Storyboard x:Key="AmbientStoryboard">
            <!-- 蓝色大光斑：缓慢左右上下漂 + 呼吸 -->
            <DoubleAnimation Storyboard.TargetName="BlueMove" Storyboard.TargetProperty="X"
                             From="0" To="150" Duration="0:0:38" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlueMove" Storyboard.TargetProperty="Y"
                             From="0" To="96" Duration="0:0:47" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobBlue" Storyboard.TargetProperty="Opacity"
                             From="0.62" To="0.92" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 紫色光斑 -->
            <DoubleAnimation Storyboard.TargetName="VioletMove" Storyboard.TargetProperty="X"
                             From="0" To="-130" Duration="0:0:44" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="VioletMove" Storyboard.TargetProperty="Y"
                             From="0" To="120" Duration="0:0:35" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobViolet" Storyboard.TargetProperty="Opacity"
                             From="0.5" To="0.78" Duration="0:0:31" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 青色光斑 -->
            <DoubleAnimation Storyboard.TargetName="CyanMove" Storyboard.TargetProperty="X"
                             From="0" To="120" Duration="0:0:29" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="CyanMove" Storyboard.TargetProperty="Y"
                             From="0" To="-90" Duration="0:0:33" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobCyan" Storyboard.TargetProperty="Opacity"
                             From="0.46" To="0.72" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 品红光斑 -->
            <DoubleAnimation Storyboard.TargetName="PinkMove" Storyboard.TargetProperty="X"
                             From="0" To="-90" Duration="0:0:41" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="PinkMove" Storyboard.TargetProperty="Y"
                             From="0" To="80" Duration="0:0:27" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobPink" Storyboard.TargetProperty="Opacity"
                             From="0.4" To="0.65" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 青绿光斑 -->
            <DoubleAnimation Storyboard.TargetName="TealMove" Storyboard.TargetProperty="X"
                             From="0" To="80" Duration="0:0:26" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="TealMove" Storyboard.TargetProperty="Y"
                             From="0" To="-110" Duration="0:0:37" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobTeal" Storyboard.TargetProperty="Opacity"
                             From="0.32" To="0.55" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 琥珀色光斑：给画面一点暖色，玻璃上的高光和色散会更有层次 -->
            <DoubleAnimation Storyboard.TargetName="AmberMove" Storyboard.TargetProperty="X"
                             From="0" To="-100" Duration="0:0:34" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="AmberMove" Storyboard.TargetProperty="Y"
                             From="0" To="70" Duration="0:0:40" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobAmber" Storyboard.TargetProperty="Opacity"
                             From="0.28" To="0.5" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- ① 底色层：每套主题自己的渐变（定义在 Views/Themes/*Theme.xaml 的 BackdropBaseBrush） -->
        <Rectangle Fill="{DynamicResource BackdropBaseBrush}" />

        <!-- ② 背景图：有图才显示（代码后置控制 Visibility + 按主题加 BlurEffect）
             两种铺法都不拉伸：UniformToFill = 铺满裁边，Uniform = 完整显示留边 -->
        <Image x:Name="BackgroundLayer"
               Stretch="UniformToFill" StretchDirection="Both"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />

        <!-- ③ 背景图压暗层：只在有背景图时显示，保证白字可读 -->
        <Rectangle x:Name="ScrimLayer" Fill="{DynamicResource BackdropImageScrimBrush}" />

        <!-- ④ 颗粒层：亚克力主题是一层很淡的噪点（其它主题 Transparent = 看不见） -->
        <Rectangle Fill="{DynamicResource BackdropNoiseBrush}" />

        <!-- ⑤ 液态玻璃的流动彩色光斑（径向渐变 = 天然柔边，不用 BlurEffect；非液态玻璃时整层隐藏） -->
        <Grid x:Name="AmbientLayer">
            <Ellipse x:Name="BlobBlue" Width="980" Height="980"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-280,-340,0,0" Opacity="0.72">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B33D7BFF" Offset="0" />
                        <GradientStop Color="#4D2B5FD6" Offset="0.46" />
                        <GradientStop Color="#003D7BFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlueMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobViolet" Width="860" Height="860"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-240,0" Opacity="0.66">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A6855CF6" Offset="0" />
                        <GradientStop Color="#458B5CF6" Offset="0.5" />
                        <GradientStop Color="#008B5CF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="VioletMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobCyan" Width="620" Height="620"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="220,0,0,-260" Opacity="0.62">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#993EE8FF" Offset="0" />
                        <GradientStop Color="#403EE8FF" Offset="0.48" />
                        <GradientStop Color="#003EE8FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="CyanMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobPink" Width="560" Height="560"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-190" Opacity="0.56">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A6FF5CD6" Offset="0" />
                        <GradientStop Color="#3DFF5CD6" Offset="0.5" />
                        <GradientStop Color="#00FF5CD6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="PinkMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobTeal" Width="460" Height="460"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-120,90,0,0" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8C2DD4BF" Offset="0" />
                        <GradientStop Color="#332DD4BF" Offset="0.52" />
                        <GradientStop Color="#002DD4BF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="TealMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobAmber" Width="540" Height="540"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="340,-190,0,0" Opacity="0.42">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#99FFB86B" Offset="0" />
                        <GradientStop Color="#3DFFB86B" Offset="0.5" />
                        <GradientStop Color="#00FFB86B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AmberMove" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- ⑤·道系（墨金）：金色光晕 + 两层远山剪影（其它主题整层隐藏；颜色由主题 token 提供，深 / 浅都适用） -->
        <Grid x:Name="DaoLayer" Visibility="Collapsed">
            <Ellipse Width="1000" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-420,-220,0" Fill="{DynamicResource DaoGlowBrush}" />
            <Grid VerticalAlignment="Bottom" Height="360" IsHitTestVisible="False">
                <Polygon Points="0,360 260,120 520,300 820,60 1200,360" Stretch="Fill"
                         Fill="{DynamicResource DaoSilhouetteBrush}" Opacity="0.9" />
            </Grid>
            <Grid VerticalAlignment="Bottom" Height="220" IsHitTestVisible="False">
                <Polygon Points="0,220 200,100 430,190 700,30 1030,180 1250,80 1450,220" Stretch="Fill"
                         Fill="{DynamicResource DaoSilhouetteBrush}" Opacity="0.55" />
            </Grid>
        </Grid>

        <!-- ⑤·云间天上：白天 = 云朵 + 暖阳；夜晚 = 暗云 + 月牙 + 星星。
             装饰元素全部用「固定像素大小 + 锚定右上角 / 满窗口 Canvas」，不再套 Viewbox，
             所以窗口怎么拉，太阳 / 月亮 / 云 / 星星的形状和大小都不变；云由代码按窗口宽度循环平移。 -->
        <Grid x:Name="CloudSkyLayer" Visibility="Collapsed">
            <!-- ===== 白天 ===== -->
            <Grid x:Name="DaySky" Visibility="Collapsed">
                <!-- 太阳固定 200px 外环，锚定右上角；窗口拉宽 / 拉高都不拉伸它 -->
                <Canvas Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,0,80,0" IsHitTestVisible="False">
                    <Ellipse Width="360" Height="360">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#66FFE8B0" Offset="0" />
                                <GradientStop Color="#22FFE8B0" Offset="0.55" />
                                <GradientStop Color="#00FFE8B0" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- 白色圆环是实心环带（外圆减内圆），不是描边细线；厚度比上一版再细 1/4 -->
                    <Path Canvas.Left="86.25" Canvas.Top="56.25" Fill="#FFFFFFFF">
                        <Path.Effect>
                            <DropShadowEffect Color="#8FB3D2" BlurRadius="14" ShadowDepth="0" Opacity="0.28" />
                        </Path.Effect>
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <EllipseGeometry Center="93.75,93.75" RadiusX="93.75" RadiusY="93.75" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="93.75,93.75" RadiusX="75" RadiusY="75" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>
                    <Ellipse Canvas.Left="105" Canvas.Top="75" Width="150" Height="150">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFFFB" Offset="0" />
                                <GradientStop Color="#FFF7DF" Offset="0.55" />
                                <GradientStop Color="#F4DDA4" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="158" Canvas.Top="128" Width="44" Height="44"
                             Stroke="#C9A227" StrokeThickness="1.2" />
                    <Ellipse Canvas.Left="174" Canvas.Top="144" Width="12" Height="12" Fill="#C9A227" />
                </Canvas>

                <!-- 云层铺满窗口，但每朵云自身是固定尺寸；X 由代码按窗口宽度循环 -->
                <Canvas x:Name="DayClouds" IsHitTestVisible="False">
                    <Canvas Canvas.Top="55">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud1Move" X="120" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#D7E8F8" Opacity="0.85">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="2.1" ScaleY="2.1" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="40">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud2Move" X="600" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#E2EFFB" Opacity="0.75">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="2.6" ScaleY="2.6" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="120">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud3Move" X="980" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#EDF5FD" Opacity="0.7">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.7" ScaleY="1.7" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="80">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud4Move" X="40" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#E3EFFA" Canvas.Top="8">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
                            </Path.RenderTransform>
                        </Path>
                        <Path Data="{StaticResource CloudShape}" Fill="#FFFFFF">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="150">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud5Move" X="760" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#E8F2FC" Canvas.Top="8">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.7" ScaleY="1.7" />
                            </Path.RenderTransform>
                        </Path>
                        <Path Data="{StaticResource CloudShape}" Fill="#FFFFFF">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.7" ScaleY="1.7" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="30">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud6Move" X="540" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#ECF4FD" Canvas.Top="8">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="2.2" ScaleY="2.2" />
                            </Path.RenderTransform>
                        </Path>
                        <Path Data="{StaticResource CloudShape}" Fill="#FFFFFF">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="2.2" ScaleY="2.2" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="100">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud7Move" X="200" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#E6F1FC" Opacity="0.62">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="170">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud8Move" X="860" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#EFF7FF" Opacity="0.55">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.9" ScaleY="1.9" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="60">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud9Move" X="1000" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#E9F4FF" Opacity="0.65">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="140">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="DayCloud10Move" X="320" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#E0EEFA" Opacity="0.5">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="2.4" ScaleY="2.4" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Canvas>
            </Grid>

            <!-- ===== 夜晚 ===== -->
            <Grid x:Name="NightSky" Visibility="Collapsed">
                <!-- 星星是固定像素的平铺画刷，窗口拉伸不改变大小 -->
                <Rectangle Fill="{StaticResource StarFieldBrush}" IsHitTestVisible="False" />

                <!-- 月亮固定 200px，锚定右上角；月牙 + 黄光，不描边 -->
                <Canvas Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,0,20,0" IsHitTestVisible="False">
                    <Ellipse Width="360" Height="360">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#88FFE9A8" Offset="0" />
                                <GradientStop Color="#44FFE9A8" Offset="0.45" />
                                <GradientStop Color="#00FFE9A8" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Path Canvas.Left="80" Canvas.Top="80" Fill="#F8E9BE">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <EllipseGeometry Center="100,100" RadiusX="95" RadiusY="95" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="178,20" RadiusX="92" RadiusY="92" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                        <Path.RenderTransform>
                            <RotateTransform Angle="18" CenterX="100" CenterY="100" />
                        </Path.RenderTransform>
                    </Path>
                </Canvas>

                <!-- 暗云同样固定尺寸，从右往左漂 -->
                <Canvas x:Name="NightClouds" IsHitTestVisible="False">
                    <Canvas Canvas.Top="90">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="NightCloud1Move" X="250" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#132C4A" Opacity="0.9">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="2.4" ScaleY="2.4" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="150">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="NightCloud2Move" X="700" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#112742" Opacity="0.8">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="110">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="NightCloud3Move" X="980" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#0E2138">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="2.6" ScaleY="2.6" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="70">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="NightCloud4Move" X="420" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#0A1A2E">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.8" ScaleY="1.8" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="160">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="NightCloud5Move" X="220" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#142B46" Opacity="0.78">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="40">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="NightCloud6Move" X="760" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#0D2036" Opacity="0.85">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="130">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="NightCloud7Move" X="1020" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#132B45" Opacity="0.7">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="2.2" ScaleY="2.2" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas Canvas.Top="40">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="NightCloud8Move" X="460" />
                        </Canvas.RenderTransform>
                        <Path Data="{StaticResource CloudShape}" Fill="#16304D" Opacity="0.6">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Canvas>
            </Grid>
        </Grid>

        <!-- ⑥ 顶部一道斜向柔光：玻璃顶边“接住光”的感觉（token 化，浅色模式可替换） -->
        <Rectangle Fill="{DynamicResource BackdropTopLightBrush}" />

        <!-- ⑥ 暗角：四周压暗，中间亮，视线集中到内容上（也让白字更稳） -->
        <Rectangle Fill="{DynamicResource BackdropVignetteBrush}" />
    </Grid>
</UserControl>

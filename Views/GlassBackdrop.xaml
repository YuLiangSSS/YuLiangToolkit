<UserControl x:Class="YuLiangToolkit.App.Views.GlassBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" ClipToBounds="True"
             UseLayoutRounding="True">
    <!--
      半透明界面风格的**窗口背景层**（v0.43.0，由原来的 LiquidBackdrop 升级而来）。

      用量：放在 MainWindow 的 RootGrid 最底层、铺满四行（标题栏 / 工具条 / 主体 / 状态栏），
      只有半透明风格（液态玻璃 / 毛玻璃 / 亚克力）才显示；默认深色风格下 Visibility=Collapsed，
      代码后置也会停掉动画（见 GlassBackdrop.xaml.cs）。

      从下往上叠六层：
        ① 底色：BackdropBaseBrush（每套主题一个渐变；没背景图时就是“舞台”）；
        ② 背景图：用户在「主页设置 → 背景图」里选的图片，铺满窗口 / 完整显示两种铺法都不拉伸；
        ③ 压暗层：BackdropImageScrimBrush（背景图亮的时候也保证白字读得清）；
        ④ 颗粒层：BackdropNoiseBrush（亚克力 = 细噪点，其它主题 = 透明）；
        ⑤ 流动光晕：液态玻璃专属的彩色光斑（其它主题隐藏；不可见时动画会停，不白跑 CPU）；
        ⑥ 顶部柔光 + 暗角：给玻璃“接光 / 有厚度”的感觉（三套半透明风格共用）。

      ⚠ 刻意**不用大范围高斯模糊动画**：只有静态的背景图会按主题加 BlurEffect（毛玻璃重、亚克力轻、
        液态玻璃不模糊），且用 BitmapCache 缓存结果；光晕动画只动 TranslateTransform / Opacity（最便宜）。
    -->
    <UserControl.Resources>
        <Storyboard x:Key="AmbientStoryboard">
            <!-- 蓝色大光斑：缓慢左右上下漂 + 呼吸 -->
            <DoubleAnimation Storyboard.TargetName="BlueMove" Storyboard.TargetProperty="X"
                             From="0" To="150" Duration="0:0:38" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlueMove" Storyboard.TargetProperty="Y"
                             From="0" To="96" Duration="0:0:47" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobBlue" Storyboard.TargetProperty="Opacity"
                             From="0.62" To="0.92" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 紫色光斑 -->
            <DoubleAnimation Storyboard.TargetName="VioletMove" Storyboard.TargetProperty="X"
                             From="0" To="-130" Duration="0:0:44" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="VioletMove" Storyboard.TargetProperty="Y"
                             From="0" To="120" Duration="0:0:35" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobViolet" Storyboard.TargetProperty="Opacity"
                             From="0.5" To="0.78" Duration="0:0:31" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 青色光斑 -->
            <DoubleAnimation Storyboard.TargetName="CyanMove" Storyboard.TargetProperty="X"
                             From="0" To="120" Duration="0:0:29" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="CyanMove" Storyboard.TargetProperty="Y"
                             From="0" To="-90" Duration="0:0:33" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobCyan" Storyboard.TargetProperty="Opacity"
                             From="0.46" To="0.72" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 品红光斑 -->
            <DoubleAnimation Storyboard.TargetName="PinkMove" Storyboard.TargetProperty="X"
                             From="0" To="-90" Duration="0:0:41" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="PinkMove" Storyboard.TargetProperty="Y"
                             From="0" To="80" Duration="0:0:27" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobPink" Storyboard.TargetProperty="Opacity"
                             From="0.4" To="0.65" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 青绿光斑 -->
            <DoubleAnimation Storyboard.TargetName="TealMove" Storyboard.TargetProperty="X"
                             From="0" To="80" Duration="0:0:26" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="TealMove" Storyboard.TargetProperty="Y"
                             From="0" To="-110" Duration="0:0:37" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobTeal" Storyboard.TargetProperty="Opacity"
                             From="0.32" To="0.55" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- 琥珀色光斑：给画面一点暖色，玻璃上的高光和色散会更有层次 -->
            <DoubleAnimation Storyboard.TargetName="AmberMove" Storyboard.TargetProperty="X"
                             From="0" To="-100" Duration="0:0:34" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="AmberMove" Storyboard.TargetProperty="Y"
                             From="0" To="70" Duration="0:0:40" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BlobAmber" Storyboard.TargetProperty="Opacity"
                             From="0.28" To="0.5" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- ① 底色层：每套主题自己的渐变（定义在 Views/Themes/*Theme.xaml 的 BackdropBaseBrush） -->
        <Rectangle Fill="{DynamicResource BackdropBaseBrush}" />

        <!-- ② 背景图：有图才显示（代码后置控制 Visibility + 按主题加 BlurEffect）
             两种铺法都不拉伸：UniformToFill = 铺满裁边，Uniform = 完整显示留边 -->
        <Image x:Name="BackgroundLayer"
               Stretch="UniformToFill" StretchDirection="Both"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />

        <!-- ③ 背景图压暗层：只在有背景图时显示，保证白字可读 -->
        <Rectangle x:Name="ScrimLayer" Fill="{DynamicResource BackdropImageScrimBrush}" />

        <!-- ④ 颗粒层：亚克力主题是一层很淡的噪点（其它主题 Transparent = 看不见） -->
        <Rectangle Fill="{DynamicResource BackdropNoiseBrush}" />

        <!-- ⑤ 液态玻璃的流动彩色光斑（径向渐变 = 天然柔边，不用 BlurEffect；非液态玻璃时整层隐藏） -->
        <Grid x:Name="AmbientLayer">
            <Ellipse x:Name="BlobBlue" Width="980" Height="980"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-280,-340,0,0" Opacity="0.72">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B33D7BFF" Offset="0" />
                        <GradientStop Color="#4D2B5FD6" Offset="0.46" />
                        <GradientStop Color="#003D7BFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlueMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobViolet" Width="860" Height="860"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-240,0" Opacity="0.66">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A6855CF6" Offset="0" />
                        <GradientStop Color="#458B5CF6" Offset="0.5" />
                        <GradientStop Color="#008B5CF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="VioletMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobCyan" Width="620" Height="620"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="220,0,0,-260" Opacity="0.62">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#993EE8FF" Offset="0" />
                        <GradientStop Color="#403EE8FF" Offset="0.48" />
                        <GradientStop Color="#003EE8FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="CyanMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobPink" Width="560" Height="560"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-190" Opacity="0.56">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A6FF5CD6" Offset="0" />
                        <GradientStop Color="#3DFF5CD6" Offset="0.5" />
                        <GradientStop Color="#00FF5CD6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="PinkMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobTeal" Width="460" Height="460"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-120,90,0,0" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8C2DD4BF" Offset="0" />
                        <GradientStop Color="#332DD4BF" Offset="0.52" />
                        <GradientStop Color="#002DD4BF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="TealMove" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="BlobAmber" Width="540" Height="540"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="340,-190,0,0" Opacity="0.42">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#99FFB86B" Offset="0" />
                        <GradientStop Color="#3DFFB86B" Offset="0.5" />
                        <GradientStop Color="#00FFB86B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AmberMove" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- ⑥ 顶部一道斜向柔光：玻璃顶边“接住光”的感觉 -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1AFFFFFF" Offset="0" />
                    <GradientStop Color="#07FFFFFF" Offset="0.34" />
                    <GradientStop Color="#00FFFFFF" Offset="0.62" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ⑥ 暗角：四周压暗，中间亮，视线集中到内容上（也让白字更稳） -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#00000000" Offset="0.42" />
                    <GradientStop Color="#40000000" Offset="0.78" />
                    <GradientStop Color="#99000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>

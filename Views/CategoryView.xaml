<UserControl x:Class="YuLiangToolkit.App.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,26">

            <!-- ===== 类别标题区：图标 + 名称 + 描述 + 统计 + 返回上一级 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="64" Height="64" CornerRadius="16" Background="#232A36" VerticalAlignment="Top">
                    <TextBlock Text="{Binding CurrentNodeEmoji}" FontSize="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="18,2,16,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding CurrentNodeName}" FontSize="22" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentNodeDescription}" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasCurrentNodeDescription, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding CurrentNodeSummary}" FontSize="11.5"
                               Foreground="{StaticResource AccentBrush}" Margin="0,7,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Content="← 返回上一级" Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Top" Command="{Binding NavigateParentCommand}"
                        ToolTip="回到上一级（顶部的面包屑也可以点）" />
            </Grid>

            <!-- ===== 搜索 + 排序条（在本类别子树里搜） ===== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="2,0,8,0" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Height="34" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="在本类别（含子类别）里按名称、分类、标签、描述、Id 搜索；Ctrl+F 聚焦、Esc 清空" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="在这个分类里搜索…（名称 / 标签 / 描述，Ctrl+F）"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                    </Grid>

                    <Button Grid.Column="2" Content="✕" Padding="10,4" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" ToolTip="清空搜索（Esc）"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="排序" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                  DisplayMemberPath="Label" Style="{StaticResource ComboBoxStyle}"
                                  MinWidth="120" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="4" Text="{Binding FilterSummary}" VerticalAlignment="Center"
                               Margin="18,0,4,0" MinWidth="120" TextAlignment="Right" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- ===== 子类别卡片（点进去继续下钻，任意层级） ===== -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowCategoryCards, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="子分类" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="点进去看更深一层的工具" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding CategoryCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolCardButtonStyle}" Width="300" Margin="0,0,16,16"
                                    ToolTip="{Binding ToolTipText}"
                                    Command="{Binding DataContext.NavigateCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="12" Background="#232A36" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Emoji}" FontSize="24"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34" Margin="0,5,0,0"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding CountText}" FontSize="10"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 工具卡片墙 ===== -->
            <StackPanel Margin="0,6,0,0" Visibility="{Binding ShowToolCards, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ToolSectionTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding ToolCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolCardButtonStyle}" Width="300" Margin="0,0,16,16"
                                    ToolTip="{Binding ToolTipText}"
                                    Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Tool}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="12" Background="#232A36" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Emoji}" FontSize="24"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding TagsText}" FontSize="10"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding LastUsedText}" FontSize="10" Foreground="#5A6472"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding ShowLastUsed, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 空状态（搜索无结果 / 分类里暂时没有工具） ===== -->
            <Border Style="{StaticResource CardStyle}" Padding="22,20" Margin="0,4,0,0"
                    Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="这个分类下没有可显示的内容" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NoResultHint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="清空搜索" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearSearchCommand}" Margin="0,0,10,0"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" />
                        <Button Content="返回上一级" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding NavigateParentCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

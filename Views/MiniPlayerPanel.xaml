<UserControl x:Class="YuLiangToolkit.App.Views.MiniPlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="99" Background="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniPlayButton" TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="99" Background="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题那一行也是个按钮：点一下回播放器 -->
        <Style x:Key="MiniTitleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MiniPlayerHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 迷你播放条：一行「来回滚」的标题 + 快退 / 播放暂停 / 快进。
         DataContext = 播放器的 ViewModel（外壳的 MiniPanelSource 给过来的）。 -->
    <Border Width="264" Background="{DynamicResource MiniPlayerBackgroundBrush}" CornerRadius="12" Padding="10,8,10,10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <Button Style="{StaticResource MiniTitleButton}"
                    Command="{Binding DataContext.OpenBackgroundToolCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="回到播放器">
                <Grid x:Name="TitleClip" Height="18" ClipToBounds="True">
                    <TextBlock x:Name="TitleText" Text="{Binding TitleText}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleShift" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Button>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <!-- 左键快退、右键上一首（右键在代码后置里接） -->
                <Button x:Name="MiniBack" Style="{StaticResource MiniIconButton}"
                        Command="{Binding SeekBackwardCommand}"
                        ToolTip="左键：快退　右键：上一首">
                    <Path Data="M 6,0 L 0,5.5 L 6,11 Z M 12,0 L 6,5.5 L 12,11 Z"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                </Button>

                <Button x:Name="MiniPlay" Style="{StaticResource MiniPlayButton}"
                        Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayTooltip}">
                    <Grid Width="12" Height="12">
                        <Path Data="M 1,0 L 12,6 L 1,12 Z" Fill="White"
                              Visibility="{Binding ShowPlayIcon, Converter={StaticResource BoolToVis}}" />
                        <Path Data="M 1,0 H 4 V 12 H 1 Z M 8,0 H 11 V 12 H 8 Z" Fill="White"
                              Visibility="{Binding ShowPauseIcon, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>

                <!-- 左键快进、右键下一首 -->
                <Button x:Name="MiniForward" Style="{StaticResource MiniIconButton}"
                        Command="{Binding SeekForwardCommand}"
                        ToolTip="左键：快进　右键：下一首">
                    <Path Data="M 0,0 L 6,5.5 L 0,11 Z M 6,0 L 12,5.5 L 6,11 Z"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                </Button>

                <TextBlock Text="{Binding PlayModeText}" FontSize="10.5" VerticalAlignment="Center"
                           Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

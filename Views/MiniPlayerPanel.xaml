<UserControl x:Class="YuLiangToolkit.App.Views.MiniPlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <!-- 左右边距给「快退 / 播放暂停 / 快进」三个按钮留**对称**的缝：
                 播放键要正好落在快退、快进的中间（左右各 4px 缝），别一边 6 一边 2 看着歪。
                 注意播放键比两侧图标宽（36 vs 30），所以只有当两侧缝相等时圆心才等于两边中心的中点。 -->
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="99" Background="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniPlayButton" TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="99" Background="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题那一行也是个按钮：点一下回播放器 -->
        <Style x:Key="MiniTitleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="2,1">
                            <!-- ⚠ 这里必须是 Stretch（不能是 Left）：标题的裁剪容器要撑满按钮内容区，
                                 否则 Width 会变成 0 / 内容宽度，滚动标题的「可视窗口」就跟着算错。
                                 整条链路见下面 TitleClip 的注释。 -->
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MiniPlayerHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 播放模式按钮：点一下循环切换（列表循环 → 单曲循环 → 随机播放），不再只是只读文字 -->
        <Style x:Key="MiniModeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 迷你播放条：一行「来回滚」的标题 + 进度条（点 / 拖跳转）+ 快退 / 播放暂停 / 快进 / 可点击的播放模式，右上角一个 ×。
         DataContext = 播放器的 ViewModel（外壳的 MiniPanelSource 给过来的）。
         ⚠ 后台时播放器页的 200ms 计时器已经停了（视图被摘下），所以**进度由本控件的计时器推进**
         （见 MiniPlayerPanel.xaml.cs 的 OnPositionTick），否则进度条会停在被切走那一刻。 -->
    <Border Width="264" Background="{DynamicResource MiniPlayerBackgroundBrush}" CornerRadius="12" Padding="10,8,10,10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <!-- 标题行：标题按钮占满剩余宽度，右上角单独放 ×（关闭小窗 + 停止播放） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource MiniTitleButton}"
                        Command="{Binding DataContext.OpenBackgroundToolCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{Binding TitleText, StringFormat={}{0}（点一下回到播放器）}">
                    <!-- ⚠⚠ 标题滚动曾经「永远只能看到前一小段、右边被切」的真正原因（v0.55.2 修）：
                         WPF 会把**子元素按自己的 DesiredSize 排版**（TextBlock 在 Grid/StackPanel 里
                         HorizontalAlignment=Left 时就会这样），排出来的宽度比父容器给它的槽位大时，
                         布局系统会给这个 TextBlock 加一个**跟着它自己走的 layout clip**（裁到槽位宽）。
                         于是 RenderTransform 把文字往左移时，裁剪窗口也一起往左移 —— 右侧的字永远露不出来，
                         看上去就是「固定位置被截断」，而且怎么调滚动速度 / 时长都没用（前两次修都没修好）。
                         正确做法：让文字量出来的宽度 = 排给它的宽度（Canvas 用无限宽量、按 DesiredSize 排，
                         不会再被加 layout clip），**裁剪交给外面宽度固定、位置不动的容器**。
                         所以这里必须是：固定宽的 Grid（ClipToBounds）→ Canvas（不裁、不定宽）→ TextBlock。
                         别改回「Grid 直接放 TextBlock」，也别把 Canvas 去掉。 -->
                    <Grid x:Name="TitleClip" Height="18" ClipToBounds="True">
                        <Canvas>
                            <TextBlock x:Name="TitleText" Text="{Binding TitleText, NotifyOnTargetUpdated=True}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Canvas.Left="0" Canvas.Top="0"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="TitleShift" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Grid>
                </Button>

                <!-- 右上角 ×：关掉小窗并把音乐停掉（只关这一次，下次开始播放再切走还会浮出来） -->
                <Button Grid.Column="1" x:Name="MiniClose" Style="{StaticResource MiniIconButton}"
                        Width="20" Height="20" Margin="4,0,0,0" VerticalAlignment="Top"
                        Command="{Binding CloseMiniPanelCommand}"
                        ToolTip="关闭小窗并停止播放">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- 进度条：点一下 / 按住拖可以跳到任意位置（后台播放时也能调）。悬停提示里的时间由代码后置每 200ms 更新。 -->
            <Grid x:Name="MiniSeekArea" Height="16" Margin="0,4,0,0" Background="Transparent"
                  Cursor="Hand" ToolTip="点 / 拖可以跳到任意位置"
                  MouseLeftButtonDown="OnMiniSeekMouseDown"
                  MouseMove="OnMiniSeekMouseMove"
                  MouseLeftButtonUp="OnMiniSeekMouseUp"
                  MouseLeave="OnMiniSeekMouseLeave">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressRatio, Mode=OneWay}"
                             Style="{StaticResource ProgressBarStyle}" Height="4"
                             VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <!-- 左键快退、右键上一首（右键在代码后置里接） -->
                <Button x:Name="MiniBack" Style="{StaticResource MiniIconButton}" Margin="0,0,2,0"
                        Command="{Binding SeekBackwardCommand}"
                        ToolTip="左键：快退　右键：上一首">
                    <Path Data="M 6,0 L 0,5.5 L 6,11 Z M 12,0 L 6,5.5 L 12,11 Z"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                </Button>

                <Button x:Name="MiniPlay" Style="{StaticResource MiniPlayButton}"
                        Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayTooltip}">
                    <Grid Width="12" Height="12">
                        <Path Data="M 1,0 L 12,6 L 1,12 Z" Fill="White"
                              Visibility="{Binding ShowPlayIcon, Converter={StaticResource BoolToVis}}" />
                        <Path Data="M 1,0 H 4 V 12 H 1 Z M 8,0 H 11 V 12 H 8 Z" Fill="White"
                              Visibility="{Binding ShowPauseIcon, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>

                <!-- 左键快进、右键下一首 -->
                <Button x:Name="MiniForward" Style="{StaticResource MiniIconButton}" Margin="2,0,0,0"
                        Command="{Binding SeekForwardCommand}"
                        ToolTip="左键：快进　右键：下一首">
                    <Path Data="M 0,0 L 6,5.5 L 0,11 Z M 6,0 L 12,5.5 L 6,11 Z"
                          Fill="{DynamicResource TextPrimaryBrush}" />
                </Button>

                <!-- 播放模式：可点击，点一下循环切换（列表循环 → 单曲循环 → 随机播放） -->
                <Button x:Name="MiniMode" Style="{StaticResource MiniModeButton}"
                        Content="{Binding PlayModeText}"
                        Command="{Binding CyclePlayModeCommand}"
                        ToolTip="{Binding PlayModeTooltip}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

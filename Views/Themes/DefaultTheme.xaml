<!--
  默认主题（第一套 UI）：经典深色界面。

  ★ 这里只放「主题 token」——颜色 / 圆角这类随主题整体切换的值；
    控件样式本身（模板、字号、边距）在 App.xaml 里，四套主题共用同一批样式。
  ★ 运行时由 ThemeManager.Apply(UiTheme) 把本字典整体替换成 LiquidGlassTheme.xaml /
    FrostedGlassTheme.xaml / AcrylicTheme.xaml，所有引用它们的控件都用 {DynamicResource 名字} 绑定，
    所以换主题立即生效、不用重启。
  ★ 四套字典的 key 必须**完全一致**（自检 ThemeChecks 会逐项对比），
    少一个 key 的话玻璃主题下会用控件默认值（例如文字变黑），很难发现。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 基础颜色（默认值 = v0.24.0 的原始外观，改这里等于改“第一套 UI”） ================= -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16181D" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1A1E25" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#191D23" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1F242C" />
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#272E39" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2C333F" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2C333F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6399FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A7AE0" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAF0" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#98A1B3" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#5A6472" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5534B" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#C7443E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#181C22" />

    <!-- ================= 控件细节颜色（把原先散落在样式里的硬编码收口到这里） ================= -->
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#3D4A5E" />
    <SolidColorBrush x:Key="WindowButtonHoverBackgroundBrush" Color="#3A414D" />
    <SolidColorBrush x:Key="WindowButtonPressedBackgroundBrush" Color="#2C333F" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#4A5568" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#20262F" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#3A414D" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#4C5563" />
    <SolidColorBrush x:Key="SidebarItemHoverBackgroundBrush" Color="#222834" />
    <SolidColorBrush x:Key="SidebarItemSelectedBackgroundBrush" Color="#2A3242" />
    <SolidColorBrush x:Key="ListRowHoverBackgroundBrush" Color="#232A36" />
    <SolidColorBrush x:Key="ListRowSelectedBackgroundBrush" Color="#2C374A" />
    <SolidColorBrush x:Key="ListRowSelectedBorderBrush" Color="#3E5A80" />
    <SolidColorBrush x:Key="TagChipBackgroundBrush" Color="#1D2735" />
    <SolidColorBrush x:Key="TagChipBorderBrush" Color="#2C3B52" />
    <SolidColorBrush x:Key="TagChipHoverBackgroundBrush" Color="#26364A" />
    <SolidColorBrush x:Key="EmojiTileBackgroundBrush" Color="#232A36" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="#C8CFDA" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#0F1216" />
    <SolidColorBrush x:Key="MiniPlayerBackgroundBrush" Color="#1F242C" />
    <SolidColorBrush x:Key="MiniPlayerHoverBackgroundBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#16181D" />

    <!-- 次级按钮底色：默认主题是透明的（外观与以前完全一致） -->
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="Transparent" />

    <!-- 主按钮（强调色实心按钮） -->
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="#6399FF" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="#3A7AE0" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="Transparent" />

    <!-- 玻璃高光层：默认主题透明（模板里那层高光等于不存在，第一套 UI 外观分毫不变） -->
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="Transparent" />

    <!-- 整窗最外圈那道 1px 玻璃边（默认主题透明 = 无边框，外观与以前一致） -->
    <SolidColorBrush x:Key="WindowEdgeBorderBrush" Color="Transparent" />

    <!-- ================= 背景层 token（v0.43.0） ================= -->
    <!-- 默认主题是纯色界面：不显示窗口背景图，也不用亚克力颗粒；这三个 token 只为
         让四套主题字典的 key 完全一致（自检 ThemeChecks 会逐项对比）。 -->
    <SolidColorBrush x:Key="BackdropBaseBrush" Color="#16181D" />
    <SolidColorBrush x:Key="BackdropImageScrimBrush" Color="Transparent" />
    <SolidColorBrush x:Key="BackdropNoiseBrush" Color="Transparent" />

    <!-- ================= 几何 token ================= -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

</ResourceDictionary>

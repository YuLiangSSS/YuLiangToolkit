<!--
  液态玻璃主题（第二套 UI）：参考 Kerxs/glassium 的 Liquid Glass 视觉语言做的 WPF 版实现。

  ★ key 必须与 DefaultTheme.xaml **完全一致**（自检 ThemeChecks 会对比两套字典的 key 集合）。
  ★ WPF 没有 WebGPU 那种真折射，这里的“玻璃”由四层拼出来：
      ① 窗口底层 LiquidBackdrop 的流动彩色光晕（玻璃后面的“场景”）；
      ② 半透明白色渐变面板（CardBackgroundBrush 等）+ 上下亮、中间暗的渐变描边（BorderBrush）；
      ③ 控件模板里那层 GlassHighlightBrush 斜向高光（默认主题下是透明画刷，第一套 UI 不受影响）；
      ④ 大圆角（CardCornerRadius / ControlCornerRadius）与更亮的文字/强调色。
    所以截图（RenderTargetBitmap 不依赖系统合成器）也能看到完整的玻璃效果，
    不依赖 Windows 11 的 Mica/Acrylic，Win10 上同样好看。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 基础颜色 ================= -->
    <!-- 窗口兜底底色（正常情况下被 LiquidBackdrop 的流动光晕盖住） -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#070A12" />

    <!-- 标题栏 / 状态栏：深色烟熏玻璃（保证白字在任何光晕上都读得清） -->
    <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#17FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- 侧边栏：横向渐变的浅色玻璃，右侧一条亮边（SeparatorBrush）收口 -->
    <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2BFFFFFF" Offset="0" />
        <GradientStop Color="#10FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- 卡片/面板：乳白半透明玻璃，上亮下暗，叠在彩色光晕上 -->
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#52FFFFFF" Offset="0" />
        <GradientStop Color="#2BFFFFFF" Offset="0.16" />
        <GradientStop Color="#14FFFFFF" Offset="0.58" />
        <GradientStop Color="#24FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#36FFFFFF" Offset="0.18" />
        <GradientStop Color="#1DFFFFFF" Offset="0.6" />
        <GradientStop Color="#33FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- 玻璃描边：上下两条边最亮（光在边缘被折出来），中间暗；圆角处会自然形成一圈亮边 -->
    <LinearGradientBrush x:Key="BorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8CFFFFFF" Offset="0" />
        <GradientStop Color="#4DFFFFFF" Offset="0.3" />
        <GradientStop Color="#26FFFFFF" Offset="0.72" />
        <GradientStop Color="#66FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SeparatorBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#74B6FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9ACBFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4F93E8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C6D1E2" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#9AA8BD" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#E05252" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5BE38B" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#24FFFFFF" />

    <!-- ================= 控件细节颜色 ================= -->
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="WindowButtonHoverBackgroundBrush" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="WindowButtonPressedBackgroundBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="SidebarItemHoverBackgroundBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SidebarItemSelectedBackgroundBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ListRowHoverBackgroundBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ListRowSelectedBackgroundBrush" Color="#3374B6FF" />
    <SolidColorBrush x:Key="ListRowSelectedBorderBrush" Color="#B374B6FF" />
    <SolidColorBrush x:Key="TagChipBackgroundBrush" Color="#1F74B6FF" />
    <SolidColorBrush x:Key="TagChipBorderBrush" Color="#7A74B6FF" />
    <SolidColorBrush x:Key="TagChipHoverBackgroundBrush" Color="#3D74B6FF" />
    <SolidColorBrush x:Key="EmojiTileBackgroundBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="MiniPlayerBackgroundBrush" Color="#E01A2434" />
    <SolidColorBrush x:Key="MiniPlayerHoverBackgroundBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ShellSurfaceBrush" Color="Transparent" />

    <!-- 次级按钮：一层很淡的玻璃底 -->
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#1FFFFFFF" />

    <!-- 主按钮：蓝 → 靛的玻璃渐变，配白色半透明描边 -->
    <LinearGradientBrush x:Key="PrimaryButtonBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5AA7FF" Offset="0" />
        <GradientStop Color="#FF6F8BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonHoverBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7DC2FF" Offset="0" />
        <GradientStop Color="#FF93A6FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonPressedBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4786E0" Offset="0" />
        <GradientStop Color="#FF5B73E0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#99FFFFFF" />

    <!-- 模板里的斜向高光层（玻璃最标志性的那道“反光”） -->
    <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#47FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="0.3" />
        <GradientStop Color="#00FFFFFF" Offset="0.62" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- 整窗最外圈那道 1px 玻璃边：让窗口和桌面之间有清楚的“玻璃壳”分层 -->
    <SolidColorBrush x:Key="WindowEdgeBorderBrush" Color="#73FFFFFF" />

    <!-- ================= 几何 token ================= -->
    <CornerRadius x:Key="CardCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>

</ResourceDictionary>

<Window x:Class="YuLiangToolkit.App.Views.ShellSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YuLiangToolkit.App.Views"
        Title="主页设置"
        Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- 无边框小窗：标题栏在代码里手动拖拽（与主窗口同一套做法：WindowStyle=None + 自己画按钮） -->
    <Border Background="{DynamicResource ShellSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 液态玻璃主题下也铺一层流动光晕，让设置窗口本身也是玻璃的（默认主题下隐藏，不跑动画） -->
            <views:LiquidBackdrop Grid.RowSpan="2" Panel.ZIndex="-100"
                                  Visibility="{Binding IsLiquidGlass, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

            <!-- 标题栏（可拖拽 + 关闭按钮） -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                    MouseLeftButtonDown="OnTitleBarMouseLeftDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="⚙" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="主页设置" FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource WindowCloseButtonStyle}"
                            Content="&#xE8BB;" Click="OnCloseClick" ToolTip="关闭（Esc）" />
                </Grid>
            </Border>

            <!-- 设置内容 -->
            <StackPanel Grid.Row="1" Margin="24,18,24,22">
                <TextBlock Text="界面风格" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                    <StackPanel>
                        <!-- 两套 UI：点一下立即换肤（不重启），选中值自动存 Config\shell\config.json 的 uiTheme -->
                        <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="UiTheme"
                                     AutomationProperties.Name="默认（深色）"
                                     IsChecked="{Binding DefaultThemeSelected}"
                                     ToolTip="经典深色界面：纯色面板，最省资源（第一套 UI）">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="46" Height="32" CornerRadius="7" Background="#16181D"
                                        BorderBrush="#2C333F" BorderThickness="1" Margin="0,0,10,0">
                                    <StackPanel Margin="7,6">
                                        <Border Height="7" CornerRadius="2" Background="#2A3242" />
                                        <Border Height="5" CornerRadius="2" Background="#1F242C" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="默认（深色）" FontWeight="SemiBold" />
                                    <TextBlock Text="经典纯色面板，最省资源" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="UiTheme"
                                     AutomationProperties.Name="液态玻璃（实验）"
                                     IsChecked="{Binding LiquidGlassThemeSelected}" Margin="0,12,0,0"
                                     ToolTip="液态玻璃：半透明玻璃面板 + 流动色彩光晕（第二套 UI，参考 Glassium）">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="46" Height="32" CornerRadius="7" BorderThickness="1" Margin="0,0,10,0"
                                        BorderBrush="#66FFFFFF">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3D7BFF" Offset="0" />
                                            <GradientStop Color="#8B5CF6" Offset="0.55" />
                                            <GradientStop Color="#FF5CD6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border Margin="6,5" CornerRadius="4" Background="#55FFFFFF"
                                            BorderBrush="#99FFFFFF" BorderThickness="1" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="液态玻璃（实验）" FontWeight="SemiBold" />
                                    <TextBlock Text="半透明玻璃 + 流动光晕，参考 Glassium" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="换主题立即生效、不用重启；选择会自动存进 Config\shell\config.json 的 uiTheme（旧配置没有这一项时按「默认」处理）。液态玻璃会多画一层流动光晕，低配机器觉得费电 / 掉帧就切回默认。" />
                    </StackPanel>
                </Border>

                <TextBlock Text="外观" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,0" />
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                    <StackPanel>
                        <CheckBox Content="显示鼠标粒子效果" Style="{StaticResource CheckBoxStyle}"
                                  IsChecked="{Binding ParticlesEnabled}"
                                  ToolTip="关掉之后不再绘制粒子，设置会自动保存" />
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,9,0,0"
                                   Text="粒子跟随鼠标移动：左键点一下爆一簇、右键点一下来更多；关闭后不再绘制。设置自动保存到 Config\shell\config.json，重启后保持。" />
                    </StackPanel>
                </Border>

                <TextBlock Text="粒子颜色" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,0" />
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                    <StackPanel>
                        <CheckBox Content="启用自定义颜色" Style="{StaticResource CheckBoxStyle}"
                                  IsChecked="{Binding ParticleCustomColorsEnabled}"
                                  ToolTip="关掉时用默认的淡紫白粒子" />
                        <StackPanel IsEnabled="{Binding ParticleCustomColorsEnabled}" Margin="0,2,0,0">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="颜色 1" Style="{StaticResource CheckBoxStyle}"
                                          IsChecked="{Binding ParticleColor1Enabled}" VerticalAlignment="Center"
                                          ToolTip="取消勾选 = 不使用这个颜色" />
                                <views:ColorPickerButton Grid.Column="1" Margin="12,0,0,0"
                                                         HorizontalAlignment="Left"
                                                         SelectedColor="{Binding ParticleColor1Value, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="颜色 2" Style="{StaticResource CheckBoxStyle}"
                                          IsChecked="{Binding ParticleColor2Enabled}" VerticalAlignment="Center"
                                          ToolTip="取消勾选 = 不使用这个颜色" />
                                <views:ColorPickerButton Grid.Column="1" Margin="12,0,0,0"
                                                         HorizontalAlignment="Left"
                                                         SelectedColor="{Binding ParticleColor2Value, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="两种颜色都勾选：每颗粒子会在两种颜色之间随机取色（渐变过渡）；只勾选一种：粒子固定用那种颜色（单色）；两种都不勾：回到默认的淡紫白。" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="窗口与托盘" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,0" />
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="点击右上角 × 时" FontSize="12.5" FontWeight="SemiBold" />
                        <RadioButton Content="关闭应用" Style="{StaticResource RadioButtonStyle}"
                                     IsChecked="{Binding ExitOnClose}" Margin="0,9,0,0"
                                     ToolTip="和以前一样：直接退出程序" />
                        <RadioButton Content="最小化到托盘" Style="{StaticResource RadioButtonStyle}"
                                     IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,9,0,0"
                                     ToolTip="窗口藏到任务栏右侧，应用继续在后台运行" />
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,9,0,0"
                                   Text="选「最小化到托盘」后，× 只把窗口藏到任务栏右侧的小图标里，应用继续在后台运行：单击 / 双击托盘图标恢复窗口，右键托盘图标可以「显示主窗口 / 主页设置 / 退出」。设置自动保存，重启后保持。" />
                    </StackPanel>
                </Border>

                <TextBlock FontSize="11" Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="主页设置只影响外壳本身（界面风格、粒子效果、关闭行为等）；各功能自己的选项在对应功能页面里。" />

                <Button Content="完成" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" Margin="0,18,0,0" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

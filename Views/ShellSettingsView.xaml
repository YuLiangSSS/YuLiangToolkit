<UserControl x:Class="YuLiangToolkit.App.Views.ShellSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YuLiangToolkit.App.Views">
    <!--
      主页设置页（v0.26.0 起从独立小窗改成主窗口里的页面）：
      从主页右上角「⚙ 主页设置」或托盘菜单进入，面包屑显示「主页 › 主页设置」，后退 / 前进也能回到这一页。
      所有设置项都直接绑 MainViewModel（改一下自动落盘，没有保存按钮）；主题 token 全部 DynamicResource。

      ★ 扩展点：特效列表（自动效果 / 点击效果）的每一项来自 Core/Effects/CursorEffects.cs 的清单，
        ItemsControl 直接按清单渲染 —— 以后加新特效只改清单 + 渲染层，不用改这个 XAML。
        特效参数滑块（v0.37.3）同理：范围 / 步进来自 Core/Effects/CursorEffectTuning.cs，
        显示名 / 说明来自 MainViewModel 建好、挂在每个特效项（ShellEffectOption.Sliders）上的列表，
        这里只放一个共用模板；**没勾选对应特效时参数块整个不显示**。
    -->
    <UserControl.Resources>
        <!-- 云间天上的小云预览（设置页主题卡用） -->
        <PathGeometry x:Key="CloudPreviewShape"
                      Figures="M0,8 C0,4 4,1 8,2 C9,-1 14,-2 17,1 C20,-1 24,1 25,4 C28,4 30,6 30,8 Z" />

        <!-- 一条特效参数滑块（自动 / 点击两张卡共用）：名称 + 当前值 + 滑块 + 一句说明。
             只会在勾选了所属特效时被渲染出来（外层用 Visibility 控制），所以这里不再做置灰。 -->
        <DataTemplate x:Key="EffectSliderTemplate">
            <StackPanel Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                </Grid>
                <Slider Style="{StaticResource SliderStyle}" Margin="0,3,0,0"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding Value, Mode=TwoWay}"
                        SmallChange="{Binding Step}" LargeChange="{Binding LargeStep}"
                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                        ToolTip="{Binding Description}" />
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- 背景图 / 自定义光标共用的历史缩略图：点一下切回这张图；当前使用的那张加主题色描边 -->
        <DataTemplate x:Key="ImageHistoryTemplate">
            <Button Command="{Binding UseCommand}" Margin="0,0,8,0" Padding="0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="{Binding FileName}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>
                <Border Width="72" Height="48" CornerRadius="7" ClipToBounds="True"
                        Background="{DynamicResource InputBackgroundBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 页面内容随窗口铺满（和主页 / 类别页 / 工具页一致）：不再限制最大宽度、也不靠左对齐。
             以前这里写的是 MaxWidth="920" + HorizontalAlignment="Left"，窗口一拉宽右半边就空着。 -->
        <StackPanel Margin="30,26,30,30">

            <!-- ===== 标题 + 返回主页 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="22" VerticalAlignment="Center" />
                        <TextBlock Text="主页设置" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="外壳自己的设置：外观模式（深色 / 浅色 / 跟随系统）、界面风格（默认 / 液态玻璃 / 毛玻璃 / 亚克力 / 道系 / 云间天上）与配色、渲染显卡（GPU，决定云朵 / 动画用哪块卡）、窗口背景图、主页显示、鼠标自动 / 点击特效（含数量 / 范围 / 半径滑块）、粒子颜色、窗口与托盘、开机自启、打开方式关联；最下面是清理缓存与重建配置（恢复默认设置）。改一下立即生效并自动保存。" />
                </StackPanel>
                <Button Grid.Column="1" Content="返回主页" Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Top" Command="{Binding GoHomeCommand}" ToolTip="回到主页（也可以点面包屑的「🏠 主页」或后退按钮）" />
            </Grid>

            <!-- ===== 外观模式（v0.89.0：深色 / 浅色 / 跟随系统） ===== -->
            <TextBlock Text="外观模式" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="深色 / 浅色 / 跟随系统，对所有界面风格生效。「跟随系统」= 跟 Windows 设置 → 个性化 → 颜色里的「应用模式」；改 Windows 设置后本程序会在几秒内自动跟上。" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="ThemeMode"
                                     Content="深色" IsChecked="{Binding DarkModeSelected}" Margin="0,0,26,0"
                                     ToolTip="深色：所有界面风格都使用深色 token" />
                        <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="ThemeMode"
                                     Content="浅色" IsChecked="{Binding LightModeSelected}" Margin="0,0,26,0"
                                     ToolTip="浅色：所有界面风格都使用浅色 token（玻璃风格会变成浅色玻璃）" />
                        <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="ThemeMode"
                                     Content="跟随系统" IsChecked="{Binding SystemModeSelected}"
                                     ToolTip="跟随 Windows 的应用模式；系统切换深浅色后自动刷新" />
                    </StackPanel>
                    <TextBlock Text="{Binding ThemeModeHint}" FontSize="11"
                               Foreground="{DynamicResource FaintTextBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== 界面风格 ===== -->
            <TextBlock Text="界面风格" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="UiTheme"
                                 AutomationProperties.Name="默认（纯色）"
                                 IsChecked="{Binding DefaultThemeSelected}"
                                 ToolTip="经典纯色界面：最省资源（第一套 UI）；深浅色随上面的「外观模式」">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="32" CornerRadius="7" Background="#16181D"
                                    BorderBrush="#2C333F" BorderThickness="1" Margin="0,0,10,0">
                                <StackPanel Margin="7,6">
                                    <Border Height="7" CornerRadius="2" Background="#2A3242" />
                                    <Border Height="5" CornerRadius="2" Background="#1F242C" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="默认（纯色）" FontWeight="SemiBold" />
                                <TextBlock Text="经典纯色面板，最省资源" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="UiTheme"
                                 AutomationProperties.Name="液态玻璃（实验）"
                                 IsChecked="{Binding LiquidGlassThemeSelected}" Margin="0,12,0,0"
                                 ToolTip="液态玻璃：半透明玻璃面板 + 流动色彩光晕（参考 Glassium）；想配背景图用这个或下面两套">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="32" CornerRadius="7" BorderThickness="1" Margin="0,0,10,0"
                                    BorderBrush="#66FFFFFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3D7BFF" Offset="0" />
                                        <GradientStop Color="#8B5CF6" Offset="0.55" />
                                        <GradientStop Color="#FF5CD6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Margin="6,5" CornerRadius="4" Background="#55FFFFFF"
                                        BorderBrush="#99FFFFFF" BorderThickness="1" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="液态玻璃（实验）" FontWeight="SemiBold" />
                                <TextBlock Text="半透明玻璃 + 流动光晕，参考 Glassium" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <!-- 选中液态玻璃时，在它下面冒出「背景图模糊度」滑块（和点击效果的参数滑块同一个模板） -->
                    <ContentControl Content="{Binding LiquidGlassBlurOption}"
                                    ContentTemplate="{StaticResource EffectSliderTemplate}"
                                    Margin="25,0,0,2"
                                    Visibility="{Binding LiquidGlassThemeSelected, Converter={StaticResource BoolToVis}}" />

                    <!-- 毛玻璃（v0.43.0）：安静冷色调，背景图会被重模糊，没有动画光晕 -->
                    <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="UiTheme"
                                 AutomationProperties.Name="毛玻璃"
                                 IsChecked="{Binding FrostedGlassThemeSelected}" Margin="0,12,0,0"
                                 ToolTip="毛玻璃：奶白磨砂面板 + 重模糊背景，安静不花哨、不跑动画">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="32" CornerRadius="7" BorderThickness="1" Margin="0,0,10,0"
                                    BorderBrush="#8CFFFFFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#C7DDF5" Offset="0" />
                                        <GradientStop Color="#8FA9C8" Offset="0.55" />
                                        <GradientStop Color="#5E748F" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Margin="6,5" CornerRadius="4" Background="#8CFFFFFF"
                                        BorderBrush="#B3FFFFFF" BorderThickness="1" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="毛玻璃" FontWeight="SemiBold" />
                                <TextBlock Text="奶白磨砂 + 重模糊背景，安静省电" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <!-- 选中毛玻璃时，在它下面冒出「背景图模糊度」滑块 -->
                    <ContentControl Content="{Binding FrostedGlassBlurOption}"
                                    ContentTemplate="{StaticResource EffectSliderTemplate}"
                                    Margin="25,0,0,2"
                                    Visibility="{Binding FrostedGlassThemeSelected, Converter={StaticResource BoolToVis}}" />

                    <!-- 亚克力（v0.43.0）：深色着色 + 轻模糊 + 颗粒噪点 -->
                    <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="UiTheme"
                                 AutomationProperties.Name="亚克力"
                                 IsChecked="{Binding AcrylicThemeSelected}" Margin="0,12,0,0"
                                 ToolTip="亚克力：深色着色玻璃 + 轻模糊 + 细颗粒噪点，类似 Win11 亚克力">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="32" CornerRadius="7" BorderThickness="1" Margin="0,0,10,0"
                                    BorderBrush="#7AA08CFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2A2140" Offset="0" />
                                        <GradientStop Color="#3B2F5C" Offset="0.55" />
                                        <GradientStop Color="#1B1730" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Margin="6,5" CornerRadius="4" Background="#3DA08CFF"
                                        BorderBrush="#8CA08CFF" BorderThickness="1" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="亚克力" FontWeight="SemiBold" />
                                <TextBlock Text="深色着色 + 轻模糊 + 颗粒，类似 Win11 亚克力" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <!-- 选中亚克力时，在它下面冒出「背景图模糊度」滑块 -->
                    <ContentControl Content="{Binding AcrylicBlurOption}"
                                    ContentTemplate="{StaticResource EffectSliderTemplate}"
                                    Margin="25,0,0,2"
                                    Visibility="{Binding AcrylicThemeSelected, Converter={StaticResource BoolToVis}}" />

                    <!-- 道系（墨金，v0.89.0）：参考道阶表——玄墨底 + 香槟金 + 远山 + 金色光晕 -->
                    <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="UiTheme"
                                 AutomationProperties.Name="道系（墨金）"
                                 IsChecked="{Binding DaojiThemeSelected}" Margin="0,12,0,0"
                                 ToolTip="道系（墨金）：玄墨底 + 香槟金 + 远山剪影 + 金色光晕，参考道阶表；支持深浅色">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="32" CornerRadius="7" BorderThickness="1" Margin="0,0,10,0"
                                    BorderBrush="#8C8A6A2F">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0C0A07" Offset="0" />
                                        <GradientStop Color="#2A2116" Offset="0.65" />
                                        <GradientStop Color="#0C0A07" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Ellipse Width="9" Height="9" Fill="#D6B26A" HorizontalAlignment="Right"
                                             VerticalAlignment="Top" Margin="0,6,7,0" />
                                    <Polygon Points="4,28 13,18 20,24 29,14 44,28" Fill="#33D6B26A"
                                             VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="道系（墨金）" FontWeight="SemiBold" />
                                <TextBlock Text="玄墨 + 香槟金、远山与金色光晕" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <!-- 云间天上（v0.90.0）：白天淡蓝天空 + 云朵 + 暖阳；夜晚星空 + 暗云 + 月亮 -->
                    <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="UiTheme"
                                 AutomationProperties.Name="云间天上"
                                 IsChecked="{Binding CloudSkyThemeSelected}" Margin="0,12,0,0"
                                 ToolTip="云间天上：浅色 = 白到淡蓝的天空 + 平铺云朵 + 暖阳；深色 = 夜空 + 暗云 + 月亮星星">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="32" CornerRadius="7" BorderThickness="1" Margin="0,0,10,0"
                                    BorderBrush="#8CD8E9F8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#CFE4F7" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Ellipse Width="12" Height="12" Fill="#F4E3BC" HorizontalAlignment="Right"
                                             VerticalAlignment="Top" Margin="0,5,7,0" />
                                    <Ellipse Width="5" Height="5" Stroke="#C9A227" StrokeThickness="0.8"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" />
                                    <Path Data="{StaticResource CloudPreviewShape}" Fill="#FFFFFF"
                                          VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5,0,0,5" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="云间天上" FontWeight="SemiBold" />
                                <TextBlock Text="白天云海 + 暖阳，夜里星空 + 月亮" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <!-- 云间天上：速度 / 密度滑块直接跟在主题选项下面（和亚克力下面的背景图模糊度同一种位置关系） -->
                    <StackPanel Margin="25,4,0,2"
                                Visibility="{Binding CloudSkyThemeSelected, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding CloudSliders}"
                                      ItemTemplate="{StaticResource EffectSliderTemplate}" />
                    </StackPanel>

                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="换主题立即生效、不用重启；选择会自动存进 Config\shell\config.json 的 uiTheme。液态玻璃 / 毛玻璃 / 亚克力是半透明面板，能透出下面的背景图；道系有远山 + 金色光晕，云间天上会按深浅画云 / 太阳 / 月亮星空，这两个主题也可以放背景图（会盖住装饰）；默认是纯色面板。选中半透明风格后，它下面会出现「背景图模糊度」滑块（0 = 清晰，最大 60 px；三套风格各记各的值）；选中云间天上后会出现「云朵速度 / 密度」滑块。深浅色由上面的「外观模式」统一控制，六套风格都支持。" />
                </StackPanel>
            </Border>

            <!-- ===== 渲染与性能（v0.96.0）：选择画界面 / 云朵用哪块显卡 ===== -->
            <TextBlock Text="渲染与性能" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="渲染显卡" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="云间天上的云朵、液态玻璃的光晕、粒子这些动画都由 WPF 画。Windows 默认可能把本程序分给核显（甚至退回软件渲染），云朵就会卡；这里可以指定优先用高性能独显。选项会写进 Windows「设置 → 系统 → 显示 → 图形」里本程序的图形首选项（同一份数据），改完需要重启本程序才生效。" />
                    <ComboBox Style="{StaticResource ComboBoxStyle}" Margin="0,10,0,0"
                              ItemsSource="{Binding RenderGpuOptions}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedRenderGpuId}"
                              ToolTip="自动 = 让 Windows 决定；高性能 = 优先独显；节能 = 优先核显；软件渲染 = 完全不用显卡（仅排查用）">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding RenderGpuOptionDescription}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding RenderGpuAdapterText}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding RenderGpuStatusText}" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="重启本程序" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RestartAppCommand}"
                                IsEnabled="{Binding RenderGpuRestartPending}"
                                ToolTip="渲染设置是「下次启动生效」：点这里自动重启（先把设置存盘）" />
                        <Button Content="打开 Windows 图形设置" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding OpenWindowsGraphicsSettingsCommand}"
                                ToolTip="打开系统自带的「图形设置」页面，可以核对本程序当前是自动 / 高性能 / 节能" />
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource FaintTextBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="提示：切换后可以按 Ctrl+Shift+Esc 打开任务管理器，在「性能 → GPU」看本程序的占用落在哪块卡上。有的笔记本显示器接在核显上、又没有 MUX 开关，Windows 仍可能只让 WPF 用核显 —— 这是系统 / 驱动的限制，不是这里的设置没保存；这种情况下把云朵密度调小（1 ~ 20）比换卡更有效。" />
                </StackPanel>
            </Border>

            <!-- ===== 配色（v0.89.0：只作用于默认风格；预设 + 自定义） ===== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14"
                    Visibility="{Binding DefaultThemeSelected, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="配色方案（仅默认风格）" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="给「默认（纯色）」风格换一套色系：多套预设 + 自己配色。每套都带深 / 浅两版，跟着上面的外观模式走；切到玻璃三套或道系时配色会保留、但不生效。" />

                    <ItemsControl ItemsSource="{Binding PaletteOptions}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource RadioButtonStyle}" GroupName="ThemePalette"
                                             IsChecked="{Binding IsSelected}" Margin="0,0,16,12"
                                             ToolTip="{Binding Description}">
                                    <StackPanel Width="188">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Border Width="20" Height="20" CornerRadius="5"
                                                    Background="{Binding AccentBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Margin="0,0,5,0" />
                                            <Border Width="20" Height="20" CornerRadius="5"
                                                    Background="{Binding DarkBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Margin="0,0,5,0" />
                                            <Border Width="20" Height="20" CornerRadius="5"
                                                    Background="{Binding LightBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 自定义配色：三个拾色器（主色 / 深色底 / 浅色底），其余颜色自动配 -->
                    <StackPanel Visibility="{Binding IsCustomPaletteSelected, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="主色" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <views:ColorPickerButton SelectedColor="{Binding CustomAccentColor, Mode=TwoWay}"
                                                         Margin="0,5,0,0" ToolTip="按钮、选中态、标签等强调色" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                <TextBlock Text="深色底色" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <views:ColorPickerButton SelectedColor="{Binding CustomDarkBackgroundColor, Mode=TwoWay}"
                                                         Margin="0,5,0,0" ToolTip="深色模式下的窗口底色；卡片 / 文字会自动配对比度" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="22,0,0,0">
                                <TextBlock Text="浅色底色" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <views:ColorPickerButton SelectedColor="{Binding CustomLightBackgroundColor, Mode=TwoWay}"
                                                         Margin="0,5,0,0" ToolTip="浅色模式下的窗口底色；卡片 / 文字会自动配对比度" />
                            </StackPanel>
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="自定义只需挑「主色 + 两种底色」，卡片、描边、悬停、文字明暗都会自动算；主色会按底色自动校正对比度，保证浅底 / 深底都读得清。" />
                    </StackPanel>

                    <TextBlock FontSize="11" Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="配色只影响「默认」风格；液态玻璃 / 毛玻璃 / 亚克力 / 道系 / 云间天上 有各自固定的配色（切换风格时不会丢你的配色，切回默认又生效）。" />
                </StackPanel>
            </Border>

            <!-- ===== 背景图（v0.43.0）：上传一张图片铺在窗口最底层，半透明风格下面板能透出来 ===== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="背景图" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="上传一张图片铺在窗口最底层（不是桌面壁纸，只影响这个程序）。图片会复制一份到 Data\shell\background\，之后原图移动 / 删除都不影响；换图 / 清除时旧图会保留在下面的历史里，随时可以点回来。背景自适应窗口、不拉伸：默认铺满窗口（保持比例，多出来的部分裁掉），也可以勾「完整显示整张图」改成四周留边。" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 缩略图预览（没有背景图时显示占位文字） -->
                        <Border Width="208" Height="117" CornerRadius="10" ClipToBounds="True"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Image Source="{Binding BackgroundImageSource}" Stretch="UniformToFill" />
                                <TextBlock Text="还没有背景图" FontSize="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}"
                                           Visibility="{Binding HasBackgroundImage, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding BackgroundImageInfoText}" FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Content="选择图片…" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ChooseBackgroundImageCommand}"
                                        ToolTip="支持 PNG / JPG / BMP / GIF / TIFF；选好立即生效并自动保存" />
                                <Button Content="清除当前背景图" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding ClearBackgroundImageCommand}"
                                        IsEnabled="{Binding HasBackgroundImageSetting}"
                                        ToolTip="只停用当前背景图，图片文件仍保留在下面的历史里" />
                            </StackPanel>
                            <CheckBox Content="完整显示整张图（不裁剪，可能留边）" Style="{StaticResource CheckBoxStyle}"
                                      Margin="0,11,0,0" IsChecked="{Binding BackgroundImageFitWhole}"
                                      IsEnabled="{Binding HasBackgroundImage}"
                                      ToolTip="勾选 = 整张图完整显示（按窗口比例缩放、四周可能留黑边）；不勾 = 铺满窗口、保持比例、裁掉超出部分。两种都不拉伸变形" />
                            <TextBlock Text="{Binding BackgroundImageThemeHint}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="用过的背景图（点一下切回）" FontSize="11.5" FontWeight="SemiBold"
                               Margin="0,12,0,6" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding BackgroundImageHistory}"
                                      ItemTemplate="{StaticResource ImageHistoryTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ===== 鼠标光标（v0.91.0）：应用内自绘光标 / 主题样式 / 上传图片 / 历史 ===== -->
            <TextBlock Text="鼠标光标" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <CheckBox Content="使用应用内光标" Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding UseInAppCursor}"
                              ToolTip="开启后隐藏系统光标，由程序自己画一个跟随鼠标的光标；关闭则恢复 Windows 光标" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="开启后，窗口内的鼠标由程序自己绘制（系统光标隐藏）。不同界面主题各有一套内置样式，而且深 / 浅色各有一套配色：浅色界面自动换成深色系（深色箭头 / 深色玻璃 / 墨金底），深色界面用浅色箭头，默认不用手动选，也可以在「光标深浅」里强制指定；还可以上传一张小图片当光标，图片会复制进 Data\shell\cursor\，历史图片不会删除。应用内光标会被粒子拖尾 / 点击爆炸 / 反色圆环等特效盖住，不会挡住它们。" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="光标样式" FontSize="12.5" FontWeight="SemiBold" />
                            <ComboBox Style="{StaticResource ComboBoxStyle}" Margin="0,6,0,0"
                                      ItemsSource="{Binding CursorStyleOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedCursorStyleId}"
                                      ToolTip="跟随界面主题 = 自动按当前主题换；也可以固定一套或选自定义图片。每套内置样式都有深 / 浅两套配色，自动跟外观模式">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding CursorStyleDescription}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />

                            <TextBlock Text="光标深浅" FontSize="12.5" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <ComboBox Style="{StaticResource ComboBoxStyle}" Margin="0,6,0,0"
                                      AutomationProperties.Name="光标深浅"
                                      ItemsSource="{Binding CursorToneOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedCursorToneId}"
                                      ToolTip="跟随界面主题 = 浅色界面用深色系、深色界面用浅色系；也可以强制光标一直用浅色系或深色系。只影响内置箭头，自定义图片原样绘制">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding CursorToneDescription}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="64" Height="64" Margin="14,0,0,0"
                                CornerRadius="8" Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                ClipToBounds="True">
                            <Image Source="{Binding CustomCursorImageSource}" Stretch="Uniform"
                                   Margin="8" ToolTip="当前自定义光标图" />
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="上传光标图片…" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ChooseCursorImageCommand}"
                                ToolTip="支持 PNG / JPG / BMP / GIF / TIFF；建议透明底小图（≤ 64×64），选好会复制进数据目录并自动启用" />
                        <Button Content="清除光标图片" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding ClearCursorImageCommand}"
                                IsEnabled="{Binding HasCustomCursorImageSetting}"
                                ToolTip="清除当前自定义图片，光标样式回到「跟随界面主题」；历史图片仍保留" />
                    </StackPanel>
                    <TextBlock Text="{Binding CursorImageInfoText}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Text="用过的光标图（点一下切回）" FontSize="11.5" FontWeight="SemiBold"
                               Margin="0,12,0,6" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CursorImageHistory}"
                                      ItemTemplate="{StaticResource ImageHistoryTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ===== 主页显示 ===== -->
            <TextBlock Text="主页显示" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <CheckBox Content="显示标签快捷筛选条" Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding ShowHomeTags}"
                              ToolTip="主页「全部分类」下面那块标签墙；关掉后整块隐藏（搜索框仍然能按标签搜到功能）" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="主页分类下面那块「快速筛选」标签墙。标签有一百多个，默认只排 3 行 + 横向滚动条，点「展开全部」才会按原来的换行方式铺开。觉得占地方就关掉它：整块标签会隐藏，搜索框仍然能按标签搜到功能（标签本身不会被删）。存 Config\shell\config.json 的 showHomeTags，重启后保持。" />
                </StackPanel>
            </Border>

            <!-- ===== 自动效果（可多选，也可以全不选） ===== -->
            <TextBlock Text="自动效果" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="鼠标移动时持续生效的特效，可以同时勾选多个；全部不勾 = 没有任何自动效果（仍然可以单独开下面的点击效果）。" />
                    <ItemsControl ItemsSource="{Binding AutoEffectOptions}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,7,0,0">
                                    <CheckBox Style="{StaticResource CheckBoxStyle}"
                                              Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding Description}" />
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="25,2,0,0" />
                                    <!-- 这个特效自己的参数：勾选后才出现，嵌在勾选框正下方 -->
                                    <StackPanel Margin="25,4,0,2"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Sliders}"
                                                      ItemTemplate="{StaticResource EffectSliderTemplate}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 点击效果（可多选；与自动效果无关） ===== -->
            <TextBlock Text="点击效果" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="鼠标按下时触发一次的特效，可以同时勾选多个（例如既爆炸粒子、又散光 + 反色）；和自动效果完全独立：自动效果关掉时点击效果照常生效。" />
                    <ItemsControl ItemsSource="{Binding ClickEffectOptions}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,7,0,0">
                                    <CheckBox Style="{StaticResource CheckBoxStyle}"
                                              Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding Description}" />
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="25,2,0,0" />
                                    <!-- 这个特效自己的参数：勾选后才出现，嵌在勾选框正下方 -->
                                    <StackPanel Margin="25,4,0,2"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Sliders}"
                                                      ItemTemplate="{StaticResource EffectSliderTemplate}" />

                                        <!-- 反色圆环专属开关：两圈重叠时再反一次变回正色（v0.37.2） -->
                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding IsInvertCircle, Converter={StaticResource BoolToVis}}">
                                            <CheckBox Content="两圆重叠时变回正色" Style="{StaticResource CheckBoxStyle}"
                                                      IsChecked="{Binding DataContext.InvertCircleOverlapCancels,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      ToolTip="勾选：两个反色圆叠在同一片区域时，重叠处会再反一次 → 恢复原来的颜色（像橡皮一样互相抵消）。" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="25,2,0,0"
                                                       Text="勾选 = 重叠处变回正色（反色反两次就是原色，3 圈及以上按覆盖次数的奇偶算）；不勾 = 后触发的圆直接盖住先前的，重叠处仍是反色。" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 粒子颜色 ===== -->
            <TextBlock Text="粒子颜色" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14"
                    IsEnabled="{Binding HasParticleEffectSelected}">
                <StackPanel>
                    <CheckBox Content="启用自定义颜色" Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding ParticleCustomColorsEnabled}"
                              ToolTip="关掉时用默认的淡紫白粒子" />
                    <StackPanel IsEnabled="{Binding ParticleCustomColorsEnabled}" Margin="0,2,0,0">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="颜色 1" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding ParticleColor1Enabled}" VerticalAlignment="Center"
                                      ToolTip="取消勾选 = 不使用这个颜色" />
                            <views:ColorPickerButton Grid.Column="1" Margin="12,0,0,0"
                                                     HorizontalAlignment="Left"
                                                     SelectedColor="{Binding ParticleColor1Value, Mode=TwoWay}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="颜色 2" Style="{StaticResource CheckBoxStyle}"
                                      IsChecked="{Binding ParticleColor2Enabled}" VerticalAlignment="Center"
                                      ToolTip="取消勾选 = 不使用这个颜色" />
                            <views:ColorPickerButton Grid.Column="1" Margin="12,0,0,0"
                                                     HorizontalAlignment="Left"
                                                     SelectedColor="{Binding ParticleColor2Value, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="两种颜色都勾选：每颗粒子在两种颜色之间随机取色（渐变过渡）；只勾选一种：固定用那种颜色（单色）；两种都不勾：回到默认的淡紫白。颜色对「粒子拖尾」「粒子爆炸」生效；散光 / 闪光会取颜色 1 作为主色调。" />
                    </StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="只勾了散光 / 闪光 / 反色（没有粒子类效果）时这里不可用 —— 粒子颜色对它们没有影响。"
                               Visibility="{Binding HasParticleEffectSelected, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ===== 窗口与托盘 ===== -->
            <TextBlock Text="窗口与托盘" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="点击右上角 × 时" FontSize="12.5" FontWeight="SemiBold" />
                    <RadioButton Content="关闭应用" Style="{StaticResource RadioButtonStyle}"
                                 IsChecked="{Binding ExitOnClose}" Margin="0,9,0,0"
                                 ToolTip="和以前一样：直接退出程序" />
                    <RadioButton Content="最小化到托盘" Style="{StaticResource RadioButtonStyle}"
                                 IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,9,0,0"
                                 ToolTip="窗口藏到任务栏右侧，应用继续在后台运行" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,9,0,0"
                               Text="选「最小化到托盘」后，× 只把窗口藏到任务栏右侧的小图标里，应用继续在后台运行：单击 / 双击托盘图标恢复窗口，右键托盘图标可以「显示主窗口 / 主页设置 / 退出」。设置自动保存，重启后保持。" />
                </StackPanel>
            </Border>

            <!-- ===== 开机自启（v0.99.0） ===== -->
            <TextBlock Text="开机自启" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <CheckBox Content="开机后自动启动凉雨工具集"
                              Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding StartWithWindows}"
                              ToolTip="写一条当前用户的开机启动项（HKCU\…\CurrentVersion\Run），不需要管理员权限；关掉就立刻删掉" />

                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,9,0,0"
                               Text="默认关闭。打开后会往注册表里登记一条指向当前程序的位置，开机登录 Windows 后自动启动；任务管理器 → 启动 里也能看到这一项（在那里禁用同样有效）。程序换过目录 / 重新编译过时，下次启动会自动把这条登记刷新成新的位置。关掉时会把那条登记删掉，并清掉任务管理器里「已禁用」的残留记录，下次再打开就能正常启动。" />

                    <TextBlock Text="{Binding StartupStatusText}" FontSize="11.5"
                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,9,0,0"
                               Visibility="{Binding StartupStatusText, Converter={StaticResource EmptyToVisInverse}}" />
                </StackPanel>
            </Border>

            <!-- ===== 打开方式关联（v0.79.0） ===== -->
            <TextBlock Text="打开方式关联" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <CheckBox Content="在右键「打开方式」里显示凉雨工具集（3 个入口）"
                              Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding OpenWithAssociationEnabled}"
                              IsEnabled="{Binding OpenWithAssociationAvailable}"
                              ToolTip="打开 / 关闭后立即写当前用户注册表；关闭后每次启动还会自动清理 Windows 记住的旧条目" />

                    <TextBlock Text="{Binding OpenWithAssociationHint}" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,9,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="清理打开方式关联" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearOpenWithAssociationCommand}"
                                ToolTip="立即删掉本工具写进注册表的「打开方式」入口和入口副本 exe，并把上面的开关关掉（Debug 构建也能用）" />
                    </StackPanel>

                    <TextBlock Text="{Binding OpenWithStatusText}" FontSize="11.5"
                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,9,0,0"
                               Visibility="{Binding OpenWithStatusText, Converter={StaticResource EmptyToVisInverse}}" />
                </StackPanel>
            </Border>

            <!-- ===== 清理缓存（v0.39.0；列表由 Core/Maintenance 按已发现工具现算，新工具自动加入） ===== -->
            <TextBlock Text="清理缓存" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="缓存是各功能放在 Cache\&lt;功能Id&gt;\ 里、随时可以删的临时文件（缩略图、解压产物、网络缓存…），删了最多下次重新生成。列表里也包括存在 Config 里的「最近浏览 / 最近会话」这类记录。Data 里的下载内容 / 聊天记录等用户数据、各功能的设置都不会被清掉。" />
                    <TextBlock Text="{Binding Maintenance.CacheSummaryText}" FontSize="12" FontWeight="SemiBold"
                               Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="全选" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding Maintenance.SelectAllCacheCommand}" />
                        <Button Content="全不选" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding Maintenance.SelectNoneCacheCommand}" />
                        <Button Content="重新扫描" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                ToolTip="重新看一下 Cache 和配置目录（在资源管理器里手动删过东西时用）"
                                Command="{Binding Maintenance.RefreshCommand}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Maintenance.CacheItems}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ToolName}" FontSize="12.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text=" · " FontSize="12.5" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="25,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Maintenance.CacheEmptyHint}" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Maintenance.HasCacheItems, Converter={StaticResource InverseBoolToVis}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="清理选中缓存" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding Maintenance.ClearCacheCommand}"
                                ToolTip="清掉勾选的缓存（会先弹确认）；图片 / PDF 阅读器的最近浏览、聊天室的最近会话也会一起清" />
                        <Button Content="打开缓存文件夹" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                                Command="{Binding Maintenance.OpenCacheFolderCommand}"
                                ToolTip="在资源管理器里打开 Cache 目录，可以自己看 / 手动删" />
                    </StackPanel>

                    <TextBlock Text="{Binding Maintenance.CacheStatusText}" FontSize="11.5"
                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Maintenance.CacheStatusText, Converter={StaticResource EmptyToVisInverse}}" />
                </StackPanel>
            </Border>

            <!-- ===== 重建配置（v0.39.0；一个功能一行，可全选；第一行是主页设置自己的外壳配置） ===== -->
            <TextBlock Text="重建配置（恢复默认设置）" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="重建 = 删掉这些功能的 Config\&lt;功能Id&gt;\ 里的配置文件，并把内存里已加载的配置改回默认值（会立刻写回一份默认 JSON）—— 效果等于「恢复默认设置」，重启后也保持。勾选要重建的功能（或点「全选」）后点下面的按钮；第一项是「主页 / 外壳设置」，重建它会把这个设置页里的选项也一起恢复默认。损坏备份 *.bad-*.json 不会被删。" />
                    <TextBlock Text="{Binding Maintenance.ConfigSummaryText}" FontSize="12" FontWeight="SemiBold"
                               Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="全选" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding Maintenance.SelectAllConfigCommand}" />
                        <Button Content="全不选" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding Maintenance.SelectNoneConfigCommand}" />
                        <Button Content="重新扫描" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                ToolTip="重新看一下各功能的配置目录（在资源管理器里手动删过东西时用）"
                                Command="{Binding Maintenance.RefreshCommand}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Maintenance.ConfigItems}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                                  Content="{Binding ToolName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="25,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Maintenance.ConfigEmptyHint}" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Maintenance.HasConfigItems, Converter={StaticResource InverseBoolToVis}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="重建选中配置" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding Maintenance.ResetConfigCommand}"
                                ToolTip="删掉勾选功能的配置文件并恢复默认设置（会先弹确认）" />
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="注意：重建会丢掉自定义过的选项（只删配置文件，不动 Data 里的用户数据）。点按钮后还会再确认一次。" />

                    <TextBlock Text="{Binding Maintenance.ConfigStatusText}" FontSize="11.5"
                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Maintenance.ConfigStatusText, Converter={StaticResource EmptyToVisInverse}}" />
                </StackPanel>
            </Border>

            <!-- ===== 快捷键（全局热键汇总：分类 → 工具 → 快捷键，可改键 / 拆分合并 / 启停） ===== -->
            <TextBlock Text="快捷键" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="全程序的全局快捷键汇总（按分类 → 工具排列，点标题前面的 ▼ / ▶ 折叠）。点框就能改键：必须同时按住组合键，全部松开后才确定；想要「Ctrl+K 然后 Ctrl+C」这种分两步的，点「拆分」再录第二步，点「合并」并回一条。每条都能单独禁用，每个工具也能整体关掉 —— 快捷键多了之后只留自己想用的。改一下立即生效并自动保存。" />

                    <!-- 分步快捷键的等待时长（全程序统一） -->
                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="分步快捷键：两步之间等多久" FontSize="11.5" FontWeight="SemiBold" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="500" Maximum="30000"
                                        SmallChange="500" LargeChange="2500"
                                        IsSnapToTickEnabled="True" TickFrequency="500"
                                        Value="{Binding ShortcutSequenceTimeoutMs, Mode=TwoWay}"
                                        IsEnabled="{Binding SequenceTimeoutUnlimited, Converter={StaticResource InverseBoolConverter}}"
                                        Style="{StaticResource SliderStyle}" />
                                <TextBlock Grid.Column="1" MinWidth="62" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding ShortcutSequenceTimeoutText}" />
                            </Grid>

                            <CheckBox Content="不限时（按下第一步后一直等，直到按对第二步或按错为止）"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,8,0,0"
                                      IsChecked="{Binding SequenceTimeoutUnlimited, Mode=TwoWay}" />

                            <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="这一项是全程序统一的（不按工具分开）。等待期间按了不匹配的键会作废并提示「未被识别的快捷键」——那一下不会传给前台程序，避免在编辑器里多打一个字符。" />
                        </StackPanel>
                    </Border>

                    <views:ShortcutsSettingsView DataContext="{Binding ShortcutRegistry}" />
                </StackPanel>
            </Border>

            <!-- ===== 日期时间显示（v1.46.0：标题栏右上角的日期 / 时间 + 点击弹日历） ===== -->
            <TextBlock Text="日期时间显示" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="窗口右上角显示日期和时间，点一下能弹出一个小日历。显示哪个时区由「全球时钟」工具决定（在那边右键某只钟选「让标题栏显示这一只」）。" />

                    <CheckBox Content="显示日期（2026年11月13日 周五）" Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding ShowTitleBarDate, Mode=TwoWay}" />
                    <CheckBox Content="显示时间（14:05:09）" Style="{StaticResource CheckBoxStyle}"
                              Margin="0,8,0,0"
                              IsChecked="{Binding ShowTitleBarTime, Mode=TwoWay}" />

                    <TextBlock FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding TitleBarClockSourceText}" />

                    <TextBlock FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="两个都关掉，右上角就整块隐藏。改一下立即生效并自动保存。" />
                </StackPanel>
            </Border>

            <!-- ===== 界面布局（v0.41.0：工具页可拖拽分隔条的尺寸记忆，一键恢复默认） ===== -->
            <TextBlock Text="界面布局" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="有多个区块的工具页，区块之间可以拖动调整大小（跟画图软件拉图形一样）：鼠标移到区块之间的缝隙上，会亮起一条蓝色竖线 / 横线，光标变成 ↔ / ↕，按住拖动即可。松手后自动记住（存在 Config\layout.json），下次打开还是调好的样子；双击某一条分隔条只恢复那一处。下面可以一次把所有页面恢复成默认布局。" />

                    <!-- v0.66.0：左侧功能列表栏的显隐 + 右边缘拖宽 -->
                    <CheckBox Content="显示左侧「功能列表」栏" Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding ShowSidebar}" Margin="0,14,0,0"
                              ToolTip="关掉后左侧功能列表整块收起、内容区占满宽度；想再打开就回这个设置页重新勾上（隐藏后可从面包屑「主页」回主页 → 设置）" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="左侧功能列表栏的右边缘可以按住左右拖动（光标变成 ↔）：松手自动记住（Config\layout.json），双击那条缝恢复默认宽度 232。关掉上面的开关时它和分隔条一起收起；拖过的宽度会保留，重新勾上还是那个宽度。" />

                    <!-- v0.88.0：左侧快捷功能栏（自定义常用功能） -->
                    <CheckBox Content="启用左侧「快捷功能栏」（自定义常用功能）" Style="{StaticResource CheckBoxStyle}"
                              IsChecked="{Binding QuickSidebarEnabled}" Margin="0,14,0,0"
                              ToolTip="启用后左侧只显示「首页 + 你放进去的功能」；从主页拖动功能卡片到左侧即可添加，侧栏条目右侧的 ⋮ 上下拖动排序、✕ 移除。关掉恢复完整功能列表（快捷栏内容会保留）。" />
                    <TextBlock Text="{Binding QuickSidebarSummary}" FontSize="11"
                               Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分隔条提示线（鼠标不在上面时）" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                                Style="{StaticResource SliderStyle}" Minimum="0" Maximum="100"
                                Value="{Binding SplitterHintOpacity}"
                                ToolTip="0 = 平时完全看不见（只能靠光标找缝隙）；100 = 一直显示一条实心蓝线；默认 18" />
                        <TextBlock Grid.Column="2" Text="{Binding SplitterHintOpacityText}" MinWidth="42"
                                   TextAlignment="Right" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="提示线是鼠标没放上去时那条淡蓝线，用来找缝隙：0% = 完全看不见；默认 18%（淡淡的）；100% = 一直显示实心蓝线。改一下所有工具页立即生效，自动保存。" />
                    <TextBlock Text="{Binding Maintenance.LayoutSummaryText}" FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="恢复默认布局" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding Maintenance.ResetLayoutCommand}"
                                ToolTip="清掉所有工具页记住的分隔条尺寸（会先弹确认）；只影响区块大小，不动任何设置 / 缓存 / 数据" />
                    </StackPanel>
                    <TextBlock Text="{Binding Maintenance.LayoutStatusText}" FontSize="11.5"
                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Maintenance.LayoutStatusText, Converter={StaticResource EmptyToVisInverse}}" />
                </StackPanel>
            </Border>

            <!-- ===== 配置导入导出（把设置 + 表情图打包成一个 zip，换电脑 / 备份用） ===== -->
            <TextBlock Text="配置导入导出" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,22,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="把当前所有设置打包成一个 zip，换台电脑 / 备份 / 分享给别人时用。导出内容：所有功能的配置文件（含这个设置页的选项、界面布局记忆）+ 表情包收藏的图片、主页背景图 / 光标图、启动器图标等个人数据。" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="导入是覆盖式的：包里有的配置会盖掉本地同名功能的设置（点按钮后先弹一个预览框，确认才开始写）。图片不覆盖本地同名文件，重名的自动编号成「名字 (1)」两份都留着。缓存、下载的游戏、聊天记录、播放器播放列表不进包。" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="含账号凭据的三份配置（邮箱代收的授权码、Spug 验证码的推送地址、osu! 下图器的客户端密钥）不会导出，导入时也会跳过 —— 换机器后请重新填一次。" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="导出配置…" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding Maintenance.ExportConfigCommand}"
                                ToolTip="选一个保存位置，把当前所有设置和个人数据打包成 zip" />
                        <Button Content="导入配置…" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                                Command="{Binding Maintenance.ImportConfigCommand}"
                                ToolTip="选一个配置包 zip，先看预览确认，再覆盖式还原（主题 / 背景 / 布局立即生效，渲染显卡设置要重启）" />
                    </StackPanel>

                    <TextBlock Text="{Binding Maintenance.ArchiveStatusText}" FontSize="11.5"
                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Maintenance.ArchiveStatusText, Converter={StaticResource EmptyToVisInverse}}" />
                </StackPanel>
            </Border>

            <TextBlock FontSize="11" Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="主页设置只影响外壳本身（外观模式、界面风格、配色方案、渲染显卡、主页显示、自动 / 点击特效、粒子颜色、关闭行为等）；各功能自己的选项在对应功能页面里，也可以在「重建配置」里一键恢复默认。" />

            <Button Content="返回主页" Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Left" Margin="0,18,0,0" Command="{Binding GoHomeCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="YuLiangToolkit.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,26">

            <!-- ===== 标题 + 主页设置按钮 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="工具集主页" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                               Text="按类别浏览，或直接搜索名称 / 标签 / 描述；点类别卡片进分类页，左侧导航列出根层分类与工具。" />
                </StackPanel>

                <Button Grid.Column="1" Content="⚙ 主页设置" Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Top" Command="{Binding OpenSettingsCommand}"
                        ToolTip="打开主页设置页面（界面风格 / 自动与点击特效 / 粒子颜色 / 关闭行为）" />
            </Grid>

            <!-- ===== 搜索 + 排序条 ===== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="2,0,8,0" />

                    <!-- 搜索框（含占位提示；Esc 清空，Ctrl+F 聚焦） -->
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Height="34" Style="{StaticResource TextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按名称、分类、标签、描述、Id 搜索；空格分隔多个关键词（需同时命中）；Esc 清空，Ctrl+F 聚焦" />
                        <TextBlock Text="搜索功能…（名称 / 标签 / 描述，Ctrl+F）"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                    </Grid>

                    <Button Grid.Column="2" Content="✕" Padding="10,4" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" ToolTip="清空搜索（Esc）"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="排序" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                  DisplayMemberPath="Label" Style="{StaticResource ComboBoxStyle}"
                                  MinWidth="120" Margin="8,0,0,0"
                                  ToolTip="默认顺序 = 功能自带的优先级；最近使用 = 刚打开过的排最前（记录在 Config\shell\config.json，重启后保留）" />
                    </StackPanel>

                    <TextBlock Grid.Column="4" Text="{Binding FilterSummary}" VerticalAlignment="Center"
                               Margin="18,0,4,0" MinWidth="120" TextAlignment="Right" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- ===== 类别卡片（根层类别；搜索时隐藏） ===== -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowCategoryCards, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="全部分类" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="点进去看这一类里的工具（支持多层分类）" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding CategoryCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolCardButtonStyle}" Width="300" Margin="0,0,16,16"
                                    ToolTip="{Binding ToolTipText}"
                                    Command="{Binding DataContext.NavigateCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource EmojiTileBackgroundBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Emoji}" FontSize="24"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34" Margin="0,5,0,0"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding CountText}" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 标签快捷筛选（未搜索时显示；点标签即搜索）。放在分类之后：先让用户看到「音游工具」入口 ===== -->
            <StackPanel Margin="0,6,0,0" Visibility="{Binding ShowTagBar, Converter={StaticResource BoolToVis}}">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="快速筛选：点标签即搜索（标签就是卡片上那行蓝色小字，分类里的工具也能搜到）" />
                <ItemsControl ItemsSource="{Binding AllTags}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Margin="0,0,8,8"
                                    Style="{StaticResource TagChipButtonStyle}"
                                    Command="{Binding DataContext.SearchTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 工具卡片墙（主页根层工具 / 搜索结果） ===== -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowToolCards, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ToolSectionTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Text="点卡片直接打开；有分类的功能也可以用搜索直接找到" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ToolCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolCardButtonStyle}" Width="300" Margin="0,0,16,16"
                                    ToolTip="{Binding ToolTipText}"
                                    Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Tool}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource EmojiTileBackgroundBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Emoji}" FontSize="24"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding TagsText}" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding LastUsedText}" FontSize="10" Foreground="{DynamicResource FaintTextBrush}"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding ShowLastUsed, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 空状态（搜索无结果 / 主页没有任何工具） ===== -->
            <Border Style="{StaticResource CardStyle}" Padding="22,20" Margin="0,4,0,0"
                    Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="没有找到匹配的功能" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NoResultHint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="清空搜索" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearSearchCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- 开发提示 -->
            <TextBlock FontSize="11" Foreground="{DynamicResource FaintTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="开发提示：新增工具只需新建一个实现 ITool 的类（或把 dll 放进 plugins 目录），主程序会自动发现；给它加上 Tags 标签就能被搜索命中，再加上 CategoryPath（例如 new[] { &quot;音游工具&quot; }）就会自动收进对应类别页。详见 AGENTS.md。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="YuLiangToolkit.App.Views.ShortcutsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:YuLiangToolkit.Core.Controls;assembly=YuLiangToolkit.Core"
             Background="Transparent">

    <!-- 主页设置 → 快捷键（汇总页）。
         结构完全按需求：分类（▼/▶ 可折叠）→ 工具（▼/▶ 可折叠）→ 每条快捷键一行。
         一行里的形态（按设计稿）：
           · 分步：两个小框（第一步 / 第二步）+「合并」+「禁用 / 启用」+ 状态
           · 同时：一个大框 +「拆分」+「禁用 / 启用」+ 状态
         改键直接点框录（只认同按、全部松开定下来）；数据全在 Core 的 ShortcutRegistry 里。 -->

    <UserControl.Resources>

        <!-- 改键框样式：显式给出，不依赖 Core 程序集的隐式默认样式（跨程序集的默认样式要靠
             ThemeInfo + Generic.xaml，偶发不生效时整个框会看不见） -->
        <Style x:Key="HotkeyBoxLocalStyle" TargetType="controls:HotkeyBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:HotkeyBox">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="28">
                            <Grid>
                                <TextBlock Text="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}}"
                                           Margin="10,0,24,0" VerticalAlignment="Center" FontSize="12"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,9,0" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsCapturing" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 折叠标题（分类 / 工具共用）：自绘箭头，不用默认 Expander 的浅色三角。
             ⚠ 必须显式给 Foreground：ToggleButton 默认模板用的是系统控件前景（浅色主题下是黑），
             深色背景下会变成"看不见的黑字"（踩过）。 -->
        <Style x:Key="GroupToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,7">
                            <!-- ⚠ ContentPresenter 要显式继承 Foreground：模板里不给的话，
                                 ToggleButton 的默认前景（系统近黑色）会一路继承到里面的文字，
                                 深色背景上就成了看不见的黑字。 -->
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内小按钮（合并 / 拆分 / 禁用 / 启用） -->
        <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- 状态文字（已启用 / 已禁用） -->
        <Style x:Key="StateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- 工具条：统计 + 全部展开 / 收起 + 搜索 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" FontSize="11.5"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <TextBox Grid.Column="1" x:Name="SearchBox" Margin="14,0,10,0" MaxWidth="260"
                     HorizontalAlignment="Left" Width="220"
                     Style="{StaticResource TextBoxStyle}" Height="28"
                     TextChanged="OnSearchChanged"
                     ToolTip="按工具名 / 快捷键名筛选" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="全部展开" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4"
                        FontSize="11.5" Click="OnExpandAllClick" Margin="0,0,8,0" />
                <Button Content="全部收起" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4"
                        FontSize="11.5" Click="OnCollapseAllClick" />
            </StackPanel>
        </Grid>

        <!-- 树：分类 → 工具 → 快捷键 -->
        <ItemsControl ItemsSource="{Binding Groups}" x:Name="GroupList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,6">

                        <!-- ===== 分类标题（可折叠 ▼ / ▶） ===== -->
                        <ToggleButton Style="{StaticResource GroupToggleStyle}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ArrowGlyph}" FontSize="10"
                                           VerticalAlignment="Center" Width="14"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="2" FontSize="11" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Children.Count, StringFormat={}{0} 个工具}" />
                            </Grid>
                        </ToggleButton>

                        <!-- 分类内容：工具列表 -->
                        <ItemsControl ItemsSource="{Binding Children}" Margin="16,0,0,0"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">

                                        <!-- ===== 工具标题（可折叠 ▼ / ▶ + 该工具的快捷键总开关） ===== -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton Grid.Column="0" Style="{StaticResource GroupToggleStyle}"
                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ArrowGlyph}"
                                                               FontSize="9" VerticalAlignment="Center" Width="14"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ToolName}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CountText}"
                                                               FontSize="10.5" Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Grid>
                                            </ToggleButton>

                                            <!-- 整工具的快捷键总开关 -->
                                            <CheckBox Grid.Column="1" Content="本工具快捷键"
                                                      Style="{StaticResource CheckBoxStyle}"
                                                      FontSize="11" VerticalAlignment="Center"
                                                      Margin="10,0,10,0"
                                                      IsChecked="{Binding ToolShortcutsEnabled, Mode=TwoWay}"
                                                      ToolTip="关掉 = 这个工具的所有快捷键都不生效（单条的设置保留）" />
                                        </Grid>

                                        <!-- 工具内容：每条快捷键一行 -->
                                        <ItemsControl ItemsSource="{Binding Children}" Margin="16,0,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="10,8" Margin="0,0,0,4">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <!-- 名字 -->
                                                                    <ColumnDefinition Width="130" />
                                                                    <!-- 组合（分步两个小框 / 同时一个大框） -->
                                                                    <ColumnDefinition Width="*" />
                                                                    <!-- 合并 / 拆分 -->
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <!-- 禁用 / 启用 -->
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <!-- 状态 -->
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                                                    <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </StackPanel>

                                                                <!-- ===== 分步：两个小框 ===== -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding IsSequence, Converter={StaticResource BoolToVis}}">
                                                                    <controls:HotkeyBox Style="{StaticResource HotkeyBoxLocalStyle}" Width="130"
                                                                                        ComboText="{Binding PrimaryBinding, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                                        IsCaptureEnabled="{Binding Definition.Enabled}" />
                                                                    <TextBlock Text="→" Margin="6,0" FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                    <controls:HotkeyBox Style="{StaticResource HotkeyBoxLocalStyle}" Width="130"
                                                                                        ComboText="{Binding SecondaryBinding, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                                        IsCaptureEnabled="{Binding Definition.Enabled}" />
                                                                </StackPanel>

                                                                <!-- ===== 同时：一个大框 ===== -->
                                                                <controls:HotkeyBox Style="{StaticResource HotkeyBoxLocalStyle}" Grid.Column="1" MaxWidth="320"
                                                                                    HorizontalAlignment="Left"
                                                                                    Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}"
                                                                                    ComboText="{Binding PrimaryBinding, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                                    IsCaptureEnabled="{Binding Definition.Enabled}" />

                                                                <!-- 合并（分步 → 同时） -->
                                                                <Button Grid.Column="2" Content="合并"
                                                                        Style="{StaticResource RowButtonStyle}"
                                                                        Visibility="{Binding CanMerge, Converter={StaticResource BoolToVis}}"
                                                                        Click="OnMergeClick"
                                                                        ToolTip="把两段合成的组合并成一条「同时按」" />

                                                                <!-- 拆分（同时 → 分步） -->
                                                                <Button Grid.Column="2" Content="拆分"
                                                                        Style="{StaticResource RowButtonStyle}"
                                                                        Visibility="{Binding CanSplit, Converter={StaticResource BoolToVis}}"
                                                                        Click="OnSplitClick"
                                                                        ToolTip="拆成两步：原来那段作第一步，再录第二步" />

                                                                <!-- 禁用 / 启用 -->
                                                                <Button Grid.Column="3" Content="{Binding ActionText}"
                                                                        Style="{StaticResource RowButtonStyle}"
                                                                        Click="OnToggleEnabledClick"
                                                                        ToolTip="单独关掉这一条（不删除设置）" />

                                                                <!-- 状态 -->
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding StateText}"
                                                                               Style="{StaticResource StateTextStyle}"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                    <TextBlock Text="{Binding StateGlyph}"
                                                                               Style="{StaticResource StateTextStyle}"
                                                                               Margin="4,0,0,0" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- 冲突 / 注册失败原因 -->
                                                            <TextBlock Text="{Binding ErrorText}" FontSize="10.5"
                                                                       TextWrapping="Wrap" Margin="130,5,0,0"
                                                                       Foreground="{DynamicResource DangerBrush}"
                                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态 -->
        <TextBlock FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="还没有任何工具声明全局快捷键。工具实现了 IShortcutProvider 就会自动出现在这里（目前：秒表、KPS 按键统计、录屏、Live2D 桌宠）。"
                   Visibility="{Binding HasNoGroups, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>

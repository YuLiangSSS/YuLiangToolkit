<UserControl x:Class="YuLiangToolkit.App.Views.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YuLiangToolkit.App.Converters"
             x:Name="Root">
    <!-- 一个小巧的颜色拾取按钮：点开 → 预设色板 + 手填 #RRGGBB。
         主页设置里的「粒子颜色 1 / 2」用它；颜色通过 SelectedColor（双向绑定）对外。 -->
    <UserControl.Resources>
        <conv:ColorToBrushConverter x:Key="ColorToBrush" />
    </UserControl.Resources>

    <Grid>
        <Button x:Name="OpenButton" Click="OnOpenClick" Cursor="Hand" Background="Transparent"
                BorderThickness="0" Padding="0" HorizontalAlignment="Left"
                ToolTip="点击选择颜色">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="8,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
                <Border Width="16" Height="16" CornerRadius="4" BorderThickness="1" BorderBrush="#55FFFFFF"
                        VerticalAlignment="Center"
                        Background="{Binding SelectedColor, ElementName=Root, Converter={StaticResource ColorToBrush}}" />
                <TextBlock Text="{Binding HexText, ElementName=Root}" Margin="8,0,0,0" FontSize="12"
                           FontFamily="Consolas" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="▾" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Button>

        <Popup x:Name="PickerPopup" StaysOpen="False" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom">
            <Border Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,6,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel Width="236">
                    <TextBlock Text="选择颜色" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Palette, ElementName=Root}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Color}" Click="OnPaletteClick" Width="24" Height="24"
                                        Margin="2" Cursor="Hand" ToolTip="{Binding Hex}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Chip" Background="{Binding Brush}"
                                                    BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="5" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontFamily="Consolas" VerticalAlignment="Center"
                                   Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="HexBox" Grid.Column="1" Height="30" Style="{StaticResource TextBoxStyle}"
                                 MaxLength="7" PreviewKeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus"
                                 ToolTip="十六进制颜色，例如 #4C8DFF（回车确认）" />
                    </Grid>

                    <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                               Margin="0,6,0,0" Visibility="Collapsed" Text="格式不对，请填 #RRGGBB" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
